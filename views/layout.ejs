<!--views/layout.ejs-->
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />

  <%
    /*
     * Kasyora general-layout SEO
     * ==========================
     *
     * views/layout.ejs is shared by both:
     *
     * - public pages that should participate in search;
     * - private/account/dashboard pages that should not receive
     *   public SEO metadata automatically.
     *
     * Therefore public SEO metadata is route-driven.
     *
     * A public route may supply:
     *
     * - seoTitle
     * - seoDescription
     * - seoCanonicalPath
     * - seoRobots
     * - seoOgType
     * - seoImage
     *
     * Routes that do not supply public SEO values retain the
     * existing general-layout behaviour.
     */

    const GENERAL_SITE_URL =
      String(
        typeof appUrl !== 'undefined' &&
        appUrl
          ? appUrl
          : 'https://kasyora.com'
      )
        .trim()
        .replace(/\/+$/, '');

    function generalAbsoluteUrl(value) {
      const raw =
        String(value || '').trim();

      if (!raw) {
        return '';
      }

      if (/^https?:\/\//i.test(raw)) {
        return raw;
      }

      return (
        GENERAL_SITE_URL +
        '/' +
        raw.replace(/^\/+/, '')
      );
    }

    const GENERAL_PAGE_TITLE =
      String(
        typeof seoTitle !== 'undefined' &&
        seoTitle
          ? seoTitle
          : (
              title
                ? `${title} | Kasyora.com`
                : 'Kasyora.com'
            )
      ).trim();

    const GENERAL_SEO_DESCRIPTION =
      String(
        typeof seoDescription !== 'undefined' &&
        seoDescription
          ? seoDescription
          : ''
      ).trim();

    const GENERAL_CANONICAL_URL =
      typeof seoCanonicalPath !== 'undefined' &&
      seoCanonicalPath
        ? generalAbsoluteUrl(
            seoCanonicalPath
          )
        : '';

    const GENERAL_ROBOTS =
      String(
        typeof seoRobots !== 'undefined' &&
        seoRobots
          ? seoRobots
          : ''
      ).trim();

    const GENERAL_OG_TYPE =
      String(
        typeof seoOgType !== 'undefined' &&
        seoOgType
          ? seoOgType
          : 'website'
      ).trim();

    const GENERAL_OG_IMAGE =
      generalAbsoluteUrl(
        typeof seoImage !== 'undefined' &&
        seoImage
          ? seoImage
          : '/images/branding/logo-unincorporate.png'
      );

    const GENERAL_HAS_PUBLIC_SEO =
      Boolean(
        GENERAL_SEO_DESCRIPTION &&
        GENERAL_CANONICAL_URL
      );
  %>

  <title><%= GENERAL_PAGE_TITLE %></title>

  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <% if (GENERAL_HAS_PUBLIC_SEO) { %>
  <meta name="description" content="<%= GENERAL_SEO_DESCRIPTION %>" />

  <meta name="robots" content="<%= GENERAL_ROBOTS || 'index,follow,max-image-preview:large' %>" />

  <link rel="canonical" href="<%= GENERAL_CANONICAL_URL %>" />

  <meta property="og:type" content="<%= GENERAL_OG_TYPE %>" />

  <meta property="og:site_name" content="Kasyora" />

  <meta property="og:title" content="<%= GENERAL_PAGE_TITLE %>" />

  <meta property="og:description" content="<%= GENERAL_SEO_DESCRIPTION %>" />

  <meta property="og:url" content="<%= GENERAL_CANONICAL_URL %>" />

  <meta property="og:image" content="<%= GENERAL_OG_IMAGE %>" />

  <meta property="og:image:alt" content="Kasyora" />

  <meta name="twitter:card" content="summary_large_image" />

  <meta name="twitter:title" content="<%= GENERAL_PAGE_TITLE %>" />

  <meta name="twitter:description" content="<%= GENERAL_SEO_DESCRIPTION %>" />

  <meta name="twitter:image" content="<%= GENERAL_OG_IMAGE %>" />

  <meta name="twitter:image:alt" content="Kasyora" />
  <% } %>

  <link rel="icon" href="/favicon.ico" />

  <!-- 📊 Chart.js for analytics dashboards -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js" nonce="<%= nonce %>" defer></script>

  <!-- ✅ Bootstrap 5 (CSS) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

  <style>
    :root {
      --bs-primary: #7C3AED;
      --bs-primary-rgb: 124, 58, 237;

      --bs-link-color: #7C3AED;
      --bs-link-hover-color: #6D28D9;
    }

    html {
      overflow-x: hidden;
      overflow-y: auto;
    }

    body {
      overflow: visible;
    }

    .text-primary,
    .btn-link,
    a {
      color: #7C3AED !important;
    }

    .bg-primary,
    .btn-primary {
      background-color: #7C3AED !important;
      border-color: #7C3AED !important;
      color: #fff !important;
    }

    .btn-primary:hover,
    .btn-primary:focus,
    .btn-primary:active {
      background-color: #6D28D9 !important;
      border-color: #6D28D9 !important;
      color: #fff !important;
    }

    .btn-outline-primary {
      color: #7C3AED !important;
      border-color: #7C3AED !important;
    }

    .btn-outline-primary:hover,
    .btn-outline-primary:focus,
    .btn-outline-primary:active {
      background-color: #7C3AED !important;
      border-color: #7C3AED !important;
      color: #fff !important;
    }

    .border-primary {
      border-color: #7C3AED !important;
    }

    .text-brand-green {
      color: #22C55E !important;
    }

    .bg-brand-green {
      background-color: #22C55E !important;
      color: #fff !important;
    }

    .border-brand-green {
      border-color: #22C55E !important;
    }

    .btn-brand-green {
      background-color: #22C55E !important;
      border-color: #22C55E !important;
      color: #fff !important;
    }

    .btn-brand-green:hover,
    .btn-brand-green:focus,
    .btn-brand-green:active {
      background-color: #16A34A !important;
      border-color: #16A34A !important;
      color: #fff !important;
    }

    .btn-outline-brand-green {
      color: #22C55E !important;
      border-color: #22C55E !important;
      background-color: transparent !important;
    }

    .btn-outline-brand-green:hover,
    .btn-outline-brand-green:focus,
    .btn-outline-brand-green:active {
      background-color: #22C55E !important;
      border-color: #22C55E !important;
      color: #fff !important;
    }
  </style>

  <%- typeof styles !== 'undefined' ? styles : '' %>
</head>

<body class="<%= (themeCss && themeCss.includes('dark')) ? 'bg-dark text-light' : 'bg-body text-body' %>">

  <%- include('partials/navbar', {
    user: typeof user !== 'undefined' ? user : null,
    business: typeof business !== 'undefined' ? business : null,
    active: typeof active !== 'undefined' ? active : '',
    themeCss: typeof themeCss !== 'undefined' ? themeCss : '',
    nonce: typeof nonce !== 'undefined' ? nonce : ''
  }) %>

  <div class="container mt-0">
    <%- include('partials/massage', {
      success: success || [],
      error: error || [],
      info: info || [],
      warning: warning || [],
      errors: errors || [],
      nonce: typeof nonce !== 'undefined' ? nonce : ''
    }) %>
  </div>

  <main class="<%= typeof fullWidthPage !== 'undefined' && fullWidthPage ? 'container-fluid px-0 pt-0 pb-4' : 'container pt-0 pb-4' %>">
    <%- body %>
  </main>

  <div class="border-top px-0">
    <div class="container-fluid px-0">
      <%- include('partials/footer', {
        nonce: typeof nonce !== 'undefined' ? nonce : ''
      }) %>
    </div>
  </div>

  <%- typeof scripts !== 'undefined' ? scripts : '' %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>

  <script nonce="<%= nonce %>">
    document.addEventListener("DOMContentLoaded", () => {
      console.log("✅ Layout loaded (Bootstrap only)");
    });
  </script>
</body>

</html>