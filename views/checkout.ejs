<!--views/checkout.ejs-->
<%
  const CO_NONCE =
    typeof nonce !== 'undefined'
      ? nonce
      : '';

  const CO_CLIENT_ID =
    typeof paypalClientId !== 'undefined'
      ? String(paypalClientId || '').trim()
      : '';

  /*
   * Currency sent to the PayPal SDK and captured by PayPal.
   * This must remain separate from the customer display currency.
   */
  const CO_PAYPAL_CURRENCY = String(
    typeof currency !== 'undefined'
      ? currency
      : 'USD'
  ).trim().toUpperCase() || 'USD';

  /*
   * Authoritative Kasyora cart, shipping, order and accounting currency.
   */
  const CO_BASE_CURRENCY = String(
    typeof baseCurrency !== 'undefined'
      ? baseCurrency
      : 'USD'
  ).trim().toUpperCase() || 'USD';

  /*
   * Customer-selected presentation currency.
   * This affects only visible values on the checkout page.
   */
  const CO_DISPLAY_CURRENCY = String(
    typeof displayCurrency !== 'undefined'
      ? displayCurrency
      : CO_BASE_CURRENCY
  ).trim().toUpperCase() || CO_BASE_CURRENCY;

  const CO_DISPLAY_RATE_RAW = Number(
    typeof displayRate !== 'undefined'
      ? displayRate
      : 1
  );

  const CO_DISPLAY_RATE =
    Number.isFinite(CO_DISPLAY_RATE_RAW) &&
    CO_DISPLAY_RATE_RAW > 0
      ? CO_DISPLAY_RATE_RAW
      : 1;

  const CO_BRAND =
    typeof brandName !== 'undefined'
      ? brandName
      : 'Kasyora.com';

  /*
   * Resolved provisional Internal checkout tax context
   * ==================================================
   *
   * This treatment controls only the initial checkout
   * presentation.
   *
   * The validated shipping country submitted to
   * POST /payment/create-order remains authoritative.
   */
  const CO_TAX_TREATMENT =
    typeof taxTreatment !== 'undefined' &&
    taxTreatment &&
    typeof taxTreatment === 'object'
      ? taxTreatment
      : {};

  const CO_VAT_RATE_RAW =
    Number(
      CO_TAX_TREATMENT.vatRate ??
      (
        typeof vatRate !== 'undefined'
          ? vatRate
          : 0
      )
    );

  const CO_VAT =
    Number.isFinite(
      CO_VAT_RATE_RAW
    ) &&
    CO_VAT_RATE_RAW >= 0 &&
    CO_VAT_RATE_RAW <= 1
      ? CO_VAT_RATE_RAW
      : 0;

  /*
   * vatEnabled distinguishes:
   *
   * VAT disabled:
   *   vatEnabled false, rate 0
   *
   * Foreign zero-rated export:
   *   vatEnabled true, rate 0
   *
   * South African standard VAT:
   *   vatEnabled true, positive rate
   */
  const CO_VAT_ENABLED =
    CO_TAX_TREATMENT.vatEnabled === true;
%>

<section class="co-page container-fluid px-0 py-0" aria-label="Checkout">
  <style nonce="<%= CO_NONCE %>">
    .checkout-page-loader {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, .92);
      backdrop-filter: blur(4px);
      opacity: 1;
      visibility: visible;
      transition: opacity .45s ease, visibility .45s ease;
    }

    .checkout-page-loader.is-hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .checkout-page-loader-box {
      width: 88px;
      height: 88px;
    }

    .checkout-page-loader-spinner {
      width: 2.5rem;
      height: 2.5rem;
      border-width: .24rem;
    }

    body.co-page-loading {
      overflow: hidden;
    }
  </style>

  <div id="checkoutPageLoader" class="position-fixed top-0 start-0 w-100 vh-100 d-flex align-items-center justify-content-center checkout-page-loader" aria-label="Loading checkout" aria-live="polite">
    <div class="bg-white rounded-circle shadow d-flex align-items-center justify-content-center checkout-page-loader-box">
      <div class="spinner-border text-primary checkout-page-loader-spinner" role="status" aria-hidden="true"></div>
    </div>
  </div>

  <!-- ===== Top Compact Header (does NOT replace your layout header/nav) ===== -->
  <header class="co-hero card border-0 shadow-sm text-white mb-3 mb-lg-4" aria-label="Checkout header">
    <div class="co-hero-inner card-body p-3 p-lg-4">
      <div class="co-breadcrumb" aria-label="Breadcrumb">
        <a href="/cart" class="co-link">Cart</a>
        <span class="co-sep">›</span>
        <span class="co-crumb">Checkout</span>
      </div>

      <div class="co-title-row">
        <h1 class="co-title">Secure Checkout</h1>

        <div class="d-flex align-items-center gap-2">
          <div class="bg-white rounded px-2 py-1">
            <%- include('store/partials/currency-selector', {
              currencyReturnTo: '/payment/checkout'
            }) %>
          </div>

          <span class="co-badge">Protected</span>
        </div>
      </div>

      <p class="co-subtitle">
        Prices are displayed in
        <strong><%= CO_DISPLAY_CURRENCY %></strong>.
        PayPal securely processes the payment in
        <strong><%= CO_PAYPAL_CURRENCY %></strong>.
      </p>

      <div class="co-steps" aria-label="Steps">
        <div class="co-step done"><span>1</span><em>Cart</em></div>
        <div class="co-step done"><span>2</span><em>Details</em></div>
        <div class="co-step now"><span>3</span><em>Payment</em></div>
        <div class="co-step"><span>4</span><em>Confirm</em></div>
      </div>
    </div>
  </header>

  <%
    const CO_SHOW_CURRENCY_WARNING =
      typeof currencyConversionAvailable !== 'undefined' &&
      currencyConversionAvailable === false;

    const CO_CURRENCY_WARNING_TEXT =
      typeof currencyConversionMessage !== 'undefined'
        ? String(currencyConversionMessage || '').trim()
        : '';
  %>

  <% if (
    CO_SHOW_CURRENCY_WARNING &&
    CO_CURRENCY_WARNING_TEXT
  ) { %>
  <div class="alert alert-warning border shadow-sm mx-2 mx-lg-auto mb-3" role="alert" style="max-width: 1100px;">
    <div class="d-flex align-items-start gap-2">
      <i class="fas fa-exclamation-triangle text-primary mt-1" aria-hidden="true"></i>

      <div>
        <div class="fw-bold text-primary">
          Currency display notice
        </div>

        <div class="small">
          <%= CO_CURRENCY_WARNING_TEXT %>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  <!-- ===== Content ===== -->
  <div class="co-grid row gx-0 gy-0 gx-lg-4 gy-lg-4">
    <!-- LEFT: Cart + Delivery -->
    <div class="co-col col-12 col-xl-6 d-flex flex-column gap-3">
      <!-- Cart Summary -->
      <div class="co-card co-card-purple card border-0 shadow-sm" aria-label="Cart summary">
        <div class="co-card-h card-header py-3 px-3 px-lg-4">
          <div class="co-card-title">
            <span class="co-icon" aria-hidden="true">🛒</span>
            <h2>Shopping Cart</h2>
          </div>
          <a href="/products/sales" class="co-action">Click here to Add more</a>
        </div>

        <div class="co-card-b card-body p-3 p-lg-4">
          <div id="cart-state" class="co-loading" aria-live="polite">
            <span class="co-spinner" aria-hidden="true"></span>
            <span>Loading your cart…</span>
          </div>

          <div id="cart-items" class="co-cart" style="display:none"></div>

          <div id="cart-empty" class="co-empty" style="display:none">
            <div class="co-empty-ic" aria-hidden="true">🛒</div>
            <h3>Your cart is empty</h3>
            <p>Go back and add items to continue.</p>
            <a href="/store/shop" class="co-btn co-btn-blue btn btn-primary">Browse Products</a>
          </div>
        </div>
      </div>

      <!-- Delivery Options -->
      <div class="co-card co-card-blue card border-0 shadow-sm" aria-label="Delivery options">
        <div class="co-card-h card-header py-3 px-3 px-lg-4">
          <div class="co-card-title">
            <span class="co-icon" aria-hidden="true">🚚</span>
            <h2>Delivery</h2>
          </div>
          <span class="co-pill">Required</span>
        </div>

        <div class="co-card-b card-body p-3 p-lg-4">

          <!-- Shipping Address (collapsible) -->
          <details id="ship-details" class="co-card co-card-purple co-collapse" aria-label="Shipping address" open style="margin-bottom:.75rem">

            <summary class="co-card-h">
              <div class="co-card-title">
                <span class="co-icon" aria-hidden="true">📍</span>
                <div class="co-collapse-title">
                  <h2>Shipping Address</h2>
                  <div id="ship-summary" class="co-collapse-summary">Not completed yet</div>
                </div>
              </div>

              <div class="co-collapse-right">
                <span class="co-pill">Required</span>
                <span class="co-collapse-caret" aria-hidden="true">▼</span>
              </div>
            </summary>

            <div class="co-card-b card-body p-3 p-lg-4">
              <div class="co-mini" id="ship-hint" aria-live="polite">
                Please enter the address where you want the order delivered.
              </div>

              <label class="co-label" for="ship-name">Full name <span class="co-req">*</span></label>
              <input id="ship-name" class="co-input form-control" autocomplete="name" placeholder="Full name" />
              <label class="co-label" for="ship-phone" style="margin-top:.6rem">Phone <span class="co-req">*</span></label>
              <input id="ship-phone" class="co-input form-control" type="tel" inputmode="tel" autocomplete="tel" placeholder="+27..." required />

              <label class="co-label" for="ship-email" style="margin-top:.6rem">Email (optional)</label>
              <input id="ship-email" class="co-input form-control" autocomplete="email" placeholder="you@example.com" />

              <label class="co-label" for="ship-line1" style="margin-top:.6rem">Address line 1 <span class="co-req">*</span></label>
              <input id="ship-line1" class="co-input form-control" autocomplete="address-line1" placeholder="Street number and street name" />

              <label class="co-label" for="ship-line2" style="margin-top:.6rem">
                Suburb / local area / Town <span class="co-req">*</span>
              </label>

              <input id="ship-line2" class="co-input form-control" autocomplete="address-level3" placeholder="e.g. Bellville South" required />

              <label class="co-label" for="ship-city" style="margin-top:.6rem">City <span class="co-req">*</span></label>
              <input id="ship-city" class="co-input form-control" autocomplete="address-level2" placeholder="City" />

              <label class="co-label" for="ship-state" style="margin-top:.6rem">Province/State <span class="co-req">*</span></label>
              <input id="ship-state" class="co-input form-control" autocomplete="address-level1" placeholder="Gauteng, WC, etc." />

              <label class="co-label" for="ship-zip" style="margin-top:.6rem">Postal code <span class="co-req">*</span></label>
              <input id="ship-zip" class="co-input form-control" autocomplete="postal-code" placeholder="0000" />

              <label class="co-label" style="margin-top:.6rem">
                Country <span class="co-req">*</span>
              </label>

              <div class="co-country-dropdown" id="coCountryDropdown">
                <div class="co-country-selected" id="coCountrySelected" role="button" tabindex="0" aria-haspopup="listbox" aria-expanded="false">
                  <span id="coCountrySelectedText">Select your country</span>
                  <span class="co-country-arrow" aria-hidden="true">▾</span>
                </div>

                <div class="co-country-menu" id="coCountryMenu" role="listbox" aria-label="Country list">
                  <input type="text" id="coCountrySearch" placeholder="Search country..." autocomplete="off" class="co-country-search-input" />
                  <div class="co-country-list" id="coCountryList"></div>
                </div>

                <!-- ✅ REAL select kept for backend-safe + your existing JS reads its value -->
                <select id="ship-country" class="co-select-el form-select" aria-label="Country" style="display:none;"></select>
              </div>

              <div class="co-mini">Tip: search by name or code (e.g. “South”, “ZA”, “United”, “US”).</div>

              <div class="co-form-actions">
                <button type="button" id="ship-done" class="co-btn co-btn-blue btn btn-primary">Done</button>
                <button type="button" id="ship-edit" class="co-btn co-btn-ghost btn btn-outline-secondary">Keep editing</button>
              </div>
            </div>
          </details>

          <label for="delivery-select" class="co-label">
            Select shipping rate (live) <span class="co-req">*</span>
          </label>

          <div class="co-select">
            <select id="delivery-select" class="co-select-el form-select" disabled aria-label="Delivery method">
              <option value="">Loading options…</option>
            </select>
            <span class="co-select-caret" aria-hidden="true">▼</span>
          </div>

          <div style="margin-top:.55rem; display:flex; gap:.55rem; flex-wrap:wrap;">
            <button type="button" id="rates-retry" class="co-btn co-btn-ghost btn btn-outline-secondary btn-sm">Retry rates</button>
            <small class="co-mini" id="rates-debug" style="margin:0;">&nbsp;</small>
          </div>

          <div id="international-customs-notice" class="alert border shadow-sm mt-3 mb-0 d-none" style="border-color:#7C3AED !important;" role="alert" aria-live="polite">
            <div class="d-flex align-items-start gap-2">
              <span class="fw-bold text-primary" aria-hidden="true">⚠️</span>
              <div>
                <div class="fw-bold text-primary">International customs notice</div>
                <div class="small text-dark">
                  Import duties, taxes, and customs fees are <strong>not included</strong> in the checkout total.
                  Your country or carrier may contact you to pay these charges before delivery.
                </div>
                <div class="small mt-1 text-muted" id="international-customs-route"></div>
              </div>
            </div>
          </div>

          <div id="delivery-hint" class="co-hint" aria-live="polite">
            <span class="co-hint-ic" aria-hidden="true">⏱️</span>
            <span>Loading delivery estimates…</span>
          </div>

          <div id="delivery-info" class="co-info" style="display:none" aria-label="Delivery details">
            <div class="co-info-row">
              <span class="co-info-ic" aria-hidden="true">📦</span>
              <div>
                <small>Delivery Type</small>
                <strong id="delivery-type">—</strong>
              </div>
            </div>

            <div class="co-info-row">
              <span class="co-info-ic" aria-hidden="true">⏱️</span>
              <div>
                <small>Estimated Delivery</small>
                <strong id="delivery-estimate">—</strong>
              </div>
            </div>

            <div class="co-info-row">
              <span class="co-info-ic" aria-hidden="true">📍</span>
              <div>
                <small>Delivery Area</small>
                <strong id="delivery-area">—</strong>
              </div>
            </div>
          </div>



          <!-- Optional note (UI only) -->
          <label for="delivery-note" class="co-label" style="margin-top:.8rem">
            Delivery note (optional)
          </label>
          <input id="delivery-note" class="co-input" type="text" placeholder="e.g. Gate code, call on arrival, leave at reception" autocomplete="off" />
          <div class="co-mini">
            Note is not required and does not affect payment.
          </div>
        </div>
      </div>
    </div>

    <!-- RIGHT: Summary + PayPal -->
    <div class="co-col col-12 col-xl-6 d-flex flex-column gap-3">
      <!-- Order Summary -->
      <div class="co-card co-card-green card border-0 shadow-sm" aria-label="Order summary">
        <div class="co-card-h card-header py-3 px-3 px-lg-4">
          <div class="co-card-title">
            <span class="co-icon" aria-hidden="true">🧾</span>
            <h2>Order Summary</h2>
          </div>
        </div>

        <div class="co-card-b card-body p-3 p-lg-4">
          <div class="co-sum">
            <div class="co-sum-row">
              <span>Subtotal</span>
              <strong id="sum-subtotal">—</strong>
            </div>

            <div id="checkoutVatRow" class="co-sum-row <%= CO_VAT_ENABLED ? '' : 'd-none' %>">
              <span>
                VAT
                (<span id="vat-rate"><%= (CO_VAT * 100).toFixed(0) %></span>%)
              </span>

              <strong id="sum-vat">—</strong>
            </div>

            <div class="co-sum-row">
              <span>Shipping</span>
              <strong id="sum-shipping">—</strong>
            </div>

            <div class="co-sum-rule"></div>

            <div class="co-sum-total">
              <span>Total</span>
              <strong id="sum-total">—</strong>
            </div>

            <div class="co-note">
              <span aria-hidden="true">💡</span>

              <span>
                <% if (CO_VAT_ENABLED) { %>
                VAT is applied according to the completed shipping
                country where applicable.
                <% } %>

                Displayed in
                <strong><%= CO_DISPLAY_CURRENCY %></strong>;
                PayPal payment is processed in
                <strong><%= CO_PAYPAL_CURRENCY %></strong>.

                The validated shipping address determines the final
                tax treatment.
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Payment -->
      <div class="co-card co-card-black card border-0 shadow-sm" aria-label="Payment">
        <div class="co-card-h card-header py-3 px-3 px-lg-4">
          <div class="co-card-title">
            <span class="co-icon" aria-hidden="true">💳</span>
            <h2>Pay Securely</h2>
          </div>
          <span class="co-sec">
            <span aria-hidden="true">🔒</span> Secure
          </span>
        </div>

        <div class="co-card-b card-body p-3 p-lg-4">
          <div class="co-payhead">
            <div>
              <div class="co-paytitle">Pay with PayPal</div>
              <div class="co-paymuted">Debit/Credit card enabled where available</div>
            </div>
          </div>

          <div class="co-paybox">
            <div id="pay-guard" class="co-guard" aria-live="polite">
              <span class="co-spinner" aria-hidden="true"></span>
              <p>Waiting for cart & delivery options…</p>
            </div>

            <div id="paypal-buttons" class="co-pp"></div>
          </div>

          <div class="co-paynote">
            <div class="co-paynote-row">
              <span class="ok" aria-hidden="true">✓</span>
              <span>Processed securely by PayPal</span>
            </div>
            <div class="co-paynote-row">
              <span class="ok" aria-hidden="true">✓</span>
              <span>We never store your card details</span>
            </div>
            <div class="co-paynote-row">
              <span class="ok" aria-hidden="true">✓</span>
              <span>Merchant: <%= CO_BRAND %></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Compact trust row -->
      <div class="co-trust row g-2 mt-1" aria-label="Trust signals">
        <div class="col-4">
          <div class="co-trust-item h-100"><span aria-hidden="true">🔒</span><span>SSL</span></div>
        </div>
        <div class="col-4">
          <div class="co-trust-item h-100"><span aria-hidden="true">💳</span><span>PCI</span></div>
        </div>
        <div class="col-4">
          <div class="co-trust-item h-100"><span aria-hidden="true">🔄</span><span>Returns</span></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast (kept) -->
  <div id="toast" class="co-toast toast align-items-center text-bg-dark border-0 show" role="status" aria-live="polite" aria-atomic="true" hidden>
    <div class="co-toast-inner">
      <span class="co-toast-icon"></span>
      <span class="co-toast-message"></span>
    </div>
  </div>

  <!-- Templates -->
  <template id="tpl-cart-row">
    <div class="co-item" data-id="">
      <div class="co-item-img">
        <img class="co-img" alt="" />
      </div>
      <div class="co-item-mid">
        <div class="co-item-top">
          <h3 class="co-item-name"></h3>
          <button type="button" class="co-x" aria-label="Remove item">×</button>
        </div>
        <div class="co-item-variants"></div>

        <div class="co-item-bot">
          <div class="co-qty" aria-label="Quantity">
            <button type="button" class="co-qty-btn co-dec" aria-label="Decrease quantity">−</button>
            <span class="co-qty-val">1</span>
            <button type="button" class="co-qty-btn co-inc" aria-label="Increase quantity">+</button>
          </div>
          <div class="co-item-price">
            <strong class="co-price-val"></strong>
            <small>total</small>
          </div>
        </div>
      </div>
    </div>
  </template>

  <!-- JSON config -->
  <script id="checkout-config" type="application/json" nonce="<%= CO_NONCE %>">
    <%- JSON.stringify({
      /*
       * Whether Internal Kasyora VAT is currently enabled.
       *
       * This controls browser presentation only.
       * POST /payment/create-order independently resolves the
       * authoritative server-side treatment.
       */
      VAT_ENABLED:
        CO_VAT_ENABLED === true,

      /*
       * Configured South African standard VAT rate.
       *
       * This is used only for browser presentation after the
       * customer selects South Africa as the shipping country.
       *
       * POST /payment/create-order independently resolves the
       * authoritative server-side rate.
       */
      SOUTH_AFRICA_VAT_RATE:
        Number(
          typeof southAfricaVatRate !== 'undefined'
            ? southAfricaVatRate
            : 0
        ),

      /*
      * Authoritative Kasyora currency.
       * Cart, shipping and total calculations remain in this currency.
       */
      BASE_CURRENCY: CO_BASE_CURRENCY,

      /*
       * Customer presentation currency.
       * This must never be sent as the authoritative payment amount.
       */
      DISPLAY_CURRENCY: CO_DISPLAY_CURRENCY,

      /*
       * BASE_CURRENCY → DISPLAY_CURRENCY.
       */
      DISPLAY_RATE: Number(CO_DISPLAY_RATE),

      /*
       * Currency loaded into the PayPal SDK.
       */
      PAYPAL_CURRENCY: CO_PAYPAL_CURRENCY,

      BRAND_NAME: CO_BRAND,

      DEFAULT_COUNTRY:
        typeof defaultCountry !== 'undefined' &&
        defaultCountry
          ? String(defaultCountry).toUpperCase()
          : 'ZA',

      COUNTRIES:
        Array.isArray(COUNTRIES)
          ? COUNTRIES
          : []
    }) %>
  </script>

  <!-- PayPal SDK (paths unchanged) -->
  <script nonce="<%= CO_NONCE %>" src="https://www.paypal.com/sdk/js?client-id=<%= encodeURIComponent(CO_CLIENT_ID) %>&components=buttons&currency=<%= encodeURIComponent(CO_PAYPAL_CURRENCY) %>&intent=capture&enable-funding=card"></script>

  <style nonce="<%= CO_NONCE %>">
    /* ===== Bootstrap-safe checkout helpers ===== */
    .co-page {
      --b: #2563EB;
      /* Blue */
      --p: #7C3AED;
      /* Purple (dominant) */
      --g: #22C55E;
      /* Green */
      --k: #0F172A;
      /* Black */
      --w: #ffffff;
      --mut: #64748B;
      --line: rgba(15, 23, 42, .12);
      --shadow: 0 10px 24px rgba(15, 23, 42, .12);

      position: relative;
      padding: .75rem;
      background:
        radial-gradient(900px 420px at 50% -10%, rgba(124, 58, 237, .25) 0%, rgba(37, 99, 235, .08) 55%, rgba(34, 197, 94, .06) 100%),
        linear-gradient(180deg, #f8fafc, #f8fafc);
      min-height: 60vh;
    }

    /* ===== Hero ===== */
    .co-hero {
      position: relative;
      z-index: 1050;
      border-radius: 18px;
      padding: .9rem;
      margin-bottom: 0 !important;
      background: linear-gradient(135deg, rgba(124, 58, 237, 1), rgba(37, 99, 235, 1));
      color: #fff;
      box-shadow: var(--shadow);
      overflow: visible;
    }

    .co-hero-inner {
      max-width: 1100px;
      margin: 0 auto;
    }

    .co-breadcrumb {
      display: flex;
      align-items: center;
      gap: .45rem;
      font-size: .88rem;
      opacity: .95;
    }

    .co-link {
      color: #fff;
      text-decoration: none;
      font-weight: 800;
    }

    .co-link:hover {
      text-decoration: underline;
    }

    .co-sep {
      opacity: .85;
    }

    .co-crumb {
      font-weight: 700;
      opacity: .95;
    }

    .co-title-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: .6rem;
      margin-top: .35rem;
    }

    .co-title {
      margin: 0;
      font-size: 1.15rem;
      font-weight: 950;
      letter-spacing: .2px;
    }

    .co-badge {
      background: rgba(255, 255, 255, .18);
      border: 1px solid rgba(255, 255, 255, .25);
      padding: .22rem .6rem;
      border-radius: 999px;
      font-weight: 900;
      font-size: .78rem;
      white-space: nowrap;
    }

    .co-subtitle {
      margin: .35rem 0 0;
      font-size: .9rem;
      opacity: .95;
    }

    .co-steps {
      margin-top: .75rem;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: .35rem;
    }

    .co-step {
      background: rgba(255, 255, 255, .14);
      border: 1px solid rgba(255, 255, 255, .22);
      border-radius: 12px;
      padding: .4rem .45rem;
      display: flex;
      align-items: center;
      gap: .45rem;
      justify-content: center;
      font-size: .78rem;
      font-weight: 900;
      text-align: center;
      white-space: nowrap;
    }

    .co-step span {
      width: 22px;
      height: 22px;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, .22);
      border: 1px solid rgba(255, 255, 255, .26);
    }

    .co-step em {
      font-style: normal;
      opacity: .98;
    }

    .co-step.done {
      background: rgba(34, 197, 94, .22);
      border-color: rgba(34, 197, 94, .35);
    }

    .co-step.now {
      background: rgba(15, 23, 42, .22);
      border-color: rgba(15, 23, 42, .18);
    }

    .co-grid {
      position: relative;
      z-index: 1;
      max-width: 1100px;
      margin: 0 auto 0;
    }

    .co-col {
      display: flex;
      flex-direction: column;
      gap: .75rem;
    }

    /* ===== Cards ===== */
    .co-card {
      border-radius: 18px;
      overflow: hidden;
      box-shadow: var(--shadow);
      border: 1px solid var(--line);
      background: #fff;
    }

    .co-card-h {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: .75rem;
      min-height: 72px;
      padding: .75rem .85rem;
      border-bottom: 1px solid var(--line);
    }

    .co-card-title {
      display: flex;
      align-items: center;
      gap: .55rem;
      min-height: 40px;
    }

    .co-card-title h2 {
      margin: 0;
      font-size: 1rem;
      font-weight: 950;
      color: var(--k);
    }

    .co-icon {
      width: 28px;
      height: 28px;
      display: grid;
      place-items: center;
      border-radius: 10px;
      font-size: 1.05rem;
    }

    .co-card-b {
      padding: .8rem .85rem;
    }

    .co-action {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
      text-decoration: none;
      font-weight: 900;
      font-size: .86rem;
      color: var(--b);
      white-space: nowrap;
    }

    .co-action:hover {
      text-decoration: underline;
    }

    .co-pill {
      background: rgba(124, 58, 237, .14);
      color: var(--p);
      border: 1px solid rgba(124, 58, 237, .25);
      padding: .2rem .55rem;
      border-radius: 999px;
      font-size: .75rem;
      font-weight: 950;
    }

    .co-sec {
      background: rgba(34, 197, 94, .14);
      color: #166534;
      border: 1px solid rgba(34, 197, 94, .25);
      padding: .2rem .55rem;
      border-radius: 999px;
      font-size: .75rem;
      font-weight: 950;
      display: flex;
      gap: .35rem;
      align-items: center;
    }

    /* colored headers (visible blocks) */
    .co-card-purple .co-card-h {
      background: rgba(124, 58, 237, .12);
    }

    .co-card-purple .co-icon {
      background: rgba(124, 58, 237, .18);
    }

    .co-card-blue .co-card-h {
      background: rgba(37, 99, 235, .10);
    }

    .co-card-blue .co-icon {
      background: rgba(37, 99, 235, .16);
    }

    .co-card-green .co-card-h {
      background: rgba(34, 197, 94, .10);
    }

    .co-card-green .co-icon {
      background: rgba(34, 197, 94, .16);
    }

    .co-card-black .co-card-h {
      background: rgba(15, 23, 42, .08);
    }

    .co-card-black .co-icon {
      background: rgba(15, 23, 42, .10);
    }

    /* ===== Loading / empty ===== */
    .co-loading {
      display: flex;
      align-items: center;
      gap: .55rem;
      padding: .7rem;
      background: rgba(124, 58, 237, .06);
      border: 1px dashed rgba(124, 58, 237, .28);
      border-radius: 14px;
      color: var(--k);
      font-weight: 800;
      font-size: .9rem;
    }

    .co-spinner {
      width: 18px;
      height: 18px;
      border-radius: 999px;
      border: 3px solid rgba(15, 23, 42, .12);
      border-top-color: var(--p);
      animation: coSpin 1s linear infinite;
      flex: 0 0 auto;
    }

    @keyframes coSpin {
      to {
        transform: rotate(360deg);
      }
    }

    .co-empty {
      text-align: center;
      padding: .9rem .4rem;
    }

    .co-empty-ic {
      font-size: 2.1rem;
    }

    .co-empty h3 {
      margin: .25rem 0 0;
      font-size: 1.05rem;
      font-weight: 950;
      color: var(--k);
    }

    .co-empty p {
      margin: .25rem 0 .6rem;
      color: var(--mut);
      font-weight: 650;
    }

    /* ===== Buttons ===== */
    .co-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: .55rem .9rem;
      border-radius: 12px;
      font-weight: 950;
      text-decoration: none;
      border: 1px solid transparent;
      cursor: pointer;
      font-size: .92rem;
      user-select: none;
    }

    .co-btn-blue {
      background: var(--b);
      color: #fff;
      border-color: var(--b);
    }

    .co-btn-blue:hover {
      filter: brightness(.95);
      transform: translateY(-1px);
    }

    /* ===== Address actions ===== */
    .co-form-actions {
      display: flex;
      gap: .55rem;
      margin-top: .85rem;
    }

    .co-btn-ghost {
      background: #fff;
      color: var(--k);
      border: 1px solid rgba(15, 23, 42, .18);
    }

    .co-btn-ghost:hover {
      background: rgba(15, 23, 42, .03);
    }

    /* ===== Delivery UI ===== */
    .co-label {
      display: block;
      font-size: .9rem;
      font-weight: 950;
      color: var(--k);
      margin-bottom: .35rem;
    }

    .co-req {
      color: #ef4444;
    }

    .co-select {
      position: relative;
    }

    .co-select-el {
      width: 100%;
      padding: .7rem 2.2rem .7rem .75rem;
      border-radius: 14px;
      border: 1px solid rgba(15, 23, 42, .14);
      font-weight: 800;
      outline: none;
      background: #fff;
      color: var(--k);
    }

    .co-select-el:focus {
      border-color: rgba(124, 58, 237, .55);
      box-shadow: 0 0 0 3px rgba(124, 58, 237, .14);
    }

    .co-select-el:disabled {
      background: #f1f5f9;
      cursor: not-allowed;
    }

    .co-select-caret {
      position: absolute;
      right: .8rem;
      top: 50%;
      transform: translateY(-50%);
      color: rgba(15, 23, 42, .55);
      pointer-events: none;
    }

    .co-hint {
      display: flex;
      gap: .45rem;
      align-items: center;
      margin-top: .45rem;
      font-weight: 750;
      color: var(--mut);
      font-size: .86rem;
    }

    .co-hint-ic {
      opacity: .9;
    }

    .co-info {
      margin-top: .7rem;
      display: flex;
      flex-direction: column;
      gap: .55rem;
      padding: .7rem;
      border-radius: 14px;
      border: 1px solid rgba(37, 99, 235, .18);
      background: rgba(37, 99, 235, .06);
    }

    .co-info-row {
      display: flex;
      gap: .55rem;
      align-items: center;
    }

    .co-info-ic {
      width: 34px;
      height: 34px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      background: #fff;
      border: 1px solid rgba(15, 23, 42, .10);
    }

    .co-info-row small {
      display: block;
      color: var(--mut);
      font-weight: 800;
      font-size: .78rem;
    }

    .co-info-row strong {
      color: var(--k);
      font-weight: 950;
      font-size: .92rem;
    }

    .co-input {
      width: 100%;
      padding: .7rem .75rem;
      border-radius: 14px;
      border: 1px solid rgba(15, 23, 42, .14);
      outline: none;
      font-weight: 800;
      color: var(--k);
      background: #fff;
    }

    .co-input::placeholder {
      color: rgba(100, 116, 139, .9);
      font-weight: 750;
    }

    .co-input:focus {
      border-color: rgba(124, 58, 237, .55);
      box-shadow: 0 0 0 3px rgba(124, 58, 237, .14);
    }

    .co-mini {
      margin-top: .35rem;
      font-size: .78rem;
      color: var(--mut);
      font-weight: 700;
    }

    /* ===== Smart Country Dropdown (Checkout) ===== */
    .co-country-dropdown {
      position: relative;
    }

    .co-country-selected {
      padding: .7rem .85rem;
      border: 1px solid rgba(15, 23, 42, .14);
      border-radius: 14px;
      cursor: pointer;
      background: #fff;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-weight: 800;
      color: var(--k);
    }

    .co-country-selected:focus {
      outline: none;
      border-color: rgba(124, 58, 237, .55);
      box-shadow: 0 0 0 3px rgba(124, 58, 237, .14);
    }

    .co-country-dropdown.open .co-country-menu {
      display: block;
    }

    .co-country-menu {
      position: absolute;
      top: calc(100% + .45rem);
      left: 0;
      right: 0;
      background: #fff;
      border: 1px solid rgba(15, 23, 42, .14);
      border-radius: 14px;
      max-height: 280px;
      overflow: hidden;
      display: none;
      z-index: 60;
      box-shadow: 0 12px 26px rgba(15, 23, 42, .14);
    }

    .co-country-search-input {
      width: 100%;
      padding: .65rem .75rem;
      border: 0;
      border-bottom: 1px solid rgba(15, 23, 42, .10);
      outline: none;
      font-weight: 800;
    }

    .co-country-list {
      max-height: 220px;
      overflow: auto;
    }

    .co-country-option {
      padding: .6rem .85rem;
      cursor: pointer;
      font-size: .9rem;
      font-weight: 800;
      color: var(--k);
    }

    .co-country-option {
      display: flex;
      align-items: center;
      gap: .55rem;
    }

    .co-country-text {
      display: inline-block;
    }

    .co-flag {
      width: 20px;
      height: 15px;
      border-radius: 3px;
      border: 1px solid rgba(15, 23, 42, .10);
      background: #fff;
      flex: 0 0 auto;
    }

    /* Selected line: make flag + text align nicely */
    #coCountrySelectedText {
      display: flex;
      align-items: center;
      gap: .55rem;
    }

    .co-country-option:hover {
      background: rgba(124, 58, 237, .08);
    }

    .co-country-option.active {
      background: rgba(124, 58, 237, .15);
    }

    /* ===== Cart items ===== */
    .co-cart {
      display: flex;
      flex-direction: column;
      gap: .65rem;
    }

    .co-item {
      display: grid;
      grid-template-columns: 72px 1fr;
      gap: .6rem;
      padding: .6rem;
      border-radius: 16px;
      border: 1px solid rgba(124, 58, 237, .16);
      background: rgba(124, 58, 237, .05);
    }

    .co-item-img {
      width: 72px;
      height: 72px;
      border-radius: 14px;
      overflow: hidden;
      background: #fff;
      border: 1px solid rgba(15, 23, 42, .10);
    }

    .co-img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    .co-item-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: .45rem;
    }

    .co-item-name {
      margin: 0;
      font-size: .92rem;
      font-weight: 950;
      color: var(--k);
      line-height: 1.2;
    }

    .co-x {
      border: 1px solid rgba(15, 23, 42, .12);
      background: #fff;
      color: rgba(15, 23, 42, .72);
      width: 32px;
      height: 32px;
      border-radius: 12px;
      cursor: pointer;
      font-size: 1.15rem;
      line-height: 1;
      font-weight: 950;
    }

    .co-x:hover {
      border-color: rgba(239, 68, 68, .45);
      color: #ef4444;
      background: rgba(239, 68, 68, .06);
    }

    .co-item-variants {
      margin-top: .25rem;
      font-size: .78rem;
      color: var(--mut);
      font-weight: 750;
    }

    .co-item-bot {
      margin-top: .5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: .6rem;
      flex-wrap: wrap;
    }

    .co-qty {
      display: flex;
      align-items: center;
      gap: .35rem;
      background: #fff;
      border: 1px solid rgba(15, 23, 42, .12);
      padding: .25rem;
      border-radius: 14px;
    }

    .co-qty-btn {
      width: 30px;
      height: 30px;
      border-radius: 12px;
      border: 0;
      background: rgba(37, 99, 235, .10);
      color: var(--b);
      font-weight: 950;
      cursor: pointer;
    }

    .co-qty-btn:hover {
      filter: brightness(.96);
    }

    .co-qty-val {
      min-width: 24px;
      text-align: center;
      font-weight: 950;
      color: var(--k);
    }

    .co-item-price {
      text-align: right;
    }

    .co-price-val {
      display: block;
      font-weight: 950;
      color: var(--k);
    }

    .co-item-price small {
      color: var(--mut);
      font-weight: 800;
    }

    /* ===== Summary ===== */
    .co-sum {
      display: flex;
      flex-direction: column;
      gap: .55rem;
    }

    .co-sum-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: .75rem;
      color: var(--k);
      font-weight: 850;
    }

    .co-sum-row span {
      color: var(--mut);
      font-weight: 850;
    }

    .co-sum-rule {
      height: 1px;
      background: rgba(15, 23, 42, .12);
      margin: .35rem 0;
    }

    .co-sum-total {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: .6rem .65rem;
      border-radius: 16px;
      background: rgba(34, 197, 94, .10);
      border: 1px solid rgba(34, 197, 94, .22);
    }

    .co-sum-total span {
      font-weight: 950;
      color: var(--k);
    }

    .co-sum-total strong {
      font-weight: 990;
      color: var(--g);
      font-size: 1.05rem;
    }

    .co-note {
      display: flex;
      gap: .45rem;
      align-items: flex-start;
      color: var(--mut);
      font-weight: 800;
      font-size: .82rem;
      margin-top: .2rem;
    }

    /* ===== PayPal ===== */
    .co-payhead {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: .6rem;
      margin-bottom: .6rem;
    }

    .co-paytitle {
      font-weight: 990;
      color: var(--k);
    }

    .co-paymuted {
      font-size: .82rem;
      color: var(--mut);
      font-weight: 750;
    }

    .co-paybox {
      position: relative;
      border-radius: 16px;
      border: 1px solid rgba(15, 23, 42, .12);
      background: rgba(15, 23, 42, .02);
      padding: .7rem;
      min-height: 170px;
      overflow: hidden;
    }

    .co-guard {
      position: absolute;
      inset: 0;
      background: rgba(255, 255, 255, .88);
      backdrop-filter: blur(4px);
      display: flex;
      flex-direction: column;
      gap: .55rem;
      align-items: center;
      justify-content: center;
      z-index: 10;
      text-align: center;
      padding: 1rem;
      font-weight: 900;
      color: var(--k);
    }

    .co-guard p {
      margin: 0;
      font-size: .9rem;
    }

    .co-pp {
      min-height: 50px;
    }

    .co-paynote {
      margin-top: .7rem;
      border-radius: 16px;
      border: 1px solid rgba(124, 58, 237, .18);
      background: rgba(124, 58, 237, .06);
      padding: .7rem;
      display: flex;
      flex-direction: column;
      gap: .45rem;
    }

    .co-paynote-row {
      display: flex;
      gap: .45rem;
      align-items: center;
      color: var(--k);
      font-weight: 850;
      font-size: .86rem;
    }

    .co-paynote-row .ok {
      color: var(--g);
      font-weight: 990;
    }

    /* ===== Trust ===== */
    .co-trust {
      display: flex;
      gap: .5rem;
      flex-wrap: wrap;
      justify-content: space-between;
    }

    .co-trust-item {
      flex: 1 1 90px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: .4rem;
      padding: .55rem .6rem;
      border-radius: 14px;
      background: #fff;
      border: 1px solid rgba(15, 23, 42, .12);
      box-shadow: 0 6px 16px rgba(15, 23, 42, .07);
      font-weight: 950;
      color: var(--k);
      font-size: .85rem;
    }

    /* ===== Toast ===== */
    .co-toast {
      position: fixed;
      right: 12px;
      bottom: 12px;
      z-index: 999;
      background: var(--k);
      color: #fff;
      border-radius: 14px;
      box-shadow: var(--shadow);
      padding: .6rem .75rem;
    }

    .co-toast-inner {
      display: flex;
      align-items: center;
      gap: .5rem;
    }

    .co-toast-icon {
      font-weight: 950;
    }

    .co-toast-message {
      font-weight: 850;
      font-size: .9rem;
    }

    /* ===== Mobile tweaks (Hisense friendly) ===== */
    @media(max-width: 480px) {
      .co-page {
        padding: .6rem;
      }

      .co-hero {
        padding: .75rem;
      }

      .co-title {
        font-size: 1.05rem;
      }

      .co-subtitle {
        font-size: .86rem;
      }

      .co-steps {
        grid-template-columns: repeat(2, 1fr);
      }

      .co-card-h {
        padding: .7rem .75rem;
      }

      .co-card-b {
        padding: .75rem;
      }

      .co-item {
        grid-template-columns: 64px 1fr;
      }

      .co-item-img {
        width: 64px;
        height: 64px;
      }
    }

    /* ===== Collapsible shipping card ===== */
    .co-collapse>summary {
      list-style: none;
      cursor: pointer;
      user-select: none;
    }

    .co-collapse>summary::-webkit-details-marker {
      display: none;
    }

    .co-collapse-title h2 {
      margin: 0;
    }

    .co-collapse-title {
      display: flex;
      flex-direction: column;
      gap: .1rem;
    }

    .co-collapse-summary {
      font-size: .78rem;
      font-weight: 850;
      color: rgba(15, 23, 42, .65);
    }

    .co-collapse-right {
      display: flex;
      align-items: center;
      gap: .55rem;
    }

    .co-collapse-caret {
      display: inline-block;
      transition: transform .18s ease;
      opacity: .85;
      font-weight: 950;
    }

    .co-collapse[open] .co-collapse-caret {
      transform: rotate(180deg);
    }

    /* ===== Full-width cards on mobile only ===== */
    @media (max-width: 767.98px) {
      .co-page {
        padding-left: 0 !important;
        padding-right: 0 !important;
      }

      .co-hero {
        width: 100vw;
        max-width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        border-radius: 0;
      }

      .co-grid {
        max-width: 100%;
        margin-left: 0;
        margin-right: 0;
      }

      .co-col {
        padding-left: 0;
        padding-right: 0;
      }

      .co-col>.co-card:first-child {
        width: 100vw;
        max-width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        border-radius: 0;
      }

      .co-col>.co-card:first-child>.co-card-h {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
      }

      .co-col>.co-card:first-child>.co-card-h .co-card-title {
        justify-content: center;
        text-align: center;
      }

      .co-col>.co-card:first-child>.co-card-h .co-action {
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
      }

      .co-col:last-child>.co-card:first-child .co-sum-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
      }

      .co-col:last-child>.co-card:first-child .co-sum-row span {
        text-align: center;
      }

      .co-col:last-child>.co-card:first-child .co-sum-row strong {
        display: block;
        text-align: center;
      }

      .co-trust {
        width: 100vw;
        max-width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        border-radius: 0;
        justify-content: center;
      }

      .co-trust .col-4 {
        padding-left: 0;
        padding-right: 0;
        display: flex;
        justify-content: center;
      }

      .co-trust-item {
        border-radius: 0;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        text-align: center;
      }
    }
  </style>

  <script nonce="<%= CO_NONCE %>">
    (function() {
      const checkoutPageLoader = document.getElementById('checkoutPageLoader');

      function showCheckoutPageLoader() {
        if (!checkoutPageLoader) return;
        checkoutPageLoader.classList.remove('is-hidden');
        document.body.classList.add('co-page-loading');
      }

      function hideCheckoutPageLoader(delay) {
        if (!checkoutPageLoader) return;

        window.setTimeout(function() {
          checkoutPageLoader.classList.add('is-hidden');
          document.body.classList.remove('co-page-loading');
        }, Number(delay) || 0);
      }

      showCheckoutPageLoader();

      window.addEventListener('load', function() {
        hideCheckoutPageLoader(1200);
      });

      window.addEventListener('pageshow', function() {
        hideCheckoutPageLoader(300);
      });

      const el = {
        cartState: document.getElementById('cart-state'),
        cartItems: document.getElementById('cart-items'),
        cartEmpty: document.getElementById('cart-empty'),

        shipDone: document.getElementById('ship-done'),
        shipEdit: document.getElementById('ship-edit'),

        deliverySelect: document.getElementById('delivery-select'),
        deliveryHint: document.getElementById('delivery-hint'),
        deliveryInfo: document.getElementById('delivery-info'),
        deliveryType: document.getElementById('delivery-type'),
        deliveryEstimate: document.getElementById('delivery-estimate'),
        deliveryArea: document.getElementById('delivery-area'),

        shipHint: document.getElementById('ship-hint'),
        shipName: document.getElementById('ship-name'),
        shipPhone: document.getElementById('ship-phone'),
        shipEmail: document.getElementById('ship-email'),
        shipLine1: document.getElementById('ship-line1'),
        shipLine2: document.getElementById('ship-line2'),
        shipCity: document.getElementById('ship-city'),
        shipState: document.getElementById('ship-state'),
        shipZip: document.getElementById('ship-zip'),
        shipDetails: document.getElementById('ship-details'),
        shipSummary: document.getElementById('ship-summary'),
        shipCountry: document.getElementById('ship-country'),
        coCountryDropdown: document.getElementById('coCountryDropdown'),
        coCountrySelected: document.getElementById('coCountrySelected'),
        coCountrySelectedText: document.getElementById('coCountrySelectedText'),
        coCountryMenu: document.getElementById('coCountryMenu'),
        coCountrySearch: document.getElementById('coCountrySearch'),
        coCountryList: document.getElementById('coCountryList'),

        ratesRetry: document.getElementById('rates-retry'),
        ratesDebug: document.getElementById('rates-debug'),

        customsNotice: document.getElementById('international-customs-notice'),
        customsRoute: document.getElementById('international-customs-route'),

        sumSubtotal: document.getElementById(
          'sum-subtotal',
        ),

        vatRow: document.getElementById(
          'checkoutVatRow',
        ),

        sumVat: document.getElementById(
          'sum-vat',
        ),

        sumShipping: document.getElementById(
          'sum-shipping',
        ),

        sumTotal: document.getElementById(
          'sum-total',
        ),

        vatRate: document.getElementById(
          'vat-rate',
        ),

        payGuard: document.getElementById('pay-guard'),
        ppMount: document.getElementById('paypal-buttons'),

        toast: document.getElementById('toast'),
        toastIcon: document.querySelector('.co-toast-icon'),
        toastMessage: document.querySelector('.co-toast-message'),

        tplRow: document.getElementById('tpl-cart-row'),
      };

      const configEl = document.getElementById('checkout-config');
      let cfg = {};
      try {
        cfg = JSON.parse(configEl ? configEl.textContent : '{}');
      } catch (_) {
        cfg = {};
      }

      /*
       * Checkout VAT presentation
       * =========================
       *
       * Internal cart prices remain VAT-exclusive.
       *
       * This browser calculation is presentation-only.
       *
       * POST /payment/create-order independently resolves the
       * final authoritative treatment from the validated shipping
       * country.
       */
      const VAT_ENABLED =
        cfg.VAT_ENABLED === true;

      const SOUTH_AFRICA_VAT_RATE_RAW =
        Number(
          cfg.SOUTH_AFRICA_VAT_RATE ??
          0,
        );

      const SOUTH_AFRICA_VAT_RATE =
        Number.isFinite(
          SOUTH_AFRICA_VAT_RATE_RAW,
        ) &&
        SOUTH_AFRICA_VAT_RATE_RAW >= 0 &&
        SOUTH_AFRICA_VAT_RATE_RAW <= 1 ?
        SOUTH_AFRICA_VAT_RATE_RAW :
        0;

      function getCheckoutVatRate() {
        if (!VAT_ENABLED) {
          return 0;
        }

        const shippingCountry =
          String(
            el.shipCountry?.value ||
            state.shipTo?.country ||
            DEFAULT_COUNTRY ||
            '',
          )
          .trim()
          .toUpperCase();

        return shippingCountry === 'ZA' ?
          SOUTH_AFRICA_VAT_RATE :
          0;
      }

      const BASE_CURRENCY = String(
        cfg.BASE_CURRENCY || 'USD'
      ).trim().toUpperCase() || 'USD';

      const DISPLAY_CURRENCY = String(
        cfg.DISPLAY_CURRENCY ||
        BASE_CURRENCY
      ).trim().toUpperCase() || BASE_CURRENCY;

      const DISPLAY_RATE_RAW =
        Number(cfg.DISPLAY_RATE || 1);

      const DISPLAY_RATE =
        Number.isFinite(DISPLAY_RATE_RAW) &&
        DISPLAY_RATE_RAW > 0 ?
        DISPLAY_RATE_RAW :
        1;

      const PAYPAL_CURRENCY = String(
        cfg.PAYPAL_CURRENCY || 'USD'
      ).trim().toUpperCase() || 'USD';

      const DEFAULT_COUNTRY = String(
        cfg.DEFAULT_COUNTRY || 'ZA'
      ).toUpperCase();

      // ✅ countries from server (utils/countries.js)
      const COUNTRIES = Array.isArray(cfg.COUNTRIES) ? cfg.COUNTRIES : [];

      function buildSmartCountryDropdown(selectedCode = DEFAULT_COUNTRY) {
        if (!el.shipCountry || !el.coCountryDropdown || !el.coCountrySelected || !el.coCountryList) return;

        const current = String(selectedCode || DEFAULT_COUNTRY).toUpperCase();

        // If server didn't provide countries, fail gracefully
        if (!Array.isArray(COUNTRIES) || !COUNTRIES.length) {
          // still keep hidden select with ZA so backend reads something
          el.shipCountry.innerHTML = `<option value="${current}">${current}</option>`;
          if (el.coCountrySelectedText) el.coCountrySelectedText.textContent = `Select your country (${current})`;
          return;
        }

        const flagUrl = (code) => {
          const cc = String(code || '').trim().toLowerCase();
          return cc && cc.length === 2 ? `https://flagcdn.com/20x15/${cc}.png` : '';
        };

        // 1) Build hidden REAL select (codes)
        el.shipCountry.innerHTML = '';
        for (const c of COUNTRIES) {
          const code = String(c.code || '').toUpperCase();
          const name = String(c.name || '').trim();

          if (!code || code.length !== 2 || !name) continue;

          const opt = document.createElement('option');
          opt.value = code; // ZA, US, etc
          opt.dataset.name = name;
          opt.textContent = `${name} (${code})`;
          el.shipCountry.appendChild(opt);
        }

        // 2) Build visible menu options (with flag images)
        el.coCountryList.innerHTML = '';
        for (const c of COUNTRIES) {
          const code = String(c.code || '').toUpperCase();
          const name = String(c.name || '').trim();
          if (!code || code.length !== 2 || !name) continue;

          const div = document.createElement('div');
          div.className = 'co-country-option';
          div.dataset.value = code;
          div.dataset.name = name;

          const img = document.createElement('img');
          img.className = 'co-flag';
          img.alt = `${code} flag`;
          img.loading = 'lazy';
          img.src = flagUrl(code);

          const textWrap = document.createElement('span');
          textWrap.className = 'co-country-text';
          textWrap.textContent = `${name} (${code})`;

          div.appendChild(img);
          div.appendChild(textWrap);

          if (code === current) div.classList.add('active');
          el.coCountryList.appendChild(div);
        }

        // 3) Set initial selected display
        setSmartCountrySelected(current, false);

        // ---- Events (wire once) ----
        if (el.coCountryDropdown._wired) return;
        el.coCountryDropdown._wired = true;

        const openDropdown = () => {
          el.coCountryDropdown.classList.add('open');
          el.coCountrySelected.setAttribute('aria-expanded', 'true');
          if (el.coCountrySearch) {
            el.coCountrySearch.value = '';
            el.coCountrySearch.focus();
          }
          el.coCountryList.querySelectorAll('.co-country-option').forEach(o => (o.style.display = 'flex'));
        };

        const closeDropdown = () => {
          el.coCountryDropdown.classList.remove('open');
          el.coCountrySelected.setAttribute('aria-expanded', 'false');
        };

        el.coCountrySelected.addEventListener('click', () => {
          const isOpen = el.coCountryDropdown.classList.contains('open');
          if (isOpen) closeDropdown();
          else openDropdown();
        });

        el.coCountrySelected.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            el.coCountrySelected.click();
          }
          if (e.key === 'Escape') closeDropdown();
        });

        document.addEventListener('click', (e) => {
          if (!el.coCountryDropdown.contains(e.target)) closeDropdown();
        });

        // Click option
        el.coCountryList.addEventListener('click', (e) => {
          const opt = e.target.closest('.co-country-option');
          if (!opt) return;
          setSmartCountrySelected(opt.dataset.value, true);
          closeDropdown();
        });

        // Search filter (supports name/code search)
        if (el.coCountrySearch) {
          el.coCountrySearch.addEventListener('input', () => {
            const term = String(el.coCountrySearch.value || '').toLowerCase().trim();
            el.coCountryList.querySelectorAll('.co-country-option').forEach(opt => {
              const code = String(opt.dataset.value || '').toLowerCase();
              const name = String(opt.dataset.name || '').toLowerCase();
              const show = !term || code.includes(term) || name.includes(term);
              opt.style.display = show ? 'flex' : 'none';
            });
          });
        }

        function setSmartCountrySelected(codeUpper, triggerChange) {
          const requestedCode = String(
              codeUpper || DEFAULT_COUNTRY,
            )
            .trim()
            .toUpperCase();

          const match = COUNTRIES.find(country =>
            String(country?.code || '')
            .trim()
            .toUpperCase() === requestedCode
          );

          if (!match) {
            console.error(
              '[checkout country] Unknown country code:',
              requestedCode,
            );

            showToast(
              'Please select a valid delivery country.',
              'error',
            );

            return;
          }

          const code = String(match.code)
            .trim()
            .toUpperCase();

          /*
           * Save the selected country in both places:
           * 1. visible custom dropdown wrapper;
           * 2. real hidden HTML select used by readShipTo().
           */
          el.coCountryDropdown.dataset.countryCode = code;

          Array.from(el.shipCountry.options).forEach(option => {
            option.selected =
              String(option.value || '')
              .trim()
              .toUpperCase() === code;
          });

          el.shipCountry.value = code;

          const hiddenCode = String(
              el.shipCountry.value || '',
            )
            .trim()
            .toUpperCase();

          if (hiddenCode !== code) {
            console.error(
              '[checkout country] Hidden country did not synchronize:', {
                requestedCode: code,
                hiddenCode,
              },
            );

            showToast(
              'The country selection could not be saved. Please select it again.',
              'error',
            );

            return;
          }

          el.coCountryList
            .querySelectorAll('.co-country-option')
            .forEach(option => {
              option.classList.toggle(
                'active',
                String(option.dataset.value || '')
                .trim()
                .toUpperCase() === code,
              );
            });

          const name =
            String(match.name || code).trim() || code;

          if (el.coCountrySelectedText) {
            el.coCountrySelectedText.innerHTML = '';

            const img = document.createElement('img');
            img.className = 'co-flag';
            img.alt = `${code} flag`;
            img.loading = 'lazy';
            img.src = flagUrl(code);

            const text = document.createElement('span');
            text.textContent = `${name} (${code})`;

            el.coCountrySelectedText.appendChild(img);
            el.coCountrySelectedText.appendChild(text);
          }

          console.log('[checkout country selected]', {
            visibleCountry: code,
            hiddenCountry: hiddenCode,
          });

          if (triggerChange) {
            onAddressChange();
          }
        }
      }

      const state = {
        items: [],

        selectedDelivery: null,
        selectedShippingProvider: '',

        deliveryReady: false,
        shipTo: null,
        addressReady: false,
        cartReady: false,
        paypalMounted: false,

        /*
         * Only one shipping quote runs at a time.
         * If the address changes while a quote is running,
         * quoteQueued forces a new quote immediately afterward.
         */
        quoteInFlight: false,
        quoteQueued: false,

        // Shippo quote identity
        shippoShipmentId: null,

        // Courier Guy quote identity
        courierGuyQuoteId: null,

        // All current server-trusted rates
        courierGuyRates: [],
        shippoRates: [],

        // UI notice only: supplied by Shippo
        isInternational: false,
        fromCountry: '',
        toCountry: '',
      };

      /*
       * Convert an authoritative BASE_CURRENCY amount only for display.
       *
       * This function must never be used to create, capture or verify
       * the PayPal transaction amount.
       */
      function convertBaseToDisplay(amount) {
        const baseAmount =
          Number(amount || 0);

        if (!Number.isFinite(baseAmount)) {
          return 0;
        }

        return Math.round(
          (
            baseAmount *
            DISPLAY_RATE +
            Number.EPSILON
          ) *
          100
        ) / 100;
      }

      function formatCurrency(amount) {
        const displayAmount =
          convertBaseToDisplay(amount);

        try {
          const formatted =
            new Intl.NumberFormat(
              undefined, {
                style: 'currency',
                currency: DISPLAY_CURRENCY,
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
              }
            ).format(displayAmount);

          if (DISPLAY_CURRENCY === 'ZAR') {
            return formatted.replace(
              /^ZAR\s?/,
              'R'
            );
          }

          return formatted;
        } catch (error) {
          return (
            DISPLAY_CURRENCY +
            ' ' +
            displayAmount.toFixed(2)
          );
        }
      }

      function updateCustomsNotice() {
        if (!el.customsNotice) return;

        const showNotice = !!state.isInternational;
        const from = String(state.fromCountry || '').toUpperCase();
        const to = String(state.toCountry || '').toUpperCase();

        el.customsNotice.classList.toggle('d-none', !showNotice);

        if (el.customsRoute) {
          el.customsRoute.textContent = showNotice && from && to ?
            `International order: ${from} → ${to}. The buyer is responsible for any import duties, taxes, or customs fees requested by customs in their country.` :
            '';
        }
      }

      function showToast(message, type = 'info') {
        const icons = {
          success: '✓',
          error: '!',
          warning: '⚠',
          info: '💡'
        };
        if (el.toastIcon) el.toastIcon.textContent = icons[type] || icons.info;
        if (el.toastMessage) el.toastMessage.textContent = message || '';
        if (el.toast) el.toast.hidden = false;

        clearTimeout(el.toast && el.toast._t);
        if (el.toast) {
          el.toast._t = setTimeout(() => {
            el.toast.hidden = true;
          }, 2800);
        }
      }

      window.addEventListener('error', (e) => {
        const msg = (e?.error?.message || e?.message || 'Script error');
        console.error('Global error:', e);
        showToast(msg, 'error');
        if (el.deliveryHint) {
          el.deliveryHint.innerHTML = `<span class="co-hint-ic">❌</span><span>${msg}</span>`;
        }
      });

      window.addEventListener('unhandledrejection', (e) => {
        const msg = (e?.reason?.message || String(e?.reason || 'Promise error'));
        console.error('Unhandled rejection:', e);
        showToast(msg, 'error');
        if (el.deliveryHint) {
          el.deliveryHint.innerHTML = `<span class="co-hint-ic">❌</span><span>${msg}</span>`;
        }
      });

      function readShipTo() {
        const value = input =>
          String(input || '').trim();

        const visibleCountry = value(
          el.coCountryDropdown?.dataset?.countryCode,
        ).toUpperCase();

        const hiddenCountry = value(
          el.shipCountry?.value,
        ).toUpperCase();

        /*
         * Never send a quote when the visible dropdown and the
         * real hidden country field disagree.
         */
        if (
          visibleCountry &&
          hiddenCountry &&
          visibleCountry !== hiddenCountry
        ) {
          const error = new Error(
            `Country selection is out of sync. The page shows ${visibleCountry}, but the shipping field contains ${hiddenCountry}. Please select the country again.`,
          );

          error.code =
            'CHECKOUT_COUNTRY_OUT_OF_SYNC';

          throw error;
        }

        const country =
          visibleCountry || hiddenCountry;

        if (!/^[A-Z]{2}$/.test(country)) {
          const error = new Error(
            'Please select a valid delivery country.',
          );

          error.code =
            'CHECKOUT_COUNTRY_REQUIRED';

          throw error;
        }

        return {
          name: value(el.shipName?.value),

          phone: value(el.shipPhone?.value),

          email: value(el.shipEmail?.value),

          street1: value(el.shipLine1?.value),

          street2: value(el.shipLine2?.value),

          city: value(el.shipCity?.value),

          state: value(el.shipState?.value),

          zip: value(el.shipZip?.value),

          country,

          is_residential: true,
        };
      }

      function validateShipTo(to) {
        if (!to.name) {
          return {
            ok: false,
            message: 'Enter full name.',
          };
        }

        if (!to.phone) {
          return {
            ok: false,
            message: 'Enter phone number.',
          };
        }

        if (!to.street1) {
          return {
            ok: false,
            message: 'Enter street number and street name.',
          };
        }

        if (!to.street2) {
          return {
            ok: false,
            message: 'Enter suburb / local area.',
          };
        }

        if (!to.city) {
          return {
            ok: false,
            message: 'Enter city.',
          };
        }

        if (!to.state) {
          return {
            ok: false,
            message: 'Enter province/state.',
          };
        }

        if (!to.zip) {
          return {
            ok: false,
            message: 'Enter postal code.',
          };
        }

        if (!to.country) {
          return {
            ok: false,
            message: 'Select country.',
          };
        }

        return {
          ok: true,
          message: 'Shipping address OK.',
        };
      }

      function onAddressChange() {
        let to;

        try {
          to = readShipTo();
        } catch (error) {
          _addressRevision += 1;

          state.shipTo = null;
          state.addressReady = false;
          state.deliveryReady = false;
          state.selectedDelivery = null;
          state.selectedShippingProvider = '';

          if (state.quoteInFlight) {
            state.quoteQueued = true;
          }

          if (el.shipHint) {
            el.shipHint.textContent =
              `⚠️ ${error?.message || 'Please check the delivery country.'}`;
          }

          if (el.shipSummary) {
            el.shipSummary.textContent =
              'Country selection needs attention';
          }

          blockPayment(
            'Please correct the shipping country.',
          );

          return;
        }

        /*
         * Any field change invalidates a quote that may already
         * be running for the previous address.
         */
        _addressRevision += 1;

        if (state.quoteInFlight) {
          state.quoteQueued = true;
        }

        const validation =
          validateShipTo(to);

        state.shipTo = to;
        state.addressReady = validation.ok;

        /*
         * Remove any previously selected rate because it belongs
         * to the previous address.
         */
        state.deliveryReady = false;
        state.selectedDelivery = null;
        state.selectedShippingProvider = '';

        state.courierGuyQuoteId = null;
        state.shippoShipmentId = null;

        state.courierGuyRates = [];
        state.shippoRates = [];

        if (el.deliverySelect) {
          el.deliverySelect.disabled = true;
          el.deliverySelect.innerHTML =
            '<option value="">Address changed — loading new rates…</option>';
        }

        state.isInternational = false;
        state.fromCountry = '';
        state.toCountry = '';

        updateCustomsNotice();

        /*
         * The completed shipping country controls the visible Internal
         * VAT rate, so update both the cart rows and the summary.
         */
        renderCart();

        if (el.shipSummary) {
          if (validation.ok) {
            const match = COUNTRIES.find(country =>
              String(country?.code || '')
              .trim()
              .toUpperCase() ===
              String(to.country || '')
              .trim()
              .toUpperCase()
            );

            const countryName =
              match?.name || to.country;

            el.shipSummary.textContent =
              `${to.name} — ${to.city}, ${countryName}`;
          } else {
            el.shipSummary.textContent =
              'Not completed yet';
          }
        }

        if (el.shipHint) {
          el.shipHint.textContent =
            validation.ok ?
            `✅ Shipping address OK. Country: ${to.country}.` :
            `⚠️ ${validation.message}`;
        }

        clearTimeout(_shippoQuoteTimer);

        _shippoQuoteTimer = setTimeout(() => {
          if (
            state.addressReady &&
            state.cartReady &&
            state.items.length
          ) {
            loadDeliveryOptions();
          }
        }, 650);

        maybeEnablePayment();
      }

      function calculateTotals() {
        /*
         * Internal cart item.price is VAT-exclusive.
         */
        const netSubtotal =
          state.items.reduce(
            (sum, item) => {
              const unitPriceExVat =
                Number(
                  item?.priceExVat ??
                  item?.price ??
                  0,
                );

              const quantity =
                Number(
                  item?.quantity ||
                  0,
                );

              const safeUnitPrice =
                Number.isFinite(unitPriceExVat) &&
                unitPriceExVat >= 0 ?
                unitPriceExVat :
                0;

              const safeQuantity =
                Number.isFinite(quantity) &&
                quantity > 0 ?
                quantity :
                0;

              return (
                sum +
                (
                  safeUnitPrice *
                  safeQuantity
                )
              );
            },
            0,
          );

        const vatRate =
          getCheckoutVatRate();

        /*
         * Apply VAT forward from the VAT-exclusive subtotal.
         */
        const vat =
          Number(
            (
              netSubtotal *
              vatRate
            ).toFixed(2),
          );

        const shippingRaw =
          state.selectedDelivery ?
          Number(
            state.selectedDelivery.amount ??
            state.selectedDelivery.price ??
            0,
          ) :
          0;

        const shipping =
          Number.isFinite(shippingRaw) &&
          shippingRaw >= 0 ?
          Number(
            shippingRaw.toFixed(2),
          ) :
          0;

        const total =
          Number(
            (
              netSubtotal +
              vat +
              shipping
            ).toFixed(2),
          );

        return {
          subtotal: Number(
            netSubtotal.toFixed(2),
          ),

          vatRate,

          vat,

          shipping,

          total,
        };
      }

      function updateSummary() {
        const totals =
          calculateTotals();

        /*
         * calculateTotals() remains in BASE_CURRENCY.
         *
         * Conversion happens only while writing visible text.
         */
        if (el.sumSubtotal) {
          el.sumSubtotal.textContent =
            formatCurrency(
              totals.subtotal,
            );
        }

        if (el.vatRow) {
          el.vatRow.classList.toggle(
            'd-none',
            !VAT_ENABLED,
          );
        }

        if (el.sumVat) {
          el.sumVat.textContent =
            formatCurrency(
              totals.vat,
            );
        }

        if (el.sumShipping) {
          el.sumShipping.textContent =
            formatCurrency(
              totals.shipping,
            );
        }

        if (el.sumTotal) {
          el.sumTotal.textContent =
            formatCurrency(
              totals.total,
            );
        }

        if (el.vatRate) {
          el.vatRate.textContent =
            (
              totals.vatRate *
              100
            ).toFixed(0);
        }
      }

      function blockPayment(message) {
        if (!el.payGuard) return;

        el.payGuard.style.display = 'flex';

        const paragraph =
          el.payGuard.querySelector('p');

        if (paragraph) {
          paragraph.textContent =
            message ||
            'Waiting for cart and shipping rates…';
        }
      }

      function allowPayment() {
        if (!el.payGuard) return;
        el.payGuard.style.display = 'none';
      }

      let _ppRetryTimer = null;

      function maybeEnablePayment() {
        const ready =
          state.cartReady &&
          state.deliveryReady &&
          state.addressReady &&
          state.items.length > 0;

        if (!ready) {
          const msg = !state.items.length ?
            'Your cart is empty.' :
            !state.cartReady ?
            'Loading cart…' :
            !state.addressReady ?
            'Please enter your shipping address.' :
            !state.deliveryReady ?
            'Select or load a shipping rate…' :
            'Waiting…';

          blockPayment(msg);
          return;
        }

        // ✅ Don’t drop the guard until PayPal SDK exists
        if (!window.paypal) {
          blockPayment('Loading PayPal…');

          if (!_ppRetryTimer) {
            _ppRetryTimer = setInterval(() => {
              if (window.paypal) {
                clearInterval(_ppRetryTimer);
                _ppRetryTimer = null;
                maybeEnablePayment(); // re-run now that SDK is ready
              }
            }, 300);

            // safety stop after 10s
            setTimeout(() => {
              if (_ppRetryTimer) {
                clearInterval(_ppRetryTimer);
                _ppRetryTimer = null;
                blockPayment('PayPal failed to load. Please refresh the page.');
              }
            }, 10000);
          }
          return;
        }

        allowPayment();
        maybeMountPayPal();
      }

      let _shippoQuoteTimer = null;

      /*
       * This number changes every time the delivery address changes.
       * A quote is accepted only when it belongs to the latest revision.
       */
      let _addressRevision = 0;

      async function loadDeliveryOptions() {
        /*
         * When another quote is already running, remember that a
         * new quote is required. Do not silently discard the request.
         */
        if (state.quoteInFlight) {
          state.quoteQueued = true;
          return;
        }

        state.quoteInFlight = true;
        state.quoteQueued = false;

        /*
         * Remember which exact address revision this request uses.
         */
        const quoteAddressRevision =
          _addressRevision;

        state.deliveryReady = false;
        state.selectedDelivery = null;
        state.selectedShippingProvider = '';

        state.courierGuyQuoteId = null;
        state.shippoShipmentId = null;

        state.courierGuyRates = [];
        state.shippoRates = [];

        el.deliverySelect.disabled = true;
        el.deliverySelect.innerHTML =
          '<option value="">Loading shipping rates…</option>';

        el.deliveryHint.innerHTML =
          '<span class="co-hint-ic">⏱️</span><span>Loading Courier Guy and Shippo rates…</span>';

        el.deliveryInfo.style.display = 'none';

        if (el.ratesDebug) {
          el.ratesDebug.textContent =
            'Requesting both providers…';
        }

        try {
          if (!state.addressReady) {
            blockPayment(
              'Please enter your shipping address.'
            );

            el.deliveryHint.innerHTML =
              '<span class="co-hint-ic">📍</span><span>Enter your shipping address to load rates.</span>';

            return;
          }

          if (
            !state.cartReady ||
            !state.items.length
          ) {
            blockPayment('Loading cart…');

            el.deliveryHint.innerHTML =
              '<span class="co-hint-ic">🛒</span><span>Loading your cart…</span>';

            return;
          }

          const shipToNow = readShipTo();
          const validation =
            validateShipTo(shipToNow);

          if (!validation.ok) {
            throw new Error(
              validation.message ||
              'Please complete your shipping address.'
            );
          }

          state.shipTo = shipToNow;

          const createRequest = () => ({
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json',
            },
            credentials: 'same-origin',
            body: JSON.stringify({
              shipTo: shipToNow,
            }),
          });

          const courierGuyPromise = fetch(
            '/payment/courier-guy/quote',
            createRequest()
          ).then(async response => ({
            response,
            data: await response
              .json()
              .catch(() => ({})),
          }));

          const shippoPromise = fetch(
            '/payment/shippo/quote',
            createRequest()
          ).then(async response => ({
            response,
            data: await response
              .json()
              .catch(() => ({})),
          }));

          const results =
            await Promise.allSettled([
              courierGuyPromise,
              shippoPromise,
            ]);

          /*
           * The customer changed the address or country while these
           * requests were running. Never display the old response.
           */
          if (
            quoteAddressRevision !==
            _addressRevision
          ) {
            console.warn(
              '[shipping quote ignored: address changed]', {
                quoteAddressRevision,
                currentAddressRevision: _addressRevision,

                quotedCountry: shipToNow.country,

                currentCountry: state.shipTo?.country || '',
              },
            );

            state.quoteQueued = true;
            return;
          }

          const courierGuyResult =
            results[0].status === 'fulfilled' ?
            results[0].value :
            null;

          const shippoResult =
            results[1].status === 'fulfilled' ?
            results[1].value :
            null;

          if (
            courierGuyResult?.response?.ok &&
            courierGuyResult?.data?.ok
          ) {
            state.courierGuyQuoteId =
              courierGuyResult.data.quoteId ||
              null;

            state.courierGuyRates =
              Array.isArray(
                courierGuyResult.data.rates
              ) ?
              courierGuyResult.data.rates : [];
          }

          if (
            shippoResult?.response?.ok &&
            shippoResult?.data?.ok
          ) {
            state.shippoShipmentId =
              shippoResult.data.shipmentId ||
              null;

            state.shippoRates =
              Array.isArray(
                shippoResult.data.rates
              ) ?
              shippoResult.data.rates : [];

            state.isInternational = !!shippoResult.data.isInternational;

            state.fromCountry =
              String(
                shippoResult.data.fromCountry ||
                ''
              ).toUpperCase();

            state.toCountry =
              String(
                shippoResult.data.toCountry ||
                ''
              ).toUpperCase();
          } else {
            state.isInternational = false;
            state.fromCountry = '';
            state.toCountry = '';
          }

          updateCustomsNotice();

          const totalRates =
            state.courierGuyRates.length +
            state.shippoRates.length;

          if (!totalRates) {
            throw new Error(
              courierGuyResult?.data?.message ||
              shippoResult?.data?.message ||
              'No shipping rates are available.'
            );
          }

          el.deliverySelect.innerHTML = '';

          const placeholder =
            document.createElement('option');

          placeholder.value = '';
          placeholder.textContent =
            'Select a shipping rate';

          el.deliverySelect.appendChild(
            placeholder
          );

          if (state.courierGuyRates.length) {
            const courierGroup =
              document.createElement(
                'optgroup'
              );

            courierGroup.label =
              'The Courier Guy';

            state.courierGuyRates.forEach(
              rate => {
                const option =
                  document.createElement(
                    'option'
                  );

                option.value =
                  `courier_guy:${rate.rateId}`;

                const service =
                  rate.service ||
                  rate.serviceCode ||
                  'Courier service';

                const description =
                  rate.description ?
                  ` — ${rate.description}` :
                  '';

                option.textContent =
                  `${service}${description} — ${formatCurrency(
                    rate.amount
                  )}`;

                courierGroup.appendChild(
                  option
                );
              }
            );

            el.deliverySelect.appendChild(
              courierGroup
            );
          }

          if (state.shippoRates.length) {
            const shippoGroup =
              document.createElement(
                'optgroup'
              );

            shippoGroup.label = 'Shippo';

            state.shippoRates.forEach(rate => {
              const option =
                document.createElement(
                  'option'
                );

              option.value =
                `shippo:${rate.rateId}`;

              const provider =
                rate.provider || 'Carrier';

              const service =
                rate.service || 'Service';

              const estimate =
                rate.durationTerms ?
                ` — ${rate.durationTerms}` :
                rate.days ?
                ` — ${rate.days} day${
                        Number(rate.days) === 1
                          ? ''
                          : 's'
                      }` :
                '';

              option.textContent =
                `${provider} ${service}${estimate} — ${formatCurrency(
                  rate.amount
                )}`;

              shippoGroup.appendChild(
                option
              );
            });

            el.deliverySelect.appendChild(
              shippoGroup
            );
          }

          el.deliverySelect.disabled = false;

          if (el.ratesDebug) {
            el.ratesDebug.textContent =
              `${state.courierGuyRates.length} Courier Guy + ${state.shippoRates.length} Shippo`;
          }

          el.deliveryHint.innerHTML =
            '<span class="co-hint-ic">🚚</span><span>Select one of the available courier rates.</span>';

          blockPayment(
            'Please select a shipping rate.'
          );
        } catch (error) {
          console.error(
            'Shipping-rate load failed:',
            error
          );

          el.deliverySelect.innerHTML =
            '<option value="">No shipping rates available</option>';

          el.deliverySelect.disabled = true;

          el.deliveryHint.innerHTML =
            `<span class="co-hint-ic">⚠️</span><span>${String(
              error?.message ||
                'Could not load shipping rates.'
            )}</span>`;

          if (el.ratesDebug) {
            el.ratesDebug.textContent =
              'Rate request failed';
          }

          blockPayment(
            'Shipping rates could not be loaded.'
          );
        } finally {
          state.quoteInFlight = false;

          updateSummary();
          maybeEnablePayment();

          /*
           * The address changed while the previous request was running.
           * Immediately request rates for the newest address.
           */
          if (
            state.quoteQueued &&
            state.addressReady &&
            state.cartReady &&
            state.items.length
          ) {
            state.quoteQueued = false;

            window.setTimeout(() => {
              loadDeliveryOptions();
            }, 0);
          }
        }
      }

      async function rememberSelectedRate() {
        const selected =
          state.selectedDelivery;

        const provider =
          state.selectedShippingProvider;

        if (!selected || !provider) {
          throw new Error(
            'Please select a shipping rate.'
          );
        }

        if (provider === 'courier_guy') {
          if (!state.courierGuyQuoteId) {
            throw new Error(
              'Courier Guy quote is missing. Reload the rates.'
            );
          }

          const response = await fetch(
            '/payment/courier-guy/remember-rate', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Accept: 'application/json',
              },
              credentials: 'same-origin',
              body: JSON.stringify({
                quoteId: state.courierGuyQuoteId,
                rateId: selected.rateId,
              }),
            }
          );

          const data =
            await response
            .json()
            .catch(() => ({}));

          if (!response.ok || !data.ok) {
            throw new Error(
              data.message ||
              'Could not save the Courier Guy rate.'
            );
          }

          return;
        }

        if (provider === 'shippo') {
          if (!state.shippoShipmentId) {
            throw new Error(
              'Shippo shipment is missing. Reload the rates.'
            );
          }

          const response = await fetch(
            '/payment/shippo/remember-rate', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Accept: 'application/json',
              },
              credentials: 'same-origin',
              body: JSON.stringify({
                shippoShipmentId: state.shippoShipmentId,

                shippoRateId: selected.rateId,

                provider: selected.provider || '',

                service: selected.service || '',

                amount: Number(selected.amount || 0),

                currency: selected.currency ||
                  BASE_CURRENCY,

                days: Number(selected.days || 0),
              }),
            }
          );

          const data =
            await response
            .json()
            .catch(() => ({}));

          if (!response.ok || !data.ok) {
            throw new Error(
              data.message ||
              'Could not save the Shippo rate.'
            );
          }

          return;
        }

        throw new Error(
          'Unsupported shipping provider.'
        );
      }

      function applyDeliverySelection() {
        const selectedValue = String(
          el.deliverySelect?.value || ''
        ).trim();

        state.selectedDelivery = null;
        state.selectedShippingProvider = '';
        state.deliveryReady = false;

        if (!selectedValue) {
          updateSummary();
          blockPayment('Please select a shipping rate.');
          return;
        }

        const separatorIndex =
          selectedValue.indexOf(':');

        if (separatorIndex < 1) {
          updateSummary();
          blockPayment('Please select a valid shipping rate.');
          return;
        }

        const providerKey =
          selectedValue
          .slice(0, separatorIndex)
          .trim()
          .toLowerCase();

        const rateId =
          selectedValue
          .slice(separatorIndex + 1)
          .trim();

        let selected = null;

        if (providerKey === 'courier_guy') {
          selected = state.courierGuyRates.find(
            rate =>
            String(rate.rateId) === rateId
          ) || null;
        }

        if (providerKey === 'shippo') {
          selected = state.shippoRates.find(
            rate =>
            String(rate.rateId) === rateId
          ) || null;
        }

        if (!selected) {
          updateSummary();
          blockPayment(
            'The selected shipping rate is no longer available.'
          );
          return;
        }

        state.selectedShippingProvider =
          providerKey;

        state.selectedDelivery = {
          ...selected,
          providerKey,
        };

        state.deliveryReady = true;

        const providerLabel =
          providerKey === 'courier_guy' ?
          'The Courier Guy' :
          selected.provider || 'Shippo';

        const serviceText =
          selected.service ||
          selected.serviceCode ||
          'Courier service';

        const estimateText =
          selected.description ||
          selected.durationTerms ||
          (
            selected.days ?
            `${selected.days} day${Number(selected.days) === 1 ? '' : 's'}` :
            selected.deliveryDateFrom ?
            `Estimated from ${new Date(selected.deliveryDateFrom).toLocaleDateString()}` :
            'Carrier estimate'
          );

        if (el.deliveryType) {
          el.deliveryType.textContent =
            `${providerLabel} — ${serviceText}`;
        }

        if (el.deliveryEstimate) {
          el.deliveryEstimate.textContent =
            estimateText;
        }

        if (el.deliveryArea) {
          el.deliveryArea.textContent =
            state.shipTo ?
            `${state.shipTo.city || ''}, ${state.shipTo.country || ''}` :
            'Shipping address';
        }

        if (el.deliveryInfo) {
          el.deliveryInfo.style.display = '';
        }

        if (el.deliveryHint) {
          el.deliveryHint.innerHTML =
            `<span class="co-hint-ic">✓</span><span>${providerLabel} ${serviceText} selected.</span>`;
        }

        updateSummary();

        rememberSelectedRate()
          .then(() => {
            maybeEnablePayment();
          })
          .catch(error => {
            console.error(
              'Could not remember selected rate:',
              error
            );

            state.deliveryReady = false;

            blockPayment(
              error?.message ||
              'Could not save the selected shipping rate.'
            );
          });
      }

      async function loadCart() {
        try {
          const r = await fetch('/api/cart', {
            headers: {
              'Accept': 'application/json'
            },
            credentials: 'same-origin'
          });

          const data = await r.json();
          const items = Array.isArray(data.items) ? data.items : [];

          state.items = items.map(item => {
            const variantsObj = (item.variants && typeof item.variants === 'object') ? item.variants : {};
            const size = item.size || item.variantSize || variantsObj.size || '';
            const color = item.color || item.variantColor || variantsObj.color || '';

            const label = [
              size ? `Size: ${size}` : '',
              color ? `Color: ${color}` : ''
            ].filter(Boolean).join(' • ');

            const priceExVatRaw =
              Number(
                item?.priceExVat ??
                item?.price ??
                0,
              );

            const priceExVat =
              Number.isFinite(priceExVatRaw) &&
              priceExVatRaw >= 0 ?
              Number(
                priceExVatRaw.toFixed(2),
              ) :
              0;

            return {
              id: String(
                item.productId ||
                item._id ||
                item.id,
              ),

              productId: String(
                item.productId ||
                item._id ||
                item.id,
              ),

              name: item.name ||
                item.title ||
                'Product',

              /*
               * Keep price for compatibility, but both values are
               * authoritative VAT-exclusive amounts.
               */
              price: priceExVat,

              priceExVat,

              quantity: Number(
                item.quantity ||
                item.qty ||
                1,
              ),

              imageUrl: item.imageUrl ||
                item.image ||
                '',

              variants: {
                size,
                color,
                label,
              },
            };
          });

          renderCart();
          state.cartReady = true;
          maybeEnablePayment();

          // ✅ If address is already valid (autofill / user already typed), quote now
          if (state.addressReady && state.items.length) {
            loadDeliveryOptions();
          } else {
            // keep UI honest
            el.deliveryHint.innerHTML = '<span class="co-hint-ic">📍</span><span>Enter your shipping address to load rates.</span>';
          }
        } catch (err) {
          console.error(err);
          el.cartState.innerHTML = '<span>⚠️ Could not load your cart. Refresh the page.</span>';
          state.cartReady = false;
          blockPayment('Could not load cart.');
        }
      }

      function renderCart() {
        if (!state.items.length) {
          el.cartState.style.display = 'none';
          el.cartItems.style.display = 'none';
          el.cartEmpty.style.display = 'block';
          updateSummary();
          return;
        }

        el.cartState.style.display = 'none';
        el.cartEmpty.style.display = 'none';
        el.cartItems.style.display = 'flex';
        el.cartItems.innerHTML = '';

        state.items.forEach(item => {
          const row = createCartRow(item);
          el.cartItems.appendChild(row);
        });

        updateSummary();
      }

      function createCartRow(item) {
        const tpl = el.tplRow.content.cloneNode(true);
        const root = tpl.querySelector('.co-item');
        root.dataset.id = item.id;

        const img = root.querySelector('.co-img');
        img.src = item.imageUrl || '/img/placeholder.png';
        img.alt = item.name;

        root.querySelector('.co-item-name').textContent = item.name;

        const variantsEl = root.querySelector('.co-item-variants');
        variantsEl.textContent = (item.variants && item.variants.label) ? item.variants.label : '';

        root.querySelector('.co-qty-val').textContent = String(item.quantity);

        /*
         * Show the customer-visible line total.
         *
         * The underlying item price remains VAT-exclusive.
         */
        const unitPriceExVat =
          Number(
            item?.priceExVat ??
            item?.price ??
            0,
          );

        const quantity =
          Number(
            item?.quantity ||
            0,
          );

        const safeUnitPriceExVat =
          Number.isFinite(unitPriceExVat) &&
          unitPriceExVat >= 0 ?
          unitPriceExVat :
          0;

        const safeQuantity =
          Number.isFinite(quantity) &&
          quantity > 0 ?
          quantity :
          0;

        const vatRate =
          getCheckoutVatRate();

        const rowNetTotal =
          safeUnitPriceExVat *
          safeQuantity;

        const rowVatTotal =
          rowNetTotal *
          vatRate;

        const rowVisibleTotal =
          Number(
            (
              rowNetTotal +
              rowVatTotal
            ).toFixed(2),
          );

        root
          .querySelector('.co-price-val')
          .textContent =
          formatCurrency(
            rowVisibleTotal,
          );

        const dec = root.querySelector('.co-dec');
        const inc = root.querySelector('.co-inc');
        const rm = root.querySelector('.co-x');

        dec.addEventListener('click', () => updateQuantity(item.id, item.quantity - 1));
        inc.addEventListener('click', () => updateQuantity(item.id, item.quantity + 1));
        rm.addEventListener('click', () => removeItem(item.id));

        return root;
      }

      async function updateQuantity(productId, quantity) {
        if (quantity < 1) {
          await removeItem(productId);
          return;
        }
        try {
          const r = await fetch(`/api/cart/item/${encodeURIComponent(productId)}`, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json'
            },
            credentials: 'same-origin',
            body: JSON.stringify({
              quantity
            })
          });
          if (!r.ok) throw new Error('Failed to update quantity');
          await loadCart();
          showToast('Quantity updated', 'success');
        } catch (err) {
          console.error(err);
          showToast('Failed to update quantity', 'error');
        }
      }

      async function removeItem(productId) {
        try {
          const r = await fetch(`/api/cart/item/${encodeURIComponent(productId)}`, {
            method: 'DELETE',
            credentials: 'same-origin'
          });
          if (!r.ok) throw new Error('Failed to remove item');
          await loadCart();
          showToast('Item removed', 'success');
        } catch (err) {
          console.error(err);
          showToast('Failed to remove item', 'error');
        }
      }

      function maybeMountPayPal() {
        if (state.paypalMounted) return;
        if (!window.paypal || !el.ppMount) return;
        if (!state.items.length || !state.selectedDelivery) return;

        state.paypalMounted = true;

        paypal.Buttons({
          style: {
            layout: 'vertical',
            shape: 'rect',
            label: 'paypal',
            color: 'blue',
            height: 48
          },

          createOrder: async function() {
            try {
              const selected =
                state.selectedDelivery;

              const shippingProvider =
                state.selectedShippingProvider;

              if (
                !selected ||
                !shippingProvider
              ) {
                showToast(
                  'Please select a shipping rate.',
                  'warning'
                );

                throw new Error(
                  'Shipping rate is missing.'
                );
              }

              if (
                shippingProvider === 'shippo' &&
                !state.shippoShipmentId
              ) {
                await loadDeliveryOptions();

                throw new Error(
                  'Shippo rates expired. Please select again.'
                );
              }

              if (
                shippingProvider ===
                'courier_guy' &&
                !state.courierGuyQuoteId
              ) {
                await loadDeliveryOptions();

                throw new Error(
                  'Courier Guy rates expired. Please select again.'
                );
              }

              const shipToNow = readShipTo();
              const validation =
                validateShipTo(shipToNow);

              if (!validation.ok) {
                showToast(
                  validation.message ||
                  'Please complete your shipping address.',
                  'warning'
                );

                if (el.shipDetails) {
                  el.shipDetails.open = true;
                }

                throw new Error(
                  'Shipping address invalid.'
                );
              }

              await rememberSelectedRate();

              const body = {
                shippingProvider,

                shippingRateId: selected.rateId,

                shippoRateId: shippingProvider === 'shippo' ?
                  selected.rateId : '',

                shippoShipmentId: shippingProvider === 'shippo' ?
                  state.shippoShipmentId : '',

                courierGuyQuoteId: shippingProvider ===
                  'courier_guy' ?
                  state.courierGuyQuoteId : '',

                courierGuyRateId: shippingProvider ===
                  'courier_guy' ?
                  selected.rateId : '',

                shipTo: shipToNow,

                deliveryNote: (
                  document
                  .getElementById(
                    'delivery-note'
                  )
                  ?.value || ''
                ).trim(),

                items: state.items.map(item => ({
                  productId: item.productId,

                  name: item.name,

                  quantity: item.quantity,

                  price: item.price,

                  variants: {
                    size: item.variants?.size ||
                      '',

                    color: item.variants?.color ||
                      '',
                  },
                })),
              };

              const response = await fetch(
                '/payment/create-order', {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/json',
                    Accept: 'application/json',
                  },
                  credentials: 'same-origin',
                  body: JSON.stringify(body),
                }
              );

              const data =
                await response
                .json()
                .catch(() => ({}));

              if (
                !response.ok ||
                !data.id
              ) {
                throw new Error(
                  data.message ||
                  `Failed to create order (HTTP ${response.status})`
                );
              }

              return data.id;
            } catch (error) {
              showToast(
                'Failed to create order: ' +
                (
                  error?.message ||
                  'Error'
                ),
                'error'
              );

              throw error;
            }
          },

          onApprove: async function(data) {
            try {
              const r = await fetch('/payment/capture-order', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'Accept': 'application/json'
                },
                credentials: 'same-origin',
                body: JSON.stringify({
                  orderID: data.orderID
                })
              });

              const result = await r.json().catch(() => ({}));
              if (!r.ok) {
                throw new Error(result.message || `Failed to capture payment (HTTP ${r.status})`);
              }

              const orderId = result.orderId || data.orderID;
              window.location.href = `/payment/thank-you?orderId=${encodeURIComponent(orderId)}`;
            } catch (err) {
              showToast('Payment error: ' + (err?.message || 'Error'), 'error');
            }
          },

          onCancel: function() {
            showToast('Payment was cancelled', 'warning');
          },

          onError: function(error) {
            console.error('PayPal error:', error);

            const message = String(
              error?.message || ''
            ).trim();

            showToast(
              message &&
              !message.toLowerCase().includes(
                'expected an order id'
              ) ?
              `Payment error: ${message}` :
              'Payment processing error. Please check the server terminal for the exact reason.',
              'error'
            );
          }
        }).render('#paypal-buttons');
      }

      function init() {
        buildSmartCountryDropdown(DEFAULT_COUNTRY);
        // events
        el.deliverySelect.addEventListener('change', applyDeliverySelection);
        if (el.ratesRetry) {
          el.ratesRetry.addEventListener('click', async () => {
            showToast('Retrying shipping rates…', 'info');
            // force refresh
            state.shippoShipmentId = null;
            state.courierGuyQuoteId = null;

            state.shippoRates = [];
            state.courierGuyRates = [];

            state.deliveryReady = false;
            state.selectedDelivery = null;
            state.selectedShippingProvider = '';
            updateSummary();
            await loadDeliveryOptions();
          });
        }

        ['input', 'change'].forEach(evt => {
          [el.shipName, el.shipPhone, el.shipEmail, el.shipLine1, el.shipLine2, el.shipCity, el.shipState, el.shipZip, el.shipCountry]
          .filter(Boolean)
            .forEach(node => node.addEventListener(evt, onAddressChange));
        });

        if (el.shipDone) el.shipDone.addEventListener('click', closeAddressIfValid);

        if (el.shipEdit) {
          el.shipEdit.addEventListener('click', () => {
            if (el.shipDetails) el.shipDetails.open = true;
          });
        }

        // run once at start
        onAddressChange();

        function closeAddressIfValid() {
          // make sure latest values are read/validated
          onAddressChange();

          if (!state.addressReady) {
            // keep it open so user can fix
            if (el.shipDetails) el.shipDetails.open = true;
            showToast('Please complete the required address fields.', 'warning');
            return;
          }

          // ✅ valid: collapse only when user clicks Done
          if (el.shipDetails) el.shipDetails.open = false;
          showToast('Address saved.', 'success');

          // ✅ load rates immediately after "Done" (clean UX)
          if (state.cartReady && state.items.length) loadDeliveryOptions();
        }

        // start
        blockPayment();
        loadCart(); // ✅ cart first; address events will quote when ready
      }

      // Your page already runs scripts after load, but safe:
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }

      // debug
      window.checkoutApp = {
        state,
        loadCart,
        loadDeliveryOptions,
        updateQuantity,
        removeItem
      };
    })();
  </script>
</section>