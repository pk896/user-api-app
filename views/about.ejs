<!-- views/about.ejs -->
<%
  const NONCE =
    typeof nonce !== 'undefined'
      ? nonce
      : '';
%>

<!-- Spinner Start -->
<div
  id="spinner"
  class="show fade bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center"
  style="z-index: 9999;"
>
  <div
    class="spinner-border text-primary"
    style="width: 3rem; height: 3rem;"
    role="status"
  >
    <span class="visually-hidden">
      Loading...
    </span>
  </div>
</div>
<!-- Spinner End -->


<main class="kasyora-about">

  <!-- Hero Start -->
  <section class="about-hero about-full-section text-white py-5 py-lg-6">
    <div class="about-full-inner py-3 py-lg-5">

      <div class="row align-items-center g-4 g-lg-5">

        <div class="col-12 col-lg-8">

          <div
            class="d-inline-flex align-items-center gap-2 bg-white bg-opacity-10 border border-white border-opacity-25 rounded-pill px-3 py-2 mb-4"
          >
            <i
              class="fas fa-globe-africa"
              aria-hidden="true"
            ></i>

            <span class="small fw-bold text-uppercase">
              South African Company · Global Vision
            </span>
          </div>

          <h1
            class="display-4 fw-bold mb-4 about-hero-title"
          >
            Building commerce
            without borders,
            exclusion or limits.
          </h1>

          <p
            class="lead mb-4 about-hero-lead"
          >
            Kasyora is building an e-commerce ecosystem
            designed to connect people, businesses and
            markets across borders — with a long-term
            vision of contributing to a more unified,
            inclusive and accessible world trading system.
          </p>

          <div
            class="d-flex flex-column flex-sm-row gap-2"
          >
            <a
              href="/store"
              class="btn btn-light btn-lg fw-bold px-4"
            >
              <i
                class="fas fa-shopping-cart me-2"
                aria-hidden="true"
              ></i>

              Explore Kasyora
            </a>

            <a
              href="#company"
              class="btn btn-outline-light btn-lg fw-bold px-4"
            >
              Learn About Our Company
            </a>
          </div>

        </div>


        <div class="col-12 col-lg-4">

          <div
            class="card border-0 shadow-lg about-company-card"
          >
            <div class="card-body p-4">

              <div
                class="d-flex align-items-center gap-3 mb-4"
              >
                <div
                  class="about-icon-circle bg-success text-white"
                >
                  <i
                    class="fas fa-building"
                    aria-hidden="true"
                  ></i>
                </div>

                <div>
                  <div
                    class="small text-uppercase text-muted fw-bold"
                  >
                    Registered Company
                  </div>

                  <div
                    class="h5 fw-bold text-dark mb-0"
                  >
                    KASYORA (Pty) Ltd
                  </div>
                </div>
              </div>


              <div class="border-top pt-3">

                <div class="mb-3">
                  <div class="small text-muted">
                    Jurisdiction
                  </div>

                  <div class="fw-semibold text-dark">
                    Republic of South Africa
                  </div>
                </div>


                <div class="mb-3">
                  <div class="small text-muted">
                    Incorporated
                  </div>

                  <div class="fw-semibold text-dark">
                    27 May 2026
                  </div>
                </div>


                <div class="mb-0">
                  <div class="small text-muted">
                    Company Registration
                  </div>

                  <div class="fw-semibold text-dark">
                    2026/419298/07
                  </div>
                </div>

              </div>

            </div>
          </div>

        </div>

      </div>

    </div>
  </section>
  <!-- Hero End -->


  <!-- Company Identity Start -->
  <section
    id="company"
    class="about-full-section py-5 bg-white"
  >
    <div class="about-full-inner py-lg-4">

      <div class="row g-5 align-items-center">

        <div class="col-12 col-lg-6">

          <div
            class="small fw-bold text-primary text-uppercase mb-2"
          >
            Who We Are
          </div>

          <h2
            class="display-6 fw-bold text-dark mb-4"
          >
            A South African company
            built with a global outlook.
          </h2>

          <p
            class="fs-5 text-secondary mb-3"
          >
            KASYORA (Pty) Ltd is a privately held
            South African company owned by its shareholders
            and incorporated on 27 May 2026.
          </p>

          <p class="text-secondary mb-3">
            Kasyora was established to develop technology
            and commercial infrastructure that can make
            participation in digital commerce simpler,
            broader and more accessible.
          </p>

          <p class="text-secondary mb-0">
            We are building for a world in which geographic
            location should not determine whether a person,
            business or community can participate in the
            opportunities created by international trade
            and the digital economy.
          </p>

        </div>


        <div class="col-12 col-lg-6">

          <div class="row g-3">

            <div class="col-12 col-sm-6">
              <div
                class="card h-100 border-0 shadow-sm about-fact-card"
              >
                <div class="card-body p-4">

                  <div
                    class="about-icon-circle bg-primary text-white mb-3"
                  >
                    <i
                      class="fas fa-scale-balanced"
                      aria-hidden="true"
                    ></i>
                  </div>

                  <h3 class="h5 fw-bold">
                    Responsible
                  </h3>

                  <p class="text-muted mb-0">
                    We believe sustainable commerce requires
                    accountability, transparent processes
                    and responsible business practices.
                  </p>

                </div>
              </div>
            </div>


            <div class="col-12 col-sm-6">
              <div
                class="card h-100 border-0 shadow-sm about-fact-card"
              >
                <div class="card-body p-4">

                  <div
                    class="about-icon-circle bg-success text-white mb-3"
                  >
                    <i
                      class="fas fa-earth-africa"
                      aria-hidden="true"
                    ></i>
                  </div>

                  <h3 class="h5 fw-bold">
                    Global
                  </h3>

                  <p class="text-muted mb-0">
                    Our ambition extends beyond individual
                    markets. We are developing Kasyora with
                    international participation in mind.
                  </p>

                </div>
              </div>
            </div>


            <div class="col-12 col-sm-6">
              <div
                class="card h-100 border-0 shadow-sm about-fact-card"
              >
                <div class="card-body p-4">

                  <div
                    class="about-icon-circle bg-success text-white mb-3"
                  >
                    <i
                      class="fas fa-people-group"
                      aria-hidden="true"
                    ></i>
                  </div>

                  <h3 class="h5 fw-bold">
                    Inclusive
                  </h3>

                  <p class="text-muted mb-0">
                    We believe economic opportunity should
                    be accessible to people and businesses
                    regardless of where they come from.
                  </p>

                </div>
              </div>
            </div>


            <div class="col-12 col-sm-6">
              <div
                class="card h-100 border-0 shadow-sm about-fact-card"
              >
                <div class="card-body p-4">

                  <div
                    class="about-icon-circle bg-primary text-white mb-3"
                  >
                    <i
                      class="fas fa-code"
                      aria-hidden="true"
                    ></i>
                  </div>

                  <h3 class="h5 fw-bold">
                    Technology-Led
                  </h3>

                  <p class="text-muted mb-0">
                    Technology is the infrastructure through
                    which we aim to simplify commerce and
                    connect participants across markets.
                  </p>

                </div>
              </div>
            </div>

          </div>

        </div>

      </div>

    </div>
  </section>
  <!-- Company Identity End -->


  <!-- Purpose Start -->
  <section
    id="purpose"
    class="about-full-section py-5 bg-light"
  >
    <div class="about-full-inner py-lg-4">

      <div
        class="text-center mx-auto mb-5"
        style="max-width: 850px;"
      >
        <div
          class="small fw-bold text-primary text-uppercase mb-2"
        >
          Why Kasyora Exists
        </div>

        <h2
          class="display-6 fw-bold text-dark mb-3"
        >
          Commerce should create opportunity,
          not exclusion.
        </h2>

        <p class="lead text-secondary mb-0">
          We believe humanity's economic progress becomes
          stronger when more people can participate in it.
        </p>
      </div>


      <div class="row g-4">

        <div class="col-12 col-lg-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4 p-lg-5">

              <div class="about-number mb-4">
                01
              </div>

              <h3 class="h4 fw-bold mb-3">
                Expand Participation
              </h3>

              <p class="text-secondary mb-0">
                We want digital commerce to be available
                to businesses and customers across different
                regions, economies and communities — including
                markets that have historically had fewer
                opportunities to participate globally.
              </p>

            </div>
          </div>
        </div>


        <div class="col-12 col-lg-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4 p-lg-5">

              <div class="about-number mb-4">
                02
              </div>

              <h3 class="h4 fw-bold mb-3">
                Connect Markets
              </h3>

              <p class="text-secondary mb-0">
                Kasyora seeks to reduce unnecessary barriers
                between buyers, sellers and suppliers by
                developing systems that make cross-market
                participation easier to understand and use.
              </p>

            </div>
          </div>
        </div>


        <div class="col-12 col-lg-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body p-4 p-lg-5">

              <div class="about-number mb-4">
                03
              </div>

              <h3 class="h4 fw-bold mb-3">
                Share Economic Progress
              </h3>

              <p class="text-secondary mb-0">
                Our long-term ambition is to contribute to
                a trading environment in which economic
                development is increasingly shared across
                borders instead of concentrated among only
                a limited number of countries or communities.
              </p>

            </div>
          </div>
        </div>

      </div>

    </div>
  </section>
  <!-- Purpose End -->


  <!-- Vision Start -->
  <section
    id="vision"
    class="about-full-section py-5 bg-dark text-white"
  >
    <div class="about-full-inner py-lg-5">

      <div class="row g-5 align-items-center">

        <div class="col-12 col-lg-5">

          <div
            class="small fw-bold text-success text-uppercase mb-2"
          >
            Our Long-Term Vision
          </div>

          <h2
            class="display-5 fw-bold mb-4"
          >
            One world.
            More opportunity.
            Wider participation.
          </h2>

        </div>


        <div class="col-12 col-lg-7">

          <p class="lead text-white-50 mb-4">
            Kasyora's long-term vision is to contribute
            toward a more unified world trading system —
            one in which individuals, businesses and nations
            are not excluded from economic progress simply
            because of geography, market size or historical
            disadvantage.
          </p>

          <p class="fs-5 mb-4">
            We believe in the equality of human potential
            and in the principle that global economic
            development should create pathways for
            participation rather than barriers to entry.
          </p>

          <p class="fs-5 mb-0">
            Technology cannot solve every inequality on its
            own, but it can help connect markets, reduce
            friction and create new opportunities. Kasyora
            intends to play a responsible part in that work.
          </p>

        </div>

      </div>

    </div>
  </section>
  <!-- Vision End -->


  <!-- Values Start -->
  <section
    id="values"
    class="about-full-section py-5 bg-white"
  >
    <div class="about-full-inner py-lg-4">

      <div
        class="text-center mx-auto mb-5"
        style="max-width: 760px;"
      >
        <div
          class="small fw-bold text-primary text-uppercase mb-2"
        >
          The Principles Behind Kasyora
        </div>

        <h2
          class="display-6 fw-bold text-dark mb-3"
        >
          What we believe.
        </h2>

        <p class="lead text-secondary mb-0">
          Our technology may evolve, but these principles
          are intended to remain at the centre of how
          Kasyora grows.
        </p>
      </div>


      <div class="row g-3">

        <div class="col-12 col-md-6 col-xl-3">
          <div class="card h-100 border shadow-sm">
            <div class="card-body p-4">

              <i
                class="fas fa-equals fa-2x text-primary mb-3"
                aria-hidden="true"
              ></i>

              <h3 class="h5 fw-bold">
                Equality
              </h3>

              <p class="text-muted mb-0">
                Human potential exists everywhere.
                Economic opportunity should not be reserved
                for a privileged geography or group.
              </p>

            </div>
          </div>
        </div>


        <div class="col-12 col-md-6 col-xl-3">
          <div class="card h-100 border shadow-sm">
            <div class="card-body p-4">

              <i
                class="fas fa-link fa-2x text-success mb-3"
                aria-hidden="true"
              ></i>

              <h3 class="h5 fw-bold">
                Unity
              </h3>

              <p class="text-muted mb-0">
                Trade can connect people across cultures,
                countries and economies through shared
                opportunity and exchange.
              </p>

            </div>
          </div>
        </div>


        <div class="col-12 col-md-6 col-xl-3">
          <div class="card h-100 border shadow-sm">
            <div class="card-body p-4">

              <i
                class="fas fa-shield-alt fa-2x text-primary mb-3"
                aria-hidden="true"
              ></i>

              <h3 class="h5 fw-bold">
                Integrity
              </h3>

              <p class="text-muted mb-0">
                Trust must be earned through responsible
                systems, clear communication and respect
                for customers and business partners.
              </p>

            </div>
          </div>
        </div>


        <div class="col-12 col-md-6 col-xl-3">
          <div class="card h-100 border shadow-sm">
            <div class="card-body p-4">

              <i
                class="fas fa-arrow-trend-up fa-2x text-success mb-3"
                aria-hidden="true"
              ></i>

              <h3 class="h5 fw-bold">
                Progress
              </h3>

              <p class="text-muted mb-0">
                We believe innovation should produce
                practical improvements in how people
                participate in modern commerce.
              </p>

            </div>
          </div>
        </div>

      </div>

    </div>
  </section>
  <!-- Values End -->


  <!-- Platform Start -->
  <section
    id="platform"
    class="about-full-section py-5 bg-light"
  >
    <div class="about-full-inner py-lg-4">

      <div class="row g-5 align-items-center">

        <div class="col-12 col-lg-5">

          <div
            class="small fw-bold text-primary text-uppercase mb-2"
          >
            What We Are Building
          </div>

          <h2
            class="display-6 fw-bold text-dark mb-3"
          >
            Commerce infrastructure
            designed for connection.
          </h2>

          <p class="text-secondary mb-0">
            Kasyora combines digital storefront technology,
            product discovery, payments, order management
            and fulfilment capabilities into an evolving
            commerce ecosystem.
          </p>

        </div>


        <div class="col-12 col-lg-7">

          <div class="row g-3">

            <div class="col-12 col-md-6">
              <div
                class="d-flex gap-3 bg-white shadow-sm rounded-3 p-4 h-100"
              >
                <div
                  class="about-icon-circle bg-primary text-white flex-shrink-0"
                >
                  <i
                    class="fas fa-store"
                    aria-hidden="true"
                  ></i>
                </div>

                <div>
                  <h3 class="h6 fw-bold mb-2">
                    Digital Commerce
                  </h3>

                  <p class="small text-muted mb-0">
                    Product discovery and online purchasing
                    experiences designed for modern customers.
                  </p>
                </div>
              </div>
            </div>


            <div class="col-12 col-md-6">
              <div
                class="d-flex gap-3 bg-white shadow-sm rounded-3 p-4 h-100"
              >
                <div
                  class="about-icon-circle bg-success text-white flex-shrink-0"
                >
                  <i
                    class="fas fa-credit-card"
                    aria-hidden="true"
                  ></i>
                </div>

                <div>
                  <h3 class="h6 fw-bold mb-2">
                    Payments
                  </h3>

                  <p class="small text-muted mb-0">
                    Integrated payment processes supporting
                    reliable online transactions.
                  </p>
                </div>
              </div>
            </div>


            <div class="col-12 col-md-6">
              <div
                class="d-flex gap-3 bg-white shadow-sm rounded-3 p-4 h-100"
              >
                <div
                  class="about-icon-circle bg-success text-white flex-shrink-0"
                >
                  <i
                    class="fas fa-box"
                    aria-hidden="true"
                  ></i>
                </div>

                <div>
                  <h3 class="h6 fw-bold mb-2">
                    Order Management
                  </h3>

                  <p class="small text-muted mb-0">
                    Systems connecting the purchasing,
                    processing and fulfilment stages of
                    commerce.
                  </p>
                </div>
              </div>
            </div>


            <div class="col-12 col-md-6">
              <div
                class="d-flex gap-3 bg-white shadow-sm rounded-3 p-4 h-100"
              >
                <div
                  class="about-icon-circle bg-primary text-white flex-shrink-0"
                >
                  <i
                    class="fas fa-truck"
                    aria-hidden="true"
                  ></i>
                </div>

                <div>
                  <h3 class="h6 fw-bold mb-2">
                    Fulfilment
                  </h3>

                  <p class="small text-muted mb-0">
                    Delivery and supplier integrations
                    designed to support broader commerce
                    operations.
                  </p>
                </div>
              </div>
            </div>

          </div>

        </div>

      </div>

    </div>
  </section>
  <!-- Platform End -->


  <!-- Legal / Trust Start -->
  <section
    id="responsibility"
    class="about-full-section py-5 bg-white"
  >
    <div class="about-full-inner py-lg-4">

      <div
        class="card border-0 shadow-lg overflow-hidden"
      >
        <div class="row g-0">

          <div
            class="col-12 col-lg-5 bg-primary text-white p-4 p-md-5"
          >
            <div
              class="small fw-bold text-uppercase text-white-50 mb-2"
            >
              Company Responsibility
            </div>

            <h2 class="display-6 fw-bold mb-3">
              Built as a company.
              Operated with responsibility.
            </h2>

            <p class="mb-0 text-white-50">
              Behind the Kasyora brand is an incorporated
              South African company with responsibilities
              to its customers, shareholders, partners
              and the regulatory environment in which
              it operates.
            </p>
          </div>


          <div class="col-12 col-lg-7 p-4 p-md-5">

            <h3 class="h4 fw-bold text-dark mb-4">
              Corporate Information
            </h3>

            <div class="row g-4">

              <div class="col-12 col-sm-6">
                <div class="small text-muted mb-1">
                  Registered Name
                </div>

                <div class="fw-bold">
                  KASYORA (Pty) Ltd
                </div>
              </div>


              <div class="col-12 col-sm-6">
                <div class="small text-muted mb-1">
                  Company Type
                </div>

                <div class="fw-bold">
                  Private Company
                </div>
              </div>


              <div class="col-12 col-sm-6">
                <div class="small text-muted mb-1">
                  Registration Number
                </div>

                <div class="fw-bold">
                  2026/419298/07
                </div>
              </div>


              <div class="col-12 col-sm-6">
                <div class="small text-muted mb-1">
                  Incorporation Date
                </div>

                <div class="fw-bold">
                  27 May 2026
                </div>
              </div>


              <div class="col-12 col-sm-6">
                <div class="small text-muted mb-1">
                  Country of Incorporation
                </div>

                <div class="fw-bold">
                  South Africa
                </div>
              </div>


              <div class="col-12 col-sm-6">
                <div class="small text-muted mb-1">
                  Ownership
                </div>

                <div class="fw-bold">
                  Privately held by its shareholders
                </div>
              </div>

            </div>

          </div>

        </div>
      </div>

    </div>
  </section>
  <!-- Legal / Trust End -->


  <!-- Commitment Start -->
  <section
    id="commitment"
    class="about-full-section py-5 about-commitment text-white"
  >
    <div class="about-full-inner py-lg-5 text-center">

      <div
        class="mx-auto"
        style="max-width: 880px;"
      >

        <div
          class="small fw-bold text-success text-uppercase mb-3"
        >
          Our Commitment
        </div>

        <h2
          class="display-5 fw-bold mb-4"
        >
          Growth with purpose.
          Technology with responsibility.
          Commerce with inclusion.
        </h2>

        <p class="lead text-white-50 mb-4">
          Kasyora intends to grow responsibly while
          continuing to build systems that help more people
          participate in digital commerce and the broader
          global economy.
        </p>

        <p class="fs-5 mb-4">
          We believe the future of trade should be measured
          not only by how much value the world creates,
          but also by how widely the opportunity to create
          and share that value is distributed.
        </p>

        <a
          href="/store"
          class="btn btn-success btn-lg fw-bold px-4"
        >
          Explore Kasyora
        </a>

      </div>

    </div>
  </section>
  <!-- Commitment End -->

</main>


<style nonce="<%= NONCE %>">
  /*
   * Kasyora About page
   * =================
   *
   * The complete page intentionally breaks out of any
   * Bootstrap/container wrapper used by the parent layout.
   *
   * Every section spans the full viewport width on desktop,
   * tablet and mobile.
   */

  .kasyora-about {
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    overflow-x: clip;
    box-sizing: border-box;
  }

  .about-full-section {
    width: 100%;
    max-width: 100%;
    margin-left: 0;
    margin-right: 0;
    box-sizing: border-box;
  }

  /*
   * No Bootstrap .container max-width is used.
   *
   * Keep only a safe amount of breathing room between
   * content and the physical edge of the display.
   */
  .about-full-inner {
    width: 100%;
    max-width: none;
    margin: 0;
    padding-left: 16px;
    padding-right: 16px;
    box-sizing: border-box;
  }

  .about-hero {
    background:
      radial-gradient(
        circle at 90% 15%,
        rgba(34, 197, 94, .30),
        transparent 32%
      ),
      linear-gradient(
        135deg,
        #4C1D95 0%,
        #7C3AED 55%,
        #5B21B6 100%
      );
  }

  .about-hero-title {
    max-width: 850px;
    letter-spacing: -.03em;
  }

  .about-hero-lead {
    max-width: 760px;
    color: rgba(255, 255, 255, .82);
  }

  .about-company-card {
    border-radius: 1rem;
  }

  .about-icon-circle {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .about-fact-card {
    transition:
      transform .2s ease,
      box-shadow .2s ease;
  }

  .about-fact-card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 1rem 2rem
      rgba(0, 0, 0, .10) !important;
  }

  .about-number {
    font-size: 2.5rem;
    line-height: 1;
    font-weight: 800;
    color: #7C3AED;
    opacity: .22;
  }

  .about-commitment {
    background:
      radial-gradient(
        circle at 12% 85%,
        rgba(34, 197, 94, .22),
        transparent 30%
      ),
      #111827;
  }

  /*
   * Tablet and desktop:
   * slightly more edge spacing, while remaining full width.
   */
  @media (min-width: 768px) {
    .about-full-inner {
      padding-left: 24px;
      padding-right: 24px;
    }
  }

  /*
   * Large desktop:
   * still edge-to-edge — no max-width container.
   */
  @media (min-width: 1200px) {
    .about-full-inner {
      padding-left: 32px;
      padding-right: 32px;
    }
  }

  /*
   * Small phones:
   * maximize usable width while keeping content readable.
   */
  @media (max-width: 575.98px) {
    .about-full-inner {
      padding-left: 12px;
      padding-right: 12px;
    }

    .about-company-card {
      border-radius: .75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-fact-card {
      transition: none;
    }

    .about-fact-card:hover {
      transform: none;
    }
  }
</style>


<script nonce="<%= NONCE %>">
  document.addEventListener(
    'DOMContentLoaded',
    function () {
      document
        .querySelectorAll('a[href^="#"]')
        .forEach(function (anchor) {
          anchor.addEventListener(
            'click',
            function (event) {
              const href =
                this.getAttribute('href');

              if (
                !href ||
                href === '#'
              ) {
                return;
              }

              const target =
                document.querySelector(href);

              if (!target) {
                return;
              }

              event.preventDefault();

              target.scrollIntoView({
                behavior: 'smooth',
                block: 'start',
              });
            },
          );
        });

      const pageSpinner =
        document.getElementById(
          'spinner',
        );

      if (pageSpinner) {
        window.addEventListener(
          'load',
          function () {
            window.setTimeout(
              function () {
                pageSpinner.classList.remove(
                  'show',
                );

                window.setTimeout(
                  function () {
                    pageSpinner.classList.add(
                      'd-none',
                    );
                  },
                  300,
                );
              },
              700,
            );
          },
        );
      }
    },
  );
</script>