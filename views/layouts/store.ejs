<!-- views/layouts/store.ejs -->
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">

  <%
    /*
     * Kasyora public Store SEO
     * ========================
     *
     * APP_URL is the canonical production site identity.
     * Render production:
     * https://kasyora.com
     *
     * Local development:
     * http://localhost:3000
     */
    const layoutProduct =
      typeof product !== 'undefined' &&
      product
        ? product
        : null;

    const layoutSiteUrl =
      String(
        typeof siteUrl !== 'undefined' &&
        siteUrl
          ? siteUrl
          : (
              typeof appUrl !== 'undefined' &&
              appUrl
                ? appUrl
                : 'https://kasyora.com'
            )
      )
        .trim()
        .replace(/\/+$/, '');

    function layoutAbsoluteUrl(value) {
      const raw =
        String(value || '').trim();

      if (!raw) {
        return '';
      }

      if (/^https?:\/\//i.test(raw)) {
        return raw;
      }

      return (
        layoutSiteUrl +
        '/' +
        raw.replace(/^\/+/, '')
      );
    }

    const layoutProductName =
      layoutProduct
        ? String(
            layoutProduct.name ||
            'Product'
          ).trim()
        : '';

    /*
     * Product category may arrive in two forms:
     *
     * Internal Kasyora:
     * category is normally a plain string.
     *
     * CJ Store:
     * category may be either a normalized string supplied by the
     * route or the original CJ category object.
     *
     * Resolve both safely so SEO metadata can never contain
     * "[object Object]".
     */
    const layoutRawProductCategory =
      layoutProduct
        ? layoutProduct.category
        : null;

    const layoutProductCategory =
      layoutProduct
        ? String(
            typeof layoutRawProductCategory === 'string'
              ? layoutRawProductCategory
              : (
                  layoutRawProductCategory?.name ||
                  layoutRawProductCategory?.secondName ||
                  layoutRawProductCategory?.firstName ||
                  layoutProduct.productType ||
                  layoutProduct.type ||
                  'Product'
                )
          ).trim() || 'Product'
        : '';

    /*
     * Product URLs have two separate purposes.
     *
     * CANONICAL:
     * Use the permanent clean product URL for search engines.
     *
     * SOCIAL SHARE:
     * Keep the optional versioned shareUrl used by the existing
     * Kasyora social-sharing/cache flow.
     */
    const layoutProductCanonicalUrl =
      layoutProduct
        ? layoutAbsoluteUrl(
            layoutProduct.url ||
            ''
          )
        : '';

    const layoutProductShareUrl =
      layoutProduct
        ? layoutAbsoluteUrl(
            layoutProduct.shareUrl ||
            layoutProduct.url ||
            ''
          )
        : '';

    const layoutProductImage =
      layoutProduct
        ? layoutAbsoluteUrl(
            layoutProduct.shareImageUrl ||
            layoutProduct.image ||
            layoutProduct.imageUrl ||
            ''
          )
        : '';

    /*
     * Do not put VAT or converted prices into the SEO description.
     *
     * Storefront VAT and display currency depend on the customer's
     * resolved destination and currency preferences. The SEO text
     * therefore remains stable and truthful for every visitor.
     */
    const layoutProductDescription =
      layoutProduct
        ? (
            `${layoutProductName} in ${layoutProductCategory}. ` +
            'View product details, pricing and availability on Kasyora.'
          )
        : '';

    /*
     * Routes may provide page-specific SEO values.
     *
     * These fallbacks make the main Store useful immediately while
     * allowing Shop, Bestseller and other public pages to receive
     * their own titles/descriptions later.
     */
    const layoutPageTitle =
      layoutProduct
        ? `${layoutProductName} | Kasyora`
        : String(
            typeof seoTitle !== 'undefined' &&
            seoTitle
              ? seoTitle
              : (
                  typeof title !== 'undefined' &&
                  title
                    ? title
                    : 'Kasyora Online Store'
                )
          ).trim();

    const layoutPageDescription =
      layoutProduct
        ? layoutProductDescription
        : String(
            typeof seoDescription !== 'undefined' &&
            seoDescription
              ? seoDescription
              : (
                  'Shop products online with Kasyora. ' +
                  'Discover products from Kasyora sellers, suppliers ' +
                  'and global commerce partners.'
                )
          ).trim();

    /*
     * Canonical URL priority:
     *
     * 1. Permanent clean product URL.
     * 2. Route-supplied canonicalUrl.
     * 3. Route-supplied seoCanonicalPath.
     * 4. Main Store fallback.
     *
     * Never use the versioned product shareUrl as the canonical URL.
     */
    const layoutCanonicalUrl =
      layoutProductCanonicalUrl ||
      (
        typeof canonicalUrl !== 'undefined' &&
        canonicalUrl
          ? layoutAbsoluteUrl(
              canonicalUrl
            )
          : (
              typeof seoCanonicalPath !== 'undefined' &&
              seoCanonicalPath
                ? layoutAbsoluteUrl(
                    seoCanonicalPath
                  )
                : layoutAbsoluteUrl(
                    '/store'
                  )
            )
      );

    /*
     * Social platforms may continue receiving the versioned
     * product share URL used by the existing Kasyora sharing flow.
     *
     * Non-product pages use their canonical URL.
     */
    const layoutSocialUrl =
      layoutProduct
        ? (
            layoutProductShareUrl ||
            layoutCanonicalUrl
          )
        : layoutCanonicalUrl;

    const layoutOgImage =
      layoutProductImage ||
      layoutAbsoluteUrl(
        '/images/branding/logo-unincorporate.png'
      );

    const layoutOgType =
      layoutProduct
        ? 'product'
        : 'website';
  %>

  <title><%= layoutPageTitle %></title>

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <meta name="description" content="<%= layoutPageDescription %>">

  <meta name="robots" content="index,follow,max-image-preview:large">

  <link rel="canonical" href="<%= layoutCanonicalUrl %>">

  <meta property="og:type" content="<%= layoutOgType %>">

  <meta property="og:site_name" content="Kasyora">

  <meta property="og:title" content="<%= layoutPageTitle %>">

  <meta property="og:description" content="<%= layoutPageDescription %>">

  <meta property="og:url" content="<%= layoutSocialUrl %>">

  <meta property="og:image" content="<%= layoutOgImage %>">

  <meta property="og:image:alt" content="<%= layoutProduct ? layoutProductName : 'Kasyora' %>">

  <meta name="twitter:card" content="summary_large_image">

  <meta name="twitter:title" content="<%= layoutPageTitle %>">

  <meta name="twitter:description" content="<%= layoutPageDescription %>">

  <meta name="twitter:image" content="<%= layoutOgImage %>">

  <meta name="twitter:image:alt" content="<%= layoutProduct ? layoutProductName : 'Kasyora' %>">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

  <link href="/electro/lib/animate/animate.min.css" rel="stylesheet">
  <link href="/electro/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
  <link href="/electro/lib/lightbox/css/lightbox.min.css" rel="stylesheet">

  <link href="/electro/css/bootstrap.min.css" rel="stylesheet">
  <link href="/electro/css/style.css" rel="stylesheet">

  <style>
    html,
    body {
      overflow-x: hidden;
    }
  </style>
</head>

<body>
  <%- body %>

  <script nonce="<%= nonce %>" src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
  <script nonce="<%= nonce %>" src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
  <script nonce="<%= nonce %>" src="/electro/lib/wow/wow.min.js"></script>
  <script nonce="<%= nonce %>" src="/electro/lib/easing/easing.min.js"></script>
  <script nonce="<%= nonce %>" src="/electro/lib/waypoints/waypoints.min.js"></script>
  <script nonce="<%= nonce %>" src="/electro/lib/counterup/counterup.min.js"></script>
  <script nonce="<%= nonce %>" src="/electro/lib/owlcarousel/owl.carousel.min.js"></script>
  <script nonce="<%= nonce %>" src="/electro/lib/lightbox/js/lightbox.min.js"></script>
  <script nonce="<%= nonce %>" src="/electro/js/main.js?v=20260723-2"></script>
  <script nonce="<%= nonce %>" src="/electro/js/store-custom.js"></script>
</body>

</html>