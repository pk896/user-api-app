<!--views/sales-products.ejs-->
<%
  const VAT = (
    typeof vatRate !== 'undefined' &&
    vatRate !== null
  )
    ? Number(vatRate)
    : 0.15;

  /*
   * BASE_CURRENCY remains Kasyora's authoritative product,
   * cart, VAT, shipping, order, payout and accounting currency.
   *
   * CURRENCY is only the customer's selected display currency.
   */
  const BASE_CURRENCY = String(
    typeof baseCurrency !== 'undefined'
      ? baseCurrency
      : 'USD'
  ).trim().toUpperCase() || 'USD';

  const CURRENCY = String(
    typeof displayCurrency !== 'undefined'
      ? displayCurrency
      : BASE_CURRENCY
  ).trim().toUpperCase() || BASE_CURRENCY;

  const CURRENCY_RATE_RAW = Number(
    typeof displayRate !== 'undefined'
      ? displayRate
      : 1
  );

  const CURRENCY_RATE =
    Number.isFinite(CURRENCY_RATE_RAW) &&
    CURRENCY_RATE_RAW > 0
      ? CURRENCY_RATE_RAW
      : 1;

  /*
   * Convert only visible prices.
   * Stored products and cart API amounts remain in BASE_CURRENCY.
   */
  function convertBaseToDisplay(amount) {
    const baseAmount = Number(amount || 0);

    if (!Number.isFinite(baseAmount)) {
      return 0;
    }

    return Number(
      (
        baseAmount *
        CURRENCY_RATE
      ).toFixed(2)
    );
  }

  function formatMoney(amount) {
    const convertedAmount =
      convertBaseToDisplay(amount);

    try {
      const formatted = new Intl.NumberFormat(
        undefined,
        {
          style: 'currency',
          currency: CURRENCY,
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }
      ).format(convertedAmount);

      if (CURRENCY === 'ZAR') {
        return formatted.replace(/^ZAR\s?/, 'R');
      }

      return formatted;
    } catch (error) {
      return (
        CURRENCY +
        ' ' +
        convertedAmount.toFixed(2)
      );
    }
  }

  const ACTIVE_DEPARTMENT = String(
    typeof storeDepartment !== 'undefined'
      ? storeDepartment
      : 'internal'
  ).trim().toLowerCase() === 'cj'
    ? 'cj'
    : 'internal';

  const IS_CJ_DEPARTMENT =
    ACTIVE_DEPARTMENT === 'cj';

  const ACTIVE_HOME_URL =
    '/store?department=' +
    encodeURIComponent(
      ACTIVE_DEPARTMENT
    );

  const ACTIVE_SHOP_URL =
    '/store/shop?department=' +
    encodeURIComponent(
      ACTIVE_DEPARTMENT
    );

  const ACTIVE_BESTSELLER_URL =
    '/store/bestseller?department=' +
    encodeURIComponent(
      ACTIVE_DEPARTMENT
    ); 

  const ACTIVE_FAST_LINER_URL =
    '/products/sales?department=' +
    encodeURIComponent(
      ACTIVE_DEPARTMENT
    );

  const ACTIVE_CART_URL =
    IS_CJ_DEPARTMENT
      ? '/cj/cart'
      : '/store/cart';

  const ACTIVE_CHECKOUT_URL =
    IS_CJ_DEPARTMENT
      ? '/cj/checkout'
      : '/payment/checkout';

  function salesProductPayload(product) {
    const source = String(
      product?.source || ''
    ).trim().toUpperCase();

    if (source === 'CJ') {
      return encodeURIComponent(
        JSON.stringify({
          source: 'CJ',

          cjProductId:
            product.cjProductId || '',

          cjVariantId:
            product.defaultCjVariantId || '',

          name:
            product.name || '',

          image:
            product.image ||
            product.imageUrl ||
            '',

          variants:
            Array.isArray(product.variants)
              ? product.variants
              : []
        })
      );
    }

    return encodeURIComponent(
      JSON.stringify({
        source: 'INTERNAL',

        customId:
          product.customId || '',

        name:
          product.name || '',

        image:
          product.image ||
          product.imageUrl ||
          '',

        sizes:
          Array.isArray(product.sizes)
            ? product.sizes
            : [],

        colors:
          Array.isArray(product.colors)
            ? product.colors
            : [],

        colorImages:
          Array.isArray(product.colorImages)
            ? product.colorImages
            : []
      })
    );
  }

  /*
   * Preserve the current search, category and page after the
   * customer changes display currency.
   */
  function salesPageUrlForDepartment(
    department,
    pageOverride
  ) {
    const safeDepartment =
      String(department || '')
        .trim()
        .toLowerCase() === 'cj'
        ? 'cj'
        : 'internal';

    const params = [];

    params.push(
      'department=' +
      encodeURIComponent(
        safeDepartment
      )
    );

    const keyword = String(
      typeof selectedQ !== 'undefined'
        ? selectedQ
        : ''
    ).trim();

    const category = String(
      typeof selectedCat !== 'undefined'
        ? selectedCat
        : ''
    ).trim();

    const pageNumber = Number(
      pageOverride !== undefined
        ? pageOverride
        : (
            typeof currentPage !== 'undefined'
              ? currentPage
              : 1
          )
    );

    if (keyword) {
      params.push(
        'q=' +
        encodeURIComponent(keyword)
      );
    }

    if (category) {
      params.push(
        'cat=' +
        encodeURIComponent(category)
      );
    }

    if (
      Number.isFinite(pageNumber) &&
      pageNumber > 1
    ) {
      params.push(
        'page=' +
        encodeURIComponent(
          pageNumber
        )
      );
    }

    return (
      '/products/sales?' +
      params.join('&')
    );
  }

  function salesPageUrl(
    pageOverride
  ) {
    return salesPageUrlForDepartment(
      ACTIVE_DEPARTMENT,
      pageOverride
    );
  }

  const SALES_CURRENCY_RETURN_TO =
    salesPageUrl();

  const INTERNAL_SALES_RETURN_TO =
    salesPageUrlForDepartment(
      'internal',
      1
    );

  const CJ_SALES_RETURN_TO =
    salesPageUrlForDepartment(
      'cj',
      1
    );
%>
<section class="sales-ministore py-3">
  <style nonce="<%= nonce %>">
    :root {
      --ms-accent: #72AEC8;
      --ms-dark: #212529;
      --ms-light: #f8f9fa;
      --ms-blue: #EDF1F3;
      --ms-gray: #AEAEAE;
      --ms-brand: #7C3AED;
    }

    .sales-ministore {
      background: var(--ms-light);
      position: relative;
      min-height: 60vh;

      /*
      * Break Fast Liner out of any parent Bootstrap container
      * so the entire page reaches both viewport edges.
      */
      width: 100vw;
      max-width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
      overflow-x: hidden;
    }

    .sales-toolbar {
      position: sticky;
      top: 0;
      z-index: 1020;
      background: rgba(248, 249, 250, .96);
      backdrop-filter: blur(8px);
    }

    .sales-search-card {
      border: 0;
      border-radius: 0;
      background: #fff;
      box-shadow: 0 6px 20px rgba(0, 0, 0, .05);
    }

    .sales-search-card .form-control,
    .sales-search-card .form-select {
      min-height: 44px;
      border-radius: 0;
      border: 1px solid #e9ecef;
      box-shadow: none;
    }

    .sales-search-card .btn {
      min-height: 44px;
      border-radius: 0;
      letter-spacing: .08em;
      text-transform: uppercase;
      background-color: var(--ms-brand) !important;
      border-color: var(--ms-brand) !important;
      color: #fff !important;
    }

    .sales-search-card .btn:hover,
    .sales-search-card .btn:focus,
    .sales-search-card .btn:active {
      background-color: var(--ms-brand) !important;
      border-color: var(--ms-brand) !important;
      color: #fff !important;
    }

    .sales-grid .product-card {
      background: #fff;
      border: 0;
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .sales-grid .product-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 24px rgba(0, 0, 0, .08);
    }

    .sales-grid .image-holder {
      background: var(--ms-blue);
      aspect-ratio: 1 / 1;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .sales-grid .image-holder img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 12px;
      display: block;
    }

    .sales-grid .card-detail {
      padding: 14px 8px 0;
      display: block !important;
      text-align: center;
    }

    .sales-grid h3.card-title {
      font-size: 1rem;
      line-height: 1.3;
      margin: 0 0 8px;
      min-height: 2.6em;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      text-transform: uppercase;
      text-align: center;
    }

    .sales-grid .card-title span {
      color: #212529;
      font-weight: bold;
      text-decoration: none;
    }

    .sales-grid .item-price {
      display: block;
      color: var(--ms-accent) !important;
      font-size: 1.15rem;
      font-weight: 700;
      line-height: 1.2;
      text-align: center;
    }

    .sales-empty {
      background: #fff;
      padding: 3rem 1rem;
      text-align: center;
      box-shadow: 0 6px 20px rgba(0, 0, 0, .05);
    }

    .sales-pager .btn {
      min-width: 120px;
      border-radius: 0;
      text-transform: uppercase;
      letter-spacing: .08em;
      background-color: var(--ms-brand) !important;
      border-color: var(--ms-brand) !important;
      color: #fff !important;
    }

    .sales-pager .btn:hover,
    .sales-pager .btn:focus,
    .sales-pager .btn:active {
      background-color: var(--ms-brand) !important;
      border-color: var(--ms-brand) !important;
      color: #fff !important;
    }

    .related-products-wrap {
      margin-top: 2rem;
    }

    .related-products-title {
      font-size: 2rem;
      font-weight: 700;
      text-transform: uppercase;
      margin: 0 0 1rem;
      text-align: center;
      color: var(--ms-brand);
    }

    .related-grid .product-card {
      background: #fff;
      border: 0;
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .related-grid .product-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 24px rgba(0, 0, 0, .08);
    }

    .related-grid .image-holder {
      background: var(--ms-blue);
      aspect-ratio: 1 / 1;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .related-grid .image-holder img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 8px;
      display: block;
    }

    .related-grid .card-detail {
      padding: 14px 8px 0;
      display: block !important;
      text-align: center;
    }

    .related-grid h3.card-title {
      font-size: .95rem;
      font-weight: bold;
      line-height: 1.3;
      margin: 0 0 8px;
      min-height: 2.5em;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      text-transform: uppercase;
      text-align: center;
    }

    .related-grid .card-title span {
      color: var(--ms-brand);
      text-decoration: none;
    }

    .related-grid .item-price {
      display: block;
      color: var(--ms-accent) !important;
      font-size: 1.05rem;
      font-weight: 700;
      line-height: 1.2;
      text-align: center;
    }

    .sales-desktop-layout {
      width: 100%;
    }

    .sales-main-column {
      min-width: 0;
    }

    .sales-rated-sidebar {
      position: sticky;
      top: 82px;
      max-height: calc(100vh - 100px);
      overflow-y: auto;
      scrollbar-width: thin;
    }

    .sales-rated-sidebar-card {
      background: #fff;
      border: 0;
      box-shadow: 0 6px 20px rgba(0, 0, 0, .05);
    }

    .sales-rated-product {
      background: #fff;
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .sales-rated-product:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 18px rgba(0, 0, 0, .08);
    }

    .sales-rated-product-image {
      width: 86px;
      height: 86px;
      flex: 0 0 86px;
      background: var(--ms-blue);
      overflow: hidden;
    }

    .sales-rated-product-image img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 6px;
    }

    .sales-product-rating {
      min-height: 24px;
    }

    @media (min-width: 1200px) {
      .sales-ministore>.container-fluid {
        width: 100%;
        max-width: none;
        margin-left: 0;
        margin-right: 0;
        padding-left: 0 !important;
        padding-right: 0 !important;
      }

      .sales-grid .col-xl-4 {
        flex: 0 0 auto;
        width: 33.333333%;
      }
    }

    /* Smart page loader */
    .sales-page-loader {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(248, 249, 250, 0.92);
      backdrop-filter: blur(8px);
      opacity: 1;
      visibility: visible;
      transition: opacity .45s ease, visibility .45s ease;
    }

    .sales-page-loader.is-hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .sales-page-loader__box {
      width: 96px;
      height: 96px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, .92);
      border: 1px solid rgba(124, 58, 237, 0.08);
      border-radius: 50%;
      box-shadow: 0 16px 40px rgba(0, 0, 0, .10);
    }

    .sales-page-loader__spinner {
      width: 56px;
      height: 56px;
      border: 4px solid rgba(124, 58, 237, 0.14);
      border-top-color: var(--ms-brand);
      border-right-color: #9f67ff;
      border-radius: 50%;
      animation: salesSpin .75s linear infinite;
    }

    .sales-loading {
      overflow: hidden;
    }

    @keyframes salesSpin {
      to {
        transform: rotate(360deg);
      }
    }

    @media (max-width: 575.98px) {
      .sales-toolbar {
        padding-left: 0;
        padding-right: 0;
      }

      .sales-grid {
        margin-left: 0 !important;
        margin-right: 0 !important;
      }

      .sales-grid .col-6 {
        padding-left: 0;
        padding-right: 0;
      }

      .sales-grid .image-holder img {
        padding: 8px;
      }

      .sales-grid h3.card-title {
        font-size: .92rem;
        min-height: 2.45em;
      }

      .sales-grid .item-price {
        font-size: 1.02rem;
      }

      .sales-page-loader__box {
        width: 82px;
        height: 82px;
      }

      .sales-page-loader__spinner {
        width: 48px;
        height: 48px;
      }
    }

    @media (prefers-reduced-motion: reduce) {

      .sales-grid .product-card,
      .related-grid .product-card,
      .sales-page-loader {
        transition: none !important;
      }

      .sales-page-loader__spinner {
        animation-duration: 1.2s !important;
      }
    }
  </style>

  <div id="salesPageLoader" class="sales-page-loader" aria-live="polite" aria-label="Loading page">
    <div class="sales-page-loader__box" role="status">
      <div class="sales-page-loader__spinner" aria-hidden="true"></div>
    </div>
  </div>

  <div class="container-fluid px-0">
    <%
    const SALES_SHOW_CURRENCY_WARNING =
      typeof currencyConversionAvailable !== 'undefined' &&
      currencyConversionAvailable === false;

    const SALES_CURRENCY_WARNING_TEXT =
      typeof currencyConversionMessage !== 'undefined'
        ? String(currencyConversionMessage || '').trim()
        : '';
  %>

    <% if (
    SALES_SHOW_CURRENCY_WARNING &&
    SALES_CURRENCY_WARNING_TEXT
  ) { %>
    <div class="alert alert-warning border shadow-sm mx-2 mx-md-0 mb-3" role="alert">
      <div class="d-flex align-items-start gap-2">
        <i class="fas fa-exclamation-triangle text-primary mt-1" aria-hidden="true"></i>

        <div>
          <div class="fw-bold text-primary">
            Currency display notice
          </div>

          <div class="small">
            <%= SALES_CURRENCY_WARNING_TEXT %>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <div class="bg-white border-bottom shadow-sm mb-3 p-2">
      <div class="d-flex justify-content-end">
        <% if (IS_CJ_DEPARTMENT) { %>
        <form action="/store/department/internal" method="POST" class="m-0 w-100 w-md-auto">
          <input type="hidden" name="returnTo" value="<%= INTERNAL_SALES_RETURN_TO %>">

          <button type="submit" class="btn btn-outline-primary w-100">
            <i class="fas fa-warehouse me-2"></i>
            Switch To Kasyora In Store
          </button>
        </form>
        <% } else { %>
        <form action="/store/department/cj" method="POST" class="m-0 w-100 w-md-auto">
          <input type="hidden" name="returnTo" value="<%= CJ_SALES_RETURN_TO %>">

          <button type="submit" class="btn btn-outline-success w-100">
            <i class="fas fa-globe me-2"></i>
            Switch To Kasyora CJ Store
          </button>
        </form>
        <% } %>
      </div>
    </div>

    <div class="sales-toolbar pb-2">
      <form method="GET" action="/products/sales" class="sales-search-card p-2 p-md-3" id="salesSearchForm">
        <input type="hidden" name="department" value="<%= ACTIVE_DEPARTMENT %>">

        <div class="row g-2 align-items-center">
          <div class="col-12 col-md-4">
            <input id="salesKeywordInput" type="text" name="q" class="form-control" placeholder="Search products..." value="<%= selectedQ || '' %>">
          </div>

          <div class="col-7 col-md-4">
            <select id="salesCategorySelect" name="cat" class="form-select">
              <option value="" <%= !selectedCat ? 'selected' : '' %>>
                All Category
              </option>

              <% (CATEGORIES || []).forEach(function(category) { %>
              <option value="<%= category.value %>" <%= selectedCat === category.value ? 'selected' : '' %>>
                <%= category.label %>
              </option>
              <% }) %>
            </select>
          </div>

          <div class="col-5 col-md-2">
            <div class="bg-white border h-100 d-flex align-items-center justify-content-center px-2">
              <%- include('store/partials/currency-selector', {
                currencyReturnTo: SALES_CURRENCY_RETURN_TO
              }) %>
            </div>
          </div>

          <div class="col-12 col-md-2 d-grid">
            <button id="salesKeywordSearchBtn" type="button" class="btn btn-dark">
              Search
            </button>
          </div>
        </div>
      </form>
    </div>

    <div class="row g-3 sales-desktop-layout align-items-start">
      <main class="col-12 col-xl-9 sales-main-column">
        <% if (!products || !products.length) { %>
        <div class="sales-empty mt-3">
          <h5 class="mb-2">
            No products found
          </h5>

          <a href="<%= ACTIVE_FAST_LINER_URL %>" class="btn btn-primary">
            Clear Search
          </a>
        </div>
        <% } else { %>
        <div class="row g-2 g-md-3 mt-1 sales-grid">
          <% products.forEach(function(product) { %>
          <%
            const image =
              product.imageUrl ||
              product.image ||
              '/images/no-image.png';

            const basePrice =
              Number(product.price || 0);

            const vatPrice =
              basePrice * (1 + VAT);

            const productIsCj =
              String(product.source || '')
                .trim()
                .toUpperCase() === 'CJ';

            const defaultCjVariant =
              Array.isArray(product.variants)
                ? (
                    product.variants.find(
                      function(variant) {
                        return (
                          String(
                            variant?.cjVariantId || ''
                          ) ===
                          String(
                            product?.defaultCjVariantId || ''
                          )
                        );
                      }
                    ) ||
                    product.variants[0]
                  )
                : null;
          %>

          <div class="col-6 col-md-4 col-lg-3 col-xl-4">
            <div class="product-card position-relative h-100 d-flex flex-column">
              <a href="<%= product.url %>" class="text-decoration-none text-reset d-block sales-nav-link" aria-label="Open <%= product.name || 'product' %>">
                <div class="image-holder">
                  <img src="<%= image %>" alt="<%= product.name %>" class="img-fluid" loading="lazy">
                </div>
              </a>

              <div class="card-detail d-flex flex-column flex-grow-1 px-2 pb-3">
                <a href="<%= product.url %>" class="text-decoration-none sales-nav-link">
                  <h3 class="card-title text-uppercase">
                    <span>
                      <%= product.name || 'Untitled Product' %>
                    </span>
                  </h3>
                </a>

                <span class="item-price text-primary">
                  <%= formatMoney(vatPrice) %>
                </span>

                <small class="text-muted d-block mb-2">
                  incl. VAT
                </small>

                <div class="sales-product-rating mb-3">
                  <%- include('partials/rating-stars', {
                    avg: Number(product.avgRating || 0),
                    count: Number(product.ratingsCount || 0),
                    nonce
                  }) %>
                </div>

                <div class="mt-auto d-grid px-1">
                  <% if (productIsCj) { %>
                  <% if (defaultCjVariant?.cjVariantId) { %>
                  <button type="button" class="btn btn-primary btn-sm js-add-to-cj-cart" data-cj-product-id="<%= product.cjProductId %>" data-cj-variant-id="<%= defaultCjVariant.cjVariantId %>" data-product="<%- salesProductPayload(product) %>">
                    <i class="fas fa-shopping-cart me-1"></i>
                    Add To CJ Cart
                  </button>
                  <% } else { %>
                  <a href="<%= product.url %>" class="btn btn-outline-primary btn-sm sales-nav-link">
                    Select Variant
                  </a>
                  <% } %>
                  <% } else { %>
                  <a href="/api/cart/add?pid=<%= encodeURIComponent(product.customId) %>&qty=1&json=1" class="btn btn-primary btn-sm js-add-to-cart" data-pid="<%= product.customId %>" data-product="<%- salesProductPayload(product) %>">
                    <i class="fas fa-shopping-cart me-1"></i>
                    Add To Cart
                  </a>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
          <% }) %>
        </div>

        <% if (
          typeof hasPrevPage !== 'undefined' ||
          typeof hasNextPage !== 'undefined'
        ) { %>
        <div class="d-flex justify-content-between align-items-center mt-4 sales-pager">
          <% if (hasPrevPage) { %>
          <a href="<%= salesPageUrl(currentPage - 1) %>" class="btn btn-outline-dark sales-nav-link">
            Previous
          </a>
          <% } else { %>
          <span></span>
          <% } %>

          <div class="small text-muted">
            Page
            <strong><%= currentPage %></strong>
            of
            <strong><%= totalPages %></strong>
          </div>

          <% if (hasNextPage) { %>
          <a href="<%= salesPageUrl(currentPage + 1) %>" class="btn btn-dark sales-nav-link">
            Next
          </a>
          <% } else { %>
          <span></span>
          <% } %>
        </div>
        <% } %>
        <% } %>
      </main>

      <aside class="col-xl-3 d-none d-xl-block">
        <div class="sales-rated-sidebar">
          <div class="sales-rated-sidebar-card p-3">
            <div class="border-bottom pb-3 mb-3">
              <div class="small text-muted text-uppercase fw-bold">
                Customer favourites
              </div>

              <h2 class="h4 text-primary mb-1">
                Most Rated Products
              </h2>
            </div>

            <% if (
              topRatedProducts &&
              topRatedProducts.length
            ) { %>
            <div class="d-grid gap-3">
              <% topRatedProducts.forEach(function(product, index) { %>
              <%
                const ratedImage =
                  product.imageUrl ||
                  product.image ||
                  '/images/no-image.png';

                const ratedPrice =
                  Number(product.price || 0) *
                  (1 + VAT);
              %>

              <a href="<%= product.url %>" class="sales-rated-product text-decoration-none text-dark d-flex gap-3 p-2 sales-nav-link">
                <div class="sales-rated-product-image">
                  <img src="<%= ratedImage %>" alt="<%= product.name || 'Product' %>" loading="lazy">
                </div>

                <div class="min-w-0 flex-grow-1">
                  <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                    <span class="badge bg-primary">
                      #<%= index + 1 %>
                    </span>

                    <span class="small text-muted">
                      <%= Number(product.ratingsCount || 0) %>
                      ratings
                    </span>
                  </div>

                  <div class="fw-bold small text-primary mb-1">
                    <%= product.name || 'Product' %>
                  </div>

                  <div class="mb-1">
                    <%- include('partials/rating-stars', {
                      avg: Number(product.avgRating || 0),
                      count: Number(product.ratingsCount || 0),
                      nonce
                    }) %>
                  </div>

                  <div class="fw-bold">
                    <%= formatMoney(ratedPrice) %>
                  </div>
                </div>
              </a>
              <% }) %>
            </div>
            <% } else { %>
            <div class="alert alert-light border mb-0">
              No rated products are available in this department yet.
            </div>
            <% } %>

            <div class="d-grid gap-2 mt-4">
              <a href="<%= ACTIVE_BESTSELLER_URL %>" class="btn btn-outline-primary sales-nav-link">
                View Bestsellers
              </a>

              <a href="<%= ACTIVE_SHOP_URL %>" class="btn btn-primary sales-nav-link">
                View Full Store
              </a>
            </div>
          </div>
        </div>
      </aside>
    </div>

    <% if (selectedQ && relatedProducts && relatedProducts.length) { %>
    <div class="related-products-wrap">
      <div class="mx-auto text-center mb-4" style="max-width: 700px;">
        <h4 class="related-products-title">Related Products</h4>
        <p class="mb-0 text-muted">
          Based on your search — here are more products closely related to your interest. Fits your style, needs, and budget best.
        </p>
      </div>

      <div class="row g-2 g-md-3 mt-1 related-grid">
        <% relatedProducts.forEach(product => { %>
        <%
          const relatedImage =
            product.imageUrl ||
            product.image ||
            '/images/no-image.png';

          const relatedBasePrice =
            Number(product.price || 0);

          const relatedVatPrice =
            relatedBasePrice * (1 + VAT);
        %>

        <div class="col-6 col-md-4 col-lg-3">
          <a href="<%= product.url %>" class="text-decoration-none text-reset d-block h-100 sales-nav-link" aria-label="Open <%= product.name || 'product' %>">
            <div class="product-card position-relative h-100">
              <div class="image-holder">
                <img src="<%= relatedImage %>" alt="<%= product.name %>" class="img-fluid" loading="lazy">
              </div>

              <div class="card-detail px-2 pb-3">
                <h3 class="card-title text-uppercase">
                  <span>
                    <%= product.name || 'Untitled Product' %>
                  </span>
                </h3>

                <span class="item-price text-primary">
                  <%= formatMoney(relatedVatPrice) %>
                </span>

                <small class="text-muted d-block mb-2">
                  incl. VAT
                </small>

                <div class="sales-product-rating">
                  <%- include('partials/rating-stars', {
                    avg: Number(product.avgRating || 0),
                    count: Number(product.ratingsCount || 0),
                    nonce
                  }) %>
                </div>
              </div>
            </div>
          </a>
        </div>
        <% }) %>
      </div>
    </div>
    <% } %>
  </div>

  <!-- Floating Cart Total Start -->
  <div id="salesFloatingCart" class="d-none position-fixed bottom-0 start-0 mb-3 ms-3" style="z-index: 1080;">
    <a href="<%= ACTIVE_CART_URL %>" class="btn btn-primary rounded-pill shadow-sm d-inline-flex align-items-center px-2 py-1" style="font-size: 0.85rem;">
      <span class="rounded-circle bg-white text-primary d-inline-flex align-items-center justify-content-center me-1" style="width: 24px; height: 24px;">
        <i class="fas fa-shopping-cart" style="font-size: 0.75rem;"></i>
      </span>

      <span id="salesFloatingCartTotal" class="text-white fw-semibold">
        <%= formatMoney(0) %>
      </span>
    </a>
  </div>
  <!-- Floating Cart Total End -->

  <%- include('store/partials/currency-client') %>

  <% if (!IS_CJ_DEPARTMENT) { %>
  <%- include('store/partials/cart-script-listing') %>
  <% } %>

  <% if (IS_CJ_DEPARTMENT) { %>
  <script nonce="<%= nonce %>">
    (function() {
      function showCjSalesMessage(
        message,
        success
      ) {
        const previous =
          document.getElementById(
            'cjSalesCartMessage'
          );

        if (previous) {
          previous.remove();
        }

        const alert =
          document.createElement('div');

        alert.id =
          'cjSalesCartMessage';

        alert.className =
          'alert alert-' +
          (
            success ?
            'success' :
            'danger'
          ) +
          ' position-fixed top-0 end-0 mt-3 me-3 shadow';

        alert.style.zIndex =
          '2000';

        alert.style.maxWidth =
          '420px';

        alert.textContent =
          String(message || '');

        document.body.appendChild(
          alert
        );

        window.setTimeout(
          function() {
            alert.remove();
          },
          5000
        );
      }

      document.addEventListener(
        'click',
        async function(event) {
          const button =
            event.target.closest(
              '.js-add-to-cj-cart'
            );

          if (!button) {
            return;
          }

          event.preventDefault();

          const cjProductId =
            String(
              button.getAttribute(
                'data-cj-product-id'
              ) || ''
            ).trim();

          const cjVariantId =
            String(
              button.getAttribute(
                'data-cj-variant-id'
              ) || ''
            ).trim();

          if (
            !cjProductId ||
            !cjVariantId
          ) {
            showCjSalesMessage(
              'Select a valid CJ product variant.',
              false
            );

            return;
          }

          const originalHtml =
            button.innerHTML;

          button.disabled = true;

          button.innerHTML =
            '<span class="spinner-border spinner-border-sm me-2"></span>' +
            'Adding...';

          try {
            const response =
              await fetch(
                '/api/cj-cart/add', {
                  method: 'POST',

                  headers: {
                    'Content-Type': 'application/json',

                    Accept: 'application/json'
                  },

                  credentials: 'same-origin',

                  body: JSON.stringify({
                    cjProductId,
                    cjVariantId,
                    quantity: 1
                  })
                }
              );

            const data =
              await response
              .json()
              .catch(function() {
                return {};
              });

            if (
              !response.ok ||
              data.success === false
            ) {
              throw new Error(
                data.message ||
                'The CJ product could not be added.'
              );
            }

            showCjSalesMessage(
              data.message ||
              'CJ product added to your CJ cart.',
              true
            );

            window.dispatchEvent(
              new Event(
                'pageshow'
              )
            );
          } catch (error) {
            showCjSalesMessage(
              error?.message ||
              'Failed to add the CJ product.',
              false
            );
          } finally {
            button.disabled = false;
            button.innerHTML =
              originalHtml;
          }
        }
      );
    })();
  </script>
  <% } %>

  <script nonce="<%= nonce %>">
    (function() {
      const keywordInput = document.getElementById('salesKeywordInput');
      const categorySelect = document.getElementById('salesCategorySelect');
      const keywordBtn = document.getElementById('salesKeywordSearchBtn');
      const pageLoader = document.getElementById('salesPageLoader');
      const floatingCart = document.getElementById('salesFloatingCart');
      const floatingCartTotal = document.getElementById('salesFloatingCartTotal');

      function showLoader() {
        if (!pageLoader) return;
        pageLoader.classList.remove('is-hidden');
        document.body.classList.add('sales-loading');
      }

      function hideLoader(delay) {
        if (!pageLoader) return;

        window.setTimeout(function() {
          pageLoader.classList.add('is-hidden');
          document.body.classList.remove('sales-loading');
        }, Number(delay) || 0);
      }

      function formatSalesCartMoney(amount) {
        /*
         * The cart API returns BASE_CURRENCY amounts.
         * Convert only the visible floating-cart total.
         */
        if (
          window.KasyoraCurrency &&
          typeof window.KasyoraCurrency.formatBaseAmount === 'function'
        ) {
          return window.KasyoraCurrency.formatBaseAmount(
            amount
          );
        }

        /*
         * Defensive fallback:
         * show the unchanged BASE_CURRENCY value if the shared
         * display helper is unavailable.
         */
        const fallbackAmount =
          Number(amount || 0);

        const fallbackCurrency =
          "<%= String(typeof baseCurrency !== 'undefined' ? baseCurrency : 'USD').trim().toUpperCase() || 'USD' %>";

        try {
          const formatted = new Intl.NumberFormat(
            undefined, {
              style: 'currency',
              currency: fallbackCurrency,
              minimumFractionDigits: 2,
              maximumFractionDigits: 2
            }
          ).format(
            Number.isFinite(fallbackAmount) ?
            fallbackAmount :
            0
          );

          if (fallbackCurrency === 'ZAR') {
            return formatted.replace(/^ZAR\s?/, 'R');
          }

          return formatted;
        } catch (error) {
          return (
            fallbackCurrency +
            ' ' +
            (
              Number.isFinite(fallbackAmount) ?
              fallbackAmount :
              0
            ).toFixed(2)
          );
        }
      }

      async function loadSalesFloatingCart() {
        if (!floatingCart || !floatingCartTotal) return;

        try {
          const response = await fetch(
            '<%= IS_CJ_DEPARTMENT ? "/api/cj-cart" : "/api/cart" %>', {
              headers: {
                Accept: 'application/json'
              },
              credentials: 'same-origin'
            }
          );

          if (!response.ok) throw new Error('Could not load cart.');

          const data =
            await response.json();

          let total = 0;

          if ('<%= ACTIVE_DEPARTMENT %>' === 'cj') {
            total = Number(
              data.totalIncVat ??
              data.total ??
              0
            );
          } else {
            const items =
              Array.isArray(data.items) ?
              data.items : [];

            total = items.reduce(
              function(sum, item) {
                const price =
                  Number(item.price || 0);

                const quantity =
                  Number(
                    item.quantity ||
                    item.qty ||
                    0
                  );

                return (
                  sum +
                  (
                    price *
                    quantity
                  )
                );
              },
              0
            );
          }

          if (total > 0) {
            floatingCartTotal.textContent = formatSalesCartMoney(total);
            floatingCart.classList.remove('d-none');
          } else {
            floatingCart.classList.add('d-none');
          }
        } catch (err) {
          floatingCart.classList.add('d-none');
        }
      }

      function goToSales(categoryValue) {
        const params =
          new URLSearchParams();

        params.set(
          'department',
          '<%= ACTIVE_DEPARTMENT %>'
        );

        const keyword =
          String(
            keywordInput ?
            keywordInput.value :
            ''
          ).trim();
        const category = String(
          categoryValue != null ? categoryValue : (categorySelect ? categorySelect.value : '')
        ).trim();

        if (keyword) {
          params.set('q', keyword);
        }

        if (category) {
          params.set('cat', category);
        }

        const queryString = params.toString();
        showLoader();
        window.location.href =
          '/products/sales?' +
          queryString;
      }

      window.addEventListener('load', function() {
        hideLoader(1200);
        loadSalesFloatingCart();
      });

      window.addEventListener('pageshow', function() {
        hideLoader(300);
        loadSalesFloatingCart();
      });

      if (!keywordInput || !categorySelect) {
        hideLoader(650);
        return;
      }

      categorySelect.addEventListener('change', function() {
        goToSales(categorySelect.value);
      });

      keywordInput.addEventListener('input', function() {
        const keyword = String(keywordInput.value || '').trim();
        const category = String(categorySelect.value || '').trim();

        if (!keyword) {
          showLoader();

          if (category) {
            goToSales(category);
          } else {
            window.location.href =
              '/products/sales?department=<%= ACTIVE_DEPARTMENT %>';
          }
        }
      });

      keywordInput.addEventListener('keydown', function(event) {
        if (event.key === 'Enter') {
          event.preventDefault();
          goToSales(categorySelect.value);
        }
      });

      if (keywordBtn) {
        keywordBtn.addEventListener('click', function() {
          goToSales(categorySelect.value);
        });
      }

      document.addEventListener('click', function(event) {
        const link = event.target.closest('a.sales-nav-link');
        if (!link) return;

        const href = link.getAttribute('href') || '';
        if (!href || href.startsWith('#') || link.hasAttribute('download') || link.target === '_blank') {
          return;
        }

        showLoader();
      });
    })();
  </script>
</section>