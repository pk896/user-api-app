        <i class="fas fa-shopping-cart" style="font-size: 0.75rem;"></i>
      </span>

      <span id="salesFloatingCartTotal" class="text-white fw-semibold">
        <%= formatMoney(0) %>
      </span>
    </a>
  </div>
  <!-- Floating Cart Total End -->

  <%- include('store/partials/currency-client') %>

  <% if (!IS_CJ_DEPARTMENT) { %>
  <%- include('store/partials/cart-script-listing') %>
  <% } %>

  <% if (IS_CJ_DEPARTMENT) { %>
  <script nonce="<%= nonce %>">
    (function() {
      function showCjSalesMessage(
        message,
        success
      ) {
        const previous =
          document.getElementById(
            'cjSalesCartMessage'
          );

        if (previous) {
          previous.remove();
        }

        const alert =
          document.createElement('div');

        alert.id =
          'cjSalesCartMessage';

        alert.className =
          'alert alert-' +
          (
            success ?
            'success' :
            'danger'
          ) +
          ' position-fixed top-0 end-0 mt-3 me-3 shadow';

        alert.style.zIndex =
          '2000';

        alert.style.maxWidth =
          '420px';

        alert.textContent =
          String(message || '');

        document.body.appendChild(
          alert
        );

        window.setTimeout(
          function() {
            alert.remove();
          },
          5000
        );
      }

      document.addEventListener(
        'click',
        async function(event) {
          const button =
            event.target.closest(
              '.js-add-to-cj-cart'
            );

          if (!button) {
            return;
          }

          event.preventDefault();

          const cjProductId =
            String(
              button.getAttribute(
                'data-cj-product-id'
              ) || ''
            ).trim();

          const cjVariantId =
            String(
              button.getAttribute(
                'data-cj-variant-id'
              ) || ''
            ).trim();

          if (
            !cjProductId ||
            !cjVariantId
          ) {
            showCjSalesMessage(
              'Select a valid CJ product variant.',
              false
            );

            return;
          }

          const originalHtml =
            button.innerHTML;

          button.disabled = true;

          button.innerHTML =
            '<span class="spinner-border spinner-border-sm me-2"></span>' +
            'Adding...';

          try {
            const response =
              await fetch(
                '/api/cj-cart/add', {
                  method: 'POST',

                  headers: {
                    'Content-Type': 'application/json',

                    Accept: 'application/json'
                  },

                  credentials: 'same-origin',

                  body: JSON.stringify({
                    cjProductId,
                    cjVariantId,
                    quantity: 1
                  })
                }
              );

            const data =
              await response
              .json()
              .catch(function() {
                return {};
              });

            if (
              !response.ok ||
              data.success === false
            ) {
              throw new Error(
                data.message ||
                'The CJ product could not be added.'
              );
            }

            showCjSalesMessage(
              data.message ||
              'CJ product added to your CJ cart.',
              true
            );

            window.dispatchEvent(
              new CustomEvent(
                'kasyora:sales-cart-updated'
              )
            );
          } catch (error) {
            showCjSalesMessage(
              error?.message ||
              'Failed to add the CJ product.',
              false
            );
          } finally {
            button.disabled = false;
            button.innerHTML =
              originalHtml;
          }
        }
      );
    })();
  </script>
  <% } %>

  <script nonce="<%= nonce %>">
    (function() {
      const keywordInput = document.getElementById('salesKeywordInput');
      const categorySelect = document.getElementById('salesCategorySelect');
      const keywordBtn = document.getElementById('salesKeywordSearchBtn');
      const pageLoader = document.getElementById('salesPageLoader');
      const floatingCart = document.getElementById('salesFloatingCart');
      const floatingCartTotal = document.getElementById('salesFloatingCartTotal');

      function showLoader() {
        if (!pageLoader) return;
        pageLoader.classList.remove('is-hidden');
        document.body.classList.add('sales-loading');
      }

      function hideLoader(delay) {
        if (!pageLoader) return;

        window.setTimeout(function() {
          pageLoader.classList.add('is-hidden');
          document.body.classList.remove('sales-loading');
        }, Number(delay) || 0);
      }

      function formatSalesCartMoney(amount) {
        /*
         * The cart API returns BASE_CURRENCY amounts.
         * Convert only the visible floating-cart total.
         */
        if (
          window.KasyoraCurrency &&
          typeof window.KasyoraCurrency.formatBaseAmount === 'function'
        ) {
          return window.KasyoraCurrency.formatBaseAmount(
            amount
          );
        }

        /*
         * Defensive fallback:
         * show the unchanged BASE_CURRENCY value if the shared
         * display helper is unavailable.
         */
        const fallbackAmount =
          Number(amount || 0);

        const fallbackCurrency =
          "<%= String(typeof baseCurrency !== 'undefined' ? baseCurrency : 'USD').trim().toUpperCase() || 'USD' %>";

        try {
          const formatted = new Intl.NumberFormat(
            undefined, {
              style: 'currency',
              currency: fallbackCurrency,
              minimumFractionDigits: 2,
              maximumFractionDigits: 2
            }
          ).format(
            Number.isFinite(fallbackAmount) ?
            fallbackAmount :
            0
          );

          if (fallbackCurrency === 'ZAR') {
            return formatted.replace(/^ZAR\s?/, 'R');
          }

          return formatted;
        } catch (error) {
          return (
            fallbackCurrency +
            ' ' +
            (
              Number.isFinite(fallbackAmount) ?
              fallbackAmount :
              0
            ).toFixed(2)
          );
        }
      }

      async function loadSalesFloatingCart() {
        if (!floatingCart || !floatingCartTotal) return;

        try {
          const response = await fetch(
            '<%= IS_CJ_DEPARTMENT ? "/api/cj-cart" : "/api/cart" %>', {
              headers: {
                Accept: 'application/json'
              },
              credentials: 'same-origin'
            }
          );

          if (!response.ok) throw new Error('Could not load cart.');

          const data =
            await response.json();

          let total = 0;

          if (
            '<%= ACTIVE_DEPARTMENT %>' ===
            'cj'
          ) {
            /*
             * CJ cart remains fully separate.
             *
             * Do not add Internal Kasyora VAT.
             */
            total =
              Number(
                data.total ??
                data.totalIncVat ??
                0
              );
          } else {
            const items =
              Array.isArray(data.items) ?
              data.items :
              [];

            /*
             * Internal cart prices are VAT-exclusive.
             */
            const internalNetTotal =
              items.reduce(
                function(sum, item) {
                  const priceExVatRaw =
                    Number(
                      item.priceExVat ??
                      item.price ??
                      0
                    );

                  const quantityRaw =
                    Number(
                      item.quantity ??
                      item.qty ??
                      0
                    );

                  const priceExVat =
                    Number.isFinite(
                      priceExVatRaw
                    ) &&
                    priceExVatRaw >= 0 ?
                    priceExVatRaw :
                    0;

                  const quantity =
                    Number.isFinite(
                      quantityRaw
                    ) &&
                    quantityRaw > 0 ?
                    quantityRaw :
                    0;

                  return (
                    sum +
                    (
                      priceExVat *
                      quantity
                    )
                  );
                },
                0
              );

            /*
             * This is the inherited provisional country-aware
             * rate supplied by routes/products.js.
             */
            const provisionalVatRate =
              Number(
                '<%= Number(VAT) %>'
              );

            const safeVatRate =
              Number.isFinite(
                provisionalVatRate
              ) &&
              provisionalVatRate >= 0 &&
              provisionalVatRate <= 1 ?
              provisionalVatRate :
              0;

            total =
              Number(
                (
                  internalNetTotal *
                  (
                    1 +
                    safeVatRate
                  )
                ).toFixed(2)
              );
          }

          if (total > 0) {
            floatingCartTotal.textContent = formatSalesCartMoney(total);
            floatingCart.classList.remove('d-none');
          } else {
            floatingCart.classList.add('d-none');
          }
        } catch (err) {
          floatingCart.classList.add('d-none');
        }
      }

      function goToSales(categoryValue) {
        const params =
          new URLSearchParams();

        params.set(
          'department',
          '<%= ACTIVE_DEPARTMENT %>'
        );

        const keyword =
          String(
            keywordInput ?
            keywordInput.value :
            ''
          ).trim();
        const category = String(
          categoryValue != null ? categoryValue : (categorySelect ? categorySelect.value : '')
        ).trim();

        if (keyword) {
          params.set('q', keyword);
        }

        if (category) {
          params.set('cat', category);
        }

        const queryString =
          params.toString();

        showLoader();

        window.location.href =
          '/products/sales?' +
          queryString +
          '<%= SALES_PRODUCTS_ANCHOR %>';
      }

      window.addEventListener('load', function() {
        hideLoader(1200);
        loadSalesFloatingCart();
      });

      window.addEventListener('pageshow', function() {
        hideLoader(300);
        loadSalesFloatingCart();
      });

      /*
       * Refresh the correct department cart total immediately
       * after either CJ or Internal add-to-cart succeeds.
       */
      window.addEventListener(
        'kasyora:sales-cart-updated',
        function() {
          loadSalesFloatingCart();
        }
      );

      if (!keywordInput || !categorySelect) {
        hideLoader(650);
        return;
      }

      categorySelect.addEventListener('change', function() {
        goToSales(categorySelect.value);
      });

      keywordInput.addEventListener('input', function() {
        const keyword = String(keywordInput.value || '').trim();
        const category = String(categorySelect.value || '').trim();

        if (!keyword) {
          showLoader();

          if (category) {
            goToSales(category);
          } else {
            window.location.href =
              '/products/sales?department=<%= ACTIVE_DEPARTMENT %><%= SALES_PRODUCTS_ANCHOR %>';
          }
        }
      });

      keywordInput.addEventListener('keydown', function(event) {
        if (event.key === 'Enter') {
          event.preventDefault();
          goToSales(categorySelect.value);
        }
      });

      if (keywordBtn) {
        keywordBtn.addEventListener('click', function() {
          goToSales(categorySelect.value);
        });
      }

      /*
       * The shared Internal Store cart script completes the
       * Internal add-to-cart request asynchronously.
       *
       * Refresh shortly after the click so this Fast Liner
       * floating cart reflects the new Internal cart total.
       * This listener is inactive for CJ buttons.
       */
      document.addEventListener(
        'click',
        function(event) {
          const internalCartButton =
            event.target.closest(
              '.js-add-to-cart'
            );

          if (
            !internalCartButton ||
            '<%= ACTIVE_DEPARTMENT %>' === 'cj'
          ) {
            return;
          }

          window.setTimeout(
            function() {
              loadSalesFloatingCart();
            },
            500
          );

          window.setTimeout(
            function() {
              loadSalesFloatingCart();
            },
            1200
          );
        }
      );

      document.addEventListener('click', function(event) {
        const link = event.target.closest('a.sales-nav-link');
        if (!link) return;

        const href = link.getAttribute('href') || '';
        if (!href || href.startsWith('#') || link.hasAttribute('download') || link.target === '_blank') {
          return;
        }

        showLoader();
      });
    })();
  </script>
</section>