<%
  /*
   * Resolved Fast Liner tax treatment
   * =================================
   *
   * This page has no delivery-country selector.
   *
   * It inherits the provisional country that was already resolved
   * globally from:
   *
   * 1. the customer's storefront country selection;
   * 2. trusted GeoIP;
   * 3. the configured default country.
   *
   * Internal:
   *
   * - ZA_STANDARD may produce a positive VAT rate;
   * - ZA_EXPORT_ZERO_RATED produces a zero visible VAT rate;
   * - VAT_DISABLED produces a zero visible VAT rate.
   *
   * CJ:
   *
   * - Kasyora-added VAT is always zero;
   * - the Internal tax resolver is never used.
   *
   * The validated checkout shipping address remains authoritative
   * for final Internal VAT, PayPal and the completed order.
   */
  const SALES_TAX_TREATMENT =
    typeof taxTreatment !== 'undefined' &&
    taxTreatment &&
    typeof taxTreatment === 'object'
      ? taxTreatment
      : {};

  const SALES_VAT_RATE_RAW =
    Number(
      SALES_TAX_TREATMENT.vatRate ??
      (
        typeof vatRate !== 'undefined' &&
        vatRate !== null
          ? vatRate
          : 0
      )
    );

  const VAT =
    Number.isFinite(
      SALES_VAT_RATE_RAW
    ) &&
    SALES_VAT_RATE_RAW >= 0 &&
    SALES_VAT_RATE_RAW <= 1
      ? SALES_VAT_RATE_RAW
      : 0;

  /*
   * vatEnabled distinguishes:
   *
   * VAT disabled:
   * vatEnabled false, vatRate 0
   *
   * Foreign zero-rated destination:
   * vatEnabled true, vatRate 0
   *
   * South African standard VAT:
   * vatEnabled true, vatRate greater than 0
   */
  const SALES_VAT_ENABLED =
    SALES_TAX_TREATMENT.vatEnabled === true;

  /*
   * BASE_CURRENCY remains Kasyora's authoritative product,
   * cart, VAT, shipping, order, payout and accounting currency.
   *
   * CURRENCY is only the customer's selected display currency.
   */
  const BASE_CURRENCY = String(
    typeof baseCurrency !== 'undefined'
      ? baseCurrency
      : 'USD'
  ).trim().toUpperCase() || 'USD';

  const CURRENCY = String(
    typeof displayCurrency !== 'undefined'
      ? displayCurrency
      : BASE_CURRENCY
  ).trim().toUpperCase() || BASE_CURRENCY;

  const CURRENCY_RATE_RAW = Number(
    typeof displayRate !== 'undefined'
      ? displayRate
      : 1
  );

  const CURRENCY_RATE =
    Number.isFinite(CURRENCY_RATE_RAW) &&
    CURRENCY_RATE_RAW > 0
      ? CURRENCY_RATE_RAW
      : 1;

  /*
   * Convert only visible prices.
   * Stored products and cart API amounts remain in BASE_CURRENCY.
   */
  function convertBaseToDisplay(amount) {
    const baseAmount = Number(amount || 0);

    if (!Number.isFinite(baseAmount)) {
      return 0;
    }

    return Number(
      (
        baseAmount *
        CURRENCY_RATE
      ).toFixed(2)
    );
  }

  function formatMoney(amount) {
    const convertedAmount =
      convertBaseToDisplay(amount);

    try {
      const formatted = new Intl.NumberFormat(
        undefined,
        {
          style: 'currency',
          currency: CURRENCY,
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }
      ).format(convertedAmount);

      if (CURRENCY === 'ZAR') {
        return formatted.replace(/^ZAR\s?/, 'R');
      }

      return formatted;
    } catch (error) {
      return (
        CURRENCY +
        ' ' +
        convertedAmount.toFixed(2)
      );
    }
  }

  /*
   * The Most Rated Products sidebar has limited horizontal
   * space. Keep the complete product value unchanged and
   * shorten only the visible sidebar product name.
   */
  function truncateSalesSidebarText(
    value,
    maxCharacters = 25
  ) {
    const text = String(
      value || ''
    ).trim();

    if (text.length <= maxCharacters) {
      return text;
    }

    return (
      text
        .slice(0, maxCharacters)
        .trimEnd() +
      '...'
    );
  }

  const ACTIVE_DEPARTMENT = String(
    typeof storeDepartment !== 'undefined'
      ? storeDepartment
      : 'internal'
  ).trim().toLowerCase() === 'cj'
    ? 'cj'
    : 'internal';

  const IS_CJ_DEPARTMENT =
    ACTIVE_DEPARTMENT === 'cj';

  /*
   * Show the short "incl. VAT" note only when:
   *
   * - the active department is Internal;
   * - the resolver confirms VAT is enabled; and
   * - the actual visible price contains a positive VAT amount.
   *
   * Therefore:
   *
   * Provisional South Africa with VAT enabled:
   * show "incl. VAT".
   *
   * Provisional foreign destination:
   * show the VAT-exclusive Product.price with no VAT note.
   *
   * VAT disabled:
   * show Product.price with no VAT note.
   *
   * CJ:
   * show the separate CJ price with no Internal VAT note.
   */
  const SALES_INTERNAL_VAT_ACTIVE =
    !IS_CJ_DEPARTMENT &&
    SALES_VAT_ENABLED &&
    VAT > 0;

  function isCjSalesProduct(product) {
    return (
      String(
        product?.source || ''
      )
        .trim()
        .toUpperCase() === 'CJ'
    );
  }

  /*
   * Return the customer-visible Fast Liner price.
   *
   * The original product.price remains VAT-exclusive.
   *
   * Internal South Africa with VAT enabled:
   *
   * Product.price 100
   * visible price 115
   *
   * Internal provisional foreign destination:
   *
   * Product.price 100
   * visible price 100
   * no VAT note
   *
   * Internal VAT disabled:
   *
   * Product.price 100
   * visible price 100
   * no VAT note
   *
   * CJ:
   *
   * The separate CJ price remains unchanged and receives
   * no Internal Kasyora VAT.
   */
  function getSalesVisiblePrice(product) {
    const basePriceRaw =
      Number(
        product?.price || 0
      );

    const basePrice =
      Number.isFinite(
        basePriceRaw
      ) &&
      basePriceRaw >= 0
        ? basePriceRaw
        : 0;

    if (
      isCjSalesProduct(product) ||
      !SALES_VAT_ENABLED ||
      VAT <= 0
    ) {
      return Number(
        basePrice.toFixed(2)
      );
    }

    return Number(
      (
        basePrice *
        (
          1 +
          VAT
        )
      ).toFixed(2)
    );
  }

  /*
   * No VAT wording is shown for:
   *
   * - provisional foreign destinations;
   * - VAT-disabled Internal destinations;
   * - CJ products.
   *
   * Foreign zero-rate information belongs in checkout.
   */
  function shouldShowSalesVatNote(product) {
    return (
      !isCjSalesProduct(product) &&
      SALES_INTERNAL_VAT_ACTIVE
    );
  }

  /*
   * Search and category requests must land at the beginning
   * of the Fast Liner product-results section.
   *
   * Pure Fast Liner page links remain unchanged.
   */
  const SALES_PRODUCTS_ANCHOR =
    '#salesProductsSection';

  const ACTIVE_HOME_URL =
    '/store?department=' +
    encodeURIComponent(
      ACTIVE_DEPARTMENT
    );

  const ACTIVE_SHOP_URL =
    '/store/shop?department=' +
    encodeURIComponent(
      ACTIVE_DEPARTMENT
    ) +
    '#shopProductsSection';

  const ACTIVE_BESTSELLER_URL =
    '/store/bestseller?department=' +
    encodeURIComponent(
      ACTIVE_DEPARTMENT
    ) +
    '#bestsellerProductsSection';

  const ACTIVE_FAST_LINER_URL =
    '/products/sales?department=' +
    encodeURIComponent(
      ACTIVE_DEPARTMENT
    );

  const ACTIVE_CART_URL =
    IS_CJ_DEPARTMENT
      ? '/cj/cart'
      : '/store/cart';

  const ACTIVE_CHECKOUT_URL =
    IS_CJ_DEPARTMENT
      ? '/cj/checkout'
      : '/payment/checkout';

  function salesProductPayload(product) {
    const source = String(
      product?.source || ''
    ).trim().toUpperCase();

    if (source === 'CJ') {
      return encodeURIComponent(
        JSON.stringify({
          source: 'CJ',

          cjProductId:
            product.cjProductId || '',

          cjVariantId:
            product.defaultCjVariantId || '',

          name:
            product.name || '',

          image:
            product.image ||
            product.imageUrl ||
            '',

          variants:
            Array.isArray(product.variants)
              ? product.variants
              : []
        })
      );
    }

    return encodeURIComponent(
      JSON.stringify({
        source: 'INTERNAL',

        customId:
          product.customId || '',

        name:
          product.name || '',

        image:
          product.image ||
          product.imageUrl ||
          '',

        sizes:
          Array.isArray(product.sizes)
            ? product.sizes
            : [],

        colors:
          Array.isArray(product.colors)
            ? product.colors
            : [],

        colorImages:
          Array.isArray(product.colorImages)
            ? product.colorImages
            : []
      })
    );
  }

  /*
   * Preserve the current search, category and page after the
   * customer changes display currency.
   */
  function salesPageUrlForDepartment(
    department,
    pageOverride
  ) {
    const safeDepartment =
      String(department || '')
        .trim()
        .toLowerCase() === 'cj'
        ? 'cj'
        : 'internal';

    const params = [];

    params.push(
      'department=' +
      encodeURIComponent(
        safeDepartment
      )
    );

    const keyword = String(
      typeof selectedQ !== 'undefined'
        ? selectedQ
        : ''
    ).trim();

    const category = String(
      typeof selectedCat !== 'undefined'
        ? selectedCat
        : ''
    ).trim();

    const pageNumber = Number(
      pageOverride !== undefined
        ? pageOverride
        : (
            typeof currentPage !== 'undefined'
              ? currentPage
              : 1
          )
    );

    if (keyword) {
      params.push(
        'q=' +
        encodeURIComponent(keyword)
      );
    }

    if (category) {
      params.push(
        'cat=' +
        encodeURIComponent(category)
      );
    }

    if (
      Number.isFinite(pageNumber) &&
      pageNumber > 1
    ) {
      params.push(
        'page=' +
        encodeURIComponent(
          pageNumber
        )
      );
    }

    const shouldLandOnProducts =
      Boolean(keyword) ||
      Boolean(category) ||
      (
        Number.isFinite(pageNumber) &&
        pageNumber > 1
      );

    return (
      '/products/sales?' +
      params.join('&') +
      (
        shouldLandOnProducts
          ? SALES_PRODUCTS_ANCHOR
          : ''
      )
    );
  }

  function salesPageUrl(
    pageOverride
  ) {
    return salesPageUrlForDepartment(
      ACTIVE_DEPARTMENT,
      pageOverride
    );
  }

  const SALES_CURRENCY_RETURN_TO =
    salesPageUrl();

  const INTERNAL_SALES_RETURN_TO =
    salesPageUrlForDepartment(
      'internal',
      1
    );

  const CJ_SALES_RETURN_TO =
    salesPageUrlForDepartment(
      'cj',
      1
    );
%>
<section class="sales-ministore py-3">
  <style nonce="<%= nonce %>">
    :root {
      --ms-accent: #72AEC8;
      --ms-dark: #212529;
      --ms-light: #f8f9fa;
      --ms-blue: #EDF1F3;
      --ms-gray: #AEAEAE;
      --ms-brand: #7C3AED;
    }

    .sales-ministore {
      background: var(--ms-light);
      position: relative;
      min-height: 60vh;

      /*
      * Break Fast Liner out of any parent Bootstrap container
      * so the entire page reaches both viewport edges.
      */
      width: 100vw;
      max-width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: calc(50% - 50vw);
      overflow-x: hidden;
    }

    .sales-toolbar {
      position: sticky;
      top: 0;
      z-index: 1020;
      background: rgba(248, 249, 250, .96);
      backdrop-filter: blur(8px);
    }

    .sales-search-card {
      border: 0;
      border-radius: 0;
      background: #fff;
      box-shadow: 0 6px 20px rgba(0, 0, 0, .05);
    }

    .sales-search-card .form-control,
    .sales-search-card .form-select {
      min-height: 44px;
      border-radius: 0;
      border: 1px solid #e9ecef;
      box-shadow: none;
    }

    .sales-search-card .btn {
      min-height: 44px;
      border-radius: 0;
      letter-spacing: .08em;
      text-transform: uppercase;
      background-color: var(--ms-brand) !important;
      border-color: var(--ms-brand) !important;
      color: #fff !important;
    }

    .sales-search-card .btn:hover,
    .sales-search-card .btn:focus,
    .sales-search-card .btn:active {
      background-color: var(--ms-brand) !important;
      border-color: var(--ms-brand) !important;
      color: #fff !important;
    }

    .sales-department-switch {
      color: #fff !important;
      transition:
        transform .2s ease,
        box-shadow .2s ease,
        background-color .2s ease,
        border-color .2s ease;
    }

    .sales-department-switch--internal {
      background-color: #7C3AED !important;
      border-color: #7C3AED !important;
    }

    .sales-department-switch--internal:hover,
    .sales-department-switch--internal:focus,
    .sales-department-switch--internal:active {
      background-color: #6D28D9 !important;
      border-color: #6D28D9 !important;
      color: #fff !important;
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(124, 58, 237, .28);
    }

    .sales-department-switch--cj {
      background-color: #22C55E !important;
      border-color: #22C55E !important;
    }

    .sales-department-switch--cj:hover,
    .sales-department-switch--cj:focus,
    .sales-department-switch--cj:active {
      background-color: #16A34A !important;
      border-color: #16A34A !important;
      color: #fff !important;
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(34, 197, 94, .28);
    }

    .sales-grid .product-card {
      background: #fff;
      border: 0;
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .sales-grid .product-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 24px rgba(0, 0, 0, .08);
    }

    .sales-grid .image-holder {
      background: var(--ms-blue);
      aspect-ratio: 1 / 1;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .sales-grid .image-holder img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 12px;
      display: block;
    }

    /*
    * MAIN FAST LINER PRODUCT CARDS
    *
    * Keep all information beneath the image compact.
    */
    .sales-grid .card-detail {
      padding: 7px 5px 6px !important;
      display: flex !important;
      text-align: left;
      min-width: 0;
    }

    .sales-grid h3.card-title {
      width: 100%;
      min-width: 0;
      min-height: 2.15em;
      margin: 0 0 3px !important;
      font-size: .86rem;
      font-weight: 700;
      line-height: 1.08;
      text-align: left;
      text-transform: none;
      overflow: hidden;
      overflow-wrap: anywhere;
      word-break: break-word;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }

    .sales-grid .card-title span {
      color: var(--ms-dark);
      font-weight: 700;
      text-decoration: none;
    }

    .sales-grid .item-price {
      display: block;
      width: 100%;
      margin: 0 !important;
      color: var(--ms-brand) !important;
      font-size: .92rem;
      font-weight: 700;
      line-height: 1.05;
      text-align: left;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .sales-product-vat {
      margin-top: 1px;
      margin-bottom: 3px !important;
      font-size: .66rem;
      line-height: 1;
    }

    .sales-product-rating {
      width: 100%;
      min-width: 0;
      min-height: 18px;
      margin-top: 0;
      font-size: .74rem;
      line-height: 1;
      overflow: hidden;
      white-space: nowrap;
    }

    .sales-grid .mt-auto.d-grid {
      margin-top: 4px !important;
    }

    .sales-empty {
      background: #fff;
      padding: 3rem 1rem;
      text-align: center;
      box-shadow: 0 6px 20px rgba(0, 0, 0, .05);
    }

    .sales-pager .btn {
      min-width: 120px;
      border-radius: 0;
      text-transform: uppercase;
      letter-spacing: .08em;
      background-color: var(--ms-brand) !important;
      border-color: var(--ms-brand) !important;
      color: #fff !important;
    }

    .sales-pager .btn:hover,
    .sales-pager .btn:focus,
    .sales-pager .btn:active {
      background-color: var(--ms-brand) !important;
      border-color: var(--ms-brand) !important;
      color: #fff !important;
    }

    .related-products-wrap {
      margin-top: 2rem;
    }

    .related-products-title {
      font-size: 2rem;
      font-weight: 700;
      text-transform: uppercase;
      margin: 0 0 1rem;
      text-align: center;
      color: var(--ms-brand);
    }

    .related-grid .product-card {
      background: #fff;
      border: 0;
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .related-grid .product-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 24px rgba(0, 0, 0, .08);
    }

    .related-grid .image-holder {
      background: var(--ms-blue);
      aspect-ratio: 1 / 1;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .related-grid .image-holder img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 8px;
      display: block;
    }

    /*
    * RELATED PRODUCTS
    *
    * Use the same compact marketplace-style information area.
    */
    .related-grid .card-detail,
    .related-product-detail {
      width: 100%;
      min-width: 0;
      padding: 7px 5px 5px !important;
      display: block !important;
      text-align: left;
    }

    .related-grid h3.card-title,
    .related-product-name {
      width: 100%;
      min-width: 0;
      min-height: 2.15em;
      margin: 0 0 3px !important;
      font-size: .84rem;
      font-weight: 700;
      line-height: 1.08;
      text-align: left;
      text-transform: none;
      overflow: hidden;
      overflow-wrap: anywhere;
      word-break: break-word;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }

    .related-grid .card-title span {
      color: var(--ms-dark);
      text-decoration: none;
    }

    .related-grid .item-price,
    .related-product-price {
      display: block;
      width: 100%;
      margin: 0 !important;
      color: var(--ms-brand) !important;
      font-size: .9rem;
      font-weight: 700;
      line-height: 1.05;
      text-align: left;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .sales-desktop-layout {
      width: 100%;
    }

    .sales-main-column {
      min-width: 0;
    }

    .sales-rated-sidebar {
      position: sticky;
      top: 82px;
      max-height: calc(100vh - 100px);
      overflow-y: auto;
      scrollbar-width: thin;
    }

    .sales-rated-sidebar-card {
      background: #fff;
      border: 0;
      box-shadow: 0 6px 20px rgba(0, 0, 0, .05);
    }

    /*
    * MOST RATED PRODUCTS SIDEBAR
    *
    * Keep the complete sidebar item shallow and compact.
    */
    .sales-rated-product {
      width: 100%;
      min-width: 0;
      background: #fff;
      transition:
        transform .2s ease,
        box-shadow .2s ease;
    }

    .sales-rated-product:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 18px rgba(0, 0, 0, .08);
    }

    .sales-rated-product-image {
      width: 70px;
      height: 70px;
      flex: 0 0 70px;
      background: var(--ms-blue);
      overflow: hidden;
    }

    .sales-rated-product-image img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 4px;
    }

    .sales-rated-rank {
      padding: 2px 5px;
      font-size: .65rem;
      line-height: 1;
    }

    .sales-rated-count {
      font-size: .64rem;
      line-height: 1;
    }

    .sales-rated-name {
      width: 100%;
      min-width: 0;
      max-height: 2.15em;
      font-size: .75rem;
      line-height: 1.05;
      overflow: hidden;
      overflow-wrap: anywhere;
      word-break: break-word;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }

    .sales-rated-stars {
      width: 100%;
      min-width: 0;
      font-size: .68rem;
      line-height: 1;
      white-space: nowrap;
    }

    .sales-rated-price {
      font-size: .8rem;
      line-height: 1.05;
    }

    @media (min-width: 1200px) {
      .sales-ministore>.container-fluid {
        width: 100%;
        max-width: none;
        margin-left: 0;
        margin-right: 0;
        padding-left: 0 !important;
        padding-right: 0 !important;
      }

      .sales-grid .col-xl-4 {
        flex: 0 0 auto;
        width: 33.333333%;
      }
    }

    /* Smart page loader */
    .sales-page-loader {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(248, 249, 250, 0.92);
      backdrop-filter: blur(8px);
      opacity: 1;
      visibility: visible;
      transition: opacity .45s ease, visibility .45s ease;
    }

    .sales-page-loader.is-hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .sales-page-loader__box {
      width: 96px;
      height: 96px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, .92);
      border: 1px solid rgba(124, 58, 237, 0.08);
      border-radius: 50%;
      box-shadow: 0 16px 40px rgba(0, 0, 0, .10);
    }

    .sales-page-loader__spinner {
      width: 56px;
      height: 56px;
      border: 4px solid rgba(124, 58, 237, 0.14);
      border-top-color: var(--ms-brand);
      border-right-color: #9f67ff;
      border-radius: 50%;
      animation: salesSpin .75s linear infinite;
    }

    .sales-loading {
      overflow: hidden;
    }

    @keyframes salesSpin {
      to {
        transform: rotate(360deg);
      }
    }

    @media (max-width: 575.98px) {
      .sales-toolbar {
        padding-left: 0;
        padding-right: 0;
      }

      .sales-grid {
        margin-left: 0 !important;
        margin-right: 0 !important;
      }

      .sales-grid .col-6 {
        padding-left: 0;
        padding-right: 0;
      }

      .sales-grid .image-holder img {
        padding: 8px;
      }

      /*
      * MAIN AND RELATED PRODUCT CARDS — MOBILE
      */
      .sales-grid .card-detail,
      .related-grid .card-detail,
      .related-product-detail {
