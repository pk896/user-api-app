<!-- views/admin/cj-shop-sidebar-banner/edit.ejs -->
<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-9">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4">
          <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
              <h1 class="h3 mb-1 text-primary">
                Edit CJ Shop Sidebar Banner
              </h1>

              <p class="text-muted mb-0">
                Select an active imported CJ product and configure the separate CJ Shop sidebar banner.
              </p>
            </div>

            <a
              href="/admin/cj-shop-sidebar-banner"
              class="btn btn-outline-secondary"
            >
              Back
            </a>
          </div>

          <% if (error && error.length) { %>
          <div class="alert alert-danger">
            <%= error[0] %>
          </div>
          <% } %>

          <% if (success && success.length) { %>
          <div class="alert alert-success">
            <%= success[0] %>
          </div>
          <% } %>

          <% if (info && info.length) { %>
          <div class="alert alert-info">
            <%= info[0] %>
          </div>
          <% } %>

          <% if (warning && warning.length) { %>
          <div class="alert alert-warning">
            <%= warning[0] %>
          </div>
          <% } %>

          <div class="alert alert-info border">
            <div class="d-flex align-items-start gap-2">
              <i class="fas fa-info-circle text-primary mt-1"></i>

              <div>
                <div class="fw-semibold text-primary">
                  CJ Store only
                </div>

                <div class="small">
                  This form searches only active imported CJ products with valid enabled variants. It does not search or change Internal Kasyora products.
                </div>
              </div>
            </div>
          </div>

          <form
            action="/admin/cj-shop-sidebar-banner"
            method="POST"
            enctype="multipart/form-data"
            class="row g-3"
          >
            <div class="col-12">
              <label
                for="cjProductSearch"
                class="form-label fw-semibold text-primary"
              >
                Choose CJ Product
              </label>

              <input
                type="hidden"
                name="cjProductId"
                id="cjProductId"
                value="<%= banner && banner.cjProductId ? banner.cjProductId : '' %>"
                required
              >

              <div class="position-relative">
                <input
                  type="text"
                  id="cjProductSearch"
                  class="form-control border-primary"
                  placeholder="Search by CJ product ID, SKU, variant SKU or product name"
                  autocomplete="off"
                  value="<%= selectedProduct
                    ? `${selectedProduct.name} — ${selectedProduct.cjProductId}`
                    : '' %>"
                  required
                >

                <div
                  id="cjProductSearchResults"
                  class="list-group position-absolute top-100 start-0 end-0 shadow-sm d-none"
                  style="z-index: 1050; max-height: 360px; overflow-y: auto;"
                ></div>
              </div>

              <div class="form-text text-primary mt-2">
                Start typing a CJ product ID, SKU, variant SKU or product name, then click the correct result.
              </div>

              <div
                id="selectedCjProductBox"
                class="mt-3 <%= selectedProduct ? '' : 'd-none' %>"
              >
                <div class="card border-primary shadow-sm">
                  <div class="card-body py-2 px-3">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                      <div>
                        <div
                          class="fw-semibold text-primary"
                          id="selectedCjProductName"
                        >
                          <%= selectedProduct ? selectedProduct.name : '' %>
                        </div>

                        <div
                          class="small text-body-secondary text-break"
                          id="selectedCjProductMeta"
                        >
                          <%= selectedProduct
                            ? `CJ Product ID: ${selectedProduct.cjProductId}`
                            : '' %>
                        </div>
                      </div>

                      <button
                        type="button"
                        id="clearSelectedCjProduct"
                        class="btn btn-sm btn-outline-secondary"
                      >
                        Clear
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-md-6">
              <label
                for="title"
                class="form-label"
              >
                Title
              </label>

              <input
                type="text"
                name="title"
                id="title"
                class="form-control"
                maxlength="80"
                value="<%= banner && banner.title ? banner.title : 'SALE' %>"
                placeholder="SALE"
              >

              <div class="form-text">
                Maximum 80 characters.
              </div>
            </div>

            <div class="col-md-6">
              <label
                for="subtitle"
                class="form-label"
              >
                Subtitle
              </label>

              <input
                type="text"
                name="subtitle"
                id="subtitle"
                class="form-control"
                maxlength="160"
                value="<%= banner && banner.subtitle
                  ? banner.subtitle
                  : 'Get UP To 50% Off' %>"
                placeholder="Get UP To 50% Off"
              >

              <div class="form-text">
                Maximum 160 characters.
              </div>
            </div>

            <div class="col-md-6">
              <label
                for="buttonText"
                class="form-label"
              >
                Button Text
              </label>

              <input
                type="text"
                name="buttonText"
                id="buttonText"
                class="form-control"
                maxlength="40"
                value="<%= banner && banner.buttonText
                  ? banner.buttonText
                  : 'Shop Now' %>"
                placeholder="Shop Now"
              >

              <div class="form-text">
                Maximum 40 characters.
              </div>
            </div>

            <div class="col-md-6">
              <div class="form-check mt-md-4 pt-md-2">
                <input
                  class="form-check-input"
                  type="checkbox"
                  name="active"
                  id="active"
                  <%= !banner || banner.active !== false ? 'checked' : '' %>
                >

                <label
                  class="form-check-label"
                  for="active"
                >
                  Active
                </label>
              </div>

              <div class="form-text">
                When inactive, the CJ banner will not be shown on the storefront.
              </div>
            </div>

            <div class="col-12">
              <label
                for="imageFile"
                class="form-label"
              >
                CJ Banner Image
              </label>

              <input
                type="file"
                name="imageFile"
                id="imageFile"
                accept="image/png,image/jpeg,image/webp,image/gif,image/bmp"
                class="form-control"
                <%= !banner || !banner.image ? 'required' : '' %>
              >

              <div class="form-text">
                Upload a separate CJ sidebar banner image. Maximum file size: 8 MB.
              </div>
            </div>

            <% if (banner && banner.image) { %>
            <div class="col-12">
              <div class="border rounded p-3 bg-light">
                <div class="small text-muted mb-2">
                  Current CJ Banner Image
                </div>

                <img
                  src="<%= banner.image %>"
                  alt="Current CJ Shop sidebar banner image"
                  class="img-fluid rounded border"
                  style="max-height: 220px; object-fit: cover;"
                >
              </div>
            </div>
            <% } %>

            <div
              class="col-12 <%= selectedProduct ? '' : 'd-none' %>"
              id="selectedCjProductPreviewWrap"
            >
              <div class="border rounded p-3 bg-light">
                <div class="row g-3 align-items-center">
                  <div class="col-12 col-md-3">
                    <% if (selectedProduct && selectedProduct.imageUrl) { %>
                    <img
                      src="<%= selectedProduct.imageUrl %>"
                      alt="<%= selectedProduct.name %>"
                      class="img-fluid rounded border w-100"
                      style="height: 140px; object-fit: contain;"
                      id="selectedCjProductPreviewImage"
                    >

                    <div
                      class="border rounded bg-white d-none align-items-center justify-content-center text-muted"
                      style="height: 140px;"
                      id="selectedCjProductPreviewPlaceholder"
                    >
                      No CJ product image
                    </div>
                    <% } else { %>
                    <div
                      class="border rounded bg-white d-flex align-items-center justify-content-center text-muted"
                      style="height: 140px;"
                      id="selectedCjProductPreviewPlaceholder"
                    >
                      No CJ product image
                    </div>

                    <img
                      src=""
                      alt=""
                      class="img-fluid rounded border w-100 d-none"
                      style="height: 140px; object-fit: contain;"
                      id="selectedCjProductPreviewImage"
                    >
                    <% } %>
                  </div>

                  <div class="col-12 col-md-9">
                    <div class="mb-2">
                      <strong class="text-primary">
                        Current CJ Product:
                      </strong>

                      <span id="selectedCjPreviewName">
                        <%= selectedProduct ? selectedProduct.name : '' %>
                      </span>
                    </div>

                    <div class="mb-2">
                      <strong>
                        CJ Product ID:
                      </strong>

                      <span
                        id="selectedCjPreviewProductId"
                        class="text-break"
                      >
                        <%= selectedProduct ? selectedProduct.cjProductId : '' %>
                      </span>
                    </div>

                    <div class="mb-2">
                      <strong>
                        Product SKU:
                      </strong>

                      <span
                        id="selectedCjPreviewSku"
                        class="text-break"
                      >
                        <%= selectedProduct && selectedProduct.productSku
                          ? selectedProduct.productSku
                          : '—' %>
                      </span>
                    </div>

                    <div class="mb-2">
                      <strong>
                        Category:
                      </strong>

                      <span id="selectedCjPreviewCategory">
                        <%= selectedProduct && selectedProduct.category
                          ? selectedProduct.category
                          : 'CJ Product' %>
                      </span>
                    </div>

                    <div class="mb-2">
                      <strong>
                        Selling price excluding VAT:
                      </strong>

                      <span id="selectedCjPreviewPrice">
                        <%= selectedProduct
                          ? Number(selectedProduct.price || 0).toFixed(2)
                          : '0.00' %>
                      </span>
                    </div>

                    <div class="mb-0">
                      <strong>
                        Enabled variants:
                      </strong>

                      <span id="selectedCjPreviewVariantCount">
                        <%= selectedProduct
                          ? Number(selectedProduct.enabledVariantCount || 0)
                          : 0 %>
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-12">
              <div class="d-flex flex-wrap gap-2">
                <button
                  type="submit"
                  class="btn btn-primary"
                >
                  <i class="fas fa-save me-2"></i>
                  Save CJ Shop Sidebar Banner
                </button>

                <% if (banner) { %>
                <a
                  href="/admin/cj-shop-sidebar-banner/toggle"
                  class="btn btn-outline-secondary"
                >
                  <i class="fas <%= banner.active ? 'fa-eye-slash' : 'fa-eye' %> me-2"></i>

                  <%= banner.active ? 'Deactivate' : 'Activate' %>
                </a>
                <% } %>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%
  scripts = `
  <script nonce="${nonce}">
    document.addEventListener('DOMContentLoaded', function () {
      const searchInput =
        document.getElementById(
          'cjProductSearch'
        );

      const hiddenInput =
        document.getElementById(
          'cjProductId'
        );

      const resultsBox =
        document.getElementById(
          'cjProductSearchResults'
        );

      const selectedProductBox =
        document.getElementById(
          'selectedCjProductBox'
        );

      const selectedProductName =
        document.getElementById(
          'selectedCjProductName'
        );

      const selectedProductMeta =
        document.getElementById(
          'selectedCjProductMeta'
        );

      const clearSelectedProductButton =
        document.getElementById(
          'clearSelectedCjProduct'
        );

      const previewWrap =
        document.getElementById(
          'selectedCjProductPreviewWrap'
        );

      const previewImage =
        document.getElementById(
          'selectedCjProductPreviewImage'
        );

      const previewPlaceholder =
        document.getElementById(
          'selectedCjProductPreviewPlaceholder'
        );

      const previewName =
        document.getElementById(
          'selectedCjPreviewName'
        );

      const previewProductId =
        document.getElementById(
          'selectedCjPreviewProductId'
        );

      const previewSku =
        document.getElementById(
          'selectedCjPreviewSku'
        );

      const previewCategory =
        document.getElementById(
          'selectedCjPreviewCategory'
        );

      const previewPrice =
        document.getElementById(
          'selectedCjPreviewPrice'
        );

      const previewVariantCount =
        document.getElementById(
          'selectedCjPreviewVariantCount'
        );

      let debounceTimer =
        null;

      function escapeHtml(value) {
        return String(value || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      function hideResults() {
        if (!resultsBox) {
          return;
        }

        resultsBox.classList.add(
          'd-none'
        );

        resultsBox.innerHTML =
          '';
      }

      function showPreview(product) {
        if (!previewWrap) {
          return;
        }

        previewWrap.classList.remove(
          'd-none'
        );

        if (previewName) {
          previewName.textContent =
            product.name ||
            '';
        }

        if (previewProductId) {
          previewProductId.textContent =
            product.cjProductId ||
            '';
        }

        if (previewSku) {
          previewSku.textContent =
            product.productSku ||
            '—';
        }

        if (previewCategory) {
          previewCategory.textContent =
            product.category ||
            'CJ Product';
        }

        if (previewPrice) {
          const price =
            Number(
              product.price ||
              0
            );

          previewPrice.textContent =
            Number.isFinite(price)
              ? price.toFixed(2)
              : '0.00';
        }

        if (previewVariantCount) {
          const variantCount =
            Number(
              product.enabledVariantCount ||
              0
            );

          previewVariantCount.textContent =
            Number.isFinite(variantCount)
              ? String(
                  Math.max(
                    0,
                    Math.floor(
                      variantCount
                    )
                  )
                )
              : '0';
        }

        if (previewImage) {
          if (product.imageUrl) {
            previewImage.src =
              product.imageUrl;

            previewImage.alt =
              product.name ||
              'Selected CJ product';

            previewImage.classList.remove(
              'd-none'
            );

            if (previewPlaceholder) {
              previewPlaceholder.classList.add(
                'd-none'
              );

              previewPlaceholder.classList.remove(
                'd-flex'
              );
            }
          } else {
            previewImage.src =
              '';

            previewImage.alt =
              '';

            previewImage.classList.add(
              'd-none'
            );

            if (previewPlaceholder) {
              previewPlaceholder.classList.remove(
                'd-none'
              );

              previewPlaceholder.classList.add(
                'd-flex'
              );
            }
          }
        }
      }

      function hidePreview() {
        if (previewWrap) {
          previewWrap.classList.add(
            'd-none'
          );
        }

        if (previewName) {
          previewName.textContent =
            '';
        }

        if (previewProductId) {
          previewProductId.textContent =
            '';
        }

        if (previewSku) {
          previewSku.textContent =
            '—';
        }

        if (previewCategory) {
          previewCategory.textContent =
            'CJ Product';
        }

        if (previewPrice) {
          previewPrice.textContent =
            '0.00';
        }

        if (previewVariantCount) {
          previewVariantCount.textContent =
            '0';
        }

        if (previewImage) {
          previewImage.src =
            '';

          previewImage.alt =
            '';

          previewImage.classList.add(
            'd-none'
          );
        }

        if (previewPlaceholder) {
          previewPlaceholder.classList.remove(
            'd-none'
          );

          previewPlaceholder.classList.add(
            'd-flex'
          );
        }
      }

      function showSelectedProduct(product) {
        hiddenInput.value =
          product.cjProductId ||
          '';

        searchInput.value =
          (
            product.name ||
            'CJ Product'
          ) +
          ' — ' +
          (
            product.cjProductId ||
            ''
          );

        selectedProductName.textContent =
          product.name ||
          'CJ Product';

        selectedProductMeta.textContent =
          'CJ Product ID: ' +
          (
            product.cjProductId ||
            ''
          );

        selectedProductBox.classList.remove(
          'd-none'
        );

        showPreview(
          product
        );

        hideResults();
      }

      function clearSelectedProduct() {
        hiddenInput.value =
          '';

        searchInput.value =
          '';

        selectedProductName.textContent =
          '';

        selectedProductMeta.textContent =
          '';

        selectedProductBox.classList.add(
          'd-none'
        );

        hidePreview();
        hideResults();

        searchInput.focus();
      }

      async function searchProducts(query) {
        try {
          const response =
            await fetch(
              '/admin/cj-shop-sidebar-banner/products/search?q=' +
              encodeURIComponent(
                query
              ),
              {
                headers: {
                  'X-Requested-With':
                    'XMLHttpRequest'
                }
              }
            );

          const data =
            await response.json();

          if (
            !response.ok ||
            !data.success ||
            !Array.isArray(
              data.products
            )
          ) {
            hideResults();
            return;
          }

          if (
            data.products.length === 0
          ) {
            resultsBox.innerHTML =
              '<button type="button" class="list-group-item list-group-item-action disabled">' +
              'No matching active CJ products found' +
              '</button>';

            resultsBox.classList.remove(
              'd-none'
            );

            return;
          }

          resultsBox.innerHTML =
            data.products.map(
              function (product) {
                const price =
                  Number(
                    product.price ||
                    0
                  );

                const displayPrice =
                  Number.isFinite(price)
                    ? price.toFixed(2)
                    : '0.00';

                return \`
                  <button
                    type="button"
                    class="list-group-item list-group-item-action"
                    data-cj-product-id="\${escapeHtml(product.cjProductId)}"
                    data-product-sku="\${escapeHtml(product.productSku || '')}"
                    data-name="\${escapeHtml(product.name)}"
                    data-category="\${escapeHtml(product.category || 'CJ Product')}"
                    data-price="\${escapeHtml(displayPrice)}"
                    data-image-url="\${escapeHtml(product.imageUrl || '')}"
                    data-enabled-variant-count="\${escapeHtml(product.enabledVariantCount || 0)}"
                  >
                    <div class="d-flex justify-content-between align-items-start gap-3">
                      <div class="overflow-hidden">
                        <div class="fw-semibold text-primary text-truncate">
                          \${escapeHtml(product.name)}
                        </div>

                        <div class="small text-body-secondary text-break">
                          CJ Product ID: \${escapeHtml(product.cjProductId)}
                        </div>

                        <div class="small text-body-secondary text-break">
                          SKU: \${escapeHtml(product.productSku || '—')}
                        </div>

                        <div class="small text-body-secondary">
                          \${escapeHtml(product.category || 'CJ Product')}
                          ·
                          \${escapeHtml(product.enabledVariantCount || 0)}
                          enabled variant(s)
                        </div>
                      </div>

                      <span class="badge bg-success flex-shrink-0">
                        Active
                      </span>
                    </div>
                  </button>
                \`;
              }
            ).join('');

          resultsBox.classList.remove(
            'd-none'
          );
        } catch (error) {
          console.error(
            'CJ Shop sidebar banner product search failed:',
            error
          );

          hideResults();
        }
      }

      if (
        !searchInput ||
        !hiddenInput ||
        !resultsBox
      ) {
        return;
      }

      searchInput.addEventListener(
        'input',
        function () {
          const query =
            searchInput.value.trim();

          hiddenInput.value =
            '';

          selectedProductBox.classList.add(
            'd-none'
          );

          hidePreview();

          if (
            query.length < 1
          ) {
            hideResults();
            return;
          }

          window.clearTimeout(
            debounceTimer
          );

          debounceTimer =
            window.setTimeout(
              function () {
                searchProducts(
                  query
                );
              },
              250
            );
        }
      );

      resultsBox.addEventListener(
        'click',
        function (event) {
          const button =
            event.target.closest(
              'button[data-cj-product-id]'
            );

          if (!button) {
            return;
          }

          showSelectedProduct({
            cjProductId:
              button.getAttribute(
                'data-cj-product-id'
              ),

            productSku:
              button.getAttribute(
                'data-product-sku'
              ),

            name:
              button.getAttribute(
                'data-name'
              ),

            category:
              button.getAttribute(
                'data-category'
              ),

            price:
              button.getAttribute(
                'data-price'
              ),

            imageUrl:
              button.getAttribute(
                'data-image-url'
              ),

            enabledVariantCount:
              button.getAttribute(
                'data-enabled-variant-count'
              )
          });
        }
      );

      if (
        clearSelectedProductButton
      ) {
        clearSelectedProductButton.addEventListener(
          'click',
          clearSelectedProduct
        );
      }

      document.addEventListener(
        'click',
        function (event) {
          const insideSearch =
            event.target.closest(
              '#cjProductSearch'
            ) ||
            event.target.closest(
              '#cjProductSearchResults'
            );

          if (!insideSearch) {
            hideResults();
          }
        }
      );

      const form =
        searchInput.closest(
          'form'
        );

      if (form) {
        form.addEventListener(
          'submit',
          function (event) {
            if (
              !hiddenInput.value.trim()
            ) {
              event.preventDefault();

              searchInput.focus();

              window.alert(
                'Please search and select a valid CJ product first.'
              );
            }
          }
        );
      }
    });
  </script>
  `;
%>
