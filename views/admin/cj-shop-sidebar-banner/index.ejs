<!-- views/admin/cj-shop-sidebar-banner/index.ejs -->
<div class="container py-4">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <h1 class="h3 mb-1 text-primary">
        Manage CJ Shop Sidebar Banner
      </h1>

      <p class="text-muted mb-0">
        Manage the separate banner shown in the sidebar of the Kasyora CJ Store Shop page.
      </p>
    </div>

    <div class="d-flex flex-wrap gap-2">
      <a
        href="/admin/shop-sidebar-banner"
        class="btn btn-outline-secondary"
      >
        <i class="fas fa-warehouse me-2"></i>
        Internal Banner
      </a>

      <a
        href="/admin/dashboard"
        class="btn btn-outline-secondary"
      >
        Back
      </a>
    </div>
  </div>

  <div class="alert alert-info border shadow-sm">
    <div class="d-flex align-items-start gap-2">
      <i class="fas fa-info-circle text-primary mt-1"></i>

      <div>
        <div class="fw-semibold text-primary">
          Separate CJ Store configuration
        </div>

        <div class="small">
          This banner uses only imported CJ products and does not affect the Internal Kasyora Shop Sidebar Banner.
        </div>
      </div>
    </div>
  </div>

  <% if (success && success.length) { %>
  <div class="alert alert-success">
    <%= success[0] %>
  </div>
  <% } %>

  <% if (error && error.length) { %>
  <div class="alert alert-danger">
    <%= error[0] %>
  </div>
  <% } %>

  <% if (info && info.length) { %>
  <div class="alert alert-info">
    <%= info[0] %>
  </div>
  <% } %>

  <% if (warning && warning.length) { %>
  <div class="alert alert-warning">
    <%= warning[0] %>
  </div>
  <% } %>

  <div class="card shadow-sm border-0">
    <div class="card-body p-4">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-3">
        <div>
          <h2 class="h5 mb-1 text-primary">
            CJ Shop Sidebar Banner
          </h2>

          <p class="text-muted mb-0">
            One admin-managed banner linked only to a valid active CJ product.
          </p>
        </div>

        <div>
          <% if (banner) { %>
          <span class="badge <%= banner.active ? 'bg-success' : 'bg-secondary' %>">
            <%= banner.active ? 'Active' : 'Inactive' %>
          </span>
          <% } else { %>
          <span class="badge bg-warning text-dark">
            Not Configured
          </span>
          <% } %>
        </div>
      </div>

      <% if (banner) { %>
      <div class="border rounded p-3 bg-light mb-3">
        <div class="row g-4 align-items-center">
          <div class="col-12 col-md-4">
            <% if (banner.image) { %>
            <img
              src="<%= banner.image %>"
              alt="<%= banner.product && banner.product.name ? banner.product.name : 'CJ banner image' %>"
              class="img-fluid w-100 rounded border"
              style="max-height: 220px; object-fit: cover;"
            >
            <% } else { %>
            <div
              class="border rounded bg-white d-flex align-items-center justify-content-center text-muted"
              style="height: 180px;"
            >
              No banner image
            </div>
            <% } %>
          </div>

          <div class="col-12 col-md-8">
            <div class="mb-3">
              <strong class="text-primary">
                CJ Product:
              </strong>

              <div>
                <%= banner.product && banner.product.name
                    ? banner.product.name
                    : 'Linked CJ product is unavailable' %>
              </div>
            </div>

            <div class="mb-3">
              <strong class="text-primary">
                CJ Product ID:
              </strong>

              <div class="text-break">
                <%= banner.cjProductId || '—' %>
              </div>
            </div>

            <div class="mb-3">
              <strong class="text-primary">
                CJ Product SKU:
              </strong>

              <div class="text-break">
                <%= banner.product && banner.product.productSku
                    ? banner.product.productSku
                    : '—' %>
              </div>
            </div>

            <div class="mb-3">
              <strong class="text-primary">
                Category:
              </strong>

              <div>
                <%= banner.product && banner.product.category
                    ? banner.product.category
                    : '—' %>
              </div>
            </div>

            <div class="mb-3">
              <strong class="text-primary">
                Current selling price excluding VAT:
              </strong>

              <div>
                <% if (banner.product) { %>
                  <%= Number(banner.product.price || 0).toFixed(2) %>
                <% } else { %>
                  —
                <% } %>
              </div>
            </div>

            <hr>

            <div class="mb-2">
              <strong>Title:</strong>
              <%= banner.title || '—' %>
            </div>

            <div class="mb-2">
              <strong>Subtitle:</strong>
              <%= banner.subtitle || '—' %>
            </div>

            <div class="mb-0">
              <strong>Button:</strong>
              <%= banner.buttonText || 'Shop Now' %>
            </div>
          </div>
        </div>
      </div>

      <% if (!banner.product) { %>
      <div class="alert alert-warning border">
        <div class="fw-semibold">
          The configured CJ product is no longer storefront-ready.
        </div>

        <div class="small mt-1">
          It may be inactive or may no longer have an enabled variant with a valid selling price. Edit the banner and select another CJ product.
        </div>
      </div>
      <% } %>
      <% } else { %>
      <div class="alert alert-light border mb-3">
        No CJ Shop Sidebar Banner has been configured yet.
      </div>
      <% } %>

      <div class="d-flex flex-wrap gap-2">
        <a
          href="/admin/cj-shop-sidebar-banner/edit"
          class="btn btn-primary"
        >
          <i class="fas fa-edit me-2"></i>

          <%= banner ? 'Edit' : 'Set Up' %>
          CJ Shop Sidebar Banner
        </a>

        <% if (banner) { %>
        <a
          href="/admin/cj-shop-sidebar-banner/toggle"
          class="btn btn-outline-secondary"
        >
          <i class="fas <%= banner.active ? 'fa-eye-slash' : 'fa-eye' %> me-2"></i>

          <%= banner.active ? 'Deactivate' : 'Activate' %>
        </a>
        <% } %>
      </div>
    </div>
  </div>
</div>