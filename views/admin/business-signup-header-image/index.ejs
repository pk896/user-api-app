<!-- views/admin/business-signup-header-image/index.ejs -->
<div class="container py-4">
  <div
    class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4"
  >
    <div>
      <div class="small text-primary text-uppercase fw-semibold mb-1">
        Kasyora Business Network
      </div>

      <h1 class="h3 mb-1 text-primary">
        Business Signup Header Image
      </h1>

      <p class="text-muted mb-0">
        Manage the background image shown only on the Kasyora Business Signup page.
      </p>
    </div>

    <a
      href="/admin/dashboard"
      class="btn btn-outline-secondary"
    >
      Back
    </a>
  </div>

  <% if (success && success.length) { %>
    <div class="alert alert-success">
      <%= success[0] %>
    </div>
  <% } %>

  <% if (error && error.length) { %>
    <div class="alert alert-danger">
      <%= error[0] %>
    </div>
  <% } %>

  <div class="card shadow-sm border-0">
    <div class="card-body p-4">

      <div
        class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-start gap-3 mb-3"
      >
        <div>
          <h2 class="h5 text-primary mb-1">
            Signup Page Header
          </h2>

          <p class="text-muted mb-0">
            This image belongs only to the Business Signup page.
          </p>
        </div>

        <% if (headerImage) { %>
          <span
            class="badge <%= headerImage.active ? 'bg-success' : 'bg-secondary' %>"
          >
            <%= headerImage.active ? 'Active' : 'Inactive' %>
          </span>
        <% } else { %>
          <span class="badge bg-warning text-dark">
            Not Configured
          </span>
        <% } %>
      </div>

      <% if (headerImage && headerImage.image) { %>
        <div class="border rounded p-3 bg-light mb-3">
          <div class="small text-muted mb-2">
            Current Signup Header Image
          </div>

          <img
            src="<%= headerImage.image %>"
            alt="Current Business Signup Header Image"
            class="img-fluid rounded border"
          >
        </div>
      <% } else { %>
        <div class="alert alert-light border mb-3">
          No Business Signup Header Image has been configured yet.
        </div>
      <% } %>

      <div class="d-flex flex-wrap gap-2">
        <a
          href="/admin/business-signup-header-image/edit"
          class="btn btn-primary"
        >
          <%= headerImage ? 'Edit' : 'Set Up' %>
          Business Signup Header Image
        </a>

        <% if (headerImage) { %>
          <a
            href="/admin/business-signup-header-image/toggle"
            class="btn btn-outline-secondary"
          >
            <%= headerImage.active ? 'Deactivate' : 'Activate' %>
          </a>
        <% } %>
      </div>

    </div>
  </div>
</div>