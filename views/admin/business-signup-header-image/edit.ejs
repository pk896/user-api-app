<!-- views/admin/business-signup-header-image/edit.ejs -->
<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-9">

      <div class="card shadow-sm border-0">
        <div class="card-body p-4">

          <div
            class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4"
          >
            <div>
              <div class="small text-primary text-uppercase fw-semibold mb-1">
                Kasyora Business Network
              </div>

              <h1 class="h3 mb-0 text-primary">
                Edit Business Signup Header Image
              </h1>
            </div>

            <a
              href="/admin/business-signup-header-image"
              class="btn btn-outline-secondary"
            >
              Back
            </a>
          </div>

          <% if (success && success.length) { %>
            <div class="alert alert-success">
              <%= success[0] %>
            </div>
          <% } %>

          <% if (error && error.length) { %>
            <div class="alert alert-danger">
              <%= error[0] %>
            </div>
          <% } %>

          <form
            action="/admin/business-signup-header-image"
            method="POST"
            enctype="multipart/form-data"
            class="row g-3"
          >

            <div class="col-12">
              <div class="form-check">
                <input
                  class="form-check-input"
                  type="checkbox"
                  name="active"
                  id="active"
                  <%= !headerImage || headerImage.active !== false ? 'checked' : '' %>
                >

                <label
                  class="form-check-label fw-semibold"
                  for="active"
                >
                  Active
                </label>
              </div>

              <div class="form-text">
                When inactive, the Business Signup page will use its existing fallback image.
              </div>
            </div>

            <div class="col-12">
              <label
                for="imageFile"
                class="form-label fw-semibold text-primary"
              >
                Signup Header Image
              </label>

              <input
                type="file"
                name="imageFile"
                id="imageFile"
                accept="image/*"
                class="form-control"
                <%= !headerImage || !headerImage.image ? 'required' : '' %>
              >

              <div class="form-text">
                Upload the background image used only by the Kasyora Business Signup page.
                JPG, PNG, WEBP, GIF, or BMP.
              </div>
            </div>

            <% if (headerImage && headerImage.image) { %>
              <div class="col-12">
                <div class="border rounded p-3 bg-light">
                  <div class="small text-muted mb-2">
                    Current Signup Header Image
                  </div>

                  <img
                    src="<%= headerImage.image %>"
                    alt="Current Business Signup Header Image"
                    class="img-fluid rounded border"
                  >
                </div>
              </div>
            <% } %>

            <div class="col-12">
              <div class="d-flex flex-wrap gap-2">
                <button
                  type="submit"
                  class="btn btn-primary"
                >
                  Save Business Signup Header Image
                </button>

                <% if (headerImage) { %>
                  <a
                    href="/admin/business-signup-header-image/toggle"
                    class="btn btn-outline-secondary"
                  >
                    <%= headerImage.active ? 'Deactivate' : 'Activate' %>
                  </a>
                <% } %>
              </div>
            </div>

          </form>

        </div>
      </div>

    </div>
  </div>
</div>