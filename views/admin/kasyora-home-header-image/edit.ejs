<!-- views/admin/kasyora-home-header-image/edit.ejs -->

<div class="container py-4">

  <div class="row justify-content-center">

    <div class="col-12 col-lg-9">

      <div class="card shadow-sm border-0">

        <div class="card-body p-4">

          <div
            class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-4"
          >

            <div>

              <h1 class="h3 mb-1 text-primary">
                Edit Kasyora Home Header Image
              </h1>

              <p class="text-muted mb-0">
                Upload the background image used only
                by the Kasyora Home page hero.
              </p>

            </div>


            <a
              href="/admin/kasyora-home-header-image"
              class="btn btn-outline-secondary"
            >
              Back
            </a>

          </div>


          <% if (error && error.length) { %>

            <div
              class="alert alert-danger"
              role="alert"
            >
              <%= error[0] %>
            </div>

          <% } %>


          <form
            action="/admin/kasyora-home-header-image"
            method="POST"
            enctype="multipart/form-data"
            class="row g-4"
          >

            <div class="col-12">

              <label
                for="imageFile"
                class="form-label fw-semibold"
              >
                Home Header Image
              </label>

              <input
                type="file"
                id="imageFile"
                name="imageFile"
                accept="image/png,image/jpeg,image/webp,image/gif,image/bmp"
                class="form-control"
                <%= !headerImage || !headerImage.image ? 'required' : '' %>
              >

              <div class="form-text">
                Upload a PNG, JPG, WEBP, GIF or BMP image.
                Maximum file size: 8 MB.
              </div>

            </div>


            <div class="col-12">

              <div class="form-check">

                <input
                  class="form-check-input"
                  type="checkbox"
                  name="active"
                  id="active"
                  <%= !headerImage || headerImage.active !== false ? 'checked' : '' %>
                >

                <label
                  class="form-check-label fw-semibold"
                  for="active"
                >
                  Active
                </label>

              </div>

              <div class="form-text">
                When inactive, the Home page will use
                its built-in fallback background instead.
              </div>

            </div>


            <% if (headerImage && headerImage.image) { %>

              <div class="col-12">

                <div
                  class="border rounded p-3 bg-light"
                >

                  <div class="small text-muted mb-2">
                    Current Home Header Image
                  </div>

                  <img
                    src="<%= headerImage.image %>"
                    alt="Current Kasyora Home header image"
                    class="img-fluid rounded border w-100"
                    style="max-height: 360px; object-fit: cover;"
                  >

                </div>

              </div>

            <% } %>


            <div class="col-12">

              <button
                type="submit"
                class="btn btn-primary"
              >
                <i
                  class="fas fa-save me-2"
                  aria-hidden="true"
                ></i>

                Save Home Header Image
              </button>


              <% if (headerImage) { %>

                <a
                  href="/admin/kasyora-home-header-image/toggle"
                  class="btn btn-outline-secondary ms-2"
                >
                  <%= headerImage.active ? 'Deactivate' : 'Activate' %>
                </a>

              <% } %>

            </div>

          </form>

        </div>

      </div>

    </div>

  </div>

</div>