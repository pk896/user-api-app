<!--views/admin/cj-shop-main-banner/index.ejs-->
<div class="container py-4">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <div class="small text-success text-uppercase fw-semibold mb-1">
        Kasyora CJ Store
      </div>

      <h1 class="h3 mb-1 text-primary">
        Manage CJ Shop Main Banner
      </h1>

      <p class="text-body-secondary mb-0">
        Manage the separate banner displayed above the CJ Shop product grid.
      </p>
    </div>

    <div class="d-flex flex-wrap gap-2">
      <a
        href="/admin/shop-main-banner"
        class="btn btn-outline-primary"
      >
        Internal Shop Main Banner
      </a>

      <a
        href="/admin/dashboard"
        class="btn btn-outline-secondary"
      >
        Back
      </a>
    </div>
  </div>

  <% if (success && success.length) { %>
  <div class="alert alert-success">
    <%= success[0] %>
  </div>
  <% } %>

  <% if (error && error.length) { %>
  <div class="alert alert-danger">
    <%= error[0] %>
  </div>
  <% } %>

  <div class="card shadow-sm border-0">
    <div class="card-body p-4">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-3">
        <div>
          <div class="small text-success text-uppercase fw-semibold mb-1">
            CJ Store
          </div>

          <h2 class="h5 mb-1">
            CJ Shop Main Banner
          </h2>

          <p class="text-body-secondary mb-0">
            This banner is independent from the Kasyora Internal Store banner.
          </p>
        </div>

        <% if (banner) { %>
          <span class="badge <%= banner.active ? 'bg-success' : 'bg-secondary' %>">
            <%= banner.active ? 'Active' : 'Inactive' %>
          </span>
        <% } else { %>
          <span class="badge bg-warning text-dark">
            Not Configured
          </span>
        <% } %>
      </div>

      <% if (banner) { %>
        <div class="border rounded p-3 bg-light mb-3">
          <div class="row g-3 align-items-center">
            <div class="col-12 col-md-4">
              <% if (banner.image) { %>
                <img
                  src="<%= banner.image %>"
                  alt="<%= banner.product?.name || 'CJ Shop Main Banner' %>"
                  class="img-fluid rounded border w-100"
                  style="height: 200px; object-fit: cover;"
                >
              <% } else { %>
                <div
                  class="border rounded bg-white d-flex align-items-center justify-content-center text-muted"
                  style="height: 200px;"
                >
                  No banner image
                </div>
              <% } %>
            </div>

            <div class="col-12 col-md-8">
              <div class="mb-2">
                <strong>Product:</strong>
                <%= banner.product?.name || 'Linked CJ product unavailable' %>
              </div>

              <div class="mb-2">
                <strong>CJ Product ID:</strong>
                <%= banner.cjProductId || '—' %>
              </div>

              <div class="mb-2">
                <strong>SKU:</strong>
                <%= banner.product?.productSku || '—' %>
              </div>

              <div class="mb-2">
                <strong>Title:</strong>
                <%= banner.title || '—' %>
              </div>

              <div class="mb-2">
                <strong>Subtitle:</strong>
                <%= banner.subtitle || '—' %>
              </div>

              <div class="mb-0">
                <strong>Button:</strong>
                <%= banner.buttonText || 'Shop Now' %>
              </div>
            </div>
          </div>
        </div>
      <% } else { %>
        <div class="alert alert-light border mb-3">
          No CJ Shop Main Banner has been configured yet.
        </div>
      <% } %>

      <div class="d-flex flex-wrap gap-2">
        <a
          href="/admin/cj-shop-main-banner/edit"
          class="btn btn-primary"
        >
          <%= banner ? 'Edit' : 'Create' %>
          CJ Shop Main Banner
        </a>

        <% if (banner) { %>
          <a
            href="/admin/cj-shop-main-banner/toggle"
            class="btn <%= banner.active ? 'btn-outline-danger' : 'btn-outline-success' %>"
            onclick="return confirm('<%= banner.active
              ? 'Deactivate the CJ Shop Main Banner?'
              : 'Activate the CJ Shop Main Banner?'
            %>');"
          >
            <%= banner.active ? 'Deactivate' : 'Activate' %>
          </a>
        <% } %>
      </div>
    </div>
  </div>
</div>
