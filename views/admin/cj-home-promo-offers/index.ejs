<!-- views/admin/cj-home-promo-offers/index.ejs -->
<div class="container py-4">
  <div class="row g-4">
    <div class="col-12">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4">
          <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
              <div class="small text-success text-uppercase fw-semibold mb-1">
                Kasyora CJ Store
              </div>

              <h1 class="h3 mb-1 text-primary">
                CJ Homepage Promo Offers
              </h1>

              <p class="text-body-secondary mb-0">
                Manage the two separate CJ promo cards shown above the Our Products section.
              </p>
            </div>

            <div class="d-flex flex-wrap gap-2">
              <a
                href="/admin/cj-home-promo-offers/left/edit"
                class="btn btn-primary"
              >
                Edit Left CJ Card
              </a>

              <a
                href="/admin/cj-home-promo-offers/right/edit"
                class="btn btn-outline-primary"
              >
                Edit Right CJ Card
              </a>

              <a
                href="/admin/home-banners"
                class="btn btn-outline-secondary"
              >
                Back
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%
      const leftOffer =
        (offers || []).find(function (offer) {
          return offer.slot === 'left';
        });

      const rightOffer =
        (offers || []).find(function (offer) {
          return offer.slot === 'right';
        });
    %>

    <div class="col-12 col-lg-6">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
            <div>
              <div class="small text-success text-uppercase fw-semibold">
                CJ Store
              </div>

              <h2 class="h5 mb-0">
                Left Promo Card
              </h2>
            </div>

            <a
              href="/admin/cj-home-promo-offers/left/edit"
              class="btn btn-outline-primary btn-sm"
            >
              <%= leftOffer ? 'Edit' : 'Create' %>
            </a>
          </div>

          <% if (leftOffer && leftOffer.product) { %>
            <div class="alert <%= leftOffer.active ? 'alert-success' : 'alert-secondary' %> border py-2">
              <div class="d-flex justify-content-between align-items-center gap-2">
                <strong>
                  Saved CJ promo offer
                </strong>

                <% if (leftOffer.active) { %>
                  <span class="badge bg-success">
                    Active
                  </span>
                <% } else { %>
                  <span class="badge bg-secondary">
                    Inactive
                  </span>
                <% } %>
              </div>
            </div>

            <div class="row g-3 align-items-center">
              <div class="col-12 col-md-4">
                <% if (leftOffer.product.imageUrl) { %>
                  <img
                    src="<%= leftOffer.product.imageUrl %>"
                    alt="<%= leftOffer.product.name %>"
                    class="img-fluid rounded border w-100"
                    style="height: 180px; object-fit: contain;"
                  >
                <% } else { %>
                  <div
                    class="border rounded bg-light d-flex align-items-center justify-content-center text-muted"
                    style="height: 180px;"
                  >
                    No product image
                  </div>
                <% } %>
              </div>

              <div class="col-12 col-md-8">
                <div class="mb-2">
                  <strong>Product:</strong>
                  <%= leftOffer.product.name %>
                </div>

                <div class="mb-2">
                  <strong>CJ Product ID:</strong>
                  <%= leftOffer.cjProductId %>
                </div>

                <div class="mb-2">
                  <strong>SKU:</strong>
                  <%= leftOffer.product.productSku || '-' %>
                </div>

                <div class="mb-2">
                  <strong>Eyebrow Text:</strong>
                  <%= leftOffer.eyebrowText || '-' %>
                </div>

                <div class="mb-2">
                  <strong>Title Override:</strong>
                  <%= leftOffer.titleOverride || '-' %>
                </div>

                <div class="mb-2">
                  <strong>Discount Text:</strong>
                  <%= leftOffer.discountText || '-' %>
                </div>

                <div class="mb-2">
                  <strong>Sort Order:</strong>
                  <%= leftOffer.sortOrder %>
                </div>

                <% if (leftOffer.updatedAt) { %>
                  <div class="small text-body-secondary mb-3">
                    Last updated:
                    <%= new Date(leftOffer.updatedAt).toLocaleString() %>
                  </div>
                <% } %>

                <div class="d-flex flex-wrap gap-2">
                  <a
                    href="/admin/cj-home-promo-offers/left/edit"
                    class="btn btn-sm btn-primary"
                  >
                    Update Left Card
                  </a>

                  <a
                    href="/admin/cj-home-promo-offers/left/toggle"
                    class="btn btn-sm <%= leftOffer.active ? 'btn-outline-danger' : 'btn-outline-success' %>"
                    onclick="return confirm('<%= leftOffer.active
                      ? 'Deactivate the left CJ promo card?'
                      : 'Activate the left CJ promo card?'
                    %>');"
                  >
                    <%= leftOffer.active
                      ? 'Deactivate'
                      : 'Activate'
                    %>
                  </a>
                </div>
              </div>
            </div>
          <% } else if (leftOffer) { %>
            <div class="alert alert-warning border mb-0">
              The left CJ promo offer is saved, but its selected CJ product is no longer eligible or available.

              <div class="mt-3">
                <a
                  href="/admin/cj-home-promo-offers/left/edit"
                  class="btn btn-sm btn-primary"
                >
                  Fix Left Card
                </a>
              </div>
            </div>
          <% } else { %>
            <div class="alert alert-light border mb-0">
              <div class="fw-semibold mb-1">
                Left CJ promo card is not configured yet.
              </div>

              <div class="small mb-3">
                Select an imported CJ product and create the left promo card.
              </div>

              <a
                href="/admin/cj-home-promo-offers/left/edit"
                class="btn btn-sm btn-primary"
              >
                Create Left CJ Card
              </a>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-6">
      <div class="card shadow-sm border-0 h-100">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
            <div>
              <div class="small text-success text-uppercase fw-semibold">
                CJ Store
              </div>

              <h2 class="h5 mb-0">
                Right Promo Card
              </h2>
            </div>

            <a
              href="/admin/cj-home-promo-offers/right/edit"
              class="btn btn-outline-primary btn-sm"
            >
              <%= rightOffer ? 'Edit' : 'Create' %>
            </a>
          </div>

          <% if (rightOffer && rightOffer.product) { %>
            <div class="alert <%= rightOffer.active ? 'alert-success' : 'alert-secondary' %> border py-2">
              <div class="d-flex justify-content-between align-items-center gap-2">
                <strong>
                  Saved CJ promo offer
                </strong>

                <% if (rightOffer.active) { %>
                  <span class="badge bg-success">
                    Active
                  </span>
                <% } else { %>
                  <span class="badge bg-secondary">
                    Inactive
                  </span>
                <% } %>
              </div>
            </div>

            <div class="row g-3 align-items-center">
              <div class="col-12 col-md-4">
                <% if (rightOffer.product.imageUrl) { %>
                  <img
                    src="<%= rightOffer.product.imageUrl %>"
                    alt="<%= rightOffer.product.name %>"
                    class="img-fluid rounded border w-100"
                    style="height: 180px; object-fit: contain;"
                  >
                <% } else { %>
                  <div
                    class="border rounded bg-light d-flex align-items-center justify-content-center text-muted"
                    style="height: 180px;"
                  >
                    No product image
                  </div>
                <% } %>
              </div>

              <div class="col-12 col-md-8">
                <div class="mb-2">
                  <strong>Product:</strong>
                  <%= rightOffer.product.name %>
                </div>

                <div class="mb-2">
                  <strong>CJ Product ID:</strong>
                  <%= rightOffer.cjProductId %>
                </div>

                <div class="mb-2">
                  <strong>SKU:</strong>
                  <%= rightOffer.product.productSku || '-' %>
                </div>

                <div class="mb-2">
                  <strong>Eyebrow Text:</strong>
                  <%= rightOffer.eyebrowText || '-' %>
                </div>

                <div class="mb-2">
                  <strong>Title Override:</strong>
                  <%= rightOffer.titleOverride || '-' %>
                </div>

                <div class="mb-2">
                  <strong>Discount Text:</strong>
                  <%= rightOffer.discountText || '-' %>
                </div>

                <div class="mb-2">
                  <strong>Sort Order:</strong>
                  <%= rightOffer.sortOrder %>
                </div>

                <% if (rightOffer.updatedAt) { %>
                  <div class="small text-body-secondary mb-3">
                    Last updated:
                    <%= new Date(rightOffer.updatedAt).toLocaleString() %>
                  </div>
                <% } %>

                <div class="d-flex flex-wrap gap-2">
                  <a
                    href="/admin/cj-home-promo-offers/right/edit"
                    class="btn btn-sm btn-primary"
                  >
                    Update Right Card
                  </a>

                  <a
                    href="/admin/cj-home-promo-offers/right/toggle"
                    class="btn btn-sm <%= rightOffer.active ? 'btn-outline-danger' : 'btn-outline-success' %>"
                    onclick="return confirm('<%= rightOffer.active
                      ? 'Deactivate the right CJ promo card?'
                      : 'Activate the right CJ promo card?'
                    %>');"
                  >
                    <%= rightOffer.active
                      ? 'Deactivate'
                      : 'Activate'
                    %>
                  </a>
                </div>
              </div>
            </div>
          <% } else if (rightOffer) { %>
            <div class="alert alert-warning border mb-0">
              The right CJ promo offer is saved, but its selected CJ product is no longer eligible or available.

              <div class="mt-3">
                <a
                  href="/admin/cj-home-promo-offers/right/edit"
                  class="btn btn-sm btn-primary"
                >
                  Fix Right Card
                </a>
              </div>
            </div>
          <% } else { %>
            <div class="alert alert-light border mb-0">
              <div class="fw-semibold mb-1">
                Right CJ promo card is not configured yet.
              </div>

              <div class="small mb-3">
                Select an imported CJ product and create the right promo card.
              </div>

              <a
                href="/admin/cj-home-promo-offers/right/edit"
                class="btn btn-sm btn-primary"
              >
                Create Right CJ Card
              </a>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
