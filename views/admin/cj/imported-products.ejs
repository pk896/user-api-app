<!--views/admin/cj/imported-products.ejs-->
<%
  const CURRENCY =
    String(baseCurrency || 'USD')
      .trim()
      .toUpperCase() || 'USD';

  function money(amount, currency = CURRENCY) {
    const value = Number(amount || 0);

    try {
      const formatted = new Intl.NumberFormat(undefined, {
        style: 'currency',
        currency,
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }).format(value);

      if (currency === 'ZAR') {
        return formatted.replace(/^ZAR\s?/, 'R');
      }

      return formatted;
    } catch {
      return currency + ' ' + value.toFixed(2);
    }
  }

  function badgeClass(status) {
    if (status === 'active') return 'bg-brand-green';
    if (status === 'paused') return 'bg-warning text-dark';
    if (status === 'archived') return 'bg-secondary';
    return 'bg-primary';
  }
%>

<section class="container-fluid px-0">
  <div class="bg-primary text-white px-3 px-lg-4 py-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
      <div>
        <div class="small text-uppercase fw-semibold opacity-75">
          CJ Dropshipping Department
        </div>

        <h1 class="h2 fw-bold mb-1">
          Imported CJ Products
        </h1>

        <p class="mb-0">
          Products stored only in Kasyora’s separate CJ collection.
        </p>
      </div>

      <div class="d-flex flex-wrap gap-2">
        <a href="/admin/cj" class="btn btn-light">
          API Health
        </a>

        <a href="/admin/cj/products" class="btn btn-brand-green">
          Browse CJ Catalogue
        </a>
      </div>
    </div>
  </div>

  <div class="p-3 p-lg-4">
    <div class="card border-primary shadow-sm mb-4">
      <div class="card-header bg-primary text-white">
        <h2 class="h5 mb-0">
          Filter Imported Products
        </h2>
      </div>

      <div class="card-body">
        <form method="GET" action="/admin/cj/products/imported" class="row g-3">
          <div class="col-12 col-lg-8">
            <label for="keyword" class="form-label fw-semibold text-primary">
              Name, product SKU, variant SKU, or CJ ID
            </label>

            <input id="keyword" name="keyword" class="form-control" value="<%= filters.keyword || '' %>">
          </div>

          <div class="col-12 col-lg-4">
            <label for="status" class="form-label fw-semibold text-primary">
              Status
            </label>

            <select id="status" name="status" class="form-select">
              <option value="">
                All statuses
              </option>

              <% ['draft', 'active', 'paused', 'archived'].forEach(function(status) { %>
              <option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>>
                <%= status %>
              </option>
              <% }) %>
            </select>
          </div>

          <div class="col-12">
            <div class="d-grid d-md-flex gap-2">
              <button class="btn btn-primary">
                Apply Filters
              </button>

              <a href="/admin/cj/products/imported" class="btn btn-outline-secondary">
                Clear
              </a>
            </div>
          </div>
        </form>
      </div>
    </div>

    <% if (!products.length) { %>
    <div class="card border-0 shadow-sm">
      <div class="card-body text-center py-5">
        <h2 class="h4 text-primary">
          No imported CJ products
        </h2>

        <p class="text-muted">
          Search the CJ catalogue and import your first product.
        </p>

        <a href="/admin/cj/products" class="btn btn-primary">
          Browse CJ Catalogue
        </a>
      </div>
    </div>
    <% } else { %>
    <div class="row g-4">
      <% products.forEach(function(product) { %>
      <div class="col-12">
        <div class="card border-primary shadow-sm">
          <div class="card-header bg-primary text-white">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2">
              <div>
                <h2 class="h5 mb-1">
                  <%= product.name %>
                </h2>

                <div class="small opacity-75">
                  <%= product.productSku %>
                </div>
              </div>

              <span class="badge <%= badgeClass(product.status) %>">
                <%= product.status %>
              </span>
            </div>
          </div>

          <div class="card-body">
            <div class="row g-4">
              <div class="col-12 col-md-3 col-xl-2">
                <div class="ratio ratio-1x1 bg-light border rounded">
                  <img src="<%= product.mainImageUrl %>" alt="<%= product.name %>" class="w-100 h-100 object-fit-contain p-2" loading="lazy">
                </div>
              </div>

              <div class="col-12 col-md-9 col-xl-10">
                <div class="row g-3 mb-3">
                  <div class="col-6 col-lg-3">
                    <div class="border rounded p-3 h-100">
                      <div class="small text-muted">
                        Enabled variants
                      </div>

                      <div class="h5 text-primary mb-0">
                        <%= product.variants.filter(function(variant) {
                              return variant.isEnabled;
                            }).length %>
                      </div>
                    </div>
                  </div>

                  <div class="col-6 col-lg-3">
                    <div class="border rounded p-3 h-100">
                      <div class="small text-muted">
                        Lowest selling price
                      </div>

                      <div class="h5 text-primary mb-0">
                        <%= money(
                              product.pricing.minimumSellingPriceExVat,
                              CURRENCY
                            ) %>
                      </div>
                    </div>
                  </div>

                  <div class="col-6 col-lg-3">
                    <div class="border rounded p-3 h-100">
                      <div class="small text-muted">
                        Highest selling price
                      </div>

                      <div class="h5 text-primary mb-0">
                        <%= money(
                              product.pricing.maximumSellingPriceExVat,
                              CURRENCY
                            ) %>
                      </div>
                    </div>
                  </div>

                  <div class="col-6 col-lg-3">
                    <div class="border rounded p-3 h-100">
                      <div class="small text-muted">
                        Last source sync
                      </div>

                      <div class="small fw-semibold text-primary">
                        <%= product.lastFullSyncAt
                              ? new Date(product.lastFullSyncAt).toLocaleString()
                              : 'Never' %>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mb-3">
                  <a href="/admin/cj/products/<%= encodeURIComponent(product.cjProductId) %>" class="btn btn-outline-primary">
                    Reopen CJ Product
                  </a>

                  <form method="POST" action="/admin/cj/products/imported/<%= product._id %>/status" class="d-flex gap-2">
                    <select name="status" class="form-select" aria-label="CJ product status">
                      <% ['draft', 'active', 'paused', 'archived'].forEach(function(status) { %>
                      <option value="<%= status %>" <%= product.status === status ? 'selected' : '' %>>
                        <%= status %>
                      </option>
                      <% }) %>
                    </select>

                    <button type="submit" class="btn btn-primary text-nowrap">
                      Save Status
                    </button>
                  </form>
                </div>

                <details class="border rounded">
                  <summary class="p-3 fw-semibold text-primary">
                    Manage variant prices
                  </summary>

                  <div class="p-3 border-top">
                    <form method="POST" action="/admin/cj/products/imported/<%= product._id %>/pricing">
                      <div class="table-responsive">
                        <table class="table table-sm align-middle">
                          <thead>
                            <tr>
                              <th>
                                Variant
                              </th>

                              <th>
                                Converted CJ cost
                              </th>

                              <th>
                                CJ selling price
                              </th>

                              <th>
                                Enabled
                              </th>
                            </tr>
                          </thead>

                          <tbody>
                            <% product.variants.forEach(function(variant) { %>
                            <tr>
                              <td>
                                <div class="fw-semibold">
                                  <%= variant.variantName || variant.variantKey || 'Variant' %>
                                </div>

                                <div class="small text-muted">
                                  <%= variant.variantSku %>
                                </div>
                              </td>

                              <td>
                                <%= money(
                                        variant.convertedSourceCost.value,
                                        variant.convertedSourceCost.currency
                                      ) %>
                              </td>

                              <td style="min-width: 200px;">
                                <input name="variantSellingPrice[<%= variant.cjVariantId %>]" type="number" min="<%= variant.convertedSourceCost.value %>" step="0.01" class="form-control" value="<%= Number(
                                          variant.sellingPriceExVat.value || 0
                                        ).toFixed(2) %>">
                              </td>

                              <td>
                                <% if (variant.isEnabled) { %>
                                <span class="badge bg-brand-green">
                                  Yes
                                </span>
                                <% } else { %>
                                <span class="badge bg-secondary">
                                  No
                                </span>
                                <% } %>
                              </td>
                            </tr>
                            <% }) %>
                          </tbody>
                        </table>
                      </div>

                      <div class="d-grid d-md-flex justify-content-md-end">
                        <button type="submit" class="btn btn-primary">
                          Update Selling Prices
                        </button>
                      </div>
                    </form>
                  </div>
                </details>
              </div>
            </div>
          </div>

          <div class="card-footer bg-white small text-muted">
            CJ product ID:
            <code><%= product.cjProductId %></code>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>