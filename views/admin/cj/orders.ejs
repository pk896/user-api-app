<!-- views/admin/cj/orders.ejs -->
<%
  const ORDERS = Array.isArray(orders) ? orders : [];
  const FILTERS = filters && typeof filters === 'object' ? filters : {};
  const PAGE = pagination && typeof pagination === 'object' ? pagination : {
    page: 1,
    totalPages: 1,
    total: 0
  };

  function moneyValue(money) {
    if (money && typeof money === 'object') {
      return Number(money.value || 0);
    }

    return Number(money || 0);
  }

  function moneyCurrency(money, fallback) {
    if (money && typeof money === 'object') {
      return String(money.currency || fallback || process.env.BASE_CURRENCY || 'USD').trim().toUpperCase();
    }

    return String(fallback || process.env.BASE_CURRENCY || 'USD').trim().toUpperCase();
  }

  function formatMoney(money, fallbackCurrency) {
    const value = moneyValue(money);
    const currency = moneyCurrency(money, fallbackCurrency);

    try {
      const formatted = new Intl.NumberFormat(undefined, {
        style: 'currency',
        currency,
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }).format(value);

      if (currency === 'ZAR') {
        return formatted.replace(/^ZAR\s?/, 'R');
      }

      return formatted;
    } catch (error) {
      return currency + ' ' + value.toFixed(2);
    }
  }

  function niceDate(value) {
    if (!value) return '';

    try {
      return new Date(value).toLocaleString('en-ZA', {
        timeZone: 'Africa/Johannesburg',
        year: 'numeric',
        month: 'short',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit'
      });
    } catch (error) {
      return String(value || '');
    }
  }

  function label(value) {
    return String(value || '')
      .replace(/_/g, ' ')
      .toLowerCase()
      .replace(/^\w/, function (letter) {
        return letter.toUpperCase();
      });
  }

  function paymentBadge(status) {
    const value = String(status || '').toUpperCase();

    if (value === 'COMPLETED') return 'bg-success';
    if (value === 'PENDING' || value === 'CREATED' || value === 'APPROVED') return 'bg-warning text-dark';
    if (value === 'FAILED' || value === 'DECLINED') return 'bg-danger';

    return 'bg-secondary';
  }

  function fulfillmentBadge(status) {
    const value = String(status || '').toUpperCase();

    if (value === 'CJ_ORDER_CREATED' || value === 'SHIPPED' || value === 'DELIVERED') return 'bg-success';
    if (value === 'CJ_ORDER_PENDING' || value === 'PROCESSING') return 'bg-warning text-dark';
    if (value === 'FAILED' || value === 'CANCELLED' || value === 'RETURNED') return 'bg-danger';

    return 'bg-secondary';
  }

  function supplierBadge(status) {
    const value = String(status || '').toUpperCase();

    if (value === 'SUCCESS') return 'bg-success';
    if (value === 'PENDING' || value === 'PROCESSING') return 'bg-warning text-dark';
    if (value === 'FAILED') return 'bg-danger';

    return 'bg-secondary';
  }

  function queryString(nextPage) {
    const params = new URLSearchParams();

    if (FILTERS.paymentStatus) params.set('paymentStatus', FILTERS.paymentStatus);
    if (FILTERS.fulfillmentStatus) params.set('fulfillmentStatus', FILTERS.fulfillmentStatus);
    if (FILTERS.supplierStatus) params.set('supplierStatus', FILTERS.supplierStatus);
    if (FILTERS.keyword) params.set('keyword', FILTERS.keyword);

    params.set('page', String(nextPage));

    return params.toString();
  }
%>

<div class="container-fluid px-0">
  <div class="bg-light border-bottom py-4">
    <div class="container-fluid px-3 px-md-4">
      <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
        <div>
          <span class="badge bg-success mb-2">
            CJ Dropshipping Department
          </span>

          <h1 class="text-primary mb-1">
            CJ Orders
          </h1>

          <p class="text-muted mb-0">
            Paid CJ orders are submitted to CJ only after PayPal payment is completed.
          </p>
        </div>

        <form method="POST" action="/admin/cj/orders/run-auto-create" class="d-flex align-items-start">
          <button type="submit" class="btn btn-primary rounded-pill px-4">
            <i class="fas fa-sync-alt me-2"></i>
            Run CJ Auto-create Now
          </button>
        </form>
      </div>
    </div>
  </div>

  <div class="container-fluid px-3 px-md-4 py-4">
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-primary text-white">
        <h2 class="h5 text-white mb-0">
          Filters
        </h2>
      </div>

      <div class="card-body">
        <form method="GET" action="/admin/cj/orders" class="row g-3">
          <div class="col-12 col-md-3">
            <label class="form-label fw-semibold" for="paymentStatus">
              Payment
            </label>

            <select id="paymentStatus" name="paymentStatus" class="form-select">
              <option value="">All</option>
              <% ['CREATED', 'APPROVED', 'PENDING', 'COMPLETED', 'DECLINED', 'CANCELLED', 'REFUNDED', 'PARTIALLY_REFUNDED', 'FAILED'].forEach(function(status) { %>
              <option value="<%= status %>" <%= FILTERS.paymentStatus === status ? 'selected' : '' %>>
                <%= label(status) %>
              </option>
              <% }) %>
            </select>
          </div>

          <div class="col-12 col-md-3">
            <label class="form-label fw-semibold" for="fulfillmentStatus">
              Fulfilment
            </label>

            <select id="fulfillmentStatus" name="fulfillmentStatus" class="form-select">
              <option value="">All</option>
              <% ['PENDING', 'CJ_ORDER_PENDING', 'CJ_ORDER_CREATED', 'PROCESSING', 'SHIPPED', 'IN_TRANSIT', 'OUT_FOR_DELIVERY', 'DELIVERED', 'CANCELLED', 'RETURNED', 'FAILED'].forEach(function(status) { %>
              <option value="<%= status %>" <%= FILTERS.fulfillmentStatus === status ? 'selected' : '' %>>
                <%= label(status) %>
              </option>
              <% }) %>
            </select>
          </div>

          <div class="col-12 col-md-3">
            <label class="form-label fw-semibold" for="supplierStatus">
              CJ supplier order
            </label>

            <select id="supplierStatus" name="supplierStatus" class="form-select">
              <option value="">All</option>
              <% ['NOT_CREATED', 'PENDING', 'PROCESSING', 'SUCCESS', 'FAILED'].forEach(function(status) { %>
              <option value="<%= status %>" <%= FILTERS.supplierStatus === status ? 'selected' : '' %>>
                <%= label(status) %>
              </option>
              <% }) %>
            </select>
          </div>

          <div class="col-12 col-md-3">
            <label class="form-label fw-semibold" for="keyword">
              Search
            </label>

            <input id="keyword" name="keyword" type="search" class="form-control" value="<%= FILTERS.keyword || '' %>" placeholder="Order, email, PayPal, CJ ID">
          </div>

          <div class="col-12 d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary rounded-pill px-4">
              Apply Filters
            </button>

            <a href="/admin/cj/orders" class="btn btn-outline-primary rounded-pill px-4">
              Reset
            </a>
          </div>
        </form>
      </div>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-header bg-primary text-white">
        <div class="d-flex flex-column flex-md-row justify-content-between gap-2">
          <h2 class="h5 text-white mb-0">
            Orders
          </h2>

          <div class="small">
            <%= Number(PAGE.total || 0) %> CJ order(s)
          </div>
        </div>
      </div>

      <div class="card-body p-0">
        <% if (!ORDERS.length) { %>
        <div class="p-5 text-center">
          <h3 class="text-primary">
            No CJ orders found
          </h3>

          <p class="text-muted mb-0">
            CJ orders will appear here after CJ checkout starts.
          </p>
        </div>
        <% } else { %>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Order</th>
                <th>Customer</th>
                <th>Payment</th>
                <th>Fulfilment</th>
                <th>CJ supplier order</th>
                <th>Total</th>
                <th>Created</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>

            <tbody>
              <% ORDERS.forEach(function(order) { %>
              <tr>
                <td>
                  <div class="fw-bold text-break">
                    <a href="/admin/cj/orders/<%= order._id %>" class="text-primary text-decoration-none">
                      <%= order.cjOrderNumber %>
                    </a>
                  </div>

                  <% if (order.paypal && order.paypal.captureId) { %>
                  <div class="small text-muted text-break">
                    PayPal capture:
                    <%= order.paypal.captureId %>
                  </div>
                  <% } %>
                </td>

                <td>
                  <div class="text-break">
                    <%= order.customerEmail || 'Not available' %>
                  </div>

                  <div class="small text-muted">
                    <%= Number(order.itemCount || 0) %>
                    item<%= Number(order.itemCount || 0) === 1 ? '' : 's' %>
                  </div>
                </td>

                <td>
                  <span class="badge <%= paymentBadge(order.paymentStatus) %>">
                    <%= label(order.paymentStatus) %>
                  </span>

                  <% if (order.paypal && order.paypal.captureStatus) { %>
                  <div class="small text-muted mt-1">
                    Capture:
                    <%= label(order.paypal.captureStatus) %>
                  </div>
                  <% } %>
                </td>

                <td>
                  <span class="badge <%= fulfillmentBadge(order.fulfillmentStatus) %>">
                    <%= label(order.fulfillmentStatus) %>
                  </span>
                </td>

                <td>
                  <span class="badge <%= supplierBadge(order.supplierOrder && order.supplierOrder.createStatus) %>">
                    <%= label((order.supplierOrder && order.supplierOrder.createStatus) || 'NOT_CREATED') %>
                  </span>

                  <% if (order.supplierOrder && (order.supplierOrder.cjOrderId || order.supplierOrder.cjOrderNumber)) { %>
                  <div class="small text-muted mt-1 text-break">
                    CJ:
                    <%= order.supplierOrder.cjOrderNumber || order.supplierOrder.cjOrderId %>
                  </div>
                  <% } %>

                  <% if (order.supplierOrder && order.supplierOrder.trackingNumber) { %>
                  <div class="small text-muted mt-1 text-break">
                    Tracking:
                    <%= order.supplierOrder.trackingNumber %>
                  </div>
                  <% } %>

                  <% if (order.supplierOrder && order.supplierOrder.lastErrorMessage) { %>
                  <div class="small text-danger mt-1 text-break">
                    <%= order.supplierOrder.lastErrorMessage %>
                  </div>
                  <% } %>
                </td>

                <td class="fw-semibold">
                  <%= formatMoney(order.payableTotal, order.currency) %>
                </td>

                <td>
                  <%= niceDate(order.createdAt) %>
                </td>

                <td class="text-end">
                  <% if (
                        order.paymentStatus === 'COMPLETED' &&
                        order.status === 'PAID' &&
                        order.fulfillmentStatus === 'CJ_ORDER_PENDING' &&
                        order.paypal &&
                        order.paypal.captureStatus === 'COMPLETED' &&
                        order.paypal.captureId &&
                        order.supplierOrder &&
                        order.supplierOrder.createStatus === 'PENDING'
                      ) { %>
                  <form method="POST" action="/admin/cj/orders/<%= order._id %>/create-supplier-order" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-primary rounded-pill">
                      Create CJ Order
                    </button>
                  </form>
                  <% } else if (
                        order.paymentStatus === 'COMPLETED' &&
                        order.status === 'PAID' &&
                        order.paypal &&
                        order.paypal.captureStatus === 'COMPLETED' &&
                        order.paypal.captureId &&
                        order.supplierOrder &&
                        order.supplierOrder.createStatus === 'FAILED'
                      ) { %>
                  <form method="POST" action="/admin/cj/orders/<%= order._id %>/retry-supplier-order" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill">
                      Retry
                    </button>
                  </form>
                  <% } else { %>
                  <span class="small text-muted">
                    No action
                  </span>
                  <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
      </div>

      <% if (PAGE.totalPages > 1) { %>
      <div class="card-footer bg-white">
        <nav aria-label="CJ orders pagination">
          <ul class="pagination mb-0">
            <li class="page-item <%= PAGE.page <= 1 ? 'disabled' : '' %>">
              <a class="page-link" href="/admin/cj/orders?<%= queryString(Math.max(1, PAGE.page - 1)) %>">
                Previous
              </a>
            </li>

            <li class="page-item disabled">
              <span class="page-link">
                Page <%= PAGE.page %> of <%= PAGE.totalPages %>
              </span>
            </li>

            <li class="page-item <%= PAGE.page >= PAGE.totalPages ? 'disabled' : '' %>">
              <a class="page-link" href="/admin/cj/orders?<%= queryString(Math.min(PAGE.totalPages, PAGE.page + 1)) %>">
                Next
              </a>
            </li>
          </ul>
        </nav>
      </div>
      <% } %>
    </div>
  </div>
</div>