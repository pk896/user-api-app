<!--views/admin/cj/health.ejs-->
<section class="container-fluid px-0">
  <div class="bg-primary text-white px-3 px-lg-4 py-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
      <div>
        <div class="small text-uppercase fw-semibold opacity-75">
          Separate Kasyora Department
        </div>

        <h1 class="h2 fw-bold mb-1">
          CJ Dropshipping
        </h1>

        <p class="mb-0">
          API authentication and connection health.
        </p>
      </div>

      <div class="d-flex flex-wrap align-items-center gap-2">
        <span class="badge bg-brand-green fs-6 px-3 py-2">
          Isolated Integration
        </span>

        <a href="/admin/cj/products" class="btn btn-light">
          Browse CJ Catalogue
        </a>

        <a href="/admin/cj/products/imported" class="btn btn-brand-green">
          Imported CJ Products
        </a>
      </div>

    </div>
  </div>

  <div class="row g-3 p-3 p-lg-4">
    <div class="col-12 col-xl-6">
      <div class="card border-primary shadow-sm h-100">
        <div class="card-header bg-primary text-white">
          <h2 class="h5 mb-0">
            Configuration
          </h2>
        </div>

        <div class="card-body">
          <dl class="row mb-0">
            <dt class="col-sm-5 text-primary">Integration enabled</dt>
            <dd class="col-sm-7">
              <% if (cjConfig.enabled) { %>
              <span class="badge bg-brand-green">Yes</span>
              <% } else { %>
              <span class="badge bg-danger">No</span>
              <% } %>
            </dd>

            <dt class="col-sm-5 text-primary">API key configured</dt>
            <dd class="col-sm-7">
              <% if (cjConfig.apiKeyConfigured) { %>
              <span class="badge bg-brand-green">Yes</span>
              <% } else { %>
              <span class="badge bg-danger">No</span>
              <% } %>
            </dd>

            <dt class="col-sm-5 text-primary">Masked API key</dt>
            <dd class="col-sm-7">
              <code><%= cjConfig.apiKeyMasked || 'Not configured' %></code>
            </dd>

            <dt class="col-sm-5 text-primary">API base URL</dt>
            <dd class="col-sm-7 text-break">
              <code><%= cjConfig.baseUrl %></code>
            </dd>
          </dl>
        </div>
      </div>
    </div>

    <div class="col-12 col-xl-6">
      <div class="card border-primary shadow-sm h-100">
        <div class="card-header bg-primary text-white">
          <h2 class="h5 mb-0">
            Token State
          </h2>
        </div>

        <div class="card-body">
          <% if (!credential) { %>
          <div class="alert alert-warning mb-3">
            Kasyora has not obtained a CJ access token yet.
          </div>
          <% } else { %>
          <dl class="row mb-0">
            <dt class="col-sm-6 text-primary">Access-token expiry</dt>
            <dd class="col-sm-6">
              <%= credential.accessTokenExpiresAt
                  ? new Date(credential.accessTokenExpiresAt).toLocaleString()
                  : 'Not available' %>
            </dd>

            <dt class="col-sm-6 text-primary">Refresh-token expiry</dt>
            <dd class="col-sm-6">
              <%= credential.refreshTokenExpiresAt
                  ? new Date(credential.refreshTokenExpiresAt).toLocaleString()
                  : 'Not available' %>
            </dd>

            <dt class="col-sm-6 text-primary">Last authentication</dt>
            <dd class="col-sm-6">
              <%= credential.lastAuthenticatedAt
                  ? new Date(credential.lastAuthenticatedAt).toLocaleString()
                  : 'Not yet' %>
            </dd>

            <dt class="col-sm-6 text-primary">Last refresh</dt>
            <dd class="col-sm-6">
              <%= credential.lastRefreshedAt
                  ? new Date(credential.lastRefreshedAt).toLocaleString()
                  : 'Not yet' %>
            </dd>
          </dl>
          <% } %>
        </div>
      </div>
    </div>

    <div class="col-12">
      <div class="card border-primary shadow-sm">
        <div class="card-header bg-primary text-white">
          <h2 class="h5 mb-0">
            Connection Health
          </h2>
        </div>

        <div class="card-body">
          <div class="row g-3 align-items-center">
            <div class="col-12 col-lg-7">
              <div class="mb-2">
                <span class="fw-bold text-primary">Status:</span>

                <% if (!credential || credential.lastHealthCheckStatus === 'NOT_TESTED') { %>
                <span class="badge bg-secondary">Not tested</span>
                <% } else if (credential.lastHealthCheckStatus === 'HEALTHY') { %>
                <span class="badge bg-brand-green">Healthy</span>
                <% } else { %>
                <span class="badge bg-danger">Failed</span>
                <% } %>
              </div>

              <div class="small text-muted">
                Last checked:
                <%= credential?.lastHealthCheckAt
                  ? new Date(credential.lastHealthCheckAt).toLocaleString()
                  : 'Never' %>
              </div>

              <% if (credential?.lastErrorMessage) { %>
              <div class="alert alert-danger mt-3 mb-0">
                <div class="fw-bold">
                  <%= credential.lastErrorCode || 'CJ_ERROR' %>
                </div>

                <div>
                  <%= credential.lastErrorMessage %>
                </div>
              </div>
              <% } %>
            </div>

            <div class="col-12 col-lg-5">
              <div class="d-grid gap-2">
                <form action="/admin/cj/authenticate" method="POST">
                  <button type="submit" class="btn btn-primary w-100">
                    Obtain Access Token
                  </button>
                </form>

                <form action="/admin/cj/refresh-token" method="POST">
                  <button type="submit" class="btn btn-outline-primary w-100">
                    Refresh Access Token
                  </button>
                </form>

                <form action="/admin/cj/health-test" method="POST">
                  <button type="submit" class="btn btn-brand-green w-100">
                    Test CJ Connection
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>