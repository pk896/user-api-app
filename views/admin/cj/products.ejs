<!--views/admin/cj/products.ejs-->
<%
  const FILTERS =
    typeof filters !== 'undefined' &&
    filters &&
    typeof filters === 'object'
      ? filters
      : {};

  const CATEGORIES =
    typeof categories !== 'undefined' &&
    Array.isArray(categories)
      ? categories.filter(function(category) {
          return category && typeof category === 'object';
        })
      : [];

  const PRODUCTS =
    typeof products !== 'undefined' &&
    Array.isArray(products)
      ? products.filter(function(product) {
          return product && typeof product === 'object';
        })
      : [];

  const PAGINATION_SOURCE =
    typeof pagination !== 'undefined' &&
    pagination &&
    typeof pagination === 'object'
      ? pagination
      : {};

  const PAGINATION_PAGE_RAW =
    Number(PAGINATION_SOURCE.page);

  const PAGINATION_TOTAL_PAGES_RAW =
    Number(PAGINATION_SOURCE.totalPages);

  const PAGINATION_TOTAL_RECORDS_RAW =
    Number(PAGINATION_SOURCE.totalRecords);

  const PAGINATION = {
    page:
      Number.isFinite(PAGINATION_PAGE_RAW) &&
      PAGINATION_PAGE_RAW >= 1
        ? Math.floor(PAGINATION_PAGE_RAW)
        : 1,

    totalPages:
      Number.isFinite(PAGINATION_TOTAL_PAGES_RAW) &&
      PAGINATION_TOTAL_PAGES_RAW >= 1
        ? Math.floor(PAGINATION_TOTAL_PAGES_RAW)
        : 1,

    totalRecords:
      Number.isFinite(PAGINATION_TOTAL_RECORDS_RAW) &&
      PAGINATION_TOTAL_RECORDS_RAW >= 0
        ? Math.floor(PAGINATION_TOTAL_RECORDS_RAW)
        : 0
  };

  /*
   * Never allow the current page to exceed the known last page.
   */
  PAGINATION.page = Math.min(
    PAGINATION.page,
    PAGINATION.totalPages
  );

  const HAS_SEARCH =
    typeof hasSearch !== 'undefined' &&
    hasSearch === true;

  const REQUEST_ID =
    typeof requestId !== 'undefined'
      ? String(requestId || '').trim()
      : '';

  function money(amount, currency = 'USD') {
    const parsedAmount = Number(amount);

    const value =
      Number.isFinite(parsedAmount)
        ? parsedAmount
        : 0;

    const safeCurrency =
      String(currency || 'USD')
        .trim()
        .toUpperCase() || 'USD';

    try {
      const formatted = new Intl.NumberFormat(undefined, {
        style: 'currency',
        currency: safeCurrency,
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }).format(value);

      if (safeCurrency === 'ZAR') {
        return formatted.replace(/^ZAR\s?/, 'R');
      }

      return formatted;
    } catch {
      return safeCurrency + ' ' + value.toFixed(2);
    }
  }

  function buildPageUrl(page) {
    const params = new URLSearchParams();

    params.set('search', '1');
    params.set('page', String(page));

    if (FILTERS.keyword) {
      params.set('keyword', FILTERS.keyword);
    }

    if (FILTERS.categoryId) {
      params.set('categoryId', FILTERS.categoryId);
    }

    if (FILTERS.countryCode) {
      params.set('countryCode', FILTERS.countryCode);
    }

    if (FILTERS.startSellPrice) {
      params.set('startSellPrice', FILTERS.startSellPrice);
    }

    if (FILTERS.endSellPrice) {
      params.set('endSellPrice', FILTERS.endSellPrice);
    }

    return '/admin/cj/products?' +
      params.toString() +
      '#cj-products-results';
  }
%>

<section class="container-fluid px-0">
  <div class="bg-primary text-white px-3 px-lg-4 py-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
      <div>
        <div class="small text-uppercase fw-semibold opacity-75">
          CJ Dropshipping Department
        </div>

        <h1 class="h2 fw-bold mb-1">
          CJ Product Catalogue
        </h1>

        <p class="mb-0">
          Search CJ and import selected products into Kasyora.
        </p>
      </div>

      <div class="d-flex flex-wrap gap-2">
        <a href="/admin/cj" class="btn btn-light">
          API Health
        </a>

        <a href="/admin/cj/products/imported" class="btn btn-brand-green">
          Imported CJ Products
        </a>
      </div>
    </div>
  </div>

  <div class="p-3 p-lg-4">
    <div class="alert alert-info border-primary shadow-sm">
      <strong class="text-primary">Controlled API usage:</strong>
      searches run only when you submit this form. Kasyora does not call CJ on every keystroke.
    </div>

    <div class="card border-primary shadow-sm mb-4">
      <div class="card-header bg-primary text-white">
        <h2 class="h5 mb-0">
          Search CJ Catalogue
        </h2>
      </div>

      <div class="card-body">
        <form method="GET" action="/admin/cj/products#cj-products-results" class="row g-3">
          <input type="hidden" name="search" value="1">

          <div class="col-12 col-lg-6">
            <label for="keyword" class="form-label fw-semibold text-primary">
              Product name or SKU
            </label>

            <input id="keyword" name="keyword" class="form-control" value="<%= FILTERS.keyword || '' %>" maxlength="200" placeholder="Example: phone case, hoodie, CJ SKU">
          </div>

          <div class="col-12 col-lg-6">
            <%
              const selectedCjCategory = CATEGORIES.find(function(category) {
                return String(category.categoryId || '') ===
                  String(FILTERS.categoryId || '');
              });

              const selectedCjCategoryText = selectedCjCategory
                ? (
                    [
                      selectedCjCategory.firstName,
                      selectedCjCategory.secondName,
                      selectedCjCategory.categoryName
                    ].filter(Boolean).join(' › ') ||
                    String(
                      selectedCjCategory.categoryId ||
                      'Unnamed CJ category'
                    )
                  )
                : 'All CJ categories';
            %>

            <label for="cjCategorySearch" class="form-label fw-semibold text-primary">
              CJ category
            </label>

            <input id="categoryId" name="categoryId" type="hidden" value="<%= FILTERS.categoryId || '' %>">

            <div class="dropdown w-100">
              <button id="cjCategoryDropdownButton" class="btn btn-light border w-100 d-flex align-items-center justify-content-between gap-2 text-start" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span id="cjSelectedCategoryText" class="text-truncate <%= FILTERS.categoryId ? '' : 'text-muted' %>">
                  <%= selectedCjCategoryText %>
                </span>

                <span aria-hidden="true">
                  ▾
                </span>
              </button>

              <div class="dropdown-menu w-100 p-2 shadow overflow-auto" style="max-height: 320px;">
                <input id="cjCategorySearch" type="text" class="form-control mb-2" placeholder="Search CJ category..." autocomplete="off">

                <button type="button" class="dropdown-item rounded py-2 js-cj-category-option <%= FILTERS.categoryId ? '' : 'active' %>" data-category-id="" data-category-name="All CJ categories">
                  All CJ categories
                </button>

                <% CATEGORIES.forEach(function(category) { %>
                <%
                    const categoryLabel = [
                      category.firstName,
                      category.secondName,
                      category.categoryName
                    ].filter(Boolean).join(' › ') ||
                      String(category.categoryId || 'Unnamed CJ category');

                    const isSelectedCategory =
                      String(FILTERS.categoryId || '') === String(category.categoryId || '');
                  %>

                <button type="button" class="dropdown-item rounded py-2 js-cj-category-option <%= isSelectedCategory ? 'active' : '' %>" data-category-id="<%= category.categoryId %>" data-category-name="<%= categoryLabel %>">
                  <%= categoryLabel %>
                </button>
                <% }) %>
              </div>
            </div>

            <div class="form-text">
              Start typing to filter CJ categories, then click the category you want.
            </div>
          </div>

          <div class="col-12 col-md-4">
            <label for="countryCode" class="form-label fw-semibold text-primary">
              Warehouse country code
            </label>

            <input id="countryCode" name="countryCode" class="form-control text-uppercase" value="<%= FILTERS.countryCode || '' %>" maxlength="2" placeholder="CN, US, GB">

            <div class="form-text">
              Optional two-letter code.
            </div>
          </div>

          <div class="col-12 col-md-4">
            <label for="startSellPrice" class="form-label fw-semibold text-primary">
              Minimum CJ price (USD)
            </label>

            <input id="startSellPrice" name="startSellPrice" type="number" min="0" step="0.01" class="form-control" value="<%= FILTERS.startSellPrice || '' %>">
          </div>

          <div class="col-12 col-md-4">
            <label for="endSellPrice" class="form-label fw-semibold text-primary">
              Maximum CJ price (USD)
            </label>

            <input id="endSellPrice" name="endSellPrice" type="number" min="0" step="0.01" class="form-control" value="<%= FILTERS.endSellPrice || '' %>">
          </div>

          <div class="col-12">
            <div class="d-grid d-md-flex gap-2">
              <button type="submit" class="btn btn-primary px-4">
                Search CJ
              </button>

              <a href="/admin/cj/products" class="btn btn-outline-secondary">
                Clear Search
              </a>
            </div>
          </div>
        </form>
      </div>
    </div>

    <div id="cj-products-results"></div>

    <% if (!HAS_SEARCH) { %>
    <div class="card border-0 shadow-sm">
      <div class="card-body text-center py-5">
        <div class="display-5 text-primary mb-3">
          <i class="fa-solid fa-magnifying-glass"></i>
        </div>

        <h2 class="h4 text-primary">
          Search before loading products
        </h2>

        <p class="text-muted mb-0">
          Enter a keyword or choose a category. This prevents unnecessary CJ API usage.
        </p>
      </div>
    </div>
    <% } else if (!PRODUCTS.length) { %>
    <div class="alert alert-warning shadow-sm">
      CJ returned no products for the selected filters.
    </div>
    <% } else { %>
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
      <div>
        <h2 class="h4 text-primary mb-1">
          Search Results
        </h2>

        <div class="text-muted small">
          <%= Number(PAGINATION.totalRecords || 0) %> matching records reported by CJ.
        </div>
      </div>

      <% if (REQUEST_ID) { %>
      <div class="small text-muted">
        Request ID:
        <code><%= REQUEST_ID %></code>
      </div>
      <% } %>
    </div>

    <div class="row g-3">
      <% PRODUCTS.forEach(function(product) { %>
      <div class="col-12 col-md-6 col-xl-4">
        <div class="card border-primary shadow-sm h-100">
          <div class="ratio ratio-1x1 bg-light">
            <img src="<%= product.mainImageUrl %>" alt="<%= product.name %>" class="w-100 h-100 object-fit-contain p-3" loading="lazy">
          </div>

          <div class="card-body d-flex flex-column">
            <div class="d-flex flex-wrap gap-2 mb-2">
              <span class="badge bg-primary">
                CJ
              </span>

              <% if (product.imported) { %>
              <span class="badge bg-brand-green">
                Imported: <%= product.imported.status %>
              </span>
              <% } %>

              <% if (product.freeShipping) { %>
              <span class="badge bg-info text-dark">
                CJ free-shipping flag
              </span>
              <% } %>
            </div>

            <h3 class="h6 fw-bold text-primary">
              <%= product.name || 'CJ Product' %>
            </h3>

            <div class="small text-muted mb-2">
              SKU: <%= product.productSku || '—' %>
            </div>

            <div class="small text-muted mb-3">
              <%= product.categoryName || 'Uncategorized' %>
            </div>

            <dl class="row small mb-3">
              <dt class="col-6">
                CJ price
              </dt>

              <dd class="col-6 text-end fw-semibold">
                <%= money(product.sourcePriceUsd, 'USD') %>
              </dd>

              <dt class="col-6">
                Verified stock
              </dt>

              <dd class="col-6 text-end">
                <%= product.totalInventory %>
              </dd>

              <dt class="col-6">
                Listed count
              </dt>

              <dd class="col-6 text-end">
                <%= product.listedNumber %>
              </dd>
            </dl>

            <div class="mt-auto d-grid">
              <a href="/admin/cj/products/<%= encodeURIComponent(product.cjProductId) %>" class="btn btn-primary">
                View Variants and Import
              </a>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>

    <% if (Number(PAGINATION.totalPages || 1) > 1) { %>
    <nav class="mt-4" aria-label="CJ catalogue pages">
      <div class="d-flex justify-content-between align-items-center gap-3">
        <% if (Number(PAGINATION.page || 1) > 1) { %>
        <a href="<%= buildPageUrl(Number(PAGINATION.page || 1) - 1) %>" class="btn btn-outline-primary">
          Previous
        </a>
        <% } else { %>
        <button class="btn btn-outline-secondary" disabled>
          Previous
        </button>
        <% } %>

        <span class="fw-semibold text-primary">
          Page <%= Number(PAGINATION.page || 1) %> of <%= Number(PAGINATION.totalPages || 1) %>
        </span>

        <% if (Number(PAGINATION.page || 1) < Number(PAGINATION.totalPages || 1)) { %>
        <a href="<%= buildPageUrl(Number(PAGINATION.page || 1) + 1) %>" class="btn btn-outline-primary">
          Next
        </a>
        <% } else { %>
        <button class="btn btn-outline-secondary" disabled>
          Next
        </button>
        <% } %>
      </div>
    </nav>
    <% } %>
    <% } %>
  </div>
</section>

<script nonce="<%= nonce %>">
  (function() {
    const categoryInput = document.getElementById(
      'categoryId'
    );

    const categoryDropdownButton = document.getElementById(
      'cjCategoryDropdownButton'
    );

    const categorySearchInput = document.getElementById(
      'cjCategorySearch'
    );

    const selectedCategoryText = document.getElementById(
      'cjSelectedCategoryText'
    );

    const categoryButtons = Array.from(
      document.querySelectorAll(
        '.js-cj-category-option'
      )
    );

    function closeCjCategoryDropdown() {
      if (!categoryDropdownButton) {
        return;
      }

      try {
        const dropdownInstance =
          bootstrap.Dropdown.getOrCreateInstance(
            categoryDropdownButton
          );

        dropdownInstance.hide();
      } catch (error) {
        const dropdownWrapper =
          categoryDropdownButton.closest('.dropdown');

        const dropdownMenu =
          dropdownWrapper?.querySelector('.dropdown-menu');

        dropdownMenu?.classList.remove('show');
        dropdownWrapper?.classList.remove('show');
        categoryDropdownButton.classList.remove('show');

        categoryDropdownButton.setAttribute(
          'aria-expanded',
          'false'
        );
      }
    }

    function selectCjCategory(categoryId, categoryName) {
      const cleanCategoryId =
        String(categoryId || '').trim();

      const cleanCategoryName =
        String(categoryName || 'All CJ categories').trim() ||
        'All CJ categories';

      if (categoryInput) {
        categoryInput.value = cleanCategoryId;
      }

      if (selectedCategoryText) {
        selectedCategoryText.textContent = cleanCategoryName;

        selectedCategoryText.classList.toggle(
          'text-muted',
          !cleanCategoryId
        );
      }

      categoryButtons.forEach(function(button) {
        button.classList.toggle(
          'active',
          String(button.dataset.categoryId || '').trim() === cleanCategoryId
        );
      });

      closeCjCategoryDropdown();
    }

    categoryButtons.forEach(function(button) {
      button.addEventListener('click', function() {
        selectCjCategory(
          button.dataset.categoryId || '',
          button.dataset.categoryName ||
          button.textContent ||
          'All CJ categories'
        );
      });
    });

    if (categorySearchInput) {
      categorySearchInput.addEventListener('click', function(event) {
        event.stopPropagation();
      });

      categorySearchInput.addEventListener('keydown', function(event) {
        event.stopPropagation();
      });

      categorySearchInput.addEventListener('input', function() {
        const term =
          String(categorySearchInput.value || '')
          .trim()
          .toLowerCase();

        categoryButtons.forEach(function(button) {
          const categoryName =
            String(
              button.dataset.categoryName ||
              button.textContent ||
              ''
            ).toLowerCase();

          const categoryId =
            String(button.dataset.categoryId || '')
            .toLowerCase();

          const matches = !term ||
            categoryName.includes(term) ||
            categoryId.includes(term);

          button.classList.toggle(
            'd-none',
            !matches
          );
        });
      });
    }

    categoryDropdownButton?.addEventListener(
      'shown.bs.dropdown',
      function() {
        if (!categorySearchInput) {
          return;
        }

        categorySearchInput.value = '';

        categoryButtons.forEach(function(button) {
          button.classList.remove('d-none');
        });

        categorySearchInput.focus();
      }
    );
  })();
</script>