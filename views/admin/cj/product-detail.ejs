<!--views/admin/cj/product-detail.ejs-->
<%
  const CURRENCY =
    String(baseCurrency || 'USD')
      .trim()
      .toUpperCase() || 'USD';

  function money(amount, currency = CURRENCY) {
    const value = Number(amount || 0);

    try {
      const formatted = new Intl.NumberFormat(undefined, {
        style: 'currency',
        currency,
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }).format(value);

      if (currency === 'ZAR') {
        return formatted.replace(/^ZAR\s?/, 'R');
      }

      return formatted;
    } catch {
      return currency + ' ' + value.toFixed(2);
    }
  }

  function priceWithMarkup(cost, markup) {
    const convertedCost = Number(cost || 0);
    const percent = Number(markup || 0);

    return Number(
      (convertedCost * (1 + percent / 100)).toFixed(2)
    );
  }

  const existingEnabledIds = new Set(
    Array.isArray(existingProduct?.variants)
      ? existingProduct.variants
          .filter(function(variant) {
            return variant.isEnabled;
          })
          .map(function(variant) {
            return String(variant.cjVariantId);
          })
      : []
  );

  const existingPriceMap = new Map(
    Array.isArray(existingProduct?.variants)
      ? existingProduct.variants.map(function(variant) {
          return [
            String(variant.cjVariantId),
            Number(variant?.sellingPriceExVat?.value || 0)
          ];
        })
      : []
  );
%>

<section class="container-fluid px-0">
  <div class="bg-primary text-white px-3 px-lg-4 py-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
      <div>
        <div class="small text-uppercase fw-semibold opacity-75">
          CJ Product Preview
        </div>

        <h1 class="h3 fw-bold mb-1">
          <%= product.name %>
        </h1>

        <div>
          SKU: <%= product.productSku || '—' %>
        </div>
      </div>

      <div class="d-flex flex-wrap gap-2">
        <a href="/admin/cj/products" class="btn btn-light">
          Back to Catalogue
        </a>

        <a href="/admin/cj/products/imported" class="btn btn-brand-green">
          Imported Products
        </a>
      </div>
    </div>
  </div>

  <div class="p-3 p-lg-4">
    <% if (existingProduct) { %>
    <div class="alert alert-success shadow-sm">
      This product is already imported into Kasyora with status
      <strong><%= existingProduct.status %></strong>.
      Submitting this page will safely update the local CJ product snapshot.
    </div>
    <% } %>

    <div class="row g-4 mb-4">
      <div class="col-12 col-lg-4">
        <div class="card border-primary shadow-sm">
          <div class="ratio ratio-1x1 bg-light">
            <img src="<%= product.mainImageUrl %>" alt="<%= product.name %>" class="w-100 h-100 object-fit-contain p-3">
          </div>
        </div>
      </div>

      <div class="col-12 col-lg-8">
        <div class="card border-primary shadow-sm h-100">
          <div class="card-header bg-primary text-white">
            <h2 class="h5 mb-0">
              CJ Source Information
            </h2>
          </div>

          <div class="card-body">
            <dl class="row mb-0">
              <dt class="col-sm-4 text-primary">
                CJ product ID
              </dt>

              <dd class="col-sm-8 text-break">
                <code><%= product.cjProductId %></code>
              </dd>

              <dt class="col-sm-4 text-primary">
                Product SKU
              </dt>

              <dd class="col-sm-8">
                <%= product.productSku || '—' %>
              </dd>

              <dt class="col-sm-4 text-primary">
                Category
              </dt>

              <dd class="col-sm-8">
                <%= product.category.name || '—' %>
              </dd>

              <dt class="col-sm-4 text-primary">
                Product weight
              </dt>

              <dd class="col-sm-8">
                <%= product.productWeightGrams != null ? product.productWeightGrams + ' g' : '—' %>
              </dd>

              <dt class="col-sm-4 text-primary">
                Packing weight
              </dt>

              <dd class="col-sm-8">
                <%= product.packingWeightGrams != null ? product.packingWeightGrams + ' g' : '—' %>
              </dd>

              <dt class="col-sm-4 text-primary">
                HS code
              </dt>

              <dd class="col-sm-8">
                <%= product.customs.hsCode || '—' %>
              </dd>

              <dt class="col-sm-4 text-primary">
                Logistics properties
              </dt>

              <dd class="col-sm-8">
                <% if (product.customs.logisticsProperties.length) { %>
                <div class="d-flex flex-wrap gap-1">
                  <% product.customs.logisticsProperties.forEach(function(property) { %>
                  <span class="badge bg-secondary">
                    <%= property %>
                  </span>
                  <% }) %>
                </div>
                <% } else { %>
                —
                <% } %>
              </dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <form method="POST" action="/admin/cj/products/<%= encodeURIComponent(product.cjProductId) %>/import">
      <div class="card border-primary shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
          <h2 class="h5 mb-0">
            Kasyora Import Settings
          </h2>
        </div>

        <div class="card-body">
          <div class="row g-3">
            <div class="col-12 col-lg-6">
              <label for="kasyoraName" class="form-label fw-semibold text-primary">
                Kasyora product name
              </label>

              <input id="kasyoraName" name="kasyoraName" class="form-control" maxlength="300" required value="<%= existingProduct?.name || product.name %>">
            </div>

            <div class="col-12 col-md-6 col-lg-3">
              <label for="markupPercent" class="form-label fw-semibold text-primary">
                Default markup %
              </label>

              <input id="markupPercent" name="markupPercent" type="number" min="0" max="10000" step="0.01" class="form-control" value="<%= defaultMarkupPercent %>" required>

              <div class="form-text">
                Used only when a variant selling price is left empty.
              </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
              <label for="status" class="form-label fw-semibold text-primary">
                Import status
              </label>

              <select id="status" name="status" class="form-select">
                <option value="draft" <%= !existingProduct || existingProduct.status === 'draft' ? 'selected' : '' %>>
                  Draft
                </option>

                <option value="active" <%= existingProduct?.status === 'active' ? 'selected' : '' %>>
                  Active
                </option>

                <option value="paused" <%= existingProduct?.status === 'paused' ? 'selected' : '' %>>
                  Paused
                </option>
              </select>
            </div>
          </div>

          <div class="alert alert-warning mt-3 mb-0">
            Selling prices below show product cost only. CJ shipping is calculated later in the separate CJ checkout and is not included in these product prices.
          </div>
        </div>
      </div>

      <div class="card border-primary shadow-sm">
        <div class="card-header bg-primary text-white">
          <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
            <h2 class="h5 mb-0">
              Select CJ Variants
            </h2>

            <span class="badge bg-brand-green">
              <%= product.variants.length %> variants returned
            </span>
          </div>
        </div>

        <div class="card-body p-0">
          <% if (!product.variants.length) { %>
          <div class="alert alert-warning m-3">
            CJ did not return any variants for this product.
          </div>
          <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th scope="col">
                    Import
                  </th>

                  <th scope="col">
                    Variant
                  </th>

                  <th scope="col">
                    CJ cost
                  </th>

                  <th scope="col">
                    Converted cost
                  </th>

                  <th scope="col">
                    Kasyora CJ selling price
                  </th>

                  <th scope="col">
                    Inventory
                  </th>
                </tr>
              </thead>

              <tbody>
                <% product.variants.forEach(function(variant, index) { %>
                <%
                      const existingPrice = existingPriceMap.get(
                        String(variant.cjVariantId)
                      );

                      const suggestedPrice =
                        existingPrice > 0
                          ? existingPrice
                          : priceWithMarkup(
                              variant.convertedSourceCost.value,
                              defaultMarkupPercent
                            );

                      const checked =
                        existingProduct
                          ? existingEnabledIds.has(String(variant.cjVariantId))
                          : true;
                    %>

                <tr>
                  <td>
                    <div class="form-check">
                      <input id="variant-<%= index %>" name="selectedVariants" value="<%= variant.cjVariantId %>" class="form-check-input" type="checkbox" <%= checked ? 'checked' : '' %>>
                    </div>
                  </td>

                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <img src="<%= variant.imageUrl || product.mainImageUrl %>" alt="" width="56" height="56" class="object-fit-contain border rounded bg-light" loading="lazy">

                      <div>
                        <div class="fw-semibold text-primary">
                          <%= variant.variantName || variant.variantKey || 'Variant' %>
                        </div>

                        <div class="small text-muted">
                          <%= variant.variantSku %>
                        </div>

                        <div class="small text-muted">
                          <%= variant.weightGrams != null ? variant.weightGrams + ' g' : 'Weight unavailable' %>
                        </div>
                      </div>
                    </div>
                  </td>

                  <td class="text-nowrap">
                    <%= money(variant.sourceCostUsd, 'USD') %>
                  </td>

                  <td class="text-nowrap">
                    <%= money(
                          variant.convertedSourceCost.value,
                          variant.convertedSourceCost.currency
                        ) %>
                  </td>

                  <td style="min-width: 210px;">
                    <div class="input-group">
                      <span class="input-group-text">
                        <%= CURRENCY === 'ZAR' ? 'R' : CURRENCY %>
                      </span>

                      <input name="variantSellingPrice[<%= variant.cjVariantId %>]" type="number" min="<%= variant.convertedSourceCost.value %>" step="0.01" class="form-control" value="<%= suggestedPrice.toFixed(2) %>">
                    </div>
                  </td>

                  <td>
                    <% if (variant.inventoryKnown) { %>
                    <span class="badge <%= variant.totalInventory > 0 ? 'bg-brand-green' : 'bg-danger' %>">
                      <%= variant.totalInventory %>
                    </span>
                    <% } else { %>
                    <span class="badge bg-secondary">
                      Not returned
                    </span>
                    <% } %>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>

        <div class="card-footer bg-white">
          <div class="d-grid d-md-flex justify-content-md-end gap-2">
            <a href="/admin/cj/products" class="btn btn-outline-secondary">
              Cancel
            </a>

            <button type="submit" class="btn btn-primary px-4" <%= !product.variants.length ? 'disabled' : '' %>>
              <%= existingProduct ? 'Update CJ Product' : 'Import into Kasyora' %>
            </button>
          </div>
        </div>
      </div>
    </form>
  </div>
</section>