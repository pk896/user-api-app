<!-- views/admin/business-login-header-image/index.ejs -->

<div class="container py-4">

  <div
    class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4"
  >

    <div>

      <h1 class="h3 mb-1 text-primary">
        Business Login Header Image
      </h1>

      <p class="text-muted mb-0">
        Manage the background image used only by the
        Kasyora Business Login page.
      </p>

    </div>

    <div class="d-flex flex-wrap gap-2">

      <a
        href="/business/login"
        class="btn btn-outline-primary"
        target="_blank"
        rel="noopener"
      >
        <i
          class="fas fa-right-to-bracket me-2"
          aria-hidden="true"
        ></i>

        View Business Login
      </a>

      <a
        href="/admin/dashboard"
        class="btn btn-outline-secondary"
      >
        Back
      </a>

    </div>

  </div>


  <% if (success && success.length) { %>

    <div class="alert alert-success" role="alert">
      <%= success[0] %>
    </div>

  <% } %>


  <% if (error && error.length) { %>

    <div class="alert alert-danger" role="alert">
      <%= error[0] %>
    </div>

  <% } %>


  <% if (info && info.length) { %>

    <div class="alert alert-info" role="alert">
      <%= info[0] %>
    </div>

  <% } %>


  <% if (warning && warning.length) { %>

    <div class="alert alert-warning" role="alert">
      <%= warning[0] %>
    </div>

  <% } %>


  <div class="card shadow-sm border-0">

    <div class="card-body p-4">

      <div
        class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-4"
      >

        <div>

          <h2 class="h5 mb-1">
            Current Business Login Header Image
          </h2>

          <div class="small text-muted">
            This image is completely separate from the
            Store Shop Header Image and Business Signup Header Image.
          </div>

        </div>

        <div>

          <% if (headerImage) { %>

            <span
              class="badge <%= headerImage.active ? 'bg-success' : 'bg-secondary' %>"
            >
              <%= headerImage.active ? 'Active' : 'Inactive' %>
            </span>

          <% } else { %>

            <span class="badge bg-warning text-dark">
              Not Configured
            </span>

          <% } %>

        </div>

      </div>


      <% if (headerImage && headerImage.image) { %>

        <div class="border rounded p-3 bg-light mb-4">

          <div class="small text-muted mb-2">
            Current Image
          </div>

          <img
            src="<%= headerImage.image %>"
            alt="Current Business Login header image"
            class="img-fluid rounded border w-100"
            style="max-height: 360px; object-fit: cover;"
          >

        </div>

      <% } else { %>

        <div class="alert alert-light border mb-4">
          No Business Login header image has been configured yet.
          Until one is active, the Business Login page will use
          its built-in fallback image.
        </div>

      <% } %>


      <div class="d-flex flex-wrap gap-2">

        <a
          href="/admin/business-login-header-image/edit"
          class="btn btn-primary"
        >
          <i
            class="fas fa-image me-2"
            aria-hidden="true"
          ></i>

          <%= headerImage ? 'Change' : 'Set Up' %>
          Business Login Header Image
        </a>


        <% if (headerImage) { %>

          <a
            href="/admin/business-login-header-image/toggle"
            class="btn btn-outline-secondary"
          >
            <%= headerImage.active ? 'Deactivate' : 'Activate' %>
          </a>

        <% } %>

      </div>

    </div>

  </div>

</div>