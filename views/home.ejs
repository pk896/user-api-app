<style nonce="<%= NONCE %>">
  /*
   * =========================================================
   * KASYORA HOME PAGE
   * =========================================================
   *
   * The Home page is intentionally full viewport width.
   *
   * It breaks out of any parent Bootstrap .container while
   * keeping a small responsive internal safety padding so
   * content never touches the physical screen edge.
   */

  .kasyora-home {
    width: 100vw;
    max-width: 100vw;

    margin-left:
      calc(50% - 50vw);

    margin-right:
      calc(50% - 50vw);

    overflow-x: clip;

    box-sizing: border-box;
  }


  .home-full-section {
    width: 100%;
    max-width: 100%;

    margin-left: 0;
    margin-right: 0;

    box-sizing: border-box;
  }


  .home-full-inner {
    width: 100%;
    max-width: none;

    margin: 0;

    padding-left: 16px;
    padding-right: 16px;

    box-sizing: border-box;
  }


  /*
   * Hero
   */
  .home-hero {
    position: relative;

    background:
      linear-gradient(115deg,
        rgba(76, 29, 149, .86) 0%,
        rgba(124, 58, 237, .80) 52%,
        rgba(76, 29, 149, .72) 100%),
      url('<%= heroBg %>') center / cover no-repeat;
  }


  .home-hero::after {
    content: '';

    position: absolute;
    inset: 0;

    pointer-events: none;

    background:
      radial-gradient(circle at 88% 15%,
        rgba(34, 197, 94, .25),
        transparent 28%);
  }


  .home-hero>.home-full-inner {
    position: relative;
    z-index: 1;
  }


  .home-hero-title {
    max-width: 950px;

    letter-spacing: -.035em;
  }


  .home-hero-lead {
    max-width: 820px;

    color:
      rgba(255,
        255,
        255,
        .86);
  }


  /*
  * Hero business button
  *
  * Uses the same soft green family as the
  * Kasyora light footer rather than the
  * stronger Bootstrap success green.
  */
  .home-hero-business-btn {
    background:
      linear-gradient(135deg,
        #F0FDF4 0%,
        #ECFDF5 48%,
        #FFFFFF 100%) !important;

    border:
      1px solid #D1FAE5 !important;

    color:
      #7C3AED !important;

    box-shadow:
      0 .35rem 1rem rgba(15,
        23,
        42,
        .10);
  }


  /*
  * Reusable light business CTA.
  *
  * Used outside the hero for business signup buttons.
  */
  .home-business-light-btn {
    background:
      linear-gradient(135deg,
        #F0FDF4 0%,
        #ECFDF5 48%,
        #FFFFFF 100%) !important;

    border:
      1px solid #D1FAE5 !important;

    color:
      #7C3AED !important;

    box-shadow:
      0 .25rem .75rem rgba(15,
        23,
        42,
        .08);
  }


  .home-business-light-btn i {
    color:
      currentColor !important;
  }


  .home-business-light-btn:hover,
  .home-business-light-btn:focus {
    background:
      #FFFFFF !important;

    border-color:
      #C4B5FD !important;

    color:
      #5B21B6 !important;
  }


  .home-business-light-btn:hover i,
  .home-business-light-btn:focus i {
    color:
      #5B21B6 !important;
  }


  /*
  * Final CTA secondary buttons.
  *
  * White text/icons must remain clearly visible
  * before hover on the purple background.
  */
  .home-final-outline-btn {
    background:
      rgba(255,
        255,
        255,
        .04) !important;

    border:
      1px solid rgba(255,
        255,
        255,
        .92) !important;

    color:
      #FFFFFF !important;
  }


  .home-final-outline-btn i {
    color:
      #FFFFFF !important;
  }


  .home-final-outline-btn:hover,
  .home-final-outline-btn:focus {
    background:
      #FFFFFF !important;

    border-color:
      #FFFFFF !important;

    color:
      #7C3AED !important;
  }


  .home-final-outline-btn:hover i,
  .home-final-outline-btn:focus i {
    color:
      #7C3AED !important;
  }


  .home-hero-business-btn i {
    color:
      currentColor !important;
  }


  .home-hero-business-btn:hover,
  .home-hero-business-btn:focus {
    background:
      #FFFFFF !important;

    border-color:
      #FFFFFF !important;

    color:
      #5B21B6 !important;
  }


  /*
  * Hero personal-account button
  *
  * White text and icon must remain clearly visible
  * before hover.
  */
  .home-hero-account-btn {
    background:
      rgba(255,
        255,
        255,
        .04) !important;

    border:
      1px solid rgba(255,
        255,
        255,
        .90) !important;

    color:
      #FFFFFF !important;
  }


  .home-hero-account-btn i {
    color:
      #FFFFFF !important;
  }


  .home-hero-account-btn:hover,
  .home-hero-account-btn:focus {
    background:
      #FFFFFF !important;

    border-color:
      #FFFFFF !important;

    color:
      #7C3AED !important;
  }


  .home-hero-account-btn:hover i,
  .home-hero-account-btn:focus i {
    color:
      #7C3AED !important;
  }


  .home-legal-line {
    color:
      rgba(255,
        255,
        255,
        .76);
  }


  .home-hero-trust {
    background:
      rgba(255,
        255,
        255,
        .10);

    backdrop-filter:
      blur(8px);

    box-shadow:
      0 1rem 2.5rem rgba(0,
        0,
        0,
        .16);
  }


  /*
   * Reusable circular icons
   */
  .home-icon-circle {
    width: 46px;
    height: 46px;

    border-radius: 50%;

    display:
      inline-flex;

    align-items:
      center;

    justify-content:
      center;
  }


  /*
   * Buyer / Seller / Supplier cards
   */
  .home-participation-card,
  .home-value-card,
  .home-system-card {
    transition:
      transform .2s ease,
      box-shadow .2s ease;
  }


  .home-participation-card:hover,
  .home-value-card:hover,
  .home-system-card:hover {
    transform:
      translateY(-4px);

    box-shadow:
      0 1rem 2rem rgba(0,
        0,
        0,
        .10) !important;
  }


  .home-participation-icon {
    width: 60px;
    height: 60px;

    border-radius:
      1rem;

    display:
      inline-flex;

    align-items:
      center;

    justify-content:
      center;

    font-size:
      1.35rem;
  }


  /*
   * Global vision section
   */
  .home-vision {
    background:
      radial-gradient(circle at 88% 15%,
        rgba(34, 197, 94, .18),
        transparent 30%),
      linear-gradient(120deg,
        #111827 0%,
        #24133f 100%);
  }


  /*
   * Final CTA
   */
  .home-final-cta {
    background:
      radial-gradient(circle at 15% 80%,
        rgba(34, 197, 94, .24),
        transparent 30%),
      linear-gradient(135deg,
        #4C1D95 0%,
        #7C3AED 55%,
        #5B21B6 100%);
  }


  /*
   * Tablet
   */
  @media (min-width: 768px) {
    .home-full-inner {
      padding-left:
        24px;

      padding-right:
        24px;
    }
  }


  /*
   * Desktop
   *
   * Still full-screen.
   * No Bootstrap max-width container is introduced.
   */
  @media (min-width: 1200px) {
    .home-full-inner {
      padding-left:
        32px;

      padding-right:
        32px;
    }
  }


  /*
   * Small phones
   */
  @media (max-width: 575.98px) {
    .home-full-inner {
      padding-left:
        12px;

      padding-right:
        12px;
    }

    .home-hero-title {
      font-size:
        clamp(2rem,
          10vw,
          2.7rem);
    }

    .home-hero-trust {
      border-radius:
        .75rem !important;
    }
  }


  /*
   * Accessibility
   */
  @media (prefers-reduced-motion: reduce) {

    .home-participation-card,
    .home-value-card,
    .home-system-card {
      transition:
        none;
    }

    .home-participation-card:hover,
    .home-value-card:hover,
    .home-system-card:hover {
      transform:
        none;
    }
  }
</style>


<script nonce="<%= NONCE %>">
  document.addEventListener(
    'DOMContentLoaded',
    function() {
      const pageSpinner =
        document.getElementById(
          'spinner',
        );

      if (pageSpinner) {
        window.addEventListener(
          'load',
          function() {
            window.setTimeout(
              function() {
                pageSpinner.classList.remove(
                  'show',
                );

                window.setTimeout(
                  function() {
                    pageSpinner.classList.add(
                      'd-none',
                    );
                  },
                  300,
                );
              },
              700,
            );
          },
        );
      }
    },
  );
</script>