<!--views/store/partials/cart-script-cart-page.ejs-->

<script nonce="<%= nonce %>">
  (function() {
    /*
     * All item and cart amounts received from /api/cart remain in
     * Kasyora's authoritative BASE_CURRENCY.
     *
     * The shared client helper converts only the visible values.
     */
    function formatMoney(amount) {
      if (
        window.KasyoraCurrency &&
        typeof window.KasyoraCurrency.formatBaseAmount === 'function'
      ) {
        return window.KasyoraCurrency.formatBaseAmount(
          amount
        );
      }

      const fallbackAmount = Number(amount || 0);
      const fallbackCurrency =
        "<%= String(typeof baseCurrency !== 'undefined' ? baseCurrency : 'USD').trim().toUpperCase() || 'USD' %>";

      try {
        return new Intl.NumberFormat(
          undefined, {
            style: 'currency',
            currency: fallbackCurrency,
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          }
        ).format(
          Number.isFinite(fallbackAmount) ?
          fallbackAmount :
          0
        );
      } catch (error) {
        return (
          fallbackCurrency +
          ' ' +
          (
            Number.isFinite(fallbackAmount) ?
            fallbackAmount :
            0
          ).toFixed(2)
        );
      }
    }

    /*
     * Provisional Internal VAT rate
     * =============================
     *
     * The cart page route has already resolved this rate from the
     * customer's provisional delivery country.
     *
     * South Africa:
     * 0.15
     *
     * Destination outside South Africa:
     * 0
     *
     * Checkout will later use the validated shipping address for
     * the authoritative final VAT calculation.
     */
    const VAT_RATE_RAW =
      Number(
        "<%= Number(
          typeof vatRate !== 'undefined' &&
          vatRate !== null
            ? vatRate
            : 0.15
        ) %>"
      );

    const VAT_RATE =
      Number.isFinite(
        VAT_RATE_RAW
      ) &&
      VAT_RATE_RAW >= 0 &&
      VAT_RATE_RAW <= 1 ?
      VAT_RATE_RAW :
      0;

    function round2(n) {
      const amount =
        Number(
          n
        );

      if (
        !Number.isFinite(
          amount
        )
      ) {
        return 0;
      }

      return (
        Math.round(
          amount *
          100
        ) /
        100
      );
    }

    function getVariantsFromRow(row) {
      const size =
        (
          row.getAttribute(
            'data-variant-size'
          ) ||
          ''
        ).trim();

      const color =
        (
          row.getAttribute(
            'data-variant-color'
          ) ||
          ''
        ).trim();

      const variants = {};

      if (size) {
        variants.size = size;
      }

      if (color) {
        variants.color = color;
      }

      return variants;
    }

    /*
     * Read the authoritative VAT-exclusive unit price.
     *
     * New Internal cart records contain the same VAT-exclusive
     * amount in both price and priceExVat.
     *
     * priceExVat remains the preferred source for compatibility
     * with older customer sessions.
     */
    function getItemPriceExVat(item) {
      const storedPriceExVat =
        Number(
          item &&
          item.priceExVat
        );

      if (
        Number.isFinite(
          storedPriceExVat
        ) &&
        storedPriceExVat >= 0
      ) {
        return round2(
          storedPriceExVat
        );
      }

      const storedPrice =
        Number(
          item &&
          item.price
        );

      if (
        Number.isFinite(
          storedPrice
        ) &&
        storedPrice >= 0
      ) {
        return round2(
          storedPrice
        );
      }

      return 0;
    }

    function getItemVatAmount(item) {
      return round2(
        getItemPriceExVat(
          item
        ) *
        VAT_RATE
      );
    }

    function getItemDisplayPrice(item) {
      return round2(
        getItemPriceExVat(
          item
        ) +
        getItemVatAmount(
          item
        )
      );
    }

    function getCartSummary(items) {
      const list =
        Array.isArray(items) ?
        items :
        [];

      return list.reduce(
        function(acc, item) {
          const quantity =
            Math.max(
              0,
              Math.floor(
                Number(
                  item &&
                  item.quantity
                ) ||
                0
              )
            );

          const unitPriceExVat =
            getItemPriceExVat(
              item
            );

          const lineSubtotalExVat =
            round2(
              unitPriceExVat *
              quantity
            );

          acc.count +=
            quantity;

          acc.subtotalExVat =
            round2(
              acc.subtotalExVat +
              lineSubtotalExVat
            );

          return acc;
        }, {
          count: 0,
          subtotalExVat: 0
        }
      );
    }

    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function renderCart(items) {
      const body = document.getElementById('cartTableBody');
      const subtotalEl =
        document.getElementById('cartSubtotal');

      const vatEl =
        document.getElementById('cartVatTotal');

      const totalEl =
        document.getElementById('cartGrandTotal');

      const headerTotals =
        document.querySelectorAll('.store-cart-total');

      const cartLinks =
        document.querySelectorAll('.store-cart-link');

      if (!body) return;

      const list = Array.isArray(items) ?
        items : [];

      const summary =
        getCartSummary(
          list
        );

      /*
       * Internal cart prices are VAT-exclusive.
       *
       * Apply the current provisional VAT rate forward:
       *
       * subtotalExVat + VAT = provisional total.
       */
      const netSubtotal =
        round2(
          summary.subtotalExVat
        );

      const vatTotal =
        round2(
          netSubtotal *
          VAT_RATE
        );

      const grossTotal =
        round2(
          netSubtotal +
          vatTotal
        );

      if (subtotalEl) {
        subtotalEl.textContent =
          formatMoney(netSubtotal);
      }

      if (vatEl) {
        vatEl.textContent =
          formatMoney(vatTotal);
      }

      if (totalEl) {
        totalEl.textContent =
          formatMoney(grossTotal);
      }

      headerTotals.forEach(function(el) {
        el.textContent =
          formatMoney(grossTotal);
      });

      cartLinks.forEach(function(link) {
        if (summary.count > 0) {
          link.classList.add('cart-flash-active');
        } else {
          link.classList.remove('cart-flash-active');
        }
      });

      if (!list.length) {
        body.innerHTML = [
          '<tr>',
          '  <td colspan="6" class="text-center py-5">',
          '    <h5 class="mb-3">Your cart is empty</h5>',
          '    <a href="/store/shop" class="btn btn-primary rounded-pill px-4 py-2">Continue Shopping</a>',
          '  </td>',
          '</tr>'
        ].join('');
        return;
      }

      body.innerHTML = list.map(function(item) {
        const size = item.variants && item.variants.size ? item.variants.size : '';
        const color = item.variants && item.variants.color ? item.variants.color : '';
        const unitDisplayPrice =
          getItemDisplayPrice(
            item
          );

        const lineTotal =
          round2(
            unitDisplayPrice *
            Number(
              item.quantity ||
              0
            )
          );

        return [
          '<tr class="cart-row" data-pid="' + escapeHtml(item.customId || '') + '" data-variant-size="' + escapeHtml(size) + '" data-variant-color="' + escapeHtml(color) + '">',
          '  <th scope="row">',
          '    <div class="py-4">',
          '      <p class="mb-1">' + escapeHtml(item.name || 'Product') + '</p>',
          (size || color) ?
          '      <small class="text-muted">' +
          (size ? ('Size: ' + escapeHtml(size)) : '') +
          (size && color ? ' | ' : '') +
          (color ? ('Color: ' + escapeHtml(color)) : '') +
          '</small>' :
          '',
          '    </div>',
          '  </th>',
          '  <td><p class="mb-0 py-4">' + escapeHtml(item.customId || 'N/A') + '</p></td>',
          '  <td><p class="mb-0 py-4">' + formatMoney(unitDisplayPrice) + '</p></td>',
          '  <td>',
          '    <div class="input-group quantity py-4" style="width: 100px;">',
          '      <div class="input-group-btn">',
          '        <button type="button" class="btn btn-sm btn-minus rounded-circle bg-light border js-cart-decrease"><i class="fa fa-minus"></i></button>',
          '      </div>',
          '      <input type="text" class="form-control form-control-sm text-center border-0" value="' + Number(item.quantity || 0) + '" readonly>',
          '      <div class="input-group-btn">',
          '        <button type="button" class="btn btn-sm btn-plus rounded-circle bg-light border js-cart-increase"><i class="fa fa-plus"></i></button>',
          '      </div>',
          '    </div>',
          '  </td>',
          '  <td><p class="mb-0 py-4">' + formatMoney(lineTotal) + '</p></td>',
          '  <td class="py-4">',
          '    <button type="button" class="btn btn-md rounded-circle bg-light border js-cart-remove">',
          '      <i class="fa fa-times text-danger"></i>',
          '    </button>',
          '  </td>',
          '</tr>'
        ].join('');
      }).join('');
    }

    async function postCart(url, payload) {
      const res = await fetch(url, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(payload || {})
      });

      const data = await res.json();

      if (!res.ok) {
        throw new Error(data.message || 'Cart update failed.');
      }

      return data;
    }

    document.addEventListener('click', async function(event) {
      const row = event.target.closest('.cart-row');
      if (!row) return;

      const pid = row.getAttribute('data-pid');
      const variants = getVariantsFromRow(row);

      try {
        if (event.target.closest('.js-cart-increase')) {
          const data = await postCart('/api/cart/increase', {
            pid: pid,
            variants: variants
          });
          renderCart(data.items || []);
          return;
        }

        if (event.target.closest('.js-cart-decrease')) {
          const data = await postCart('/api/cart/decrease', {
            pid: pid,
            variants: variants
          });
          renderCart(data.items || []);
          return;
        }

        if (event.target.closest('.js-cart-remove')) {
          const data = await postCart('/api/cart/remove', {
            pid: pid,
            variants: variants
          });
          renderCart(data.items || []);
        }
      } catch (err) {
        alert(err.message || 'Failed to update cart.');
      }
    });
  })();
</script>