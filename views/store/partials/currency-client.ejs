<!--views/store/partials/currency-client.ejs-->
<script nonce="<%= nonce %>">
  (function () {
    const BASE_CURRENCY = "<%= String(typeof baseCurrency !== 'undefined' ? baseCurrency : 'USD').trim().toUpperCase() || 'USD' %>";
    const DISPLAY_CURRENCY = "<%= String(typeof displayCurrency !== 'undefined' ? displayCurrency : BASE_CURRENCY).trim().toUpperCase() || BASE_CURRENCY %>";
    const DISPLAY_RATE_RAW =
      Number(
        "<%= Number(
          typeof displayRate !== 'undefined'
            ? displayRate
            : NaN
        ) %>"
      );

    const DISPLAY_RATE =
      Number.isFinite(DISPLAY_RATE_RAW) &&
      DISPLAY_RATE_RAW > 0
        ? DISPLAY_RATE_RAW
        : (
            BASE_CURRENCY === DISPLAY_CURRENCY
              ? 1
              : NaN
          );

    const DISPLAY_DECIMALS_RAW =
      Number(
        "<%= Number(
          typeof displayCurrencyDetails !== 'undefined' &&
          displayCurrencyDetails &&
          typeof displayCurrencyDetails.decimals !== 'undefined'
            ? displayCurrencyDetails.decimals
            : 2
        ) %>"
      );

    const DISPLAY_DECIMALS =
      Number.isInteger(
        DISPLAY_DECIMALS_RAW
      ) &&
      DISPLAY_DECIMALS_RAW >= 0 &&
      DISPLAY_DECIMALS_RAW <= 4
        ? DISPLAY_DECIMALS_RAW
        : 2;

    function roundCurrency(value) {
      const factor =
        10 ** DISPLAY_DECIMALS;

      return Math.round(
        (
          Number(value || 0) +
          Number.EPSILON
        ) *
        factor
      ) / factor;
    }

    function convertBaseToDisplay(amount) {
      const baseAmount = Number(amount || 0);

      if (
        !Number.isFinite(baseAmount) ||
        !Number.isFinite(DISPLAY_RATE) ||
        DISPLAY_RATE <= 0
      ) {
        return 0;
      }

      return roundCurrency(
        baseAmount * DISPLAY_RATE
      );
    }

    function formatDisplayMoneyFromBase(amount) {
      const displayAmount =
        convertBaseToDisplay(amount);

      const formatted =
        new Intl.NumberFormat(
          undefined,
          {
            style: 'currency',
            currency:
              DISPLAY_CURRENCY,

            minimumFractionDigits:
              DISPLAY_DECIMALS,

            maximumFractionDigits:
              DISPLAY_DECIMALS
          }
        ).format(
          displayAmount
        );

      if (DISPLAY_CURRENCY === 'ZAR') {
        return formatted.replace(/^ZAR\s?/, 'R');
      }

      return formatted;
    }

    window.KasyoraCurrency = Object.freeze({
      baseCurrency:
        BASE_CURRENCY,

      displayCurrency:
        DISPLAY_CURRENCY,

      displayRate:
        DISPLAY_RATE,

      displayDecimals:
        DISPLAY_DECIMALS,

      convertBaseToDisplay:
        convertBaseToDisplay,

      formatBaseAmount:
        formatDisplayMoneyFromBase
    });
  })();
</script>
