<!-- views/store/partials/currency-selector.ejs -->
<%
  const CURRENCY_SELECTOR_ACTIVE = String(
    typeof userCurrency !== 'undefined'
      ? userCurrency
      : (
          typeof displayCurrency !== 'undefined'
            ? displayCurrency
            : 'USD'
        )
  ).trim().toUpperCase() || 'USD';

  const CURRENCY_SELECTOR_OPTIONS =
    Array.isArray(
      typeof supportedUserCurrencies !== 'undefined'
        ? supportedUserCurrencies
        : null
    )
      ? supportedUserCurrencies
      : [];

  const CURRENCY_SELECTOR_RETURN_TO =
    typeof currencyReturnTo !== 'undefined' &&
    currencyReturnTo
      ? String(currencyReturnTo)
      : '/store';

  /*
   * The same currency selector is shared by:
   *
   * - the compact desktop topbar;
   * - the full-width mobile collapsed navbar.
   *
   * Only the mobile navbar passes:
   *
   * currencySelectorMobile: true
   */
  const CURRENCY_SELECTOR_IS_MOBILE =
    typeof currencySelectorMobile !== 'undefined' &&
    currencySelectorMobile === true;

  const CURRENCY_SELECTOR_WRAPPER_CLASS =
    CURRENCY_SELECTOR_IS_MOBILE
      ? 'dropdown w-100'
      : 'dropdown';

  const CURRENCY_SELECTOR_BUTTON_CLASS =
    CURRENCY_SELECTOR_IS_MOBILE
      ? 'btn btn-sm border-0 dropdown-toggle text-muted d-flex align-items-center justify-content-between gap-2 px-2 py-2 w-100'
      : 'btn btn-sm border-0 dropdown-toggle text-muted d-inline-flex align-items-center gap-1 px-1';

  const CURRENCY_SELECTOR_MENU_CLASS =
    CURRENCY_SELECTOR_IS_MOBILE
      ? 'dropdown-menu rounded shadow-sm border-0 p-2 w-100'
      : 'dropdown-menu dropdown-menu-end rounded shadow-sm border-0 p-2';
%>

<div class="<%= CURRENCY_SELECTOR_WRAPPER_CLASS %>">
  <button
    type="button"
    class="<%= CURRENCY_SELECTOR_BUTTON_CLASS %>"
    data-bs-toggle="dropdown"
    aria-expanded="false"
    aria-label="Choose display currency"
  >
    <% if (CURRENCY_SELECTOR_IS_MOBILE) { %>
    <span class="d-inline-flex align-items-center gap-2">
      <i
        class="fas fa-coins text-primary"
        aria-hidden="true"
      ></i>

      <span class="fw-semibold">
        <%= CURRENCY_SELECTOR_ACTIVE %>
      </span>
    </span>
    <% } else { %>
    <i
      class="fas fa-coins text-primary"
      aria-hidden="true"
    ></i>

    <span class="fw-semibold">
      <%= CURRENCY_SELECTOR_ACTIVE %>
    </span>
    <% } %>
  </button>

  <div class="<%= CURRENCY_SELECTOR_MENU_CLASS %>">
    <div class="px-2 pt-1 pb-2">
      <div class="small fw-bold text-primary">
        Display currency
      </div>

      <div class="small text-muted">
        Payments remain securely processed in USD.
      </div>
    </div>

    <% CURRENCY_SELECTOR_OPTIONS.forEach(function(currencyOption) { %>
    <form
      method="post"
      action="/currency/select"
      class="m-0"
    >
      <input
        type="hidden"
        name="currency"
        value="<%= currencyOption.code %>"
      >

      <input
        type="hidden"
        name="returnTo"
        value="<%= CURRENCY_SELECTOR_RETURN_TO %>"
      >

      <button
        type="submit"
        class="dropdown-item rounded d-flex align-items-center justify-content-between gap-3 <%= currencyOption.code === CURRENCY_SELECTOR_ACTIVE ? 'active bg-primary text-white' : '' %>"
      >
        <span class="d-inline-flex align-items-center">
          <span class="fw-semibold flex-shrink-0">
            <%= currencyOption.symbol %>
          </span>

          <span class="ms-2">
            <%= currencyOption.name %>
          </span>
        </span>

        <small class="flex-shrink-0 <%= currencyOption.code === CURRENCY_SELECTOR_ACTIVE ? 'text-white' : 'text-muted' %>">
          <%= currencyOption.code %>
        </small>
      </button>
    </form>
    <% }) %>
  </div>
</div>