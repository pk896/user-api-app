<!-- views/store/index.ejs -->
<%
  const VAT = (
    typeof vatRate !== 'undefined' &&
    vatRate !== null
  )
    ? Number(vatRate)
    : 0.15;

  /*
   * Show the existing short VAT wording only when:
   *
   * - the active department is Internal; and
   * - the resolved provisional VAT rate is greater than zero.
   *
   * CJ shows no Kasyora VAT wording.
   *
   * Internal destinations outside South Africa also show no VAT
   * wording because South African VAT is provisionally zero.
   */
  const SHOW_INTERNAL_VAT_TEXT =
    String(
      typeof storeDepartment !== 'undefined'
        ? storeDepartment
        : 'internal'
    ).trim().toLowerCase() !== 'cj' &&
    Number.isFinite(VAT) &&
    VAT > 0;

  /*
   * BASE_CURRENCY is Kasyora's authoritative internal currency.
   * DISPLAY_CURRENCY is the customer's selected presentation currency.
   *
   * Product, cart, order, payout and PayPal source values remain in
   * BASE_CURRENCY. Only visible amounts are converted here.
   */
  const BASE_CURRENCY = String(
    typeof baseCurrency !== 'undefined'
      ? baseCurrency
      : 'USD'
  ).trim().toUpperCase() || 'USD';

  const CURRENCY = String(
    typeof displayCurrency !== 'undefined'
      ? displayCurrency
      : BASE_CURRENCY
  ).trim().toUpperCase() || BASE_CURRENCY;

  const CURRENCY_RATE_RAW = Number(
    typeof displayRate !== 'undefined'
      ? displayRate
      : 1
  );

  const CURRENCY_RATE =
    Number.isFinite(CURRENCY_RATE_RAW) &&
    CURRENCY_RATE_RAW > 0
      ? CURRENCY_RATE_RAW
      : 1;

  function convertBaseToDisplay(amount) {
    const baseAmount = Number(amount || 0);

    if (!Number.isFinite(baseAmount)) {
      return 0;
    }

    return Number(
      (baseAmount * CURRENCY_RATE).toFixed(2)
    );
  }

  /*
   * Homepage marketing cards have limited display space,
   * especially on mobile.
   *
   * Preserve the complete product data everywhere else and
   * shorten only the visible homepage banner/card text.
   *
   * Text longer than 15 characters is displayed as:
   * "Women Dress Sum..."
   */
  function truncateHomepageText(value, maxCharacters = 15) {
    const text = String(value || '').trim();

    if (text.length <= maxCharacters) {
      return text;
    }

    return text.slice(0, maxCharacters).trimEnd() + '...';
  }

  const ACTIVE_DEPARTMENT = String(
    typeof storeDepartment !== 'undefined'
      ? storeDepartment
      : 'internal'
  ).trim().toLowerCase() === 'cj'
    ? 'cj'
    : 'internal';

  const IS_CJ_DEPARTMENT = ACTIVE_DEPARTMENT === 'cj';

    /*
   * Store-page navigation must always carry the selected
   * department explicitly.
   *
   * This prevents CJ pages from accidentally reopening the
   * internal storefront and prevents internal pages from
   * accidentally reopening the CJ storefront.
   */
  const ACTIVE_HOME_URL =
    '/store?department=' +
    encodeURIComponent(ACTIVE_DEPARTMENT);

  const ACTIVE_HOME_PRODUCTS_URL =
    ACTIVE_HOME_URL +
    '#homeProductsSection';

  const ACTIVE_SHOP_URL =
    '/store/shop?department=' +
    encodeURIComponent(ACTIVE_DEPARTMENT) +
    '#shopProductsSection';

  const ACTIVE_BESTSELLER_URL =
    '/store/bestseller?department=' +
    encodeURIComponent(ACTIVE_DEPARTMENT);

  const ACTIVE_CART_URL = IS_CJ_DEPARTMENT
    ? '/cj/cart'
    : '/store/cart';

  const ACTIVE_CHECKOUT_URL = IS_CJ_DEPARTMENT
    ? '/cj/checkout'
    : '/payment/checkout';

  /*
  * Currency selection must return to the same department.
  */
  const INDEX_CURRENCY_RETURN_TO =
    ACTIVE_HOME_URL;

  /*
  * Department switching from the homepage must return
  * to the homepage of the selected storefront.
  */
  const INTERNAL_INDEX_RETURN_TO =
    '/store?department=internal';

  const CJ_INDEX_RETURN_TO =
    '/store?department=cj';

  const ACTIVE_CART = (
    typeof activeStoreCart !== 'undefined' &&
    activeStoreCart
  )
    ? activeStoreCart
    : {
        count: 0,
        total: 0
      };

  function formatMoney(amount) {
    const convertedAmount =
      convertBaseToDisplay(amount);

    try {
      const formatted = new Intl.NumberFormat(
        undefined,
        {
          style: 'currency',
          currency: CURRENCY,
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }
      ).format(convertedAmount);

      if (CURRENCY === 'ZAR') {
        return formatted.replace(/^ZAR\s?/, 'R');
      }

      return formatted;
    } catch (error) {
      return `${CURRENCY} ${convertedAmount.toFixed(2)}`;
    }
  }

  function storeProductPayload(product) {
    if (
      String(product?.source || '').trim().toUpperCase() === 'CJ'
    ) {
      return encodeURIComponent(JSON.stringify({
        source: 'CJ',
        cjProductId: product.cjProductId || '',
        cjVariantId: product.defaultCjVariantId || '',
        name: product.name || '',
        image: product.image || product.imageUrl || '',
        variants: Array.isArray(product.variants)
          ? product.variants
          : []
      }));
    }

    return encodeURIComponent(JSON.stringify({
      source: 'INTERNAL',
      customId: product.customId || '',
      name: product.name || '',
      image: product.image || product.imageUrl || '',
      sizes: Array.isArray(product.sizes)
        ? product.sizes
        : [],
      colors: Array.isArray(product.colors)
        ? product.colors
        : [],
      colorImages: Array.isArray(product.colorImages)
        ? product.colorImages
        : []
    }));
  }
%>

