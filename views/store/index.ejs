<script nonce="<%= nonce %>">
  (function() {
    function formatMoney(amount) {
      if (
        window.KasyoraCurrency &&
        typeof window.KasyoraCurrency.formatBaseAmount === 'function'
      ) {
        return window.KasyoraCurrency.formatBaseAmount(
          amount
        );
      }

      const fallbackAmount = Number(amount || 0);
      const fallbackCurrency =
        "<%= BASE_CURRENCY %>";

      return new Intl.NumberFormat(
        undefined, {
          style: 'currency',
          currency: fallbackCurrency,
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }
      ).format(
        Number.isFinite(fallbackAmount) ?
        fallbackAmount :
        0
      );
    }

    function showMessage(message, type) {
      const existing = document.getElementById(
        'cjStoreCartMessage'
      );

      if (existing) {
        existing.remove();
      }

      const alert = document.createElement('div');

      alert.id = 'cjStoreCartMessage';
      alert.className =
        'alert alert-' +
        (type === 'success' ? 'success' : 'danger') +
        ' position-fixed top-0 end-0 mt-3 me-3 shadow';

      alert.style.zIndex = '2000';
      alert.style.maxWidth = '420px';
      alert.setAttribute('role', 'alert');
      alert.textContent = String(message || '');

      document.body.appendChild(alert);

      window.setTimeout(function() {
        alert.remove();
      }, 5000);
    }

    function updateActiveCart(data) {
      const itemCount = Math.max(
        0,
        Math.floor(
          Number(
            data?.itemCount ??
            data?.count ??
            0
          )
        )
      );

      const total = Number(
        data?.totalIncVat ??
        data?.total ??
        0
      );

      const shopCreateOrderButton =
        document.getElementById(
          'shopCreateOrderButton'
        );

      const shopCreateOrderQuantity =
        document.getElementById(
          'shopCreateOrderQuantity'
        );

      const mobileFloatingCart =
        document.getElementById(
          'mobileFloatingCart'
        );

      const mobileFloatingCheckoutLink =
        document.getElementById(
          'mobileFloatingCheckoutLink'
        );

      document
        .querySelectorAll('.store-cart-total')
        .forEach(function(element) {
          element.textContent = formatMoney(total);
        });

      document
        .querySelectorAll('.store-cart-link')
        .forEach(function(link) {
          link.href = '/cj/cart';

          if (itemCount > 0) {
            link.classList.add(
              'cart-flash-active'
            );
          } else {
            link.classList.remove(
              'cart-flash-active'
            );
          }
        });

      /*
       * Homepage Create Order Now button.
       * This remains completely isolated to the CJ cart.
       */
      if (
        shopCreateOrderButton &&
        shopCreateOrderButton.getAttribute(
          'data-store-department'
        ) === 'cj'
      ) {
        shopCreateOrderButton.href =
          '/cj/checkout';

        if (shopCreateOrderQuantity) {
          shopCreateOrderQuantity.textContent =
            String(itemCount);
        }

        if (itemCount > 0) {
          shopCreateOrderButton.classList.remove(
            'd-none'
          );
        } else {
          shopCreateOrderButton.classList.add(
            'd-none'
          );
        }
      }

      /*
       * Mobile floating CJ checkout total.
       */
      if (mobileFloatingCheckoutLink) {
        mobileFloatingCheckoutLink.href =
          '/cj/checkout';
      }

      if (mobileFloatingCart) {
        if (itemCount > 0) {
          mobileFloatingCart.classList.remove(
            'd-none'
          );
        } else {
          mobileFloatingCart.classList.add(
            'd-none'
          );
        }
      }
    }

    async function addCjItem(button) {
      const cjProductId = String(
        button.getAttribute('data-cj-product-id') || ''
      ).trim();

      const cjVariantId = String(
        button.getAttribute('data-cj-variant-id') || ''
      ).trim();

      if (!cjProductId || !cjVariantId) {
        throw new Error(
          'This CJ product does not have a valid selected variant.'
        );
      }

      const originalHtml = button.innerHTML;

      button.disabled = true;
      button.innerHTML =
        '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>' +
        'Adding...';

      try {
        const response = await fetch('/api/cj-cart/add', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          credentials: 'same-origin',
          body: JSON.stringify({
            cjProductId: cjProductId,
            cjVariantId: cjVariantId,
            quantity: 1
          })
        });

        const data = await response
          .json()
          .catch(function() {
            return {};
          });

        if (!response.ok || data.success === false) {
          throw new Error(
            data.message ||
            'The CJ product could not be added to the CJ cart.'
          );
        }

        updateActiveCart(data);

        showMessage(
          data.message ||
          'CJ product added to your separate CJ cart.',
          'success'
        );
      } finally {
        button.disabled = false;
        button.innerHTML = originalHtml;
      }
    }

    document.addEventListener('click', async function(event) {
      const button = event.target.closest(
        '.js-add-to-cj-cart'
      );

      if (!button) {
        return;
      }

      event.preventDefault();

      try {
        await addCjItem(button);
      } catch (error) {
        showMessage(
          error?.message ||
          'Failed to add the CJ product.',
          'error'
        );
      }
    });

    async function loadCjCart() {
      try {
        const response = await fetch('/api/cj-cart', {
          headers: {
            'Accept': 'application/json'
          },
          credentials: 'same-origin'
        });

        const data = await response
          .json()
          .catch(function() {
            return {};
          });

        if (response.ok) {
          updateActiveCart(data);
        }
      } catch (error) {
        console.error(
          'Failed to load the active CJ cart:',
          error
        );
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener(
        'DOMContentLoaded',
        loadCjCart, {
          once: true
        }
      );
    } else {
      loadCjCart();
    }
  })();
</script>
<% } %>

<script nonce="<%= nonce %>">
  (function() {
    const topCart = document.getElementById('storeTopCartAmount');
    if (!topCart) return;

    const topCartTotal = topCart.querySelector('.store-cart-total');
    if (!topCartTotal) return;

    function cartAmountNumber() {
      const raw = String(topCartTotal.textContent || '').replace(/[^0-9.-]/g, '');
      const amount = Number(raw);
      return Number.isFinite(amount) ? amount : 0;
    }

    function syncTopCartSticky() {
      if (cartAmountNumber() > 0) {
        topCart.classList.add('position-fixed', 'top-0', 'end-0', 'mt-5', 'me-5');
        topCart.style.zIndex = '1080';
      } else {
        topCart.classList.remove('position-fixed', 'top-0', 'end-0', 'mt-5', 'me-5');
        topCart.style.zIndex = '';
      }
    }

    syncTopCartSticky();

    const observer = new MutationObserver(syncTopCartSticky);
    observer.observe(topCartTotal, {
      childList: true,
      characterData: true,
      subtree: true
    });

    window.addEventListener('pageshow', syncTopCartSticky);
  })();
</script>

<script nonce="<%= nonce %>">
  document.addEventListener('click', function(event) {
    const button = event.target.closest('.js-hero-shop-button');

    if (!button) {
      return;
    }

    const buttonText = button.querySelector(
      '.js-hero-shop-button-text'
    );

    if (buttonText) {
      buttonText.textContent = 'Loading...';
    }

    button.setAttribute('aria-busy', 'true');
    button.classList.add('disabled');
  });

  window.addEventListener('pageshow', function() {
    document
      .querySelectorAll('.js-hero-shop-button')
      .forEach(function(button) {
        const buttonText = button.querySelector(
          '.js-hero-shop-button-text'
        );

        const originalText = String(
          button.getAttribute('data-original-text') || ''
        ).trim();

        if (buttonText && originalText) {
          buttonText.textContent = originalText;
        }

        button.removeAttribute('aria-busy');
        button.classList.remove('disabled');
      });
  });
</script>

