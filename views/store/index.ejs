<script nonce="<%= nonce %>">
  (function() {
    const btn = document.getElementById('backToTopBtn');
    if (!btn) return;

    function toggleBackToTop() {
      if (window.scrollY > 300) {
        btn.style.display = 'inline-flex';
        btn.style.alignItems = 'center';
        btn.style.justifyContent = 'center';
      } else {
        btn.style.display = 'none';
      }
    }

    btn.addEventListener('click', function(event) {
      event.preventDefault();
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });

    window.addEventListener('scroll', toggleBackToTop);
    toggleBackToTop();
  })();
</script>

<script nonce="<%= nonce %>">
  (function() {
    const select =
      document.getElementById(
        'storeCategorySelect'
      );

    const keywordInput =
      document.getElementById(
        'storeKeywordInput'
      );

    const keywordInputSecondary =
      document.getElementById(
        'bestsellerKeywordInputSecondary'
      );

    const keywordBtn =
      document.getElementById(
        'storeKeywordSearchBtn'
      );

    const keywordBtnSecondary =
      document.getElementById(
        'bestsellerKeywordSearchBtnSecondary'
      );

    const links = Array.from(
      document.querySelectorAll(
        '.store-category-link'
      )
    );

    if (!select) {
      return;
    }

    function getKeyword() {
      const primaryValue =
        keywordInput ?
        String(
          keywordInput.value || ''
        ).trim() :
        '';

      const secondaryValue =
        keywordInputSecondary ?
        String(
          keywordInputSecondary.value || ''
        ).trim() :
        '';

      return (
        primaryValue ||
        secondaryValue
      );
    }

    function syncKeywordInputs(keyword) {
      if (keywordInput) {
        keywordInput.value = keyword;
      }

      if (keywordInputSecondary) {
        keywordInputSecondary.value =
          keyword;
      }
    }

    function buildHomeProductsUrl(
      keyword,
      category
    ) {
      const params =
        new URLSearchParams();

      /*
       * The active department is always included,
       * even when no keyword or category is selected.
       */
      params.set(
        'department',
        '<%= ACTIVE_DEPARTMENT %>'
      );

      if (keyword) {
        params.set(
          'keyword',
          keyword
        );
      }

      if (category) {
        params.set(
          'category',
          category
        );
      }

      return (
        '/store?' +
        params.toString() +
        '#homeProductsSection'
      );
    }

    function goToHomeProducts(
      categoryValue
    ) {
      const keyword = getKeyword();

      const category = String(
        categoryValue != null ?
        categoryValue :
        select.value || ''
      ).trim();

      syncKeywordInputs(keyword);

      window.location.href =
        buildHomeProductsUrl(
          keyword,
          category
        );
    }

    links.forEach(function(link) {
      link.addEventListener(
        'click',
        function(event) {
          event.preventDefault();

          goToHomeProducts(
            link.getAttribute(
              'data-category'
            )
          );
        }
      );
    });

    select.addEventListener(
      'change',
      function() {
        goToHomeProducts(
          select.value
        );
      }
    );

    if (keywordInput) {
      keywordInput.addEventListener(
        'input',
        function() {
          const keyword = String(
            keywordInput.value || ''
          ).trim();

          const category = String(
            select ?
            select.value || '' :
            ''
          ).trim();

          syncKeywordInputs(keyword);

          if (!keyword) {
            window.location.href =
              buildHomeProductsUrl(
                '',
                category
              );
          }
        }
      );

      keywordInput.addEventListener(
        'keydown',
        function(event) {
          if (event.key === 'Enter') {
            event.preventDefault();

            goToHomeProducts(
              select.value
            );
          }
        }
      );
    }

    if (keywordInputSecondary) {
      keywordInputSecondary.addEventListener(
        'input',
        function() {
          const keyword = String(
            keywordInputSecondary.value ||
            ''
          ).trim();

          const category = String(
            select ?
            select.value || '' :
            ''
          ).trim();

          syncKeywordInputs(keyword);

          if (!keyword) {
            window.location.href =
              buildHomeProductsUrl(
                '',
                category
              );
          }
        }
      );

      keywordInputSecondary.addEventListener(
        'keydown',
        function(event) {
          if (event.key === 'Enter') {
            event.preventDefault();

            goToHomeProducts(
              select.value
            );
          }
        }
      );
    }

    if (keywordBtn) {
      keywordBtn.addEventListener(
        'click',
        function() {
          goToHomeProducts(
            select.value
          );
        }
      );
    }

    if (keywordBtnSecondary) {
      keywordBtnSecondary.addEventListener(
        'click',
        function() {
          goToHomeProducts(
            select.value
          );
        }
      );
    }
  })();
</script>

