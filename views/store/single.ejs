<script nonce="<%= nonce %>">
  (function() {
    const SINGLE_PRODUCT_ANCHOR_ID =
      'singleProductDetails';

    function landOnSingleProduct() {
      const productSection =
        document.getElementById(
          SINGLE_PRODUCT_ANCHOR_ID
        );

      if (!productSection) {
        return;
      }

      const currentHash =
        String(
          window.location.hash || ''
        ).trim();

      /*
       * Preserve deliberate anchors such as the ratings form
       * or reviews section.
       */
      if (
        currentHash &&
        currentHash !==
        '#' + SINGLE_PRODUCT_ANCHOR_ID
      ) {
        return;
      }

      /*
       * Product links from older cards may not yet contain
       * the anchor. Add it without reloading the page.
       */
      if (!currentHash) {
        window.history.replaceState(
          null,
          '',
          window.location.pathname +
          window.location.search +
          '#' +
          SINGLE_PRODUCT_ANCHOR_ID
        );
      }

      productSection.scrollIntoView({
        behavior: 'auto',
        block: 'start'
      });
    }

    window.addEventListener(
      'load',
      function() {
        /*
         * Allow the product image and Owl Carousel to finish
         * their final layout before positioning the page.
         */
        window.setTimeout(
          landOnSingleProduct,
          100
        );
      }
    );

    window.addEventListener(
      'pageshow',
      function() {
        window.setTimeout(
          landOnSingleProduct,
          100
        );
      }
    );
  })();
</script>