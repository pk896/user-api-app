<!--views/store/single.ejs-->
<%
  /*
   * Resolved Internal single-product tax context
   * =============================================
   *
   * The /store/product/:id route supplies taxTreatment for
   * this Internal Kasyora Store request.
   *
   * Possible treatments:
   *
   * - VAT_DISABLED
   * - ZA_STANDARD
   * - ZA_EXPORT_ZERO_RATED
   *
   * The checkout shipping address remains authoritative for
   * the final VAT calculation.
   */
  const SINGLE_TAX_TREATMENT =
    typeof taxTreatment !== 'undefined' &&
    taxTreatment &&
    typeof taxTreatment === 'object'
      ? taxTreatment
      : (
          typeof internalTaxTreatment !== 'undefined' &&
          internalTaxTreatment &&
          typeof internalTaxTreatment === 'object'
            ? internalTaxTreatment
            : {}
        );

  /*
   * Safe VAT-rate priority:
   *
   * 1. taxTreatment.vatRate
   * 2. route vatRate
   * 3. middleware internalVatRate
   * 4. zero
   *
   * Never assume 15% inside this template.
   */
  const SINGLE_VAT_RATE_RAW =
    Number(
      SINGLE_TAX_TREATMENT.vatRate ??
      (
        typeof vatRate !== 'undefined'
          ? vatRate
          : (
              typeof internalVatRate !== 'undefined'
                ? internalVatRate
                : 0
            )
      )
    );

  const VAT =
    Number.isFinite(
      SINGLE_VAT_RATE_RAW
    ) &&
    SINGLE_VAT_RATE_RAW >= 0 &&
    SINGLE_VAT_RATE_RAW <= 1
      ? SINGLE_VAT_RATE_RAW
      : 0;

  const SINGLE_VAT_ENABLED =
    SINGLE_TAX_TREATMENT.vatEnabled === true ||
    (
      typeof internalVatEnabled !== 'undefined' &&
      internalVatEnabled === true
    );

  /*
   * Show "incl. VAT" only when the visible price actually
   * contains a positive VAT amount.
   *
   * VAT disabled and foreign zero-rated destinations show
   * the price without VAT wording.
   */
  const SHOW_SINGLE_VAT_TEXT =
    SINGLE_VAT_ENABLED &&
    VAT > 0;

  /*
   * BASE_CURRENCY remains Kasyora's authoritative product,
   * cart, VAT, shipping, order and accounting currency.
   *
   * CURRENCY is only the customer's selected display currency.
   * Product and cart source values are never changed here.
   */
  const BASE_CURRENCY = String(
    typeof baseCurrency !== 'undefined'
      ? baseCurrency
      : 'USD'
  ).trim().toUpperCase() || 'USD';

  const CURRENCY = String(
    typeof displayCurrency !== 'undefined'
      ? displayCurrency
      : BASE_CURRENCY
  ).trim().toUpperCase() || BASE_CURRENCY;

  const CURRENCY_RATE_RAW = Number(
    typeof displayRate !== 'undefined'
      ? displayRate
      : NaN
  );

  /*
   * displayCurrency/displayRate are already resolved safely by
   * middleware/userCurrency.js.
   *
   * If FX conversion is unavailable, that middleware changes the
   * actual rendered displayCurrency back to BASE_CURRENCY and
   * supplies rate 1.
   *
   * Keep the template defensive too: rate 1 is safe without an FX
   * lookup only when the rendered currency is BASE_CURRENCY.
   */
  const CURRENCY_RATE =
    Number.isFinite(CURRENCY_RATE_RAW) &&
    CURRENCY_RATE_RAW > 0
      ? CURRENCY_RATE_RAW
      : (
          CURRENCY === BASE_CURRENCY
            ? 1
            : NaN
        );

  /*
   * Display rounding must follow the currency that is actually
   * rendered on this response.
   *
   * Examples:
   *
   * JPY -> 0 decimals
   * USD -> 2 decimals
   * KWD -> 3 decimals
   */
  const CURRENCY_DECIMALS_RAW = Number(
    typeof displayCurrencyDetails !== 'undefined' &&
    displayCurrencyDetails &&
    typeof displayCurrencyDetails.decimals !== 'undefined'
      ? displayCurrencyDetails.decimals
      : 2
  );

  const CURRENCY_DECIMALS =
    Number.isInteger(CURRENCY_DECIMALS_RAW) &&
    CURRENCY_DECIMALS_RAW >= 0 &&
    CURRENCY_DECIMALS_RAW <= 4
      ? CURRENCY_DECIMALS_RAW
      : 2;

  /*
   * Convert only visible values.
   *
   * The original amount remains a BASE_CURRENCY amount.
   */
  function convertBaseToDisplay(amount) {
    const baseAmount = Number(amount || 0);

    if (
      !Number.isFinite(baseAmount) ||
      !Number.isFinite(CURRENCY_RATE) ||
      CURRENCY_RATE <= 0
    ) {
      return 0;
    }

    return Number(
      (
        baseAmount *
        CURRENCY_RATE
      ).toFixed(
        CURRENCY_DECIMALS
      )
    );
  }

  function formatMoney(amount) {
    const convertedAmount =
      convertBaseToDisplay(amount);

    try {
      const formatted =
        new Intl.NumberFormat(
          undefined,
          {
            style: 'currency',

            currency:
              CURRENCY,

            minimumFractionDigits:
              CURRENCY_DECIMALS,

            maximumFractionDigits:
              CURRENCY_DECIMALS
          }
        ).format(
          convertedAmount
        );

      if (CURRENCY === 'ZAR') {
        return formatted.replace(
          /^ZAR\s?/,
          'R'
        );
      }

      return formatted;
    } catch (error) {
      return (
        CURRENCY +
        ' ' +
        convertedAmount.toFixed(
          CURRENCY_DECIMALS
        )
      );
    }
  }

  /*
   * Product.price remains VAT-exclusive.
   *
   * This helper changes only the visible storefront amount.
   */
  function getSingleVisiblePrice(item) {
    const basePriceRaw =
      Number(
        item?.price || 0
      );

    const basePrice =
      Number.isFinite(basePriceRaw) &&
      basePriceRaw >= 0
        ? basePriceRaw
        : 0;

    return Number(
      (
        basePrice *
        (
          1 +
          VAT
        )
      ).toFixed(2)
    );
  }

  /*
   * product.oldPrice is already the authoritative
   * VAT-exclusive comparison amount in BASE_CURRENCY.
   *
   * Apply only the resolved provisional Internal VAT rate
   * for visible storefront presentation.
   */
  function getSingleVisibleOldPrice(item) {
    const oldPriceRaw =
      Number(
        item?.oldPrice
      );

    if (
      !Number.isFinite(oldPriceRaw) ||
      oldPriceRaw <= 0
    ) {
      return null;
    }

    return Number(
      (
        oldPriceRaw *
        (
          1 +
          VAT
        )
      ).toFixed(2)
    );
  }

  /*
   * Related-product cards have limited display space,
   * especially on mobile.
   *
   * Keep complete product values unchanged for URLs,
   * cart data, search data, alt text and product details.
   * Shorten only the visible card text.
   */
  function truncateSingleCardText(
    value,
    maxCharacters
  ) {
    const text = String(
      value || ''
    ).trim();

    const safeLimit = Number.isFinite(
      Number(maxCharacters)
    )
      ? Math.max(
          0,
          Math.floor(
            Number(maxCharacters)
          )
        )
      : 15;

    if (
      !safeLimit ||
      text.length <= safeLimit
    ) {
      return text;
    }

    return (
      text
        .slice(0, safeLimit)
        .trimEnd() +
      '...'
    );
  }

  const SINGLE_PRODUCT_ID = String(
    product && product.customId
      ? product.customId
      : ''
  ).trim();

  /*
   * Return the customer to this exact product after changing
   * their display currency.
   */
  const SINGLE_PRODUCT_ANCHOR =
    '#singleProductDetails';

  /*
   * Both the currency selector and provisional delivery-country
   * selector return to this exact Internal product.
   */
  const SINGLE_CURRENCY_RETURN_TO =
    SINGLE_PRODUCT_ID
      ? (
          '/store/product/' +
          encodeURIComponent(
            SINGLE_PRODUCT_ID
          ) +
          '?department=internal' +
          SINGLE_PRODUCT_ANCHOR
        )
      : (
          '/store/shop' +
          '?department=internal' +
          '#shopProductsSection'
        );

  /*
  * The single-product page belongs only to Kasyora's
  * Internal commerce flow.
  *
  * No CJ cart, checkout, order or product route is used here.
  */
  const SINGLE_HOME_URL =
    '/store?department=internal';

  const SINGLE_SHOP_URL =
    '/store/shop?department=internal#shopProductsSection';

  const SINGLE_BESTSELLER_URL =
    '/store/bestseller?department=internal';

  const SINGLE_CART_URL =
    '/store/cart';

  const SINGLE_CHECKOUT_URL =
    '/payment/checkout';

  const SINGLE_CURRENT_PAGE_URL =
    SINGLE_PRODUCT_ID
      ? (
          '/store/product/' +
          encodeURIComponent(SINGLE_PRODUCT_ID) +
          SINGLE_PRODUCT_ANCHOR
        )
      : '/store/shop?department=internal#shopProductsSection';

  const avgRating = Number(
    (product && product.avgRating) || 0
  );

  const ratingsCount = Number(
    (product && product.ratingsCount) || 0
  );

  const ratingSummaryText =
    ratingsCount > 0
      ? (
          `${avgRating.toFixed(1)} • ` +
          `${ratingsCount} review` +
          `${ratingsCount === 1 ? '' : 's'}`
        )
      : 'No reviews yet';

  function storeProductPayload(product) {
    return encodeURIComponent(JSON.stringify({
      customId: product.customId || '',
      name: product.name || '',
      image: product.image || product.imageUrl || '',
      sizes: Array.isArray(product.sizes)
        ? product.sizes
        : [],
      colors: Array.isArray(product.colors)
        ? product.colors
        : [],
      colorImages: Array.isArray(product.colorImages)
        ? product.colorImages
        : []
    }));
  }
%>

<%
  /*
   * Internal Kasyora Product structured data
   * =========================================
   *
   * This describes only the current Internal Kasyora product.
   *
   * Pricing is intentionally NOT included yet because:
   *
   * - Product.price is authoritative in BASE_CURRENCY;
   * - the visible display currency can change per customer;
   * - provisional VAT can change according to destination;
   * - checkout shipping address later becomes authoritative.
   *
   * We must not publish misleading Offer.price structured data.
   */
  const INTERNAL_PRODUCT_SCHEMA_SITE_URL =
    String(
      typeof siteUrl !== 'undefined' &&
      siteUrl
        ? siteUrl
        : (
            typeof appUrl !== 'undefined' &&
            appUrl
              ? appUrl
              : 'https://kasyora.com'
          )
    )
      .trim()
      .replace(/\/+$/, '');

  const INTERNAL_PRODUCT_SCHEMA_URL =
    INTERNAL_PRODUCT_SCHEMA_SITE_URL +
    '/store/product/' +
    encodeURIComponent(
      String(
        product?.customId ||
        ''
      ).trim()
    );

  const INTERNAL_PRODUCT_SCHEMA_IMAGES =
    [
      product?.image,
      product?.imageUrl,
      ...(Array.isArray(product?.colorImages)
        ? product.colorImages.map(function (entry) {
            return entry?.imageUrl || '';
          })
        : [])
    ]
      .map(function (imageUrl) {
        const raw =
          String(
            imageUrl ||
            ''
          ).trim();

        if (!raw) {
          return '';
        }

        if (/^https?:\/\//i.test(raw)) {
          return raw;
        }

        return (
          INTERNAL_PRODUCT_SCHEMA_SITE_URL +
          '/' +
          raw.replace(/^\/+/, '')
        );
      })
      .filter(Boolean)
      .filter(function (imageUrl, index, array) {
        return array.indexOf(imageUrl) === index;
      });

  const INTERNAL_PRODUCT_SCHEMA = {
    '@context': 'https://schema.org',

    '@type': 'Product',

    '@id':
      INTERNAL_PRODUCT_SCHEMA_URL +
      '#product',

    url:
      INTERNAL_PRODUCT_SCHEMA_URL,

    name:
      String(
        product?.name ||
        'Product'
      ).trim(),

    sku:
      String(
        product?.customId ||
        ''
      ).trim(),

    category:
      String(
        product?.category ||
        'Product'
      ).trim(),

    image:
      INTERNAL_PRODUCT_SCHEMA_IMAGES,

    description:
      String(
        product?.description ||
        (
          String(
            product?.name ||
            'Product'
          ).trim() +
          ' available on Kasyora.'
        )
      ).trim()
  };

  if (
    Number.isFinite(
      Number(
        product?.avgRating
      )
    ) &&
    Number(
      product?.avgRating
    ) > 0 &&
    Number(
      product?.avgRating
    ) <= 5 &&
    Number.isFinite(
      Number(
        product?.ratingsCount
      )
    ) &&
    Number(
      product?.ratingsCount
    ) > 0
  ) {
    INTERNAL_PRODUCT_SCHEMA.aggregateRating = {
      '@type':
        'AggregateRating',

      ratingValue:
        Number(
          Number(
            product.avgRating
          ).toFixed(2)
        ),

      ratingCount:
        Math.max(
          1,
          Math.floor(
            Number(
              product.ratingsCount
            )
          )
        ),

      bestRating:
        5,

      worstRating:
        1
    };
  }

  function safeInternalProductSchemaJson(value) {
    return JSON.stringify(
      value
    )
      .replace(
        /</g,
        '\\u003c'
      )
      .replace(
        />/g,
        '\\u003e'
      )
      .replace(
        /&/g,
        '\\u0026'
      );
  }
%>

<script
  type="application/ld+json"
  nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>"
><%- safeInternalProductSchemaJson(INTERNAL_PRODUCT_SCHEMA) %></script>

<%
  /*
   * Internal product breadcrumb structured data
   * ============================================
   *
   * Search hierarchy:
   *
   * Kasyora
   * → Store
   * → Shop
   * → Current Internal product
   */
  const INTERNAL_PRODUCT_BREADCRUMB_SCHEMA = {
    '@context': 'https://schema.org',

    '@type': 'BreadcrumbList',

    itemListElement: [
      {
        '@type': 'ListItem',

        position: 1,

        name: 'Kasyora',

        item:
          INTERNAL_PRODUCT_SCHEMA_SITE_URL +
          '/'
      },

      {
        '@type': 'ListItem',

        position: 2,

        name: 'Store',

        item:
          INTERNAL_PRODUCT_SCHEMA_SITE_URL +
          '/store'
      },

      {
        '@type': 'ListItem',

        position: 3,

        name: 'Shop',

        item:
          INTERNAL_PRODUCT_SCHEMA_SITE_URL +
          '/store/shop'
      },

      {
        '@type': 'ListItem',

        position: 4,

        name:
          String(
            product?.name ||
            'Product'
          ).trim(),

        item:
          INTERNAL_PRODUCT_SCHEMA_URL
      }
    ]
  };
%>

<script
  type="application/ld+json"
  nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>"
><%- safeInternalProductSchemaJson(INTERNAL_PRODUCT_BREADCRUMB_SCHEMA) %></script>

