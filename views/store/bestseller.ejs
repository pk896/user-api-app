<!--views/store/bestseller.ejs-->
<%
  const VAT = (
    typeof vatRate !== 'undefined' &&
    vatRate !== null
  )
    ? Number(vatRate)
    : 0.15;

  /*
   * BASE_CURRENCY remains Kasyora's authoritative product,
   * cart, VAT, shipping, order and accounting currency.
   *
   * CURRENCY is only the customer's selected display currency.
   */
  const BASE_CURRENCY = String(
    typeof baseCurrency !== 'undefined'
      ? baseCurrency
      : 'USD'
  ).trim().toUpperCase() || 'USD';

  const CURRENCY = String(
    typeof displayCurrency !== 'undefined'
      ? displayCurrency
      : BASE_CURRENCY
  ).trim().toUpperCase() || BASE_CURRENCY;

  const CURRENCY_RATE_RAW = Number(
    typeof displayRate !== 'undefined'
      ? displayRate
      : 1
  );

  const CURRENCY_RATE =
    Number.isFinite(CURRENCY_RATE_RAW) &&
    CURRENCY_RATE_RAW > 0
      ? CURRENCY_RATE_RAW
      : 1;

  /*
   * Convert only customer-visible amounts.
   * Product and cart source values remain in BASE_CURRENCY.
   */
  function convertBaseToDisplay(amount) {
    const baseAmount = Number(amount || 0);

    if (!Number.isFinite(baseAmount)) {
      return 0;
    }

    return Number(
      (
        baseAmount *
        CURRENCY_RATE
      ).toFixed(2)
    );
  }

  /*
   * Product cards have limited display space, especially
   * on mobile.
   *
   * Keep the complete product data unchanged and shorten
   * only the visible category and product-name text.
   */
  function truncateBestsellerText(
    value,
    maxCharacters = 15
  ) {
    const text = String(
      value || ''
    ).trim();

    if (
      text.length <=
      maxCharacters
    ) {
      return text;
    }

    return (
      text
        .slice(
          0,
          maxCharacters
        )
        .trimEnd() +
      '...'
    );
  }

  function formatMoney(amount) {
    const convertedAmount =
      convertBaseToDisplay(amount);

    try {
      const formatted = new Intl.NumberFormat(
        undefined,
        {
          style: 'currency',
          currency: CURRENCY,
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }
      ).format(convertedAmount);

      if (CURRENCY === 'ZAR') {
        return formatted.replace(/^ZAR\s?/, 'R');
      }

      return formatted;
    } catch (error) {
      return (
        CURRENCY +
        ' ' +
        convertedAmount.toFixed(2)
      );
    }
  }

  const ACTIVE_DEPARTMENT = String(
    typeof storeDepartment !== 'undefined'
      ? storeDepartment
      : 'internal'
  ).trim().toLowerCase() === 'cj'
    ? 'cj'
    : 'internal';

  const IS_CJ_DEPARTMENT =
    ACTIVE_DEPARTMENT === 'cj';

  /*
   * Pure Bestseller-page requests land at the active
   * Kasyora In Store / Kasyora CJ Store Bestseller notice.
   *
   * Search, category, sorting and other filtered requests
   * must land at the Bestseller products section.
   */
  const BESTSELLER_DEPARTMENT_ANCHOR =
    '#bestsellerDepartmentSection';

  const BESTSELLER_PRODUCTS_ANCHOR =
    '#bestsellerProductsSection';

  const ACTIVE_SORT = String(
    typeof selectedSort !== 'undefined'
      ? selectedSort
      : 'popular'
  ).trim() || 'popular';

  const ACTIVE_HOME_URL =
    '/store?department=' +
    encodeURIComponent(
      ACTIVE_DEPARTMENT
    );

  const ACTIVE_SHOP_URL =
    '/store/shop?department=' +
    encodeURIComponent(
      ACTIVE_DEPARTMENT
    ) +
    '#shopDepartmentSection';

  const ACTIVE_BESTSELLER_URL =
    '/store/bestseller?department=' +
    encodeURIComponent(
      ACTIVE_DEPARTMENT
    ) +
    BESTSELLER_DEPARTMENT_ANCHOR;

  const ACTIVE_CART_URL =
    IS_CJ_DEPARTMENT
      ? '/cj/cart'
      : '/store/cart';

  const ACTIVE_CHECKOUT_URL =
    IS_CJ_DEPARTMENT
      ? '/cj/checkout'
      : '/payment/checkout';

  const ACTIVE_CART = (
    typeof activeStoreCart !== 'undefined' &&
    activeStoreCart
  )
    ? activeStoreCart
    : {
        count: 0,
        total: 0
      };

  function bestsellerPageUrlForDepartment(
    department
  ) {
    const safeDepartment =
      String(department || '')
        .trim()
        .toLowerCase() === 'cj'
        ? 'cj'
        : 'internal';

    const params = [];

    params.push(
      'department=' +
      encodeURIComponent(
        safeDepartment
      )
    );

    const keyword = String(
      typeof selectedKeyword !== 'undefined'
        ? selectedKeyword
        : ''
    ).trim();

    const category = String(
      typeof selectedCategory !== 'undefined'
        ? selectedCategory
        : ''
    ).trim();

    if (keyword) {
      params.push(
        'keyword=' +
        encodeURIComponent(keyword)
      );
    }

    if (category) {
      params.push(
        'category=' +
        encodeURIComponent(category)
      );
    }

    if (ACTIVE_SORT) {
      params.push(
        'sort=' +
        encodeURIComponent(
          ACTIVE_SORT
        )
      );
    }

    return (
      '/store/bestseller?' +
      params.join('&') +
      BESTSELLER_PRODUCTS_ANCHOR
    );
  }

  function bestsellerPageUrl() {
    return bestsellerPageUrlForDepartment(
      ACTIVE_DEPARTMENT
    );
  }

  const BESTSELLER_CURRENCY_RETURN_TO =
    bestsellerPageUrl();

  const INTERNAL_BESTSELLER_RETURN_TO =
    '/store/bestseller?department=internal' +
    BESTSELLER_DEPARTMENT_ANCHOR;

  const CJ_BESTSELLER_RETURN_TO =
    '/store/bestseller?department=cj' +
    BESTSELLER_DEPARTMENT_ANCHOR;

  function storeProductPayload(product) {
    const source = String(
      product?.source || ''
    ).trim().toUpperCase();

    if (source === 'CJ') {
      return encodeURIComponent(
        JSON.stringify({
          source: 'CJ',

          cjProductId:
            product.cjProductId || '',

          cjVariantId:
            product.defaultCjVariantId || '',

          name:
            product.name || '',

          image:
            product.image ||
            product.imageUrl ||
            '',

          variants:
            Array.isArray(product.variants)
              ? product.variants
              : []
        })
      );
    }

    return encodeURIComponent(
      JSON.stringify({
        source: 'INTERNAL',

        customId:
          product.customId || '',

        name:
          product.name || '',

        image:
          product.image ||
          product.imageUrl ||
          '',

        sizes:
          Array.isArray(product.sizes)
            ? product.sizes
            : [],

        colors:
          Array.isArray(product.colors)
            ? product.colors
            : [],

        colorImages:
          Array.isArray(product.colorImages)
            ? product.colorImages
            : []
      })
    );
  }

  function getDefaultCjVariant(product) {
    if (!Array.isArray(product?.variants)) {
      return null;
    }

    return (
      product.variants.find(
        function(variant) {
          return (
            String(
              variant?.cjVariantId || ''
            ) ===
            String(
              product?.defaultCjVariantId || ''
            )
          );
        }
      ) ||
      product.variants[0] ||
      null
    );
  }
%>

