<style nonce="<%= nonce %>">
  /*
   * Compact promotional cards used only by the separate
   * Kasyora CJ Store Bestseller section.
   *
   * Bootstrap handles the responsive grid. These few custom
   * rules are required for the fixed compact card proportions,
   * two-line text clamping and mobile image containment.
   */
  .cj-bestseller-offer {
    position: relative;
    min-height: 230px;
    border: 1px solid rgba(124, 58, 237, 0.12);
    isolation: isolate;
  }

  .cj-bestseller-offer-left {
    background:
      radial-gradient(circle at 90% 15%,
        rgba(255, 255, 255, 0.22),
        transparent 34%),
      linear-gradient(135deg,
        #7C3AED 0%,
        #5B21B6 100%);
  }

  .cj-bestseller-offer-right {
    background:
      radial-gradient(circle at 90% 15%,
        rgba(255, 255, 255, 0.2),
        transparent 34%),
      linear-gradient(135deg,
        #111827 0%,
        #166534 100%);
  }

  .cj-bestseller-offer-content {
    min-width: 0;
  }

  .cj-bestseller-offer-badge {
    max-width: 100%;
    font-size: 0.68rem;
    letter-spacing: 0.03em;
  }

  .cj-bestseller-offer-title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    line-height: 1.2;
  }

  .cj-bestseller-offer-promotion {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    line-clamp: 1;
  }

  .cj-bestseller-offer-image-panel {
    min-height: 230px;
    background: rgba(255, 255, 255, 0.96);
  }

  .cj-bestseller-offer-image {
    width: 100%;
    height: 210px;
    object-fit: contain;
  }

  .cj-bestseller-offer-button {
    max-width: 100%;
    font-size: 0.78rem;
  }

  @media (max-width: 575.98px) {
    .cj-bestseller-offer {
      min-height: 220px;
    }

    .cj-bestseller-offer-image-panel {
      min-height: 220px;
    }

    .cj-bestseller-offer-image {
      height: 190px;
    }

    .cj-bestseller-offer-title {
      font-size: 1rem;
    }

    .cj-bestseller-offer-price {
      font-size: 0.72rem;
    }
  }

  @media (min-width: 576px) {
    .cj-bestseller-offer {
      min-height: 280px;
    }

    .cj-bestseller-offer-image-panel {
      min-height: 280px;
    }

    .cj-bestseller-offer-image {
      height: 250px;
    }
  }
</style>

