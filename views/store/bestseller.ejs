<script nonce="<%= nonce %>">
  (function() {
    const select = document.getElementById('bestsellerCategorySelect');
    const keywordInput = document.getElementById('bestsellerKeywordInput');
    const keywordInputSecondary = document.getElementById('bestsellerKeywordInputSecondary');
    const keywordBtn = document.getElementById('bestsellerKeywordSearchBtn');
    const keywordBtnSecondary = document.getElementById('bestsellerKeywordSearchBtnSecondary');
    const sortSelect = document.getElementById('bestsellerSortSelect');
    const links = Array.from(document.querySelectorAll('.bestseller-category-link'));

    if (!select) return;

    function getKeyword() {
      const primaryValue = keywordInput ? String(keywordInput.value || '').trim() : '';
      const secondaryValue = keywordInputSecondary ? String(keywordInputSecondary.value || '').trim() : '';
      return primaryValue || secondaryValue;
    }

    function syncKeywordInputs(keyword) {
      if (keywordInput) {
        keywordInput.value = keyword;
      }

      if (keywordInputSecondary) {
        keywordInputSecondary.value = keyword;
      }
    }

    function goToBestseller(categoryValue) {
      const params = new URLSearchParams();

      params.set(
        'department',
        '<%= ACTIVE_DEPARTMENT %>'
      );

      const keyword = getKeyword();

      const category = String(
        categoryValue != null ?
        categoryValue :
        select.value || ''
      ).trim();

      const sort = String(
        sortSelect ?
        sortSelect.value || '' :
        '<%= ACTIVE_SORT %>'
      ).trim();

      syncKeywordInputs(keyword);

      if (keyword) {
        params.set('keyword', keyword);
      }

      if (category) {
        params.set('category', category);
      }

      if (sort) {
        params.set('sort', sort);
      }

      const queryString =
        params.toString();

      window.location.href =
        queryString ?
        (
          '/store/bestseller?' +
          queryString +
          '<%= BESTSELLER_PRODUCTS_ANCHOR %>'
        ) :
        (
          '/store/bestseller' +
          '<%= BESTSELLER_PRODUCTS_ANCHOR %>'
        );
    }

    links.forEach(function(link) {
      link.addEventListener('click', function(event) {
        event.preventDefault();
        goToBestseller(link.getAttribute('data-category'));
      });
    });

    select.addEventListener('change', function() {
      goToBestseller(select.value);
    });

    if (sortSelect) {
      sortSelect.addEventListener('change', function() {
        goToBestseller(select.value);
      });
    }

    if (keywordInput) {
      keywordInput.addEventListener('input', function() {
        const keyword = String(keywordInput.value || '').trim();
        const category = String(select ? (select.value || '') : '').trim();

        syncKeywordInputs(keyword);

        if (!keyword) {
          if (category) {
            goToBestseller(category);
          } else {
            window.location.href =
              '/store/bestseller?department=' +
              encodeURIComponent('<%= ACTIVE_DEPARTMENT %>') +
              '&sort=' +
              encodeURIComponent('<%= ACTIVE_SORT %>') +
              '<%= BESTSELLER_PRODUCTS_ANCHOR %>';
          }
        }
      });

      keywordInput.addEventListener('keydown', function(event) {
        if (event.key === 'Enter') {
          event.preventDefault();
          goToBestseller(select.value);
        }
      });
    }

    if (keywordInputSecondary) {
      keywordInputSecondary.addEventListener('input', function() {
        const keyword = String(keywordInputSecondary.value || '').trim();
        const category = String(select ? (select.value || '') : '').trim();

        syncKeywordInputs(keyword);

        if (!keyword) {
          if (category) {
            goToBestseller(category);
          } else {
            window.location.href =
              '/store/bestseller?department=' +
              encodeURIComponent('<%= ACTIVE_DEPARTMENT %>') +
              '&sort=' +
              encodeURIComponent('<%= ACTIVE_SORT %>') +
              '<%= BESTSELLER_PRODUCTS_ANCHOR %>';
          }
        }
      });

      keywordInputSecondary.addEventListener('keydown', function(event) {
        if (event.key === 'Enter') {
          event.preventDefault();
          goToBestseller(select.value);
        }
      });
    }

    if (keywordBtn) {
      keywordBtn.addEventListener('click', function() {
        goToBestseller(select.value);
      });
    }

    if (keywordBtnSecondary) {
      keywordBtnSecondary.addEventListener('click', function() {
        goToBestseller(select.value);
      });
    }
  })();
</script>

