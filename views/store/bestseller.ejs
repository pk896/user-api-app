<div id="bestsellerProductsSection" class="container-fluid products pt-5">
  <div class="container products-mini py-5">
    <div class="mx-auto text-center mb-4" style="max-width: 700px;">
      <h4 class="text-primary mb-4 border-bottom border-primary border-2 d-inline-block p-2 title-border-radius wow fadeInUp" data-wow-delay="0.1s">
        <%= IS_CJ_DEPARTMENT
          ? 'CJ Bestseller Products'
          : 'Kasyora Bestseller Products' %>
      </h4>

      <p class="mb-2 wow fadeInUp" data-wow-delay="0.2s">
        Discover our top-selling products, chosen for their quality,
      </p>

      <p class="small text-muted mb-0 wow fadeInUp" data-wow-delay="0.25s">
        Prices are displayed in
        <strong><%= CURRENCY %></strong>.
        Cart and order values remain securely calculated in
        <strong><%= BASE_CURRENCY %></strong>.
      </p>
    </div>

    <div class="row justify-content-end mb-4">
      <div class="col-12 col-md-6 col-lg-4">
        <label for="bestsellerSortSelect" class="form-label fw-bold text-primary">
          Sort bestseller products
        </label>

        <select id="bestsellerSortSelect" class="form-select border-primary">
          <option value="popular" <%= ACTIVE_SORT === 'popular' ? 'selected' : '' %>>
            Most Popular
          </option>

          <option value="newest" <%= ACTIVE_SORT === 'newest' ? 'selected' : '' %>>
            Newest
          </option>

          <option value="rating" <%= ACTIVE_SORT === 'rating' ? 'selected' : '' %>>
            Highest Rated
          </option>

          <option value="price_asc" <%= ACTIVE_SORT === 'price_asc' ? 'selected' : '' %>>
            Price: Low To High
          </option>

          <option value="price_desc" <%= ACTIVE_SORT === 'price_desc' ? 'selected' : '' %>>
            Price: High To Low
          </option>
        </select>
      </div>
    </div>
    <div class="row g-4">
      <% (bestSellerProducts || []).forEach(function(product, index) { %>
      <div class="col-md-6 col-lg-6 col-xl-4 wow fadeInUp bestseller-filter-card" data-wow-delay="<%= ['0.1s','0.3s','0.5s','0.1s','0.3s','0.5s'][index % 6] %>" data-category="<%= String(product.category || '').trim().toLowerCase() %>" data-search="<%= [
                    product.name,
                    product.category,
                    product.type,
                    product.manufacturer,
                    product.description,
                    Array.isArray(product.keywords) ? product.keywords.join(' ') : ''
                ].filter(Boolean).join(' ').toLowerCase() %>">
        <div class="products-mini-item border js-store-product-card">
          <div class="row g-0">
            <div class="col-5">
              <div class="products-mini-img border-end h-100 d-flex align-items-center">
                <img src="<%= product.image %>" class="img-fluid w-100 h-auto" alt="<%= product.name %>">
                <div class="products-mini-icon rounded-circle bg-primary">
                  <a href="<%= product.url %>"><i class="fa fa-eye fa-1x text-white"></i></a>
                </div>
              </div>
            </div>
            <div class="col-7">
              <div class="products-mini-content p-3">
                <span class="d-block mb-2" style="color: #f28b00;" title="<%= product.category || 'Product' %>">
                  <%= truncateBestsellerText(
                    product.category || 'Product',
                    25
                  ) %>
                </span>

                <span class="d-block h4" title="<%= product.name || 'Product' %>">
                  <%= truncateBestsellerText(
                    product.name || 'Product',
                    15
                  ) %>
                </span>

                <% if (product.oldPrice) { %>
                <del class="me-2 fs-5"><%= formatMoney(product.oldPrice) %></del>
                <% } %>
                <span class="text-primary fs-5"><%= formatMoney(Number(product.price || 0) * (1 + VAT)) %></span>
                <small class="text-muted ms-2">incl. VAT</small>
              </div>
            </div>
          </div>
          <div class="products-mini-add border p-3">
            <%
              const bestsellerIsCjProduct =
                String(product?.source || '')
                  .trim()
                  .toUpperCase() === 'CJ';

              const bestsellerDefaultCjVariant =
                Array.isArray(product?.variants)
                  ? (
                      product.variants.find(
                        function(variant) {
                          return (
                            String(
                              variant?.cjVariantId || ''
                            ) ===
                            String(
                              product?.defaultCjVariantId || ''
                            )
                          );
                        }
                      ) ||
                      product.variants[0]
                    )
                  : null;
            %>

            <% if (bestsellerIsCjProduct) { %>
            <% if (bestsellerDefaultCjVariant?.cjVariantId) { %>
            <button type="button" class="btn btn-primary border-secondary rounded-pill py-2 px-4 js-add-to-cj-cart" data-cj-product-id="<%= product.cjProductId %>" data-cj-variant-id="<%= bestsellerDefaultCjVariant.cjVariantId %>" data-product="<%- storeProductPayload(product) %>">
              <i class="fas fa-shopping-cart me-2"></i>
              Add To CJ Cart
            </button>
            <% } else { %>
            <a href="<%= product.url %>" class="btn btn-outline-primary rounded-pill py-2 px-4">
              <i class="fas fa-eye me-2"></i>
              Select Variant
            </a>
            <% } %>
            <% } else { %>
            <a href="/api/cart/add?pid=<%= encodeURIComponent(product.customId) %>&qty=1&json=1" class="btn btn-primary border-secondary rounded-pill py-2 px-4 js-add-to-cart" data-pid="<%= product.customId %>" data-product="<%- storeProductPayload(product) %>">
              <i class="fas fa-shopping-cart me-2"></i>
              Buy
            </a>
            <% } %>

            <div class="my-3">
              <%- include('../partials/rating-stars', {
                avg: Number(product.avgRating || 0),
                count: Number(product.ratingsCount || 0),
                nonce
              }) %>
            </div>

            <div class="d-flex">
              <a href="#" class="text-primary d-flex align-items-center justify-content-center me-0" aria-label="Add to wishlist" title="Add to wishlist">
                <span class="rounded-circle btn-sm-square border">
                  <i class="fas fa-heart"></i>
                </span>
              </a>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</div>
<!-- Bestseller Products End -->

