<script nonce="<%= nonce %>">
  (function() {
    const BESTSELLER_DEPARTMENT_ANCHOR_ID =
      'bestsellerDepartmentSection';

    const BESTSELLER_PRODUCTS_ANCHOR_ID =
      'bestsellerProductsSection';

    function isPureBestsellerRequest() {
      const params =
        new URLSearchParams(
          window.location.search
        );

      const parameterNames =
        Array.from(
          params.keys()
        );

      /*
       * A pure Bestseller request contains:
       *
       * - no query parameters, or
       * - only the department parameter.
       *
       * Keyword, category, sort or any other browsing
       * parameter means the user is viewing product results.
       */
      return (
        parameterNames.length === 0 ||
        (
          parameterNames.length === 1 &&
          parameterNames[0] ===
          'department'
        )
      );
    }

    function updateUrlHash(hashValue) {
      window.history.replaceState(
        null,
        '',
        window.location.pathname +
        window.location.search +
        hashValue
      );
    }

    function landOnCorrectBestsellerSection() {
      const departmentSection =
        document.getElementById(
          BESTSELLER_DEPARTMENT_ANCHOR_ID
        );

      const productsSection =
        document.getElementById(
          BESTSELLER_PRODUCTS_ANCHOR_ID
        );

      const currentHash =
        String(
          window.location.hash || ''
        ).trim();

      /*
       * Respect an explicit valid destination supplied by
       * the link.
       */
      if (
        currentHash ===
        '#' + BESTSELLER_DEPARTMENT_ANCHOR_ID
      ) {
        if (departmentSection) {
          departmentSection.scrollIntoView({
            behavior: 'auto',
            block: 'start'
          });
        }

        return;
      }

      if (
        currentHash ===
        '#' + BESTSELLER_PRODUCTS_ANCHOR_ID
      ) {
        if (productsSection) {
          productsSection.scrollIntoView({
            behavior: 'auto',
            block: 'start'
          });
        }

        return;
      }

      /*
       * Preserve unrelated intentional anchors.
       */
      if (currentHash) {
        return;
      }

      if (isPureBestsellerRequest()) {
        if (!departmentSection) {
          return;
        }

        updateUrlHash(
          '#' +
          BESTSELLER_DEPARTMENT_ANCHOR_ID
        );

        departmentSection.scrollIntoView({
          behavior: 'auto',
          block: 'start'
        });

        return;
      }

      /*
       * Requests containing search, category, sort or any
       * other browsing parameter belong at the products.
       */
      if (!productsSection) {
        return;
      }

      updateUrlHash(
        '#' +
        BESTSELLER_PRODUCTS_ANCHOR_ID
      );

      productsSection.scrollIntoView({
        behavior: 'auto',
        block: 'start'
      });
    }

    window.addEventListener(
      'load',
      function() {
        window.setTimeout(
          landOnCorrectBestsellerSection,
          100
        );
      }
    );

    window.addEventListener(
      'pageshow',
      function() {
        window.setTimeout(
          landOnCorrectBestsellerSection,
          100
        );
      }
    );
  })();
</script>