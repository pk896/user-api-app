<script nonce="<%= nonce %>">
  (function() {
    const cartLink = document.querySelector('.store-cart-link');
    const cartTotal = document.querySelector('.store-cart-total');

    if (!cartLink || !cartTotal) return;

    const raw = String(cartTotal.textContent || '').replace(/[^0-9.-]/g, '');
    const total = Number(raw);

    if (Number.isFinite(total) && total > 0) {
      cartLink.classList.add('cart-flash-active');
    } else {
      cartLink.classList.remove('cart-flash-active');
    }
  })();
</script>

<script nonce="<%= nonce %>">
  (function() {
    const select = document.getElementById('cartCategorySelect');
    const keywordInput = document.getElementById('cartKeywordInput');
    const keywordBtn = document.getElementById('cartKeywordSearchBtn');
    const links = Array.from(document.querySelectorAll('.cart-category-link'));

    function normalize(value) {
      return String(value || '').trim();
    }

    function goToShop(categoryValue, keywordValue) {
      const selectedCategory = normalize(categoryValue);
      const keyword = normalize(keywordValue);

      const params = new URLSearchParams();

      if (selectedCategory) {
        params.set('category', selectedCategory);
      }

      if (keyword) {
        params.set('keyword', keyword);
      }

      const query = params.toString();
      window.location.href = query ? `/store/shop?${query}#shopProductsSection` : '/store/shop#shopProductsSection';
    }

    function currentKeyword() {
      return normalize(keywordInput ? keywordInput.value : '');
    }

    links.forEach(function(link) {
      link.addEventListener('click', function(event) {
        event.preventDefault();
        goToShop(link.getAttribute('data-category') || '', currentKeyword());
      });
    });

    if (select) {
      select.addEventListener('change', function() {
        goToShop(select.value || '', currentKeyword());
      });
    }

    if (keywordInput) {
      keywordInput.addEventListener('keydown', function(event) {
        if (event.key === 'Enter') {
          event.preventDefault();
          goToShop(select ? select.value : '', keywordInput.value);
        }
      });
    }

    if (keywordBtn) {
      keywordBtn.addEventListener('click', function() {
        goToShop(select ? select.value : '', currentKeyword());
      });
    }
  })();
</script>

