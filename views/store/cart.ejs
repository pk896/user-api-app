<!-- Cart Page Start -->
<div class="container-fluid py-5">
  <div class="container py-5">
    <div class="table-responsive">
      <table class="table align-middle cart-table cart-table-brand mb-0">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Model</th>
            <th scope="col">Price</th>
            <th scope="col">Quantity</th>
            <th scope="col">Total</th>
            <th scope="col">Handle</th>
          </tr>
        </thead>
        <tbody id="cartTableBody">
          <% if (!(cartItems || []).length) { %>
          <tr>
            <td colspan="6" class="text-center py-5">
              <h5 class="mb-3">Your cart is empty</h5>
              <a href="/store/shop" class="btn btn-primary rounded-pill px-4 py-2">Continue Shopping</a>
            </td>
          </tr>
          <% } %>

          <% (cartItems || []).forEach(function(item) { %>
          <tr class="cart-row" data-pid="<%= item.customId %>" data-variant-size="<%= item.variants && item.variants.size ? item.variants.size : '' %>" data-variant-color="<%= item.variants && item.variants.color ? item.variants.color : '' %>">
            <th scope="row">
              <div class="py-3">
                <div class="cart-name-box rounded-3 p-3 text-white h-100">
                  <p class="mb-2 fw-bold text-break"><%= item.name %></p>
                  <% if (item.variants && (item.variants.size || item.variants.color)) { %>
                  <div class="small text-white text-break">
                    <% if (item.variants.size) { %><span class="fw-semibold">Size:</span> <%= item.variants.size %><% } %>
                    <% if (item.variants.size && item.variants.color) { %> | <% } %>
                    <% if (item.variants.color) { %><span class="fw-semibold">Color:</span> <%= item.variants.color %><% } %>
                  </div>
                  <% } %>
                </div>
              </div>
            </th>
            <td>
              <div class="py-3">
                <div class="rounded-3 p-3 text-break fw-semibold">
                  <%= item.customId || 'N/A' %>
                </div>
              </div>
            </td>
            <td>
              <p class="mb-0 py-4">
                <%= formatMoney(getCartItemDisplayPrice(item)) %>
              </p>
            </td>
            <td>
              <div class="input-group quantity py-4" style="width: 100px;">
                <div class="input-group-btn">
                  <button type="button" class="btn btn-sm btn-minus rounded-circle bg-light border js-cart-decrease">
                    <i class="fa fa-minus"></i>
                  </button>
                </div>
                <input type="text" class="form-control form-control-sm text-center border-0" value="<%= Number(item.quantity || 0) %>" readonly>
                <div class="input-group-btn">
                  <button type="button" class="btn btn-sm btn-plus rounded-circle bg-light border js-cart-increase">
                    <i class="fa fa-plus"></i>
                  </button>
                </div>
              </div>
            </td>
            <td>
              <p class="mb-0 py-4">
                <%= formatMoney(
                  roundMoney(
                    getCartItemDisplayPrice(item) *
                    Number(item.quantity || 0)
                  )
                ) %>
              </p>
            </td>
            <td class="py-4">
              <button type="button" class="btn btn-md rounded-circle bg-light border js-cart-remove">
                <i class="fa fa-times text-danger"></i>
              </button>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="mt-5">
      <input type="text" class="border-0 border-bottom rounded me-5 py-3 mb-4" placeholder="Coupon Code">
      <button class="btn btn-primary rounded-pill px-4 py-3" type="button">Apply Coupon</button>
    </div>

    <div class="row g-4 justify-content-end">
      <div class="col-8"></div>
      <div class="col-sm-8 col-md-7 col-lg-6 col-xl-4">
        <div class="bg-light rounded">
          <div class="p-4">
            <h1 class="display-6 mb-4">Cart <span class="fw-normal">Total</span></h1>

            <div class="d-flex justify-content-between mb-3">
              <h5 class="mb-0 me-4">
                Products subtotal:
              </h5>

              <p class="mb-0" id="cartSubtotal">
                <%= formatMoney(cartNetSubtotal) %>
              </p>
            </div>

            <% if (CART_VAT_ENABLED) { %>
            <div class="d-flex justify-content-between mb-3">
              <h5 class="mb-0 me-4">
                VAT (<%= (VAT * 100).toFixed(0) %>%):
              </h5>

              <p class="mb-0" id="cartVatTotal">
                <%= formatMoney(cartVatAmount) %>
              </p>
            </div>
            <% } %>

            <div class="d-flex justify-content-between mb-0">
              <h5 class="mb-0 me-4">
                Provisional total:
              </h5>

              <p class="mb-0 fw-bold" id="cartGrandTotal">
                <%= formatMoney(cartGrossTotal) %>
              </p>
            </div>

            <% if (CART_HAS_POSITIVE_VAT) { %>
            <div class="alert alert-info mt-4 mb-0 py-3 px-3" role="alert">
              This provisional cart total includes South African VAT.
              Shipping is not included yet. Your validated Checkout
              delivery address will determine the final VAT treatment
              and available shipping rates.
            </div>

            <% } else if (CART_IS_EXPORT_ZERO_RATED) { %>
            <div class="alert alert-warning mt-4 mb-0 py-3 px-3" role="alert">
              South African VAT is provisionally shown at 0% because
              the selected delivery destination is outside South Africa.
              Shipping, destination-country import taxes, customs duties
              and other import charges are not included. Your validated
              Checkout delivery address will determine the final tax
              treatment and shipping rates.
            </div>

            <% } else if (CART_VAT_IS_DISABLED) { %>
            <div class="alert alert-info mt-4 mb-0 py-3 px-3" role="alert">
              Shipping is not included yet. Your validated Checkout
              delivery address will determine the final tax treatment
              and available shipping rates.
            </div>
            <% } %>
          </div>

          <a href="/payment/checkout" class="btn btn-primary rounded-pill px-4 py-3 text-uppercase mb-4 ms-4">
            Proceed Checkout
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- Cart Page End -->

