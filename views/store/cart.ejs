<!--views/store/cart.ejs-->
<%
  /*
   * Resolved Internal cart tax context
   * ===================================
   *
   * The Internal cart uses only the provisional Internal
   * tax treatment resolved for this request.
   *
   * Possible treatments:
   *
   * - VAT_DISABLED
   * - ZA_STANDARD
   * - ZA_EXPORT_ZERO_RATED
   *
   * The validated Checkout shipping country remains
   * authoritative for the final VAT calculation.
   */
  const CART_TAX_TREATMENT =
    typeof taxTreatment !== 'undefined' &&
    taxTreatment &&
    typeof taxTreatment === 'object'
      ? taxTreatment
      : (
          typeof internalTaxTreatment !== 'undefined' &&
          internalTaxTreatment &&
          typeof internalTaxTreatment === 'object'
            ? internalTaxTreatment
            : {}
        );

  /*
   * Safe VAT-rate priority:
   *
   * 1. taxTreatment.vatRate
   * 2. route vatRate
   * 3. middleware internalVatRate
   * 4. zero
   *
   * Never assume 15% inside this template.
   */
  const CART_VAT_RATE_RAW =
    Number(
      CART_TAX_TREATMENT.vatRate ??
      (
        typeof vatRate !== 'undefined'
          ? vatRate
          : (
              typeof internalVatRate !== 'undefined'
                ? internalVatRate
                : 0
            )
      )
    );

  const VAT =
    Number.isFinite(
      CART_VAT_RATE_RAW
    ) &&
    CART_VAT_RATE_RAW >= 0 &&
    CART_VAT_RATE_RAW <= 1
      ? CART_VAT_RATE_RAW
      : 0;

  const CART_VAT_ENABLED =
    CART_TAX_TREATMENT.vatEnabled === true ||
    (
      typeof internalVatEnabled !== 'undefined' &&
      internalVatEnabled === true
    );

  const CART_TREATMENT_CODE =
    String(
      CART_TAX_TREATMENT.treatmentCode || ''
    )
      .trim()
      .toUpperCase();

  /*
   * BASE_CURRENCY remains Kasyora's authoritative accounting,
   * cart, order and payment currency.
   *
   * CURRENCY is only the customer's selected display currency.
   */
  const BASE_CURRENCY = String(
    typeof baseCurrency !== 'undefined'
      ? baseCurrency
      : 'USD'
  ).trim().toUpperCase() || 'USD';

  const CURRENCY = String(
    typeof displayCurrency !== 'undefined'
      ? displayCurrency
      : BASE_CURRENCY
  ).trim().toUpperCase() || BASE_CURRENCY;

  const CURRENCY_RATE_RAW = Number(
    typeof displayRate !== 'undefined'
      ? displayRate
      : NaN
  );

  /*
   * displayCurrency/displayRate are already resolved safely by
   * middleware/userCurrency.js.
   *
   * If FX conversion is unavailable, that middleware changes the
   * actual rendered displayCurrency back to BASE_CURRENCY and
   * supplies rate 1.
   *
   * Keep this template defensive too: rate 1 is safe without an
   * FX lookup only when the rendered currency is BASE_CURRENCY.
   */
  const CURRENCY_RATE =
    Number.isFinite(CURRENCY_RATE_RAW) &&
    CURRENCY_RATE_RAW > 0
      ? CURRENCY_RATE_RAW
      : (
          CURRENCY === BASE_CURRENCY
            ? 1
            : NaN
        );

  /*
   * Display rounding must follow the currency that is actually
   * rendered on this response.
   *
   * Examples:
   *
   * JPY -> 0 decimals
   * USD -> 2 decimals
   * KWD -> 3 decimals
   */
  const CURRENCY_DECIMALS_RAW = Number(
    typeof displayCurrencyDetails !== 'undefined' &&
    displayCurrencyDetails &&
    typeof displayCurrencyDetails.decimals !== 'undefined'
      ? displayCurrencyDetails.decimals
      : 2
  );

  const CURRENCY_DECIMALS =
    Number.isInteger(CURRENCY_DECIMALS_RAW) &&
    CURRENCY_DECIMALS_RAW >= 0 &&
    CURRENCY_DECIMALS_RAW <= 4
      ? CURRENCY_DECIMALS_RAW
      : 2;

  /*
   * Convert only customer-visible amounts.
   *
   * Cart source values remain authoritative BASE_CURRENCY
   * amounts.
   */
  function convertBaseToDisplay(amount) {
    const baseAmount = Number(amount || 0);

    if (
      !Number.isFinite(baseAmount) ||
      !Number.isFinite(CURRENCY_RATE) ||
      CURRENCY_RATE <= 0
    ) {
      return 0;
    }

    return Number(
      (
        baseAmount *
        CURRENCY_RATE
      ).toFixed(
        CURRENCY_DECIMALS
      )
    );
  }

  function formatMoney(amount) {
    const convertedAmount =
      convertBaseToDisplay(amount);

    try {
      const formatted =
        new Intl.NumberFormat(
          undefined,
          {
            style: 'currency',

            currency:
              CURRENCY,

            minimumFractionDigits:
              CURRENCY_DECIMALS,

            maximumFractionDigits:
              CURRENCY_DECIMALS
          }
        ).format(
          convertedAmount
        );

      if (CURRENCY === 'ZAR') {
        return formatted.replace(
          /^ZAR\s?/,
          'R'
        );
      }

      return formatted;
    } catch (error) {
      return (
        CURRENCY +
        ' ' +
        convertedAmount.toFixed(
          CURRENCY_DECIMALS
        )
      );
    }
  }  

  function roundMoney(amount) {
    const numericAmount =
      Number(amount || 0);

    if (!Number.isFinite(numericAmount)) {
      return 0;
    }

    return Number(
      numericAmount.toFixed(2)
    );
  }

  /*
   * Internal cart pricing
   * =====================
   *
   * cartSubtotal and cart item.price are authoritative
   * VAT-exclusive BASE_CURRENCY amounts.
   *
   * VAT is added only for provisional storefront presentation.
   *
   * The validated checkout shipping country will later make the
   * authoritative final VAT decision.
   */
  const cartNetSubtotal =
    roundMoney(
      cartSubtotal
    );

  const cartVatAmount =
    roundMoney(
      cartNetSubtotal *
      VAT
    );

  const cartGrossTotal =
    roundMoney(
      cartNetSubtotal +
      cartVatAmount
    );

  function getCartItemPriceExVat(item) {
    const priceExVat =
      Number(
        item &&
        item.priceExVat
      );

    if (
      Number.isFinite(priceExVat) &&
      priceExVat >= 0
    ) {
      return roundMoney(
        priceExVat
      );
    }

    const storedPrice =
      Number(
        item &&
        item.price
      );

    return (
      Number.isFinite(storedPrice) &&
      storedPrice >= 0
    )
      ? roundMoney(storedPrice)
      : 0;
  }

  function getCartItemVatAmount(item) {
    return roundMoney(
      getCartItemPriceExVat(item) *
      VAT
    );
  }

  function getCartItemDisplayPrice(item) {
    return roundMoney(
      getCartItemPriceExVat(item) +
      getCartItemVatAmount(item)
    );
  }

  /*
   * Separate the three possible presentation states.
   *
   * VAT disabled:
   * - no VAT row;
   * - no VAT wording;
   * - cart total equals VAT-exclusive subtotal.
   *
   * South African standard VAT:
   * - VAT row shown;
   * - positive VAT included provisionally.
   *
   * Foreign export:
   * - VAT row shown at 0%;
   * - export explanation shown.
   */
  const CART_HAS_POSITIVE_VAT =
    CART_VAT_ENABLED &&
    VAT > 0;

  const CART_IS_EXPORT_ZERO_RATED =
    CART_VAT_ENABLED &&
    CART_TREATMENT_CODE ===
      'ZA_EXPORT_ZERO_RATED';

  const CART_VAT_IS_DISABLED =
    !CART_VAT_ENABLED;
%>

