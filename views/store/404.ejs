    <li class="breadcrumb-item active text-white">404</li>
  </ol>
</div>
<!-- Single Page Header End -->

<!-- 404 Start -->
<div class="container-fluid py-5">
  <div class="container py-5 text-center">
    <div class="row justify-content-center">
      <div class="col-lg-6">
        <i class="bi bi-exclamation-triangle display-1 text-secondary"></i>
        <h1 class="display-1">404</h1>
        <h1 class="mb-4">Page Not Found</h1>
        <p class="mb-4">We’re sorry, the page you have looked for does not exist in our website! Maybe go to
          our home page or try to use a search?</p>
        <a class="btn btn-primary rounded-pill py-3 px-5" href="/store">Go Back To Shopping home</a>
      </div>
    </div>
  </div>
</div>
<!-- 404 End -->

<%- include('partials/footer') %>

<script nonce="<%= nonce %>">
  (function() {
    const select = document.getElementById('notFoundCategorySelect');
    const keywordInput = document.getElementById('notFoundKeywordInput');
    const keywordBtn = document.getElementById('notFoundKeywordSearchBtn');
    const links = Array.from(document.querySelectorAll('.notfound-category-link'));

    function normalize(value) {
      return String(value || '').trim();
    }

    function goToShop(categoryValue, keywordValue) {
      const selectedCategory = normalize(categoryValue);
      const keyword = normalize(keywordValue);

      const params = new URLSearchParams();

      if (selectedCategory) {
        params.set('category', selectedCategory);
      }

      if (keyword) {
        params.set('keyword', keyword);
      }

      const query = params.toString();
      window.location.href = query ? `/store/shop?${query}#shopProductsSection` : '/store/shop#shopProductsSection';
    }

    function currentKeyword() {
      return normalize(keywordInput ? keywordInput.value : '');
    }

    links.forEach(function(link) {
      link.addEventListener('click', function(event) {
        event.preventDefault();
        goToShop(link.getAttribute('data-category') || '', currentKeyword());
      });
    });

    if (select) {
      select.addEventListener('change', function() {
        goToShop(select.value || '', currentKeyword());
      });
    }

    if (keywordInput) {
      keywordInput.addEventListener('keydown', function(event) {
        if (event.key === 'Enter') {
          event.preventDefault();
          goToShop(select ? select.value : '', keywordInput.value);
        }
      });
    }

    if (keywordBtn) {
      keywordBtn.addEventListener('click', function() {
        goToShop(select ? select.value : '', currentKeyword());
      });
    }
  })();
</script>

<style nonce="<%= nonce %>">
  .store-cart-link.cart-flash-active .fa-shopping-cart {
    animation: cartPurpleFlash 3s infinite;
    position: relative;
    z-index: 1;
  }

  .store-cart-link.cart-flash-active .rounded-circle {
    animation: cartCirclePurpleFlash 3s infinite;
  }

  @keyframes cartPurpleFlash {

    0%,
    100% {
      color: inherit;
    }

    50% {
      color: #fff;
    }
  }

  @keyframes cartCirclePurpleFlash {

    0%,
    100% {
      background-color: transparent;
      border-color: inherit;
    }

    50% {
      background-color: #7C3AED;
      border-color: #7C3AED;
    }
  }
</style>

