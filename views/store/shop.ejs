<%
  /*
  * The route supplies no more than five bestselling
  * category groups for the active store department.
  *
  * Every category may contain up to twenty bestselling
  * products in its horizontal sliding row.
  *
  * Internal and CJ sales remain completely separate
  * because the route builds this collection from the
  * appropriate order and product models.
  */
  const BESTSELLING_CATEGORY_GROUPS =
    Array.isArray(bestsellingCategoryGroups)
      ? bestsellingCategoryGroups.slice(0, 5)
      : [];
%>

<div class="container-fluid py-5">
  <div class="container">
    <div class="row g-4">
      <!--
        Additional Products comes first.

        Mobile:
        It appears above Products Categories.

        Desktop:
        It remains in the left column.
      -->
      <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.1s">
        <section class="additional-product bestselling-categories-section mb-0" aria-labelledby="additionalProductsHeading">
          <h4 id="additionalProductsHeading" class="mb-4 fw-bold text-primary">
            Additional Products
          </h4>

          <% if (BESTSELLING_CATEGORY_GROUPS.length > 0) { %>
          <% BESTSELLING_CATEGORY_GROUPS.forEach(function(categoryGroup, categoryIndex) { %>
          <%
            const categoryProducts =
              Array.isArray(categoryGroup.products)
                ? categoryGroup.products.slice(0, 20)
                : [];

            const categoryAnimationDelay =
              (
                0.1 +
                (
                  categoryIndex % 4
                ) * 0.1
              ).toFixed(1) + 's';
          %>

          <% if (categoryProducts.length > 0) { %>
          <section class="bestselling-category-group mb-5 wow fadeInUp" data-wow-delay="<%= categoryAnimationDelay %>" aria-labelledby="bestsellingCategoryHeading-<%= categoryIndex %>">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
              <h5 id="bestsellingCategoryHeading-<%= categoryIndex %>" class="mb-0 fw-bold text-dark text-truncate" title="<%= categoryGroup.category || 'Products' %>">
                <%= truncateShopText(
                  categoryGroup.category || 'Products',
                  40
                ) %>
              </h5>

              <a href="#" class="shop-category-link text-primary text-decoration-none fw-semibold flex-shrink-0" data-category="<%= categoryGroup.category || '' %>">
                View all
                <i class="fas fa-chevron-right ms-1" aria-hidden="true"></i>
              </a>
            </div>

            <div class="bestselling-products-scroll d-flex gap-3 overflow-auto pb-3" tabindex="0" role="region" aria-label="Bestselling products in <%= categoryGroup.category || 'this category' %>">
              <% categoryProducts.forEach(function(product) { %>
              <a href="<%= product.url %>" class="bestselling-product-card card border rounded-3 text-decoration-none text-reset overflow-hidden" title="<%= product.name || 'Product' %>">
                <div class="bestselling-product-image bg-light overflow-hidden">
                  <img src="<%= product.image || product.imageUrl || '' %>" class="w-100 h-100 d-block" alt="<%= product.name || 'Product' %>" loading="lazy">
                </div>

                <div class="card-body bestselling-product-body p-2 overflow-hidden">
                  <h6 class="bestselling-product-name fw-bold text-dark mb-2" title="<%= product.name || 'Product' %>">
                    <%= truncateShopText(
                      product.name || 'Product',
                      30
                    ) %>
                  </h6>

                  <div class="small text-muted text-truncate mb-2" title="<%= product.category || categoryGroup.category || 'Product' %>">
                    <%= truncateShopText(
                      product.category ||
                      categoryGroup.category ||
                      'Product',
                      30
                    ) %>
                  </div>

                  <div class="text-primary fw-bold mb-1">
                    <%= formatMoney(
                      Number(product.price || 0) *
                      (1 + VAT)
                    ) %>
                  </div>

                  <small class="text-muted d-block">
                    incl. VAT
                  </small>
                </div>
              </a>
              <% }) %>
            </div>
          </section>
          <% } %>
          <% }) %>
          <% } else { %>
          <div class="alert alert-light border text-muted mb-0">
            No bestselling categories are available yet.
          </div>
          <% } %>
        </section>
      </div>

      <!--
        Products Categories remains second.

        Mobile:
        It appears below Additional Products.

        Desktop:
        It remains in the right column.
      -->
      <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.2s">
        <div class="product-categories mb-0">
          <h4 class="mb-4">
            Products Categories
          </h4>

          <ul class="list-unstyled mb-0">
            <li class="mb-2">
              <div class="categories-item">
                <a href="#" class="text-dark shop-category-link" data-category="">
                  <i class="fas fa-apple-alt text-secondary me-2"></i>
                  All Categories
                </a>

                <span></span>
              </div>
            </li>

            <% (CATEGORIES || []).forEach(function(category) { %>
            <li class="mb-2">
              <div class="categories-item">
                <a href="#" class="text-dark shop-category-link" data-category="<%= category.value %>">
                  <i class="fas fa-apple-alt text-secondary me-2"></i>
                  <%= category.label %>
                </a>

                <span></span>
              </div>
            </li>
            <% }) %>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

