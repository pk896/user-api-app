<div class="container-fluid shop py-5">
  <div class="container py-5">
    <div class="row g-4">
      <div class="col-lg-3 wow fadeInUp" data-wow-delay="0.1s">
        <!--
          Featured Products are shared visually by both storefronts.

          The route supplies:
          - Internal Product records for Kasyora In Store
          - CjProduct records for Kasyora CJ Store

          Product URLs, ratings and visible prices already come from
          the correct isolated department mapping.
        -->
        <div class="featured-product mb-4">
          <h4 class="mb-3 text-primary fw-bold">
            Featured products
          </h4>

          <% if ((featuredSidebarProducts || []).length > 0) { %>
          <% featuredSidebarProducts.forEach(function(product) { %>
          <a href="<%= product.url %>" class="featured-product-item mb-3 d-flex text-decoration-none text-dark">
            <div class="rounded me-4 flex-shrink-0 overflow-hidden" style="width: 100px; height: 100px;">
              <img src="<%= product.image || product.imageUrl || '' %>" class="img-fluid rounded w-100 h-100" style="object-fit: contain;" alt="<%= product.name || 'Featured product' %>" loading="lazy">
            </div>

            <div class="flex-grow-1 overflow-hidden">
              <h6 class="mb-2" style="color: #8B4513;" title="<%= product.category || 'Product' %>">
                <%= truncateShopText(
                    product.category || 'Product',
                    25
                  ) %>
              </h6>

              <div class="mb-2">
                <%- include('../partials/rating-stars', {
                    avg: Number(product.avgRating || 0),
                    count: Number(product.ratingsCount || 0),
                    nonce
                  }) %>
              </div>

              <div class="d-flex mb-2 align-items-center flex-wrap">
                <h5 class="fw-bold text-primary me-2 mb-0">
                  <%= formatMoney(
                      Number(product.price || 0) *
                      (1 + VAT)
                    ) %>
                </h5>

                <small class="text-muted me-2">
                  incl. VAT
                </small>

                <% if (product.oldPrice) { %>
                <h5 class="text-danger text-decoration-line-through mb-0">
                  <%= formatMoney(product.oldPrice) %>
                </h5>
                <% } %>
              </div>
            </div>
          </a>
          <% }) %>
          <% } else { %>
          <div class="alert alert-light border small text-muted">
            No featured products are available right now.
          </div>
          <% } %>

          <div class="d-flex justify-content-center my-4">
            <a href="<%= ACTIVE_SHOP_URL + SHOP_PRODUCTS_ANCHOR %>" class="btn btn-primary px-4 py-3 rounded-pill w-100">
              View More
            </a>
          </div>
        </div>

        <!--
          The Shop Sidebar Banner is supplied by the active department.

          Internal department:
          - ShopSidebarBanner
          - Product
          - productCustomId

          CJ department:
          - CjShopSidebarBanner
          - CjProduct
          - cjProductId

          The two database flows remain completely separate.
        -->
        <% if (shopSidebarBanner) { %>
        <a href="<%= shopSidebarBanner.url %>">
          <div class="position-relative">
            <img src="<%= shopSidebarBanner.image %>" class="img-fluid w-100 rounded" alt="<%= shopSidebarBanner.productName || shopSidebarBanner.title %>">

            <div class="text-center position-absolute d-flex flex-column align-items-center justify-content-center rounded p-4" style="width: 100%; height: 100%; top: 0; right: 0; background: rgba(242, 139, 0, 0.3);">
              <h5 class="display-6 text-primary" title="<%= shopSidebarBanner.title || '' %>">
                <%= truncateShopText(
                  shopSidebarBanner.title,
                  20
                ) %>
              </h5>

              <h4 class="text-secondary" title="<%= shopSidebarBanner.subtitle || '' %>">
                <%= truncateShopText(
                  shopSidebarBanner.subtitle,
                  25
                ) %>
              </h4>

              <span class="btn btn-primary rounded-pill px-4" title="<%= shopSidebarBanner.buttonText || 'Shop Now' %>">
                <%= truncateShopText(
                  shopSidebarBanner.buttonText || 'Shop Now',
                  16
                ) %>
              </span>
            </div>
          </div>
        </a>
        <% } %>

        <!--
          TOP RATED PRODUCTS are supplied by the active department.

          Internal department:
          - Product
          - avgRating
          - ratingsCount
          - /store/product/:customId

          CJ department:
          - CjProduct
          - avgRating
          - ratingsCount
          - /cj/product/:cjProductId

          The route keeps both rating and product flows separate.
        -->
        <div class="product-tags py-4 top-rated-sales-wrap">
          <h4 class="mb-3 text-primary fw-bold">
            TOP RATED PRODUCTS
          </h4>

          <% if ((topRatedTagProducts || []).length > 0) { %>
          <div class="row g-2 g-md-3 top-rated-sales-grid">
            <% topRatedTagProducts.forEach(function(item) { %>
            <div class="col-6 col-md-4 col-lg-12">
              <a href="<%= item.url %>" class="text-decoration-none text-reset d-block h-100" title="<%= item.name %>">
                <div class="product-card position-relative h-100">
                  <div class="image-holder">
                    <img src="<%= item.image %>" alt="<%= item.name %>" class="img-fluid" loading="lazy">
                  </div>

                  <div class="card-detail">
                    <h3 class="card-title text-uppercase" title="<%= item.name || 'Untitled Product' %>">
                      <span>
                        <%= truncateShopText(
                          item.name || 'Untitled Product',
                          15
                        ) %>
                      </span>
                    </h3>

                    <span class="item-price text-primary">
                      <%= formatMoney(
                        Number(item.price || 0) *
                        (1 + VAT)
                      ) %>
                    </span>
                  </div>
                </div>
              </a>
            </div>
            <% }) %>
          </div>
          <% } else { %>
          <div class="small text-muted">
            No top rated products available right now.
          </div>
          <% } %>
        </div>
      </div>

      <div class="col-lg-9 wow fadeInUp" data-wow-delay="0.1s">
        <% if (shopMainBanner) { %>
        <div class="rounded mb-4 position-relative">
          <img src="<%= shopMainBanner.image %>" class="img-fluid rounded w-100" style="height: 250px;" alt="<%= shopMainBanner.productName || shopMainBanner.title %>">

          <div class="position-absolute rounded d-flex flex-column align-items-center justify-content-center text-center" style="width: 100%; height: 250px; top: 0; left: 0; background: rgba(242, 139, 0, 0.3);">
            <h4 class="display-5 text-primary" title="<%= shopMainBanner.title || '' %>">
              <%= truncateShopText(
                shopMainBanner.title,
                25
              ) %>
            </h4>

            <h3 class="display-4 text-white mb-4" title="<%= shopMainBanner.subtitle || '' %>">
              <%= truncateShopText(
                shopMainBanner.subtitle,
                30
              ) %>
            </h3>

            <span class="btn btn-primary rounded-pill" title="<%= shopMainBanner.buttonText || 'Shop Now' %>">
              <%= truncateShopText(
                shopMainBanner.buttonText || 'Shop Now',
                17
              ) %>
            </span>
          </div>
        </div>
        <% } %>

        <div class="row g-4">
          <div class="col-xl-7">
            <div class="input-group w-100 mx-auto d-flex">
              <input id="shopKeywordInputSecondary" type="search" class="form-control p-3" value="<%= selectedKeyword || '' %>" placeholder="keywords" aria-describedby="search-icon-1">
              <button id="shopKeywordSearchBtnSecondary" type="button" class="input-group-text p-3 border-0 bg-primary text-white">
                <i class="fa fa-search"></i>
              </button>
            </div>
          </div>
          <div class="col-xl-3 text-end">
            <div class="bg-light ps-3 py-3 rounded d-flex justify-content-between">
              <label for="shopSortSelect">Sort By:</label>
              <select id="shopSortSelect" name="sort" class="border-0 form-select-sm bg-light me-3">
                <option value="default" <%= (selectedSort || 'default') === 'default' ? 'selected' : '' %>>Default Sorting</option>
                <option value="popular" <%= selectedSort === 'popular' ? 'selected' : '' %>>Popularity</option>
                <option value="newest" <%= selectedSort === 'newest' ? 'selected' : '' %>>Newness</option>
                <option value="rating" <%= selectedSort === 'rating' ? 'selected' : '' %>>
                  Average Rating
                </option>
                <option value="price_asc" <%= selectedSort === 'price_asc' ? 'selected' : '' %>>Low to high</option>
                <option value="price_desc" <%= selectedSort === 'price_desc' ? 'selected' : '' %>>High to low</option>
              </select>
            </div>
          </div>
          <div class="col-lg-4 col-xl-2">
            <ul class="nav nav-pills d-inline-flex text-center py-2 px-2 rounded bg-light mb-4">
              <li class="nav-item me-4">
                <a class="bg-light" data-bs-toggle="pill" href="#tab-5">
                  <i class="fas fa-th fa-3x text-primary"></i>
                </a>
              </li>
              <li class="nav-item">
                <a class="bg-light active" data-bs-toggle="pill" href="#tab-6">
                  <i class="fas fa-bars fa-3x text-primary"></i>
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div id="shopProductsSection" class="tab-content">
          <% if (!(shopProducts || []).length) { %>
          <div class="alert alert-light border shadow-sm text-center py-5">
            <i class="fas fa-search fa-3x text-primary mb-3"></i>

            <h3 class="text-primary">
              No products found
            </h3>

            <p class="text-muted mb-4">
              No
              <%= IS_CJ_DEPARTMENT
                  ? 'CJ Dropshipping'
                  : 'Kasyora internal' %>
              products matched the selected search or category.
            </p>

            <a href="/store/shop?department=<%= encodeURIComponent(ACTIVE_DEPARTMENT) %><%= SHOP_PRODUCTS_ANCHOR %>" class="btn btn-primary rounded-pill px-4">
              View All Products
            </a>
          </div>
          <% } %>
          <div id="tab-5" class="tab-pane fade p-0">
            <div class="row g-4 product">
              <% (shopProducts || []).forEach(function(product) { %>
              <div class="col-lg-4 shop-filter-card" data-category="<%= String(product.category || '').trim().toLowerCase() %>" data-search="<%= [
                                        product.name,
                                        product.category,
                                        product.type,
                                        product.manufacturer,
                                        product.description,
                                        Array.isArray(product.keywords) ? product.keywords.join(' ') : ''
                                    ].filter(Boolean).join(' ').toLowerCase() %>">
                <div class="product-item rounded wow fadeInUp js-store-product-card" data-wow-delay="0.1s">
                  <div class="product-item-inner border rounded">
                    <div class="product-item-inner-item">
                      <img src="<%= product.image %>" class="img-fluid w-100 rounded-top" alt="<%= product.name %>">
                      <% if (product.isNew) { %>
                      <div class="product-new">New</div>
                      <% } %>
                      <div class="product-details">
                        <a href="<%= product.url %>"><i class="fa fa-eye fa-1x"></i></a>
                      </div>
                    </div>
                    <div class="text-center rounded-bottom p-4">
                      <a href="<%= product.url %>" class="d-block mb-2" title="<%= product.category || 'Product' %>">
                        <%= truncateShopText(
                          product.category || 'Product',
                          25
                        ) %>
                      </a>

                      <a href="<%= product.url %>" class="d-block h4" title="<%= product.name || 'Product' %>">
                        <%= truncateShopText(
                          product.name || 'Product',
                          15
                        ) %>
                      </a>

                      <% if (product.oldPrice) { %>
                      <del class="me-2 fs-5"><%= formatMoney(product.oldPrice) %></del>
                      <% } %>
                      <span class="text-primary fs-5"><%= formatMoney(Number(product.price || 0) * (1 + VAT)) %></span>
                      <small class="text-muted ms-2">incl. VAT</small>
                    </div>
                  </div>
                  <div class="product-item-add border border-top-0 rounded-bottom text-center p-4 pt-0">
                    <%
                      const gridIsCjProduct =
                        String(product?.source || '')
                          .trim()
                          .toUpperCase() === 'CJ';

                      const gridDefaultCjVariant =
                        Array.isArray(product?.variants)
                          ? product.variants.find(function(variant) {
                              return (
                                String(variant?.cjVariantId || '') ===
                                String(product?.defaultCjVariantId || '')
                              );
                            }) || product.variants[0]
                          : null;
                    %>

                    <% if (gridIsCjProduct) { %>
                    <% if (gridDefaultCjVariant?.cjVariantId) { %>
                    <button type="button" class="btn btn-primary border-secondary rounded-pill py-2 px-4 mb-4 js-add-to-cj-cart" data-cj-product-id="<%= product.cjProductId %>" data-cj-variant-id="<%= gridDefaultCjVariant.cjVariantId %>" data-product="<%- storeProductPayload(product) %>">
                      <i class="fas fa-shopping-cart me-2"></i>
                      Add To CJ Cart
                    </button>
                    <% } else { %>
                    <a href="<%= product.url %>" class="btn btn-outline-primary rounded-pill py-2 px-4 mb-4">
                      <i class="fas fa-eye me-2"></i>
                      Select Variant
                    </a>
                    <% } %>
                    <% } else { %>
                    <a href="/api/cart/add?pid=<%= encodeURIComponent(product.customId) %>&qty=1&json=1" class="btn btn-primary border-secondary rounded-pill py-2 px-4 mb-4 js-add-to-cart" data-pid="<%= product.customId %>" data-product="<%- storeProductPayload(product) %>">
                      <i class="fas fa-shopping-cart me-2"></i>
                      Add To Cart
                    </a>
                    <% } %>

                    <div class="d-flex justify-content-between align-items-center">
                      <div>
                        <%- include('../partials/rating-stars', {
                          avg: Number(product.avgRating || 0),
                          count: Number(product.ratingsCount || 0),
                          nonce
                        }) %>
                      </div>

                      <div class="d-flex">
                        <a href="#" class="text-primary d-flex align-items-center justify-content-center me-0" aria-label="Add to wishlist" title="Add to wishlist">
                          <span class="rounded-circle btn-sm-square border">
                            <i class="fas fa-heart"></i>
                          </span>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <% }) %>

              <div class="col-12 wow fadeInUp" data-wow-delay="0.1s">
                <div class="pagination d-flex justify-content-center mt-5 flex-wrap">
                  <% if (hasPrevPage) { %>
                  <a href="<%= shopPageUrl(currentPage - 1) %>" class="rounded">&laquo;</a>
                  <% } else { %>
                  <span class="rounded disabled">&laquo;</span>
                  <% } %>

                  <% for (let page = 1; page <= totalPages; page++) { %>
                  <a href="<%= shopPageUrl(page) %>" class="rounded <%= page === currentPage ? 'active' : '' %>">
                    <%= page %>
                  </a>
                  <% } %>

                  <% if (hasNextPage) { %>
                  <a href="<%= shopPageUrl(currentPage + 1) %>" class="rounded">&raquo;</a>
                  <% } else { %>
                  <span class="rounded disabled">&raquo;</span>
                  <% } %>
                </div>
              </div>
            </div>
          </div>

          <div id="tab-6" class="products tab-pane fade show p-0 active">
            <div class="row g-4 product products-mini">
              <% (shopProducts || []).forEach(function(product) { %>
              <div class="col-lg-6 col-xl-4 wow fadeInUp shop-filter-card" data-wow-delay="0.1s" data-category="<%= String(product.category || '').trim().toLowerCase() %>" data-search="<%= [
                                        product.name,
                                        product.category,
                                        product.type,
                                        product.manufacturer,
                                        product.description,
                                        Array.isArray(product.keywords) ? product.keywords.join(' ') : ''
                                    ].filter(Boolean).join(' ').toLowerCase() %>">
                <div class="products-mini-item border js-store-product-card">
                  <div class="row g-0">
                    <div class="col-5">
                      <div class="products-mini-img border-end h-100 d-flex align-items-center">
                        <img src="<%= product.image %>" class="img-fluid w-100 h-auto" alt="<%= product.name %>">
                        <div class="products-mini-icon rounded-circle bg-primary">
                          <a href="<%= product.url %>"><i class="fa fa-eye fa-1x text-white"></i></a>
                        </div>
                      </div>
                    </div>

                    <div class="col-7">
                      <div class="products-mini-content p-3 overflow-hidden">
                        <span class="d-block mb-2 text-truncate" style="color: #f28b00;" title="<%= product.category || 'Product' %>">
                          <%= truncateShopText(
                            product.category || 'Product',
                            25
                          ) %>
                        </span>

                        <span class="d-block h4 text-truncate" title="<%= product.name || 'Product' %>">
                          <%= truncateShopText(
                            product.name || 'Product',
                            15
                          ) %>
                        </span>

                        <% if (product.oldPrice) { %>
                        <del class="me-2 fs-5"><%= formatMoney(product.oldPrice) %></del>
                        <% } %>

                        <span class="text-primary fs-5"><%= formatMoney(Number(product.price || 0) * (1 + VAT)) %></span>
                        <small class="text-muted ms-2">incl. VAT</small>
                      </div>
                    </div>
                  </div>

                  <div class="products-mini-add border p-3">
                    <%
                      const listIsCjProduct =
                        String(product?.source || '')
                          .trim()
                          .toUpperCase() === 'CJ';

                      const listDefaultCjVariant =
                        Array.isArray(product?.variants)
                          ? product.variants.find(function(variant) {
                              return (
                                String(variant?.cjVariantId || '') ===
                                String(product?.defaultCjVariantId || '')
                              );
                            }) || product.variants[0]
                          : null;
                    %>

                    <% if (listIsCjProduct) { %>
                    <% if (listDefaultCjVariant?.cjVariantId) { %>
                    <button type="button" class="btn btn-primary border-secondary rounded-pill py-2 px-4 js-add-to-cj-cart" data-cj-product-id="<%= product.cjProductId %>" data-cj-variant-id="<%= listDefaultCjVariant.cjVariantId %>" data-product="<%- storeProductPayload(product) %>">
                      <i class="fas fa-shopping-cart me-2"></i>
                      Add To CJ Cart
                    </button>
                    <% } else { %>
                    <a href="<%= product.url %>" class="btn btn-outline-primary rounded-pill py-2 px-4">
                      <i class="fas fa-eye me-2"></i>
                      Select Variant
                    </a>
                    <% } %>
                    <% } else { %>
                    <a href="/api/cart/add?pid=<%= encodeURIComponent(product.customId) %>&qty=1&json=1" class="btn btn-primary border-secondary rounded-pill py-2 px-4 js-add-to-cart" data-pid="<%= product.customId %>" data-product="<%- storeProductPayload(product) %>">
                      <i class="fas fa-shopping-cart me-2"></i>
                      Add To Cart
                    </a>
                    <% } %>

                    <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
                      <div>
                        <%- include('../partials/rating-stars', {
                          avg: Number(product.avgRating || 0),
                          count: Number(product.ratingsCount || 0),
                          nonce
                        }) %>
                      </div>

                      <div class="d-flex">
                        <a href="#" class="text-primary d-flex align-items-center justify-content-center me-0" aria-label="Add to wishlist" title="Add to wishlist">
                          <span class="rounded-circle btn-sm-square border">
                            <i class="fas fa-heart"></i>
                          </span>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <% }) %>

              <div class="col-12 wow fadeInUp" data-wow-delay="0.1s">
                <div class="pagination d-flex justify-content-center mt-5 flex-wrap">
                  <% if (hasPrevPage) { %>
                  <a href="<%= shopPageUrl(currentPage - 1) %>" class="rounded">&laquo;</a>
                  <% } else { %>
                  <span class="rounded disabled">&laquo;</span>
                  <% } %>

                  <% for (let page = 1; page <= totalPages; page++) { %>
                  <a href="<%= shopPageUrl(page) %>" class="rounded <%= page === currentPage ? 'active' : '' %>">
                    <%= page %>
                  </a>
                  <% } %>

                  <% if (hasNextPage) { %>
                  <a href="<%= shopPageUrl(currentPage + 1) %>" class="rounded">&raquo;</a>
                  <% } else { %>
                  <span class="rounded disabled">&raquo;</span>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!--
          CUSTOMER-PROVEN PRODUCTS

          The server supplies this collection according
          to the active storefront department.

          Internal department:
          - successful Internal Order records
          - Internal Product records
          - Internal rating aggregates

          CJ department:
          - successful CjOrder records
          - CjProduct records
          - separate CJ rating aggregates

          Both flows remain completely isolated.
        -->
        <% if (
          Array.isArray(soldRatedOldProducts) &&
          soldRatedOldProducts.length > 0
        ) { %>
        <section class="pt-5 mt-4 border-top" aria-labelledby="customerProvenProductsHeading">
          <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-4 wow fadeInUp" data-wow-delay="0.1s">
            <h3 id="customerProvenProductsHeading" class="text-primary mb-1 fw-bold">
              CUSTOMER-PROVEN PRODUCTS
            </h3>
          </div>

          <!--
            col-6:
            Two product cards on mobile.

            col-md-4:
            Three product cards on medium screens.

            col-xl-3:
            Four product cards across the large Shop content area.
          -->
          <div class="row g-2 g-md-3 g-lg-4 customer-proven-products-grid">
            <% soldRatedOldProducts.forEach(function(product, productIndex) { %>
            <%
              /*
              * Repeat delays from 0.1s to 0.4s for each row.
              *
              * This provides a staggered appearance without causing
              * later products to wait several seconds before appearing.
              */
              const customerProvenDelay =
                (
                  0.1 +
                  (
                    productIndex % 4
                  ) * 0.1
                ).toFixed(1) + 's';
            %>

            <div class="col-6 col-md-4 col-xl-3 wow fadeInUp overflow-hidden" data-wow-delay="<%= customerProvenDelay %>">
              <a href="<%= product.url %>" class="text-decoration-none text-reset d-block h-100 overflow-hidden" title="<%= product.name || 'Product' %>">
                <div class="product-card customer-proven-product-card position-relative h-100 overflow-hidden">
                  <div class="image-holder">
                    <img src="<%= product.image || product.imageUrl %>" alt="<%= product.name || 'Product' %>" class="img-fluid" loading="lazy">
                  </div>

                  <div class="card-detail customer-proven-card-detail overflow-hidden">
                    <h3 class="card-title customer-proven-product-name mb-1" title="<%= product.name || 'Untitled Product' %>">
                      <span>
                        <%= truncateShopText(
                          product.name || 'Untitled Product',
                          15
                        ) %>
                      </span>
                    </h3>

                    <div class="customer-proven-category text-muted mb-1" title="<%= product.category || 'Product' %>">
                      <%= truncateShopText(
                        product.category || 'Product',
                        25
                      ) %>
                    </div>

                    <span class="item-price customer-proven-price text-primary d-block mb-0">
                      <%= formatMoney(
                        Number(product.price || 0) *
                        (1 + VAT)
                      ) %>
                    </span>

                    <small class="customer-proven-vat text-muted d-block mb-1">
                      incl. VAT
                    </small>

                    <div class="customer-proven-rating overflow-hidden">
                      <%- include('../partials/rating-stars', {
                        avg: Number(product.avgRating || 0),
                        count: Number(product.ratingsCount || 0),
                        nonce
                      }) %>
                    </div>
                  </div>
                </div>
              </a>
            </div>
            <% }) %>
          </div>
        </section>
        <% } %>
      </div>
    </div>
  </div>
</div>
<!-- Shop Page End -->

