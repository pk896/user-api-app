<!-- views/store/shop.ejs -->
<%
  const VAT = (typeof vatRate !== 'undefined' && vatRate !== null)
    ? Number(vatRate)
    : 0.15;

    /*
   * BASE_CURRENCY remains Kasyora's authoritative internal currency.
   * CURRENCY is only the customer's selected display currency.
   */
  const BASE_CURRENCY = String(
    typeof baseCurrency !== 'undefined'
      ? baseCurrency
      : 'USD'
  ).trim().toUpperCase() || 'USD';

  const CURRENCY = String(
    typeof displayCurrency !== 'undefined'
      ? displayCurrency
      : BASE_CURRENCY
  ).trim().toUpperCase() || BASE_CURRENCY;

  const CURRENCY_RATE_RAW = Number(
    typeof displayRate !== 'undefined'
      ? displayRate
      : 1
  );

  const CURRENCY_RATE =
    Number.isFinite(CURRENCY_RATE_RAW) &&
    CURRENCY_RATE_RAW > 0
      ? CURRENCY_RATE_RAW
      : 1;

  function convertBaseToDisplay(amount) {
    const baseAmount = Number(amount || 0);

    if (!Number.isFinite(baseAmount)) {
      return 0;
    }

    return Number(
      (baseAmount * CURRENCY_RATE).toFixed(2)
    );
  }

  /*
   * Shop product cards have limited display space,
   * especially in the mobile list layout.
   *
   * Keep complete product values unchanged and shorten
   * only the visible category and product-name text.
   */
  function truncateShopText(
    value,
    maxCharacters = 15
  ) {
    const text = String(
      value || ''
    ).trim();

    if (text.length <= maxCharacters) {
      return text;
    }

    return (
      text
        .slice(0, maxCharacters)
        .trimEnd() +
      '...'
    );
  }

  function formatMoney(amount) {
  const convertedAmount =
    convertBaseToDisplay(amount);

  try {
    const formatted = new Intl.NumberFormat(
      undefined,
      {
        style: 'currency',
        currency: CURRENCY,
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }
    ).format(convertedAmount);

    if (CURRENCY === 'ZAR') {
      return formatted.replace(/^ZAR\s?/, 'R');
    }

    return formatted;
  } catch (error) {
    return (
      CURRENCY +
      ' ' +
      convertedAmount.toFixed(2)
    );
  }
}

const ACTIVE_DEPARTMENT = String(
  typeof storeDepartment !== 'undefined'
    ? storeDepartment
    : 'internal'
).trim().toLowerCase() === 'cj'
  ? 'cj'
  : 'internal';

const IS_CJ_DEPARTMENT =
  ACTIVE_DEPARTMENT === 'cj';

/*
 * Only search, category, sort, pagination and filtered
 * Shop requests land at the products section.
 *
 * Normal Shop-page links and department changes open
 * the Shop page normally from the top.
 */
const SHOP_PRODUCTS_ANCHOR =
  '#shopProductsSection';

/*
 * Every shared store-page link must explicitly preserve
 * the active storefront department.
 */
const ACTIVE_HOME_URL =
  '/store?department=' +
  encodeURIComponent(
    ACTIVE_DEPARTMENT
  );

const ACTIVE_SHOP_URL =
  '/store/shop?department=' +
  encodeURIComponent(
    ACTIVE_DEPARTMENT
  );

const ACTIVE_BESTSELLER_URL =
  '/store/bestseller?department=' +
  encodeURIComponent(
    ACTIVE_DEPARTMENT
  );

const ACTIVE_CART_URL =
  IS_CJ_DEPARTMENT
    ? '/cj/cart'
    : '/store/cart';

const ACTIVE_CHECKOUT_URL =
  IS_CJ_DEPARTMENT
    ? '/cj/checkout'
    : '/payment/checkout';

const ACTIVE_CART = (
  typeof activeStoreCart !== 'undefined' &&
  activeStoreCart
)
  ? activeStoreCart
  : {
      count: 0,
      total: 0
    };

  function storeProductPayload(product) {
    const source = String(
      product?.source || ''
    ).trim().toUpperCase();

    if (source === 'CJ') {
      return encodeURIComponent(JSON.stringify({
        source: 'CJ',
        cjProductId:
          product.cjProductId || '',
        cjVariantId:
          product.defaultCjVariantId || '',
        name:
          product.name || '',
        image:
          product.image ||
          product.imageUrl ||
          '',
        variants:
          Array.isArray(product.variants)
            ? product.variants
            : []
      }));
    }

    return encodeURIComponent(JSON.stringify({
      source: 'INTERNAL',
      customId:
        product.customId || '',
      name:
        product.name || '',
      image:
        product.image ||
        product.imageUrl ||
        '',
      sizes:
        Array.isArray(product.sizes)
          ? product.sizes
          : [],
      colors:
        Array.isArray(product.colors)
          ? product.colors
          : [],
      colorImages:
        Array.isArray(product.colorImages)
          ? product.colorImages
          : []
    }));
  }

  function shopPageUrlForDepartment(
    pageNumber,
    department
  ) {
    const safeDepartment =
      String(department || '')
        .trim()
        .toLowerCase() === 'cj'
        ? 'cj'
        : 'internal';

    const params = [];

    params.push(
      'department=' +
      encodeURIComponent(
        safeDepartment
      )
    );

    if (selectedKeyword) {
      params.push(
        'keyword=' +
        encodeURIComponent(
          selectedKeyword
        )
      );
    }

    if (selectedCategory) {
      params.push(
        'category=' +
        encodeURIComponent(
          selectedCategory
        )
      );
    }

    if (
      selectedSort &&
      selectedSort !== 'default'
    ) {
      params.push(
        'sort=' +
        encodeURIComponent(
          selectedSort
        )
      );
    }

    params.push(
      'page=' +
      encodeURIComponent(
        pageNumber
      )
    );

    return (
      '/store/shop?' +
      params.join('&') +
      SHOP_PRODUCTS_ANCHOR
    );
  }

  function shopPageUrl(pageNumber) {
    return shopPageUrlForDepartment(
      pageNumber,
      ACTIVE_DEPARTMENT
    );
  }

  const SAFE_CURRENT_PAGE =
    Number.isFinite(
      Number(currentPage)
    )
      ? Number(currentPage)
      : 1;

  const SHOP_CURRENCY_RETURN_TO =
    shopPageUrl(
      SAFE_CURRENT_PAGE
    );

  const INTERNAL_SHOP_RETURN_TO =
    '/store/shop?department=internal';

  const CJ_SHOP_RETURN_TO =
    '/store/shop?department=cj';
%>

