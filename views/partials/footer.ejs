<!-- views/partials/footer.ejs -->
<%
  const FOOTER_NONCE =
    typeof nonce !== 'undefined'
      ? nonce
      : '';

  const FOOTER_THEME =
    typeof themeCss !== 'undefined'
      ? String(themeCss || '')
      : '';

  const FOOTER_IS_DARK =
    FOOTER_THEME.includes('dark');
%>


<footer
  class="kasyora-footer <%= FOOTER_IS_DARK ? 'kasyora-footer-dark' : 'kasyora-footer-light' %>"
>

  <!-- =====================================================
       MAIN CORPORATE FOOTER
       ===================================================== -->
  <div class="kasyora-footer-inner">

    <div class="row g-4 g-xl-5">

      <!-- =================================================
           COMPANY
           ================================================= -->
      <div class="col-12 col-lg-5">

        <a
          href="/home"
          class="kasyora-footer-brand d-inline-flex align-items-center gap-2 text-decoration-none mb-3"
          aria-label="Kasyora Home"
        >
          <img
            src="/images/branding/logo-unincorporate.png"
            alt="Kasyora"
            class="kasyora-footer-logo"
            width="40"
            height="40"
            loading="lazy"
            decoding="async"
          >

          <div>
            <div class="kasyora-footer-brand-name">
              Kasyora
            </div>

            <div class="kasyora-footer-brand-legal">
              KASYORA (Pty) Ltd
            </div>
          </div>
        </a>


        <p class="kasyora-footer-description mb-4">
          A Global commerce company building
          technology that connects buyers, sellers
          and suppliers across markets, with a
          long-term vision of wider and more inclusive
          participation in global trade.
        </p>


        <div class="row g-3">

          <div class="col-12 col-sm-6">

            <div
              class="kasyora-footer-company-item"
            >
              <div class="kasyora-footer-label">
                Incorporated
              </div>

              <div class="kasyora-footer-value">
                27 May 2026
              </div>
            </div>

          </div>


          <div class="col-12 col-sm-6">

            <div
              class="kasyora-footer-company-item"
            >
              <div class="kasyora-footer-label">
                Country
              </div>

              <div class="kasyora-footer-value">
                South Africa
              </div>
            </div>

          </div>


          <div class="col-12">

            <div
              class="kasyora-footer-company-item"
            >
              <div class="kasyora-footer-label">
                Company Registration
              </div>

              <div class="kasyora-footer-value">
                2026/419298/07
              </div>
            </div>

          </div>

        </div>

      </div>


      <!-- =================================================
           KASYORA
           ================================================= -->
      <div class="col-6 col-md-4 col-lg-2">

        <div class="kasyora-footer-heading">
          Kasyora
        </div>

        <nav
          class="d-flex flex-column gap-2"
          aria-label="Kasyora footer navigation"
        >

          <a
            href="/home"
            class="kasyora-footer-link"
          >
            Home
          </a>

          <a
            href="/store"
            class="kasyora-footer-link"
          >
            Store
          </a>

          <a
            href="/users/about"
            class="kasyora-footer-link"
          >
            About Kasyora
          </a>

          <a
            href="/store/contact"
            class="kasyora-footer-link"
          >
            Contact
          </a>

        </nav>

      </div>


      <!-- =================================================
           PARTICIPATE
           ================================================= -->
      <div class="col-6 col-md-4 col-lg-2">

        <div class="kasyora-footer-heading">
          Participate
        </div>

        <nav
          class="d-flex flex-column gap-2"
          aria-label="Kasyora participation links"
        >

          <a
            href="/store"
            class="kasyora-footer-link"
          >
            Buy
          </a>

          <a
            href="/business/signup"
            class="kasyora-footer-link"
          >
            Sell
          </a>

          <a
            href="/business/signup"
            class="kasyora-footer-link"
          >
            Supply
          </a>

          <a
            href="/users/signup"
            class="kasyora-footer-link"
          >
            Create Account
          </a>

        </nav>

      </div>


      <!-- =================================================
           LEGAL
           ================================================= -->
      <div class="col-12 col-md-4 col-lg-3">

        <div class="kasyora-footer-heading">
          Legal &amp; Trust
        </div>

        <nav
          class="d-flex flex-column gap-2 mb-4"
          aria-label="Kasyora legal links"
        >

          <a
            href="/terms"
            class="kasyora-footer-link"
          >
            Terms of Service
          </a>

          <a
            href="/privacy"
            class="kasyora-footer-link"
          >
            Privacy Policy
          </a>

          <a
            href="/store/contact"
            class="kasyora-footer-link"
          >
            Contact Kasyora
          </a>

        </nav>


        <div
          class="kasyora-footer-trust border rounded-3 p-3"
        >

          <div
            class="d-flex align-items-start gap-2"
          >
            <i
              class="fas fa-building text-success mt-1"
              aria-hidden="true"
            ></i>

            <div>

              <div class="fw-bold mb-1">
                South African Company
              </div>

              <div class="small">
                KASYORA (Pty) Ltd is incorporated
                in the Republic of South Africa.
              </div>

            </div>
          </div>

        </div>

      </div>

    </div>

  </div>


  <!-- =====================================================
       GLOBAL VISION STRIP
       ===================================================== -->
  <div class="kasyora-footer-vision">

    <div class="kasyora-footer-inner py-3">

      <div
        class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3"
      >

        <div
          class="d-flex align-items-start align-items-sm-center gap-3"
        >
          <div
            class="kasyora-footer-vision-icon flex-shrink-0"
          >
            <i
              class="fas fa-earth-africa"
              aria-hidden="true"
            ></i>
          </div>

          <div>

            <div class="fw-bold">
              Built in South Africa.
              Designed for global participation.
            </div>

            <div
              class="small kasyora-footer-vision-copy"
            >
              Connecting commerce while supporting
              a future in which economic opportunity
              can reach across borders.
            </div>

          </div>
        </div>


        <a
          href="/users/about"
          class="btn btn-sm fw-bold flex-shrink-0 kasyora-footer-vision-btn"
        >
          Our Vision

          <i
            class="fas fa-arrow-right ms-2"
            aria-hidden="true"
          ></i>
        </a>

      </div>

    </div>

  </div>


  <!-- =====================================================
       BOTTOM LEGAL BAR
       ===================================================== -->
  <div class="kasyora-footer-bottom">

    <div class="kasyora-footer-inner py-3">

      <div
        class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2"
      >

        <div class="small">
          © <%= new Date().getFullYear() %>
          KASYORA (Pty) Ltd.
          All rights reserved.
        </div>


        <div
          class="d-flex flex-wrap align-items-center gap-2 small"
        >

          <span>
            Registration No. 2026/419298/07
          </span>

          <span
            class="kasyora-footer-dot"
            aria-hidden="true"
          >
            •
          </span>

          <a
            href="/terms"
            class="kasyora-footer-bottom-link"
          >
            Terms
          </a>

          <span
            class="kasyora-footer-dot"
            aria-hidden="true"
          >
            •
          </span>

          <a
            href="/privacy"
            class="kasyora-footer-bottom-link"
          >
            Privacy
          </a>

        </div>

      </div>

    </div>

  </div>

</footer>


<style nonce="<%= FOOTER_NONCE %>">
  /*
   * =========================================================
   * KASYORA CORPORATE FOOTER
   * =========================================================
   *
   * Full-width footer.
   *
   * No 1000px / 1200px max-width wrapper is used.
   * Only responsive screen-edge padding is applied.
   */

  .kasyora-footer {
    --footer-purple:
      #7C3AED;

    --footer-green:
      #22C55E;

    --footer-dark:
      #111827;

    width: 100vw;
    max-width: 100vw;

    margin-left:
      calc(50% - 50vw);

    margin-right:
      calc(50% - 50vw);

    overflow-x:
      clip;

    box-sizing:
      border-box;

    font-size:
      14px;
  }


  /*
   * Full-width inner content.
   *
   * There is deliberately no max-width.
   */
  .kasyora-footer-inner {
    width: 100%;
    max-width: none;

    margin: 0;

    padding-left:
      16px;

    padding-right:
      16px;

    box-sizing:
      border-box;
  }

  /*
  * Light footer
  *
  * Soft Kasyora green background inspired by the
  * original footer, while keeping the new corporate
  * footer structure.
  */
  .kasyora-footer-light {
    background:
      linear-gradient(
        135deg,
        #F0FDF4 0%,
        #ECFDF5 48%,
        #FFFFFF 100%
      );

    color:
      #111827;

    border-top:
      1px solid
      #D1FAE5;
  }

  /*
   * Dark footer
   */
  .kasyora-footer-dark {
    background:
      #111827;

    color:
      #f8fafc;

    border-top:
      1px solid
      rgba(
        255,
        255,
        255,
        .10
      );
  }


  /*
   * Main content
   */
  .kasyora-footer >
  .kasyora-footer-inner {
    padding-top:
      40px;

    padding-bottom:
      40px;
  }


  /*
   * Brand
   */
  .kasyora-footer-brand {
    color:
      inherit;
  }


  .kasyora-footer-brand:hover {
    color:
      var(
        --footer-purple
      );
  }


  .kasyora-footer-logo {
    width:
      40px;

    height:
      40px;

    object-fit:
      contain;

    border-radius:
      10px;

    box-shadow:
      0 4px 16px
      rgba(
        15,
        23,
        42,
        .12
      );

    flex:
      0 0 auto;
  }


  .kasyora-footer-brand-name {
    font-size:
      1.1rem;

    font-weight:
      800;

    line-height:
      1.1;
  }


  .kasyora-footer-brand-legal {
    margin-top:
      3px;

    font-size:
      .75rem;

    opacity:
      .65;
  }


  /*
   * Company copy
   */
  .kasyora-footer-description {
    max-width:
      620px;

    line-height:
      1.7;

    opacity:
      .75;
  }


  .kasyora-footer-company-item {
    padding-left:
      12px;

    border-left:
      3px solid
      var(
        --footer-purple
      );
  }


  .kasyora-footer-company-item:nth-child(even) {
    border-left-color:
      var(
        --footer-green
      );
  }


  .kasyora-footer-label {
    margin-bottom:
      2px;

    font-size:
      .72rem;

    opacity:
      .60;

    text-transform:
      uppercase;

    letter-spacing:
      .04em;
  }


  .kasyora-footer-value {
    font-weight:
      700;
  }


  /*
   * Navigation
   */
  .kasyora-footer-heading {
    margin-bottom:
      16px;

    font-weight:
      800;

    color:
      inherit;
  }


  .kasyora-footer-link {
    width:
      fit-content;

    color:
      inherit;

    opacity:
      .68;

    text-decoration:
      none;

    transition:
      color .15s ease,
      opacity .15s ease;
  }


  .kasyora-footer-link:hover {
    color:
      var(
        --footer-purple
      );

    opacity:
      1;
  }


  .kasyora-footer-dark
  .kasyora-footer-link:hover {
    color:
      #c4b5fd;
  }


  /*
   * Trust box
   */
  .kasyora-footer-trust {
    background:
      rgba(
        124,
        58,
        237,
        .05
      );

    border-color:
      rgba(
        124,
        58,
        237,
        .15
      ) !important;
  }


  .kasyora-footer-dark
  .kasyora-footer-trust {
    background:
      rgba(
        255,
        255,
        255,
        .05
      );

    border-color:
      rgba(
        255,
        255,
        255,
        .10
      ) !important;
  }


  /*
   * Global vision strip
   */
  .kasyora-footer-vision {
    color:
      #ffffff;

    background:
      radial-gradient(
        circle at 85% 20%,
        rgba(
          34,
          197,
          94,
          .22
        ),
        transparent 28%
      ),
      linear-gradient(
        135deg,
        #4C1D95 0%,
        #7C3AED 55%,
        #5B21B6 100%
      );
  }


  .kasyora-footer-vision-icon {
    width:
      42px;

    height:
      42px;

    border-radius:
      50%;

    display:
      inline-flex;

    align-items:
      center;

    justify-content:
      center;

    color:
      #111827;

    background:
      var(
        --footer-green
      );
  }


  .kasyora-footer-vision-copy {
    margin-top:
      2px;

    color:
      rgba(
        255,
        255,
        255,
        .72
      );
  }


  /*
  * Footer vision CTA.
  *
  * Keep text and arrow clearly visible before hover
  * on the purple global-vision strip.
  */
  .kasyora-footer-vision-btn {
    background:
      rgba(
        255,
        255,
        255,
        .04
      ) !important;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        .92
      ) !important;

    color:
      #FFFFFF !important;
  }


  .kasyora-footer-vision-btn i {
    color:
      #FFFFFF !important;
  }


  .kasyora-footer-vision-btn:hover,
  .kasyora-footer-vision-btn:focus {
    background:
      #FFFFFF !important;

    border-color:
      #FFFFFF !important;

    color:
      #7C3AED !important;
  }


  .kasyora-footer-vision-btn:hover i,
  .kasyora-footer-vision-btn:focus i {
    color:
      #7C3AED !important;
  }


  /*
   * Bottom bar
   */
  .kasyora-footer-bottom {
    border-top:
      1px solid
      rgba(
        15,
        23,
        42,
        .08
      );

    background:
      #f8fafc;

    color:
      #64748b;
  }


  .kasyora-footer-dark
  .kasyora-footer-bottom {
    border-top-color:
      rgba(
        255,
        255,
        255,
        .08
      );

    background:
      #0b1120;

    color:
      #94a3b8;
  }


  .kasyora-footer-bottom-link {
    color:
      var(
        --footer-purple
      );

    font-weight:
      600;

    text-decoration:
      none;
  }


  .kasyora-footer-bottom-link:hover {
    text-decoration:
      underline;
  }


  .kasyora-footer-dark
  .kasyora-footer-bottom-link {
    color:
      #c4b5fd;
  }


  .kasyora-footer-dot {
    opacity:
      .45;
  }


  /*
   * Tablet
   */
  @media (min-width: 768px) {
    .kasyora-footer-inner {
      padding-left:
        24px;

      padding-right:
        24px;
    }
  }


  /*
   * Large screens.
   *
   * Footer intentionally remains full-width.
   */
  @media (min-width: 1200px) {
    .kasyora-footer-inner {
      padding-left:
        32px;

      padding-right:
        32px;
    }
  }


  /*
   * Mobile
   */
  @media (max-width: 575.98px) {
    .kasyora-footer-inner {
      padding-left:
        12px;

      padding-right:
        12px;
    }


    .kasyora-footer >
    .kasyora-footer-inner {
      padding-top:
        32px;

      padding-bottom:
        32px;
    }


    .kasyora-footer-description {
      line-height:
        1.6;
    }


    .kasyora-footer-vision
    .btn {
      width:
        100%;
    }


    .kasyora-footer-bottom {
      text-align:
        center;
    }


    .kasyora-footer-bottom
    .d-flex {
      justify-content:
        center;
    }
  }


  /*
   * Keyboard accessibility
   */
  .kasyora-footer a:focus-visible {
    outline:
      2px solid
      var(
        --footer-green
      );

    outline-offset:
      3px;
  }


  /*
   * Reduced motion.
   */
  @media (prefers-reduced-motion: reduce) {
    .kasyora-footer-link,
    .kasyora-footer-brand {
      transition:
        none;
    }
  }
</style>