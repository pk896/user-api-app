<!-- views/cj/cart.ejs -->
<%
  /*
  * BASE_CURRENCY remains authoritative for all CJ product,
  * cart, checkout, shipping, payment, order and supplier
  * fulfilment calculations.
  *
  * Kasyora adds and collects no VAT in the CJ flow.
  * Destination import VAT, customs duties and carrier charges
  * are outside this cart calculation.
  *
  * CURRENCY is only the customer's selected display currency.
  */
  const BASE_CURRENCY = String(
    typeof baseCurrency !== 'undefined'
      ? baseCurrency
      : 'USD'
  ).trim().toUpperCase() || 'USD';

  const CURRENCY = String(
    typeof displayCurrency !== 'undefined'
      ? displayCurrency
      : BASE_CURRENCY
  ).trim().toUpperCase() || BASE_CURRENCY;

  const CURRENCY_RATE_RAW = Number(
    typeof displayRate !== 'undefined'
      ? displayRate
      : NaN
  );

  /*
   * displayCurrency/displayRate are already resolved safely by
   * middleware/userCurrency.js.
   *
   * If FX conversion is unavailable, that middleware changes the
   * actual rendered displayCurrency back to BASE_CURRENCY and
   * supplies rate 1.
   *
   * Keep this template defensive too: rate 1 is safe without an
   * FX lookup only when the rendered currency is BASE_CURRENCY.
   */
  const CURRENCY_RATE =
    Number.isFinite(CURRENCY_RATE_RAW) &&
    CURRENCY_RATE_RAW > 0
      ? CURRENCY_RATE_RAW
      : (
          CURRENCY === BASE_CURRENCY
            ? 1
            : NaN
        );

  /*
   * Display rounding must follow the currency that is actually
   * rendered on this response.
   *
   * Examples:
   *
   * JPY -> 0 decimals
   * USD -> 2 decimals
   * KWD -> 3 decimals
   */
  const CURRENCY_DECIMALS_RAW = Number(
    typeof displayCurrencyDetails !== 'undefined' &&
    displayCurrencyDetails &&
    typeof displayCurrencyDetails.decimals !== 'undefined'
      ? displayCurrencyDetails.decimals
      : 2
  );

  const CURRENCY_DECIMALS =
    Number.isInteger(CURRENCY_DECIMALS_RAW) &&
    CURRENCY_DECIMALS_RAW >= 0 &&
    CURRENCY_DECIMALS_RAW <= 4
      ? CURRENCY_DECIMALS_RAW
      : 2;

  const ITEMS = Array.isArray(cartItems)
    ? cartItems
    : [];

  const ITEM_COUNT = Number(
    typeof itemCount !== 'undefined'
      ? itemCount
      : 0
  );

  /*
   * CJ cart prices contain no Kasyora-added VAT.
   *
   * Prefer the new VAT-free summary fields.
   * Keep the old field names only as temporary fallbacks
   * while the CJ checkout is still being patched.
   */
  const CJ_SUBTOTAL = Number(
    typeof subtotal !== 'undefined'
      ? subtotal
      : (
          typeof subtotalExVat !== 'undefined'
            ? subtotalExVat
            : 0
        )
  );

  const CJ_TOTAL = Number(
    typeof total !== 'undefined'
      ? total
      : (
          typeof totalIncVat !== 'undefined'
            ? totalIncVat
            : CJ_SUBTOTAL
        )
  );

  /*
   * Convert only visible values.
   * The underlying CJ cart amounts remain in BASE_CURRENCY.
   */
  function convertBaseToDisplay(amount) {
    const baseAmount = Number(amount || 0);

    if (
      !Number.isFinite(baseAmount) ||
      !Number.isFinite(CURRENCY_RATE) ||
      CURRENCY_RATE <= 0
    ) {
      return 0;
    }

    return Number(
      (
        baseAmount *
        CURRENCY_RATE
      ).toFixed(
        CURRENCY_DECIMALS
      )
    );
  }

  function formatMoney(amount) {
    const convertedAmount =
      convertBaseToDisplay(amount);

    try {
      const formatted =
        new Intl.NumberFormat(
          undefined,
          {
            style: 'currency',

            currency:
              CURRENCY,

            minimumFractionDigits:
              CURRENCY_DECIMALS,

            maximumFractionDigits:
              CURRENCY_DECIMALS
          }
        ).format(
          convertedAmount
        );

      if (CURRENCY === 'ZAR') {
        return formatted.replace(
          /^ZAR\s?/,
          'R'
        );
      }

      return formatted;
    } catch (error) {
      return (
        CURRENCY +
        ' ' +
        convertedAmount.toFixed(
          CURRENCY_DECIMALS
        )
      );
    }
  }

  const CJ_CART_CURRENCY_RETURN_TO =
    '/cj/cart';
%>

<!-- Page Header Start -->
<div class="container-fluid bg-light py-4 border-bottom">
  <div class="container">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
      <div>
        <span class="badge bg-success mb-2">
          CJ Dropshipping Department
        </span>

        <h1 class="text-primary mb-1">
          CJ Cart
        </h1>

        <nav aria-label="breadcrumb">
          <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
              <a href="/store">Store</a>
            </li>

            <li class="breadcrumb-item active" aria-current="page">
              CJ Cart
            </li>
          </ol>
        </nav>
      </div>

      <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-2">
        <div class="bg-white border rounded px-2 py-1">
          <div class="small fw-bold text-primary mb-1">
            Display currency
          </div>

          <%- include('../store/partials/currency-selector', {
            currencyReturnTo: CJ_CART_CURRENCY_RETURN_TO
          }) %>
        </div>

        <a href="/store#homeProductsSection" class="btn btn-outline-primary rounded-pill px-4">
          <i class="fas fa-arrow-left me-2"></i>
          Continue Shopping
        </a>
      </div>
    </div>
  </div>
</div>
<!-- Page Header End -->

<%
  const CJ_CART_SHOW_CURRENCY_WARNING =
    typeof currencyConversionAvailable !== 'undefined' &&
    currencyConversionAvailable === false;

  const CJ_CART_CURRENCY_WARNING_TEXT =
    typeof currencyConversionMessage !== 'undefined'
      ? String(currencyConversionMessage || '').trim()
      : '';
%>

<% if (
  CJ_CART_SHOW_CURRENCY_WARNING &&
  CJ_CART_CURRENCY_WARNING_TEXT
) { %>
<div class="container mt-4">
  <div class="alert alert-warning border shadow-sm mb-0" role="alert">
    <div class="d-flex align-items-start gap-2">
      <i class="fas fa-exclamation-triangle text-primary mt-1" aria-hidden="true"></i>

      <div>
        <div class="fw-bold text-primary">
          Currency display notice
        </div>

        <div class="small">
          <%= CJ_CART_CURRENCY_WARNING_TEXT %>
        </div>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- Department Notice Start -->
<div class="container-fluid px-0">
  <div class="alert alert-success rounded-0 border-0 mb-0">
    <div class="container">
      <div class="d-flex align-items-start gap-3">
        <i class="fas fa-shopping-cart fa-lg mt-1"></i>

        <div>
          <strong>
            Separate CJ cart
          </strong>

          <div class="small mt-1">
            This cart contains only CJ Dropshipping products.
            Your internal Kasyora seller and supplier cart remains separate
            and is not changed by this page.
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- Department Notice End -->

<!-- CJ Cart Start -->
<div class="container-fluid py-4 py-lg-5 px-0">
  <div class="container-fluid px-0 px-lg-4">
    <div id="cjCartMessage" class="d-none mx-2 mx-lg-0" role="alert"></div>

    <% if (ITEMS.length === 0) { %>
    <!-- Empty Cart -->
    <div id="cjEmptyCartState" class="card border-0 shadow-sm rounded-0">
      <div class="card-body text-center py-5">
        <div class="mb-4">
          <i class="fas fa-shopping-cart fa-4x text-primary"></i>
        </div>

        <h2 class="text-primary">
          Your CJ cart is empty
        </h2>

        <p class="text-muted mb-4">
          Browse the CJ Dropshipping department and select a product variant
          to add it to this separate cart.
        </p>

        <a href="/store#homeProductsSection" class="btn btn-primary btn-lg rounded-pill px-5">
          <i class="fas fa-store me-2"></i>
          Browse CJ Products
        </a>
      </div>
    </div>
    <% } else { %>
    <div id="cjCartContent" class="row g-0 g-lg-4">
      <!-- Cart Items -->
      <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-0">
          <div class="card-header bg-primary text-white py-3">
            <div class="d-flex align-items-center justify-content-between">
              <h4 class="mb-0 text-white">
                CJ Cart Items
              </h4>

              <span id="cjCartItemCountBadge" class="badge bg-success">
                <%= ITEM_COUNT %>
                item<%= ITEM_COUNT === 1 ? '' : 's' %>
              </span>
            </div>
          </div>

          <div class="card-body p-0">
            <div id="cjCartItems">
              <% ITEMS.forEach(function(item) { %>
              <div class="cj-cart-item border-bottom p-3 p-lg-4" data-cj-variant-id="<%= item.cjVariantId %>">
                <div class="row g-3 align-items-start">
                  <!-- Product Image -->
                  <div class="col-4 col-md-2">
                    <a href="/cj/product/<%= encodeURIComponent(item.cjProductId) %>" class="d-block border rounded p-2 bg-white">
                      <img src="<%= item.imageUrl %>" alt="<%= item.name %>" class="img-fluid w-100" style="height: 110px; object-fit: contain;">
                    </a>
                  </div>

                  <!-- Product Information -->
                  <div class="col-8 col-md-4">
                    <a href="/cj/product/<%= encodeURIComponent(item.cjProductId) %>" class="text-decoration-none">
                      <h5 class="text-primary mb-2">
                        <%= item.name %>
                      </h5>
                    </a>

                    <div class="small text-muted mb-1">
                      Variant:
                      <strong class="text-dark">
                        <%= item.variantName %>
                      </strong>
                    </div>

                    <div class="small text-muted mb-1">
                      Variant SKU:
                      <span class="text-dark text-break">
                        <%= item.variantSku || 'Not available' %>
                      </span>
                    </div>

                    <% if (item.inventoryKnown) { %>
                    <div class="small text-muted">
                      Inventory snapshot:
                      <span class="text-dark">
                        <%= item.inventorySnapshot %>
                      </span>
                    </div>
                    <% } else { %>
                    <div class="small text-muted">
                      Inventory will be checked again during checkout.
                    </div>
                    <% } %>
                  </div>

                  <!-- Unit Price -->
                  <div class="col-6 col-md-2">
                    <div class="small text-muted mb-1">
                      Unit price
                    </div>

                    <div class="fw-bold text-primary">
                      <%= formatMoney(
                        Number(
                          item.priceExVat ??
                          item.price ??
                          0
                        )
                      ) %>
                    </div>
                  </div>

                  <!-- Quantity -->
                  <div class="col-6 col-md-2">
                    <label for="cjQuantity_<%= item.cjVariantId %>" class="small text-muted mb-1">
                      Quantity
                    </label>

                    <div class="input-group">
                      <button type="button" class="btn btn-outline-primary js-cj-quantity-step" data-cj-variant-id="<%= item.cjVariantId %>" data-step="-1" aria-label="Decrease quantity">
                        <i class="fas fa-minus"></i>
                      </button>

                      <input id="cjQuantity_<%= item.cjVariantId %>" type="number" class="form-control text-center js-cj-cart-quantity" value="<%= item.quantity %>" min="1" max="<%= item.inventoryKnown ? Math.max(1, Number(item.inventorySnapshot || 1)) : 100 %>" step="1" data-cj-variant-id="<%= item.cjVariantId %>" data-previous-quantity="<%= item.quantity %>">

                      <button type="button" class="btn btn-outline-primary js-cj-quantity-step" data-cj-variant-id="<%= item.cjVariantId %>" data-step="1" aria-label="Increase quantity">
                        <i class="fas fa-plus"></i>
                      </button>
                    </div>
                  </div>

                  <!-- Line Total / Remove -->
                  <div class="col-12 col-md-2 text-md-end">
                    <div class="small text-muted mb-1">
                      Line total
                    </div>

                    <div class="fw-bold text-primary fs-5 mb-2 js-cj-line-total" data-cj-variant-id="<%= item.cjVariantId %>">
                      <%= formatMoney(
                        Number(
                          item.priceExVat ??
                          item.price ??
                          0
                        ) *
                        Number(
                          item.quantity ||
                          0
                        )
                      ) %>
                    </div>

                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill js-cj-remove-item" data-cj-variant-id="<%= item.cjVariantId %>">
                      <i class="fas fa-trash-alt me-1"></i>
                      Remove
                    </button>
                  </div>
                </div>
              </div>
              <% }) %>
            </div>
          </div>

          <div class="card-footer bg-white py-3">
            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-between">
              <a href="/store#homeProductsSection" class="btn btn-outline-primary rounded-pill">
                <i class="fas fa-arrow-left me-2"></i>
                Continue Shopping
              </a>

              <button id="cjClearCartButton" type="button" class="btn btn-outline-danger rounded-pill">
                <i class="fas fa-trash me-2"></i>
                Clear CJ Cart
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Cart Summary -->
      <div class="col-12 col-lg-4 mt-4 mt-lg-0">
        <div class="card border-0 shadow-sm rounded-0">
          <div class="card-header bg-primary text-white py-3">
            <h4 class="text-white mb-0">
              CJ Order Summary
            </h4>
          </div>

          <div class="card-body p-4">
            <div class="d-flex justify-content-between mb-3">
              <span class="text-muted">
                Items
              </span>

              <strong id="cjSummaryItemCount">
                <%= ITEM_COUNT %>
              </strong>
            </div>

            <div class="d-flex justify-content-between mb-3">
              <span class="text-muted">
                Product subtotal
              </span>

              <strong id="cjSummarySubtotal">
                <%= formatMoney(CJ_SUBTOTAL) %>
              </strong>
            </div>

            <hr>

            <div class="d-flex justify-content-between align-items-center mb-4">
              <span class="fw-bold fs-5">
                Cart total
              </span>

              <strong id="cjSummaryTotal" class="text-primary fs-4">
                <%= formatMoney(CJ_TOTAL) %>
              </strong>
            </div>

            <div class="alert alert-light border small">
              <div class="mb-2">
                <i class="fas fa-info-circle text-primary me-2"></i>

                Kasyora does not add or collect VAT on CJ Dropshipping
                products. Shipping and CJ logistics costs will be calculated
                in the CJ checkout. Any destination import VAT,
                customs duties remain the customer’s responsibility
                during import and delivery.
              </div>

              <div>
                Visible amounts are displayed in
                <strong><%= CURRENCY %></strong>.
                CJ cart, checkout, shipping, PayPal and supplier-order values
                remain securely calculated in
                <strong><%= BASE_CURRENCY %></strong>.
              </div>
            </div>

            <a href="/cj/checkout" id="cjProceedCheckoutButton" class="btn btn-primary btn-lg rounded-pill w-100">
              <i class="fas fa-lock me-2"></i>
              Proceed To CJ Checkout
            </a>

            <div class="small text-muted text-center mt-3">
              This checkout does not use Shippo, Courier Guy or the internal
              Kasyora order flow.
            </div>
          </div>
        </div>
      </div>
    </div>
    <% } %>
  </div>
</div>
<!-- CJ Cart End -->

<%- include('../store/partials/footer') %>

<%- include('../store/partials/currency-client') %>

<script nonce="<%= nonce %>">
  (function() {
    const messageElement = document.getElementById(
      'cjCartMessage'
    );

    const cartContent = document.getElementById(
      'cjCartContent'
    );

    const cartItemsContainer = document.getElementById(
      'cjCartItems'
    );

    const itemCountBadge = document.getElementById(
      'cjCartItemCountBadge'
    );

    const summaryItemCount = document.getElementById(
      'cjSummaryItemCount'
    );

    const summarySubtotal = document.getElementById(
      'cjSummarySubtotal'
    );

    const summaryTotal = document.getElementById(
      'cjSummaryTotal'
    );

    const clearCartButton = document.getElementById(
      'cjClearCartButton'
    );

    const checkoutButton = document.getElementById(
      'cjProceedCheckoutButton'
    );

    function formatMoney(amount) {
      /*
       * Every amount returned by /api/cj-cart is still an
       * authoritative BASE_CURRENCY amount.
       */
      if (
        window.KasyoraCurrency &&
        typeof window.KasyoraCurrency.formatBaseAmount === 'function'
      ) {
        return window.KasyoraCurrency.formatBaseAmount(
          amount
        );
      }

      /*
       * Defensive fallback:
       * never attach the selected display-currency label to an
       * amount that was not converted.
       */
      const fallbackAmount =
        Number(amount || 0);

      /*
       * This branch is reached only if the normal
       * window.KasyoraCurrency helper is unavailable.
       *
       * Fall back to authoritative BASE_CURRENCY rather than
       * pretending an unconverted amount is in the requested
       * display currency.
       *
       * Let Intl determine BASE_CURRENCY's normal fraction digits
       * so this fallback also works safely for currencies with
       * 0, 2 or 3 decimal places.
       */
      const fallbackCurrency =
        "<%= String(typeof baseCurrency !== 'undefined' ? baseCurrency : 'USD').trim().toUpperCase() || 'USD' %>";

      let fallbackDecimals = 2;

      try {
        const fallbackFormatter =
          new Intl.NumberFormat(
            undefined, {
              style: 'currency',

              currency: fallbackCurrency
            }
          );

        const resolvedOptions =
          fallbackFormatter
          .resolvedOptions();

        const resolvedDecimals =
          Number(
            resolvedOptions
            .maximumFractionDigits
          );

        if (
          Number.isInteger(
            resolvedDecimals
          ) &&
          resolvedDecimals >= 0 &&
          resolvedDecimals <= 4
        ) {
          fallbackDecimals =
            resolvedDecimals;
        }

        const formatted =
          fallbackFormatter.format(
            Number.isFinite(
              fallbackAmount
            ) ?
            fallbackAmount :
            0
          );

        if (
          fallbackCurrency ===
          'ZAR'
        ) {
          return formatted.replace(
            /^ZAR\s?/,
            'R'
          );
        }

        return formatted;
      } catch (error) {
        return (
          fallbackCurrency +
          ' ' +
          (
            Number.isFinite(
              fallbackAmount
            ) ?
            fallbackAmount :
            0
          ).toFixed(
            fallbackDecimals
          )
        );
      }
    }

    function showMessage(message, type, scrollToTop = true) {
      if (!messageElement) {
        return;
      }

      messageElement.className =
        'alert alert-' +
        (type === 'success' ?
          'success' :
          'danger');

      messageElement.textContent = String(
        message || ''
      );

      if (scrollToTop) {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      }
    }

    function clearMessage() {
      if (!messageElement) {
        return;
      }

      messageElement.className = 'd-none';
      messageElement.textContent = '';
    }

    function safeQuantity(value, maximum) {
      const max = Math.max(
        1,
        Number(maximum || 100)
      );

      let quantity = Math.floor(
        Number(value || 1)
      );

      if (!Number.isFinite(quantity)) {
        quantity = 1;
      }

      return Math.max(
        1,
        Math.min(max, quantity)
      );
    }

    function updateSummary(data) {
      const itemCount =
        Number(
          data?.itemCount ||
          0
        );

      /*
       * Prefer the new VAT-free CJ summary fields.
       *
       * The older names remain fallbacks only until the
       * separate CJ checkout has also been patched.
       */
      const subtotal =
        Number(
          data?.subtotal ??
          data?.subtotalExVat ??
          0
        );

      const total =
        Number(
          data?.total ??
          data?.totalIncVat ??
          subtotal
        );

      if (itemCountBadge) {
        itemCountBadge.textContent =
          String(itemCount) +
          ' item' +
          (
            itemCount === 1 ?
            '' :
            's'
          );
      }

      if (summaryItemCount) {
        summaryItemCount.textContent =
          String(itemCount);
      }

      if (summarySubtotal) {
        summarySubtotal.textContent =
          formatMoney(
            subtotal
          );
      }

      if (summaryTotal) {
        summaryTotal.textContent =
          formatMoney(
            total
          );
      }

      if (checkoutButton) {
        checkoutButton.classList.toggle(
          'disabled',
          itemCount <= 0
        );

        checkoutButton.setAttribute(
          'aria-disabled',
          itemCount <= 0 ?
          'true' :
          'false'
        );
      }

      document
        .querySelectorAll(
          '.store-cart-total'
        )
        .forEach(function(element) {
          element.textContent =
            formatMoney(
              total
            );
        });

      document
        .querySelectorAll(
          '.store-cart-link'
        )
        .forEach(function(link) {
          link.href =
            '/cj/cart';

          link.classList.toggle(
            'cart-flash-active',
            itemCount > 0
          );
        });
    }

    function renderEmptyCart() {
      if (!cartContent) {
        window.location.reload();
        return;
      }

      cartContent.outerHTML = `
        <div
          id="cjEmptyCartState"
          class="card border-0 shadow-sm rounded-0"
        >
          <div class="card-body text-center py-5">
            <div class="mb-4">
              <i class="fas fa-shopping-cart fa-4x text-primary"></i>
            </div>

            <h2 class="text-primary">
              Your CJ cart is empty
            </h2>

            <p class="text-muted mb-4">
              Browse the CJ Dropshipping department and select a product
              variant to add it to this separate cart.
            </p>

            <a
              href="/store#homeProductsSection"
              class="btn btn-primary btn-lg rounded-pill px-5"
            >
              <i class="fas fa-store me-2"></i>
              Browse CJ Products
            </a>
          </div>
        </div>
      `;
    }

    async function updateCjCartQuantity(input, nextQuantity) {
      if (!input) {
        return;
      }

      clearMessage();

      const cjVariantId = String(
        input.getAttribute(
          'data-cj-variant-id'
        ) || ''
      ).trim();

      const previousQuantity = safeQuantity(
        input.getAttribute(
          'data-previous-quantity'
        ),
        input.max
      );

      const quantity = safeQuantity(
        nextQuantity,
        input.max
      );

      input.value = String(quantity);
      input.disabled = true;

      document
        .querySelectorAll(
          '.js-cj-quantity-step[data-cj-variant-id="' +
          CSS.escape(cjVariantId) +
          '"]'
        )
        .forEach(function(button) {
          button.disabled = true;
        });

      try {
        const data = await postCartAction(
          '/api/cj-cart/quantity', {
            cjVariantId,
            quantity
          }
        );

        input.setAttribute(
          'data-previous-quantity',
          String(quantity)
        );

        const updatedItem = Array.isArray(data.items) ?
          data.items.find(function(item) {
            return String(
              item?.cjVariantId || ''
            ) === cjVariantId;
          }) :
          null;

        const lineTotalElement =
          document.querySelector(
            '.js-cj-line-total[data-cj-variant-id="' +
            CSS.escape(cjVariantId) +
            '"]'
          );

        if (
          lineTotalElement &&
          updatedItem
        ) {
          lineTotalElement.textContent =
            formatMoney(
              Number(
                updatedItem.priceExVat ??
                updatedItem.price ??
                0
              ) *
              Number(
                updatedItem.quantity ||
                0
              )
            );
        }

        updateSummary(data);

        showMessage(
          data.message ||
          'CJ cart quantity updated.',
          'success',
          false
        );
      } catch (error) {
        input.value =
          String(previousQuantity);

        showMessage(
          error?.message ||
          'The CJ cart quantity could not be updated.',
          'error',
          false
        );
      } finally {
        input.disabled = false;

        document
          .querySelectorAll(
            '.js-cj-quantity-step[data-cj-variant-id="' +
            CSS.escape(cjVariantId) +
            '"]'
          )
          .forEach(function(button) {
            button.disabled = false;
          });
      }
    }

    async function postCartAction(url, body) {
      const response = await fetch(url, {
        method: 'POST',

        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json'
        },

        credentials: 'same-origin',

        body: JSON.stringify(body || {})
      });

      const data = await response
        .json()
        .catch(function() {
          return {};
        });

      if (
        !response.ok ||
        data.success === false
      ) {
        throw new Error(
          data.message ||
          'The CJ cart could not be updated.'
        );
      }

      return data;
    }

    document.addEventListener(
      'change',
      async function(event) {
        const input = event.target.closest(
          '.js-cj-cart-quantity'
        );

        if (!input) {
          return;
        }

        await updateCjCartQuantity(
          input,
          input.value
        );
      }
    );

    document.addEventListener(
      'click',
      async function(event) {
        const stepButton = event.target.closest(
          '.js-cj-quantity-step'
        );

        if (stepButton) {
          event.preventDefault();

          const cjVariantId = String(
            stepButton.getAttribute(
              'data-cj-variant-id'
            ) || ''
          ).trim();

          const step = Number(
            stepButton.getAttribute(
              'data-step'
            ) || 0
          );

          const input = document.querySelector(
            '.js-cj-cart-quantity[data-cj-variant-id="' +
            CSS.escape(cjVariantId) +
            '"]'
          );

          if (!input) {
            showMessage(
              'The CJ cart quantity field could not be found.',
              'error'
            );

            return;
          }

          const nextQuantity =
            safeQuantity(
              Number(input.value || 1) + step,
              input.max
            );

          await updateCjCartQuantity(
            input,
            nextQuantity
          );

          return;
        }
        const removeButton = event.target.closest(
          '.js-cj-remove-item'
        );

        if (!removeButton) {
          return;
        }

        event.preventDefault();
        clearMessage();

        const cjVariantId = String(
          removeButton.getAttribute(
            'data-cj-variant-id'
          ) || ''
        ).trim();

        if (!cjVariantId) {
          showMessage(
            'The CJ cart item could not be identified.',
            'error'
          );

          return;
        }

        const originalHtml =
          removeButton.innerHTML;

        removeButton.disabled = true;
        removeButton.innerHTML =
          '<span class="spinner-border spinner-border-sm me-1"></span>' +
          'Removing...';

        try {
          const data = await postCartAction(
            '/api/cj-cart/remove', {
              cjVariantId
            }
          );

          const row = removeButton.closest(
            '.cj-cart-item'
          );

          if (row) {
            row.remove();
          }

          updateSummary(data);

          if (
            !Array.isArray(data.items) ||
            data.items.length === 0
          ) {
            renderEmptyCart();
          } else {
            showMessage(
              data.message ||
              'CJ product removed from the cart.',
              'success'
            );
          }
        } catch (error) {
          removeButton.disabled = false;
          removeButton.innerHTML =
            originalHtml;

          showMessage(
            error?.message ||
            'The CJ product could not be removed.',
            'error'
          );
        }
      }
    );

    clearCartButton?.addEventListener(
      'click',
      async function() {
        clearMessage();

        const confirmed = window.confirm(
          'Remove every product from the separate CJ cart?'
        );

        if (!confirmed) {
          return;
        }

        const originalHtml =
          clearCartButton.innerHTML;

        clearCartButton.disabled = true;
        clearCartButton.innerHTML =
          '<span class="spinner-border spinner-border-sm me-2"></span>' +
          'Clearing...';

        try {
          const data = await postCartAction(
            '/api/cj-cart/clear', {}
          );

          updateSummary(data);
          renderEmptyCart();
        } catch (error) {
          clearCartButton.disabled = false;
          clearCartButton.innerHTML =
            originalHtml;

          showMessage(
            error?.message ||
            'The CJ cart could not be cleared.',
            'error'
          );
        }
      }
    );
  })();
</script>