<!-- views/cj/product.ejs -->
<%
  /*
   * BASE_CURRENCY remains authoritative for CJ product,
   * variant, cart, checkout, payment and order amounts.
   *
   * Kasyora adds and collects no VAT in the CJ flow.
   * Destination import VAT, customs duties and carrier charges
   * remain outside Kasyora's product-price calculation.
   *
   * CURRENCY affects customer-visible prices only.
   */
  const BASE_CURRENCY = String(
    typeof baseCurrency !== 'undefined'
      ? baseCurrency
      : product?.currency || 'USD'
  ).trim().toUpperCase() || 'USD';

  const CURRENCY = String(
    typeof displayCurrency !== 'undefined'
      ? displayCurrency
      : BASE_CURRENCY
  ).trim().toUpperCase() || BASE_CURRENCY;

  const CURRENCY_RATE_RAW = Number(
    typeof displayRate !== 'undefined'
      ? displayRate
      : NaN
  );

  /*
   * displayCurrency/displayRate are already resolved safely by
   * middleware/userCurrency.js.
   *
   * If FX conversion is unavailable, that middleware changes the
   * actual rendered displayCurrency back to BASE_CURRENCY and
   * supplies rate 1.
   *
   * Keep this template defensive too: rate 1 is safe without an
   * FX lookup only when the rendered currency is BASE_CURRENCY.
   */
  const CURRENCY_RATE =
    Number.isFinite(CURRENCY_RATE_RAW) &&
    CURRENCY_RATE_RAW > 0
      ? CURRENCY_RATE_RAW
      : (
          CURRENCY === BASE_CURRENCY
            ? 1
            : NaN
        );

  /*
   * Display rounding must follow the currency that is actually
   * rendered on this response.
   *
   * Examples:
   *
   * JPY -> 0 decimals
   * USD -> 2 decimals
   * KWD -> 3 decimals
   */
  const CURRENCY_DECIMALS_RAW = Number(
    typeof displayCurrencyDetails !== 'undefined' &&
    displayCurrencyDetails &&
    typeof displayCurrencyDetails.decimals !== 'undefined'
      ? displayCurrencyDetails.decimals
      : 2
  );

  const CURRENCY_DECIMALS =
    Number.isInteger(CURRENCY_DECIMALS_RAW) &&
    CURRENCY_DECIMALS_RAW >= 0 &&
    CURRENCY_DECIMALS_RAW <= 4
      ? CURRENCY_DECIMALS_RAW
      : 2;

  const PRODUCT =
    product && typeof product === 'object'
      ? product
      : {};

  const VARIANTS =
    Array.isArray(PRODUCT.variants)
      ? PRODUCT.variants
      : [];

  const DEFAULT_VARIANT =
    PRODUCT.defaultVariant ||
    VARIANTS[0] ||
    null;

  const PRODUCT_IMAGES =
    Array.isArray(PRODUCT.images)
      ? PRODUCT.images.filter(Boolean)
      : [];

  const RELATED_PRODUCTS =
    Array.isArray(relatedProducts)
      ? relatedProducts
      : [];

  /*
  * Separate CJ rating data supplied by routes/cjStore.js.
  */
  const CJ_REVIEWS =
    Array.isArray(cjReviews)
      ? cjReviews
      : [];

  const MY_CJ_RATING =
    myCjRating &&
    typeof myCjRating === 'object'
      ? myCjRating
      : null;

  const CURRENT_RATING_ACTOR =
    currentRatingActor &&
    typeof currentRatingActor === 'object'
      ? currentRatingActor
      : {
          type: 'guest',
          id: null,
          displayName: 'Guest'
        };

  const CJ_AVG_RATING = Math.max(
    0,
    Math.min(
      5,
      Number(PRODUCT.avgRating || 0)
    )
  );

  const CJ_RATINGS_COUNT = Math.max(
    0,
    Math.floor(
      Number(PRODUCT.ratingsCount || 0)
    )
  );

  function cjReviewBelongsToCurrentActor(review) {
    if (
      !review ||
      !CURRENT_RATING_ACTOR.id
    ) {
      return false;
    }

    if (
      CURRENT_RATING_ACTOR.type === 'user' &&
      review.raterType === 'user'
    ) {
      return (
        String(review.raterUser || '') ===
        String(CURRENT_RATING_ACTOR.id)
      );
    }

    if (
      CURRENT_RATING_ACTOR.type === 'business' &&
      review.raterType === 'business'
    ) {
      return (
        String(review.raterBusiness || '') ===
        String(CURRENT_RATING_ACTOR.id)
      );
    }

    return false;
  }

  function cjReviewerLabel(review) {
    if (cjReviewBelongsToCurrentActor(review)) {
      return 'Your review';
    }

    if (review?.raterType === 'business') {
      return 'Verified business customer';
    }

    if (review?.raterType === 'user') {
      return 'Verified Kasyora customer';
    }

    return 'Guest customer';
  }

  function cjReviewDate(value) {
    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
      return '';
    }

    try {
      return new Intl.DateTimeFormat(
        undefined,
        {
          year: 'numeric',
          month: 'short',
          day: 'numeric'
        }
      ).format(date);
    } catch (error) {
      return date.toLocaleDateString();
    }
  }

  function convertBaseToDisplay(amount) {
    const baseAmount = Number(amount || 0);

    if (
      !Number.isFinite(baseAmount) ||
      !Number.isFinite(CURRENCY_RATE) ||
      CURRENCY_RATE <= 0
    ) {
      return 0;
    }

    return Number(
      (
        baseAmount *
        CURRENCY_RATE
      ).toFixed(
        CURRENCY_DECIMALS
      )
    );
  }

  function formatMoney(amount) {
    const convertedAmount =
      convertBaseToDisplay(amount);

    try {
      const formatted =
        new Intl.NumberFormat(
          undefined,
          {
            style: 'currency',

            currency:
              CURRENCY,

            minimumFractionDigits:
              CURRENCY_DECIMALS,

            maximumFractionDigits:
              CURRENCY_DECIMALS
          }
        ).format(
          convertedAmount
        );

      if (CURRENCY === 'ZAR') {
        return formatted.replace(
          /^ZAR\s?/,
          'R'
        );
      }

      return formatted;
    } catch (error) {
      return (
        CURRENCY +
        ' ' +
        convertedAmount.toFixed(
          CURRENCY_DECIMALS
        )
      );
    }
  }

  /*
   * Related CJ Product cards have limited display space,
   * especially on mobile.
   *
   * Keep the complete CJ product data unchanged and shorten
   * only the visible related-card name and category.
   */
  function truncateRelatedCjText(
    value,
    maxCharacters = 15
  ) {
    const text = String(
      value || ''
    ).trim();

    if (text.length <= maxCharacters) {
      return text;
    }

    return (
      text
        .slice(0, maxCharacters)
        .trimEnd() +
      '...'
    );
  }

  const CJ_PRODUCT_CURRENCY_RETURN_TO =
    '/cj/product/' +
    encodeURIComponent(
      String(PRODUCT.cjProductId || '')
    );

  function safeJson(value) {
    return JSON.stringify(value || {})
      .replace(/</g, '\\u003c')
      .replace(/>/g, '\\u003e')
      .replace(/&/g, '\\u0026');
  }

  function variantLabel(variant) {
    return String(
      variant?.variantName ||
      variant?.variantKey ||
      variant?.variantSku ||
      'Variant'
    ).trim();
  }

  function inventoryText(variant) {
    if (!variant) return 'Select a variant';

    if (variant.inventoryKnown && Number(variant.totalInventory || 0) <= 0) {
      return 'Out of stock';
    }

    if (variant.inventoryKnown) {
      return Number(variant.totalInventory || 0) + ' available';
    }

    return 'Available';
  }

  /*
   * CJ Product structured data
   * ==========================
   *
   * This describes only the current CJ Dropshipping product.
   *
   * It must remain completely separate from:
   *
   * - Internal Product;
   * - Internal ratings;
   * - Internal VAT;
   * - Internal cart/checkout/orders.
   *
   * Offer pricing is intentionally omitted for now because
   * customers may view this same URL in different display
   * currencies while CJ accounting remains in BASE_CURRENCY.
   */
  const CJ_PRODUCT_SCHEMA_SITE_URL =
    String(
      typeof siteUrl !== 'undefined' &&
      siteUrl
        ? siteUrl
        : (
            typeof appUrl !== 'undefined' &&
            appUrl
              ? appUrl
              : 'https://kasyora.com'
          )
    )
      .trim()
      .replace(/\/+$/, '');

  const CJ_PRODUCT_SCHEMA_URL =
    CJ_PRODUCT_SCHEMA_SITE_URL +
    '/cj/product/' +
    encodeURIComponent(
      String(
        PRODUCT.cjProductId ||
        ''
      ).trim()
    );

  /*
   * Use only images belonging to this CJ product.
   *
   * Priority:
   *
   * 1. Main CJ product image.
   * 2. CJ product image gallery.
   * 3. Enabled/rendered CJ variant images.
   */
  const CJ_PRODUCT_SCHEMA_IMAGES =
    [
      PRODUCT.mainImageUrl,

      ...PRODUCT_IMAGES,

      ...VARIANTS.map(function (variant) {
        return variant?.imageUrl || '';
      })
    ]
      .map(function (imageUrl) {
        const raw =
          String(
            imageUrl ||
            ''
          ).trim();

        if (!raw) {
          return '';
        }

        if (/^https?:\/\//i.test(raw)) {
          return raw;
        }

        return (
          CJ_PRODUCT_SCHEMA_SITE_URL +
          '/' +
          raw.replace(/^\/+/, '')
        );
      })
      .filter(Boolean)
      .filter(function (imageUrl, index, array) {
        return array.indexOf(imageUrl) === index;
      });

  /*
   * CJ stores its source description as HTML.
   *
   * Structured-data description must be plain readable text,
   * not the original HTML markup.
   */
  const CJ_PRODUCT_SCHEMA_DESCRIPTION =
    String(
      PRODUCT.descriptionHtml ||
      ''
    )
      .replace(
        /<[^>]*>/g,
        ' '
      )
      .replace(
        /\s+/g,
        ' '
      )
      .trim();

  const CJ_PRODUCT_SCHEMA_CATEGORY =
    String(
      PRODUCT.category?.name ||
      PRODUCT.category?.secondName ||
      PRODUCT.category?.firstName ||
      PRODUCT.productType ||
      'CJ Product'
    ).trim();

  const CJ_PRODUCT_SCHEMA = {
    '@context': 'https://schema.org',

    '@type': 'Product',

    '@id':
      CJ_PRODUCT_SCHEMA_URL +
      '#product',

    url:
      CJ_PRODUCT_SCHEMA_URL,

    name:
      String(
        PRODUCT.name ||
        'CJ Product'
      ).trim(),

    sku:
      String(
        PRODUCT.productSku ||
        PRODUCT.cjProductId ||
        ''
      ).trim(),

    category:
      CJ_PRODUCT_SCHEMA_CATEGORY,

    image:
      CJ_PRODUCT_SCHEMA_IMAGES,

    description:
      CJ_PRODUCT_SCHEMA_DESCRIPTION ||
      (
        String(
          PRODUCT.name ||
          'CJ Product'
        ).trim() +
        ' available through the Kasyora CJ Store.'
      )
  };

  /*
   * Add only real published CJ rating aggregates.
   *
   * Never borrow Internal Product/Rating values.
   */
  if (
    Number.isFinite(
      CJ_AVG_RATING
    ) &&
    CJ_AVG_RATING > 0 &&
    CJ_AVG_RATING <= 5 &&
    Number.isFinite(
      CJ_RATINGS_COUNT
    ) &&
    CJ_RATINGS_COUNT > 0
  ) {
    CJ_PRODUCT_SCHEMA.aggregateRating = {
      '@type':
        'AggregateRating',

      ratingValue:
        Number(
          CJ_AVG_RATING.toFixed(2)
        ),

      ratingCount:
        Math.max(
          1,
          Math.floor(
            CJ_RATINGS_COUNT
          )
        ),

      bestRating:
        5,

      worstRating:
        1
    };
  }
%>

<script type="application/ld+json" nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">
  <%- safeJson(CJ_PRODUCT_SCHEMA) %>
</script>

<%
  /*
   * CJ product breadcrumb structured data
   * =====================================
   *
   * Search hierarchy:
   *
   * Kasyora
   * → Store
   * → CJ Store
   * → Current CJ product
   *
   * This remains completely separate from the
   * Internal Kasyora product breadcrumb flow.
   */
  const CJ_PRODUCT_BREADCRUMB_SCHEMA = {
    '@context': 'https://schema.org',

    '@type': 'BreadcrumbList',

    itemListElement: [
      {
        '@type': 'ListItem',

        position: 1,

        name: 'Kasyora',

        item:
          CJ_PRODUCT_SCHEMA_SITE_URL +
          '/'
      },

      {
        '@type': 'ListItem',

        position: 2,

        name: 'Store',

        item:
          CJ_PRODUCT_SCHEMA_SITE_URL +
          '/store'
      },

      {
        '@type': 'ListItem',

        position: 3,

        name: 'CJ Store',

        item:
          CJ_PRODUCT_SCHEMA_SITE_URL +
          '/store?department=cj'
      },

      {
        '@type': 'ListItem',

        position: 4,

        name:
          String(
            PRODUCT.name ||
            'CJ Product'
          ).trim(),

        item:
          CJ_PRODUCT_SCHEMA_URL
      }
    ]
  };
%>

<script
  type="application/ld+json"
  nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>"
><%- safeJson(CJ_PRODUCT_BREADCRUMB_SCHEMA) %></script>

<style nonce="<%= nonce %>">
  .cj-product-description img,
  .cj-product-description video,
  .cj-product-description iframe {
    max-width: 100% !important;
    height: auto !important;
  }

  .cj-product-description table {
    width: 100% !important;
    max-width: 100% !important;
  }

  .cj-product-description {
    overflow-x: hidden;
  }

  .cj-main-product-image {
    max-height: 70vh;
    object-fit: contain;
  }

  @media (max-width: 576px) {
    .cj-main-product-image {
      max-height: 420px;
    }
  }
</style>

<!-- Header Start -->
<div class="container-fluid bg-light py-4 border-bottom">
  <div class="container">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
      <div>
        <span class="badge bg-success mb-2">
          CJ Dropshipping Department
        </span>

        <h1 class="text-primary mb-1">
          <%= PRODUCT.name || 'CJ Product' %>
        </h1>

        <nav aria-label="breadcrumb">
          <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
              <a href="/store">Store</a>
            </li>

            <li class="breadcrumb-item">
              <a href="/store#homeProductsSection">CJ Products</a>
            </li>

            <li class="breadcrumb-item active" aria-current="page">
              Product
            </li>
          </ol>
        </nav>
      </div>

      <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-2">
        <div class="bg-white border rounded px-2 py-1">
          <div class="small fw-bold text-primary mb-1">
            Display currency
          </div>

          <%- include('../store/partials/currency-selector', {
            currencyReturnTo: CJ_PRODUCT_CURRENCY_RETURN_TO
          }) %>
        </div>

        <a href="/cj/cart" class="btn btn-primary rounded-pill px-4">
          <i class="fas fa-shopping-cart me-2"></i>
          View CJ Cart
        </a>
      </div>
    </div>
  </div>
</div>
<!-- Header End -->

<%
  const CJ_PRODUCT_SHOW_CURRENCY_WARNING =
    typeof currencyConversionAvailable !== 'undefined' &&
    currencyConversionAvailable === false;

  const CJ_PRODUCT_CURRENCY_WARNING_TEXT =
    typeof currencyConversionMessage !== 'undefined'
      ? String(currencyConversionMessage || '').trim()
      : '';
%>

<% if (
  CJ_PRODUCT_SHOW_CURRENCY_WARNING &&
  CJ_PRODUCT_CURRENCY_WARNING_TEXT
) { %>
<div class="container mt-4">
  <div class="alert alert-warning border shadow-sm mb-0" role="alert">
    <div class="d-flex align-items-start gap-2">
      <i class="fas fa-exclamation-triangle text-primary mt-1" aria-hidden="true"></i>

      <div>
        <div class="fw-bold text-primary">
          Currency display notice
        </div>

        <div class="small">
          <%= CJ_PRODUCT_CURRENCY_WARNING_TEXT %>
        </div>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- CJ Notice Start -->
<div class="container-fluid px-0">
  <div class="alert alert-success rounded-0 border-0 mb-0">
    <div class="container">
      <div class="d-flex align-items-start gap-3">
        <i class="fas fa-globe fa-lg mt-1"></i>

        <div>
          <strong>
            Separate CJ fulfilment flow
          </strong>

          <div class="small mt-1">
            This product belongs to the CJ Dropshipping department. It uses the separate CJ cart, checkout, payment, order and fulfilment process.
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- CJ Notice End -->

<div class="container-fluid py-4 py-lg-5 px-0">
  <div class="container-fluid px-0 px-lg-4">
    <div id="cjProductMessage" class="d-none mx-2 mx-lg-0" role="alert"></div>

    <div class="row g-0 g-lg-4 align-items-start">
      <!-- Images -->
      <div class="col-12 col-lg-6">
        <div class="card border-0 shadow-sm rounded-0">
          <div class="card-body p-2 p-sm-3 p-lg-4">
            <div class="ratio ratio-1x1 bg-light rounded border">
              <img id="cjMainProductImage" src="<%= DEFAULT_VARIANT?.imageUrl || PRODUCT.mainImageUrl || '' %>" alt="<%= PRODUCT.name || 'CJ Product' %>" class="w-100 h-100 p-3 cj-main-product-image" loading="eager">
            </div>

            <% if (PRODUCT_IMAGES.length > 1) { %>
            <div class="d-flex gap-2 overflow-auto pt-3">
              <% PRODUCT_IMAGES.forEach(function(imageUrl, index) { %>
              <button type="button" class="btn btn-light border p-1 flex-shrink-0 js-cj-product-image-thumb <%= index === 0 ? 'border-primary' : '' %>" data-image-url="<%= imageUrl %>" aria-label="View product image <%= index + 1 %>" style="width: 72px; height: 72px;">
                <img src="<%= imageUrl %>" alt="" class="w-100 h-100" style="object-fit: contain;" loading="lazy">
              </button>
              <% }) %>
            </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Product Info -->
      <div class="col-12 col-lg-6 mt-4 mt-lg-0">
        <div class="card border-0 shadow-sm rounded-0">
          <div class="card-body p-3 p-sm-4">

            <h2 class="text-primary mb-2">
              <%= PRODUCT.name || 'CJ Product' %>
            </h2>

            <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-2 mb-3">
              <%- include('../partials/rating-stars', {
                avg: CJ_AVG_RATING,
                count: CJ_RATINGS_COUNT,
                nonce
              }) %>

              <a href="#cjRatingsSection" class="small text-decoration-none">
                <%= CJ_RATINGS_COUNT > 0
                    ? 'Read customer reviews'
                    : 'Be the first to rate this product' %>
              </a>
            </div>

            <div class="text-muted mb-3">
              Product SKU:
              <strong><%= PRODUCT.productSku || '—' %></strong>
            </div>

            <div class="bg-light border rounded p-3 mb-4">
              <div class="text-muted">
                Selling price
              </div>

              <div id="cjVariantPrice" class="display-6 fw-bold text-primary">
                <%= DEFAULT_VARIANT
                  ? formatMoney(
                      DEFAULT_VARIANT.priceExVat ??
                      DEFAULT_VARIANT.price ??
                      0
                    )
                  : formatMoney(
                      PRODUCT.minimumPriceExVat ??
                      PRODUCT.minimumPrice ??
                      0
                    ) %>
              </div>

              <div class="small text-muted mt-3">
                Visible prices are displayed in
                <strong><%= CURRENCY %></strong>.
                CJ product, cart, checkout, PayPal and order amounts remain
                calculated in
                <strong><%= BASE_CURRENCY %></strong>.
              </div>
            </div>

            <form id="cjAddToCartForm">
              <input id="cjProductId" type="hidden" value="<%= PRODUCT.cjProductId || '' %>">

              <div class="mb-3">
                <label for="cjVariantSelect" class="form-label fw-semibold">
                  Select variant/Size/Color
                </label>

                <select id="cjVariantSelect" class="form-select form-select-lg" required>
                  <% VARIANTS.forEach(function(variant) { %>
                  <option value="<%= variant.cjVariantId %>" data-image-url="<%= variant.imageUrl || PRODUCT.mainImageUrl || '' %>" data-price="<%= Number(
                      variant.priceExVat ??
                      variant.price ??
                      0
                    ) %>" data-currency="<%= variant.currency || BASE_CURRENCY %>" data-inventory-known="<%= variant.inventoryKnown ? '1' : '0' %>" data-total-inventory="<%= Number(variant.totalInventory || 0) %>" data-available="<%= variant.available ? '1' : '0' %>" <%= DEFAULT_VARIANT &&
                        String(DEFAULT_VARIANT.cjVariantId) ===
                        String(variant.cjVariantId)
                          ? 'selected'
                          : '' %>>
                    <%= variantLabel(variant) %>
                    —
                    <%= formatMoney(
                      variant.priceExVat ??
                      variant.price ??
                      0
                    ) %>

                    <% if (variant.inventoryKnown) { %>
                    —
                    <%= Number(variant.totalInventory || 0) %> available
                    <% } %>
                  </option>
                  <% }) %>
                </select>

                <div class="form-text">
                  The selected variant determines the product image, selling price, inventory and CJ fulfilment reference.
                </div>
              </div>

              <div class="row g-3 align-items-end mb-4">
                <div class="col-12 col-sm-5">
                  <label for="cjQuantity" class="form-label fw-semibold">
                    Quantity
                  </label>

                  <input id="cjQuantity" type="number" class="form-control form-control-lg" value="1" min="1" max="100" step="1" required>
                </div>

                <div class="col-12 col-sm-7">
                  <div class="alert alert-light border mb-0">
                    <div class="small text-muted">
                      Variant status
                    </div>

                    <div id="cjVariantInventoryStatus" class="fw-semibold text-primary">
                      <%= inventoryText(DEFAULT_VARIANT) %>
                    </div>
                  </div>
                </div>
              </div>

              <div class="d-grid gap-2">
                <button id="cjAddToCartButton" type="submit" class="btn btn-primary btn-lg rounded-pill" <%= DEFAULT_VARIANT && DEFAULT_VARIANT.available ? '' : 'disabled' %>>
                  <i class="fas fa-cart-plus me-2"></i>
                  Add To CJ Cart
                </button>

                <a href="/cj/cart" class="btn btn-outline-primary rounded-pill">
                  View CJ Cart
                </a>
              </div>
            </form>
          </div>
        </div>

        <div class="card border-0 shadow-sm rounded-0 mt-4">
          <div class="card-body p-3 p-sm-4">
            <h3 class="h5 text-primary">
              Product fulfilment details
            </h3>

            <dl class="row mb-0 small">
              <dt class="col-6">
                Product unit
              </dt>
              <dd class="col-6 text-end">
                <%= PRODUCT.productUnit || '—' %>
              </dd>

              <dt class="col-6">
                Product weight
              </dt>
              <dd class="col-6 text-end">
                <%= PRODUCT.productWeightGrams ? PRODUCT.productWeightGrams + ' g' : '—' %>
              </dd>

              <dt class="col-6">
                Packing weight
              </dt>
              <dd class="col-6 text-end">
                <%= PRODUCT.packingWeightGrams ? PRODUCT.packingWeightGrams + ' g' : '—' %>
              </dd>

              <% if (PRODUCT.customs?.hsCode) { %>
              <dt class="col-6">
                HS code
              </dt>
              <dd class="col-6 text-end">
                <%= PRODUCT.customs.hsCode %>
              </dd>
              <% } %>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <% if (PRODUCT.descriptionHtml) { %>
    <div class="card border-0 shadow-sm rounded-0 mt-4">
      <div class="card-header bg-primary text-white rounded-0">
        <h3 class="h5 text-white mb-0">
          Product Description
        </h3>
      </div>

      <div class="card-body cj-product-description p-2 p-sm-3 p-lg-4">
        <%- PRODUCT.descriptionHtml %>
      </div>
    </div>
    <% } %>

    <!-- CJ Ratings Start -->
    <div id="cjRatingsSection" class="mt-5 px-2 px-lg-0">
      <div class="row g-4 align-items-start">
        <div class="col-12 col-lg-5">
          <div class="mb-3">
            <span class="badge bg-success mb-2">
              CJ Product Ratings
            </span>

            <h3 class="text-primary mb-2">
              Customer ratings and reviews
            </h3>

            <p class="text-muted mb-3">
              These ratings belong only to this CJ Dropshipping product.
            </p>

            <div class="card border-0 shadow-sm mb-4">
              <div class="card-body p-3 p-md-4">
                <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-3">
                  <div class="display-4 fw-bold text-primary">
                    <%= CJ_AVG_RATING.toFixed(1) %>
                  </div>

                  <div>
                    <%- include('../partials/rating-stars', {
                      avg: CJ_AVG_RATING,
                      count: CJ_RATINGS_COUNT,
                      nonce
                    }) %>

                    <div class="small text-muted mt-2">
                      Based on
                      <strong><%= CJ_RATINGS_COUNT %></strong>
                      published
                      <%= CJ_RATINGS_COUNT === 1
                          ? 'rating'
                          : 'ratings' %>.
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <%- include('../partials/cj-rating-form', {
            cjProductId: PRODUCT.cjProductId,
            myCjRating: MY_CJ_RATING,
            nonce
          }) %>

          <% if (
            MY_CJ_RATING &&
            CURRENT_RATING_ACTOR.type !== 'guest'
          ) { %>
          <div class="card border-danger mt-3">
            <div class="card-body p-3">
              <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
                <div>
                  <div class="fw-semibold text-danger">
                    Delete your CJ rating
                  </div>

                  <div class="small text-muted">
                    This permanently removes your rating and review.
                  </div>
                </div>

                <form method="POST" action="/cj-ratings/ratings/<%= MY_CJ_RATING._id %>/delete" class="m-0">
                  <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                    <i class="fas fa-trash-alt me-1"></i>
                    Delete Rating
                  </button>
                </form>
              </div>
            </div>
          </div>
          <% } %>

          <% if (
            MY_CJ_RATING &&
            CURRENT_RATING_ACTOR.type === 'guest'
          ) { %>
          <div class="alert alert-light border mt-3 mb-0">
            <div class="small text-muted">
              Guest ratings can be updated from this browser using the same CJ rating cookie.
            </div>
          </div>
          <% } %>
        </div>

        <div class="col-12 col-lg-7">
          <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
            <h3 class="h5 text-primary mb-0">
              Published reviews
            </h3>

            <span class="badge bg-primary rounded-pill">
              <%= CJ_RATINGS_COUNT %>
            </span>
          </div>

          <% if (CJ_REVIEWS.length > 0) { %>
          <div class="d-grid gap-3">
            <% CJ_REVIEWS.forEach(function(review) { %>
            <div class="card border shadow-sm">
              <div class="card-body p-3 p-md-4">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-start gap-3 mb-3">
                  <div>
                    <div class="fw-bold text-primary">
                      <%= cjReviewerLabel(review) %>
                    </div>

                    <% if (cjReviewDate(review.createdAt)) { %>
                    <div class="small text-muted mt-1">
                      <i class="far fa-calendar-alt me-1"></i>
                      <%= cjReviewDate(review.createdAt) %>
                    </div>
                    <% } %>
                  </div>

                  <%- include('../partials/rating-stars', {
                    avg: Number(review.stars || 0),
                    count: 1,
                    nonce
                  }) %>
                </div>

                <% if (review.title) { %>
                <h4 class="h6 mb-2">
                  <%= review.title %>
                </h4>
                <% } %>

                <% if (review.body) { %>
                <p class="text-muted mb-3">
                  <%= review.body %>
                </p>
                <% } else { %>
                <p class="small text-muted fst-italic mb-3">
                  This customer submitted a star rating without a written review.
                </p>
                <% } %>

                <div class="d-flex flex-wrap justify-content-end gap-2">
                  <% if (
                    cjReviewBelongsToCurrentActor(review) &&
                    CURRENT_RATING_ACTOR.type !== 'guest'
                  ) { %>
                  <a href="#cj-rating-form-<%= String(PRODUCT.cjProductId || '').replace(/[^a-zA-Z0-9_-]/g, '') || 'cj-product' %>" class="btn btn-outline-primary btn-sm rounded-pill">
                    <i class="fas fa-edit me-1"></i>
                    Update
                  </a>

                  <form method="POST" action="/cj-ratings/ratings/<%= review._id %>/delete" class="m-0">
                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill">
                      <i class="fas fa-trash-alt me-1"></i>
                      Delete
                    </button>
                  </form>
                  <% } else if (
                    CURRENT_RATING_ACTOR.type === 'user' ||
                    CURRENT_RATING_ACTOR.type === 'business'
                  ) { %>
                  <form method="POST" action="/cj-ratings/ratings/<%= review._id %>/flag" class="m-0">
                    <button type="submit" class="btn btn-outline-secondary btn-sm rounded-pill">
                      <i class="fas fa-flag me-1"></i>
                      Report
                    </button>
                  </form>
                  <% } %>
                </div>
              </div>
            </div>
            <% }) %>
          </div>
          <% } else { %>
          <div class="card border-0 shadow-sm">
            <div class="card-body text-center p-4 p-md-5">
              <i class="far fa-star fa-3x text-primary mb-3"></i>

              <h4 class="h5 text-primary">
                No ratings yet
              </h4>

              <p class="text-muted mb-0">
                Be the first customer to rate this CJ product.
              </p>
            </div>
          </div>
          <% } %>

          <% if (CJ_RATINGS_COUNT > CJ_REVIEWS.length) { %>
          <div class="alert alert-light border mt-3 mb-0">
            <div class="small text-muted">
              Showing the latest
              <%= CJ_REVIEWS.length %>
              of
              <%= CJ_RATINGS_COUNT %>
              published ratings.
            </div>
          </div>
          <% } %>
        </div>
      </div>
    </div>
    <!-- CJ Ratings End -->

    <% if (RELATED_PRODUCTS.length) { %>
    <div class="mt-5 px-2 px-lg-0">
      <h3 class="text-primary mb-3">
        Related CJ Products
      </h3>

      <div class="row g-3">
        <% RELATED_PRODUCTS.forEach(function(related) { %>
        <div class="col-12 col-md-6 col-xl-3">
          <div class="card border-0 shadow-sm h-100">
            <a href="/cj/product/<%= encodeURIComponent(related.cjProductId) %>" class="text-decoration-none">
              <div class="ratio ratio-1x1 bg-light">
                <img src="<%= related.mainImageUrl %>" alt="<%= related.name %>" class="w-100 h-100 p-3" style="object-fit: contain;" loading="lazy">
              </div>
            </a>

            <div class="card-body d-flex flex-column">
              <h4 class="h6 text-primary" title="<%= related.name || 'CJ Product' %>">
                <%= truncateRelatedCjText(
                  related.name || 'CJ Product',
                  80
                ) %>
              </h4>

              <div class="small text-muted mb-2" title="<%= related.category?.name || 'CJ Product' %>">
                <%= truncateRelatedCjText(
                  related.category?.name || 'CJ Product',
                  60
                ) %>
              </div>

              <div class="mb-3">
                <%- include('../partials/rating-stars', {
                  avg: Number(related.avgRating || 0),
                  count: Number(related.ratingsCount || 0),
                  nonce
                }) %>
              </div>

              <div class="fw-bold text-primary mt-auto">
                <%= formatMoney(
                  related.minimumPriceExVat ??
                  related.minimumPrice ??
                  0
                ) %>
              </div>

              <a href="/cj/product/<%= encodeURIComponent(related.cjProductId) %>" class="btn btn-outline-primary btn-sm mt-3">
                View Product
              </a>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
    <% } %>
  </div>
</div>

<%- include('../store/partials/currency-client') %>

<script nonce="<%= nonce %>">
  (function() {
    const productVariants =
      <%- safeJson(VARIANTS) %>;

    const productIdInput = document.getElementById(
      'cjProductId'
    );

    const variantSelect = document.getElementById(
      'cjVariantSelect'
    );

    const quantityInput = document.getElementById(
      'cjQuantity'
    );

    const mainImage = document.getElementById(
      'cjMainProductImage'
    );

    const priceElement = document.getElementById(
      'cjVariantPrice'
    );

    const inventoryStatusElement = document.getElementById(
      'cjVariantInventoryStatus'
    );

    const addButton = document.getElementById(
      'cjAddToCartButton'
    );

    const messageElement = document.getElementById(
      'cjProductMessage'
    );

    const addForm = document.getElementById(
      'cjAddToCartForm'
    );

    function formatMoney(amount) {
      /*
       * Variant values remain authoritative BASE_CURRENCY values.
       * Convert only their visible presentation.
       */
      if (
        window.KasyoraCurrency &&
        typeof window.KasyoraCurrency.formatBaseAmount === 'function'
      ) {
        return window.KasyoraCurrency.formatBaseAmount(
          amount
        );
      }

      const fallbackAmount =
        Number(amount || 0);

      /*
       * This branch is reached only if the normal
       * window.KasyoraCurrency helper is unavailable.
       *
       * Fall back to authoritative BASE_CURRENCY rather than
       * pretending an unconverted amount is in the requested
       * display currency.
       *
       * Let Intl determine BASE_CURRENCY's normal fraction digits
       * so this fallback also works safely for currencies with
       * 0, 2 or 3 decimal places.
       */
      const fallbackCurrency =
        "<%= String(typeof baseCurrency !== 'undefined' ? baseCurrency : 'USD').trim().toUpperCase() || 'USD' %>";

      let fallbackDecimals = 2;

      try {
        const fallbackFormatter =
          new Intl.NumberFormat(
            undefined, {
              style: 'currency',

              currency: fallbackCurrency
            }
          );

        const resolvedOptions =
          fallbackFormatter
          .resolvedOptions();

        const resolvedDecimals =
          Number(
            resolvedOptions
            .maximumFractionDigits
          );

        if (
          Number.isInteger(
            resolvedDecimals
          ) &&
          resolvedDecimals >= 0 &&
          resolvedDecimals <= 4
        ) {
          fallbackDecimals =
            resolvedDecimals;
        }

        const formatted =
          fallbackFormatter.format(
            Number.isFinite(
              fallbackAmount
            ) ?
            fallbackAmount :
            0
          );

        if (
          fallbackCurrency ===
          'ZAR'
        ) {
          return formatted.replace(
            /^ZAR\s?/,
            'R'
          );
        }

        return formatted;
      } catch (error) {
        return (
          fallbackCurrency +
          ' ' +
          (
            Number.isFinite(
              fallbackAmount
            ) ?
            fallbackAmount :
            0
          ).toFixed(
            fallbackDecimals
          )
        );
      }
    }

    function showMessage(message, type) {
      if (!messageElement) {
        return;
      }

      const safeType =
        String(type || 'danger')
        .trim()
        .toLowerCase();

      const bootstrapType =
        safeType === 'success' ||
        safeType === 'warning' ||
        safeType === 'info' ?
        safeType :
        'danger';

      messageElement.className =
        'alert alert-' + bootstrapType + ' shadow-sm';

      messageElement.textContent =
        String(message || '');

      messageElement.scrollIntoView({
        behavior: 'smooth',
        block: 'start'
      });
    }

    function clearMessage() {
      if (!messageElement) {
        return;
      }

      messageElement.className = 'd-none';
      messageElement.textContent = '';
    }

    function selectedVariantFromOption() {
      const option =
        variantSelect?.selectedOptions?.[0];

      if (!option) {
        return null;
      }

      const selectedId =
        String(option.value || '').trim();

      return productVariants.find(function(variant) {
        return String(variant.cjVariantId || '').trim() === selectedId;
      }) || null;
    }

    function updateSelectedVariantUi() {
      const option =
        variantSelect?.selectedOptions?.[0];

      const variant =
        selectedVariantFromOption();

      if (!option || !variant) {
        if (addButton) {
          addButton.disabled = true;
        }

        return;
      }

      const imageUrl =
        String(
          variant.imageUrl ||
          option.getAttribute('data-image-url') ||
          ''
        ).trim();

      if (mainImage && imageUrl) {
        mainImage.src = imageUrl;
      }

      /*
       * Use only the authoritative VAT-free CJ variant price.
       *
       * Never fall back to the historical priceIncVat field.
       */
      const selectedVariantPrice = Number(
        variant.priceExVat ??
        variant.price ??
        option.getAttribute('data-price') ??
        0
      );

      if (priceElement) {
        priceElement.textContent =
          formatMoney(
            Number.isFinite(selectedVariantPrice) ?
            selectedVariantPrice :
            0
          );
      }

      const inventoryKnown =
        variant.inventoryKnown === true;

      const totalInventory =
        Math.max(
          0,
          Math.floor(Number(variant.totalInventory || 0))
        );

      const available =
        variant.available === true &&
        (!inventoryKnown || totalInventory > 0);

      if (inventoryStatusElement) {
        inventoryStatusElement.textContent =
          inventoryKnown ?
          (
            totalInventory > 0 ?
            totalInventory + ' available' :
            'Out of stock'
          ) :
          'Available';
      }

      if (quantityInput) {
        quantityInput.max =
          inventoryKnown && totalInventory > 0 ?
          String(Math.min(100, totalInventory)) :
          '100';

        if (Number(quantityInput.value || 1) > Number(quantityInput.max || 100)) {
          quantityInput.value = quantityInput.max;
        }
      }

      if (addButton) {
        addButton.disabled = !available;
      }
    }

    document
      .querySelectorAll('.js-cj-product-image-thumb')
      .forEach(function(button) {
        button.addEventListener('click', function() {
          const imageUrl =
            String(
              button.getAttribute('data-image-url') || ''
            ).trim();

          if (mainImage && imageUrl) {
            mainImage.src = imageUrl;
          }

          document
            .querySelectorAll('.js-cj-product-image-thumb')
            .forEach(function(otherButton) {
              otherButton.classList.remove('border-primary');
            });

          button.classList.add('border-primary');
        });
      });

    variantSelect?.addEventListener(
      'change',
      function() {
        clearMessage();
        updateSelectedVariantUi();
      }
    );

    addForm?.addEventListener(
      'submit',
      async function(event) {
        event.preventDefault();
        clearMessage();

        const cjProductId =
          String(productIdInput?.value || '').trim();

        const cjVariantId =
          String(variantSelect?.value || '').trim();

        const quantity =
          Math.max(
            1,
            Math.min(
              100,
              Math.floor(Number(quantityInput?.value || 1))
            )
          );

        if (!cjProductId || !cjVariantId) {
          showMessage(
            'Please select a CJ product variant before adding to cart.',
            'warning'
          );

          return;
        }

        const originalHtml =
          addButton ? addButton.innerHTML : '';

        if (addButton) {
          addButton.disabled = true;
          addButton.innerHTML =
            '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>' +
            'Adding To CJ Cart...';
        }

        try {
          const response = await fetch('/api/cj-cart/add', {
            method: 'POST',

            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json'
            },

            credentials: 'same-origin',

            body: JSON.stringify({
              cjProductId,
              cjVariantId,
              quantity
            })
          });

          const data = await response
            .json()
            .catch(function() {
              return {};
            });

          if (
            !response.ok ||
            data.success === false
          ) {
            throw new Error(
              data.message ||
              'The CJ product could not be added to cart.'
            );
          }

          showMessage(
            data.message ||
            'CJ product added to the CJ cart.',
            'success'
          );

          const redirectTo =
            String(data.redirectTo || '/cj/cart').trim();

          window.setTimeout(function() {
            window.location.assign(
              redirectTo.startsWith('/') ?
              redirectTo :
              '/cj/cart'
            );
          }, 500);
        } catch (error) {
          showMessage(
            error?.message ||
            'The CJ product could not be added to cart.',
            'danger'
          );

          if (addButton) {
            addButton.disabled = false;
            addButton.innerHTML = originalHtml;
          }

          updateSelectedVariantUi();
        }
      }
    );

    updateSelectedVariantUi();
  })();
</script>