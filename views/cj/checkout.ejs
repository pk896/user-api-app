    function formatMoney(amount) {
      /*
       * Every price returned by the CJ cart, quote and shipping
       * APIs remains an authoritative BASE_CURRENCY amount.
       */
      if (
        window.KasyoraCurrency &&
        typeof window.KasyoraCurrency.formatBaseAmount === 'function'
      ) {
        return window.KasyoraCurrency.formatBaseAmount(
          amount
        );
      }

      /*
       * Defensive fallback:
       * never label an unconverted amount with the selected
       * display currency.
       */
      const fallbackAmount =
        Number(amount || 0);

      const fallbackCurrency =
        "<%= String(typeof baseCurrency !== 'undefined' ? baseCurrency : 'USD').trim().toUpperCase() || 'USD' %>";

      try {
        const formatted = new Intl.NumberFormat(
          undefined, {
            style: 'currency',
            currency: fallbackCurrency,
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          }
        ).format(
          Number.isFinite(fallbackAmount) ?
          fallbackAmount :
          0
        );

        if (fallbackCurrency === 'ZAR') {
          return formatted.replace(/^ZAR\s?/, 'R');
        }

        return formatted;
      } catch (error) {
        return (
          fallbackCurrency +
          ' ' +
          (
            Number.isFinite(fallbackAmount) ?
            fallbackAmount :
            0
          ).toFixed(2)
        );
      }
    }

    function escapeHtml(value) {
      return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function showMessage(message, type, scrollToTop = true) {
      if (!messageElement) {
        return;
      }

      const safeType = String(type || 'danger')
        .trim()
        .toLowerCase();

      const bootstrapType =
        safeType === 'success' ||
        safeType === 'warning' ||
        safeType === 'info' ?
        safeType :
        'danger';

      messageElement.className =
        'alert alert-' + bootstrapType;

      messageElement.textContent =
        String(message || '');

      if (scrollToTop) {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      }
    }

    function setCjCheckoutHashAndScroll(targetId) {
      const cleanTargetId = String(targetId || '').trim();

      if (!cleanTargetId) {
        return;
      }

      const target = document.getElementById(cleanTargetId);

      if (!target) {
        return;
      }

      if (window.history && window.history.replaceState) {
        window.history.replaceState(
          null,
          '',
          '#' + cleanTargetId
        );
      } else {
        window.location.hash = cleanTargetId;
      }

      window.setTimeout(function() {
        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }, 50);
    }

    function clearMessage() {
      if (!messageElement) {
        return;
      }

      messageElement.className = 'd-none';
      messageElement.textContent = '';
    }

    function cjDigitsOnly(value) {
      return String(value || '')
        .replace(/\D/g, '')
        .slice(0, 30);
    }

    function isSouthAfricaPhone(value) {
      let digits = cjDigitsOnly(value);

      if (digits.startsWith('0027')) {
        digits = digits.slice(2);
      }

      return (
        /^27\d{9}$/.test(digits) ||
        /^0\d{9}$/.test(digits) ||
        /^\d{9}$/.test(digits)
      );
    }

    function isGlobalPhoneUsable(value) {
      const digits = cjDigitsOnly(value);

      return digits.length >= 6 && digits.length <= 20;
    }

    function buyerTaxDigits(value) {
      return String(value || '')
        .replace(/\D/g, '')
        .slice(0, 30);
    }

    function normalizeFrontendBuyerTaxId(value) {
      return String(value || '')
        .trim()
        .replace(/\s+/g, '')
        .slice(0, 50);
    }

    function isBuyerTaxIdValidForRule(value, rule) {
      const normalized = normalizeFrontendBuyerTaxId(value);
      const digits = buyerTaxDigits(normalized);

      const lengthRules = Array.isArray(rule?.allowedDigitLengths) ?
        rule.allowedDigitLengths : [];

      const lengthOk =
        lengthRules.length > 0 &&
        lengthRules.includes(digits.length);

      /*
       * Some CJ Tax IDs include letters, so JSON cannot carry
       * backend RegExp values to the browser. Keep these frontend
       * pattern checks aligned with utils/cj/taxIdCountries.js.
       *
       * South Africa must stay digit-length only because CJ rejected
       * SARS tax numbers and passport numbers with:
       * "Consignee ID: Must be a 13 digit number without special characters."
       */
      let patternOk = false;

      if (rule?.countryName === 'Mexico') {
        patternOk =
          /^[A-ZÑ&]{3,4}\d{6}[A-Z0-9]{3}$/i.test(normalized) ||
          /^[A-Z][AEIOUX][A-Z]{2}\d{6}[HM][A-Z]{5}[A-Z0-9]\d$/i.test(normalized);
      }

      if (rule?.countryName === 'South Korea') {
        patternOk =
          /^P\d{12}$/i.test(normalized);
      }

      if (rule?.countryName === 'Singapore') {
        patternOk =
          /^[A-Z]\d{8}[A-Z]$/i.test(normalized);
      }

      return lengthOk || patternOk;
    }

    function updateTaxIdRequiredUi({
      countryCode,
      buyerTaxRule,
      taxIdInvalid,
      showTaxIdError
    }) {
      const buyerTaxCountryName =
        String(buyerTaxRule?.countryName || '')
        .trim();

      const taxIdRequired = Boolean(buyerTaxRule);

      if (taxIdInput) {
        taxIdInput.required = taxIdRequired;

        if (buyerTaxRule) {
          taxIdInput.placeholder =
            buyerTaxRule.placeholder ||
            (
              buyerTaxCountryName ?
              'Required for ' + buyerTaxCountryName :
              'Required for selected country'
            );
        } else {
          taxIdInput.placeholder =
            'Optional for most countries';
        }
      }

      taxIdRequiredBadge?.classList.toggle(
        'd-none',
        !taxIdRequired
      );

      if (taxIdDynamicHelp) {
        if (buyerTaxRule) {
          const label =
            String(buyerTaxRule.label || 'Tax ID')
            .trim();

          const examples =
            String(buyerTaxRule.examples || '')
            .trim();

          taxIdDynamicHelp.textContent =
            'Tax ID / Consignee ID is required for ' +
            buyerTaxCountryName +
            ' CJ delivery. Enter the buyer ' +
            label +
            ' before payment.' +
            (
              examples ?
              ' Example: ' + examples + '.' :
              ''
            );
        } else {
          taxIdDynamicHelp.textContent =
            'Tax ID / Consignee ID is required for this destination.';
        }

        taxIdDynamicHelp.classList.toggle(
          'd-none',
          !buyerTaxRule
        );

        taxIdDynamicHelp.classList.toggle(
          'text-danger',
          Boolean(showTaxIdError)
        );

        taxIdDynamicHelp.classList.toggle(
          'text-muted',
          !showTaxIdError
        );
      }

      if (!countryCode) {
        taxIdRequiredBadge?.classList.add('d-none');

        if (taxIdInput) {
          taxIdInput.required = false;
          taxIdInput.placeholder = 'Optional for most countries';
        }

        taxIdDynamicHelp?.classList.add('d-none');
        taxIdDynamicHelp?.classList.remove('text-danger');
        taxIdDynamicHelp?.classList.add('text-muted');
      }
    }

    function setFieldInvalid(input, isInvalid) {
      if (!input) {
        return;
      }

      input.classList.toggle('is-invalid', isInvalid);
    }

    function toggleHelp(element, shouldShow) {
      if (!element) {
        return;
      }

      element.classList.toggle('d-none', !shouldShow);
    }

    function validateCjCountrySensitiveFields(showErrors) {
      const countryCode = String(countrySelect?.value || '')
        .trim()
        .toUpperCase();

      const phoneValue = String(phoneInput?.value || '').trim();
      const taxIdValue = String(taxIdInput?.value || '').trim();
      const iossValue = '';

      const isSouthAfrica = countryCode === 'ZA';

      const buyerTaxRule =
        cjBuyerTaxIdRules &&
        typeof cjBuyerTaxIdRules === 'object' ?
        cjBuyerTaxIdRules[countryCode] :
        null;

      const buyerTaxRequired =
        Boolean(buyerTaxRule);

      const countryInvalid = !countryCode;

      const iossRequired =
        cjIossRequiredCountryCodes.has(countryCode);

      const iossInvalid = iossRequired;

      let phoneInvalid = false;
      let buyerTaxIdInvalid = false;

      if (phoneValue) {
        phoneInvalid = isSouthAfrica ?
          !isSouthAfricaPhone(phoneValue) :
          !isGlobalPhoneUsable(phoneValue);
      }

      if (buyerTaxRequired) {
        buyerTaxIdInvalid = !isBuyerTaxIdValidForRule(
          taxIdValue,
          buyerTaxRule
        );
      }

      const taxIdInvalid = buyerTaxIdInvalid;

      /*
       * Important UI rule:
       * Selecting a country should show normal guidance only.
       * Red error styling appears only after the customer submits
       * or after they started typing an invalid Tax ID.
       */
      const showTaxIdError =
        taxIdInvalid &&
        (
          showErrors ||
          Boolean(taxIdValue)
        );

      updateTaxIdRequiredUi({
        countryCode,
        buyerTaxRule,
        taxIdInvalid,
        showTaxIdError
      });

      if (
        showErrors ||
        phoneValue ||
        taxIdValue ||
        iossValue ||
        countryCode
      ) {
        countryDropdownButton?.classList.toggle(
          'is-invalid',
          countryInvalid && showErrors
        );

        countryDropdownButton?.classList.toggle(
          'border-danger',
          countryInvalid && showErrors
        );

        setFieldInvalid(
          phoneInput,
          phoneInvalid && (showErrors || Boolean(phoneValue))
        );

        setFieldInvalid(
          taxIdInput,
          showTaxIdError
        );

        setFieldInvalid(
          iossInput,
          iossInvalid && showErrors
        );

        toggleHelp(
          phoneCountryHelp,
          isSouthAfrica &&
          phoneInvalid &&
          (showErrors || Boolean(phoneValue))
        );

        toggleHelp(
          phoneGlobalHelp,
          !isSouthAfrica &&
          phoneInvalid &&
          (showErrors || Boolean(phoneValue))
        );

        toggleHelp(
          iossRequiredHelp,
          iossInvalid && showErrors
        );

        toggleHelp(
          iossDefaultHelp,
          !(iossInvalid && showErrors)
        );
      }

      if (!countryInvalid) {
        countryDropdownButton?.classList.remove(
          'is-invalid',
          'border-danger'
        );
      }

      if (!phoneInvalid) {
        setFieldInvalid(phoneInput, false);
        toggleHelp(phoneCountryHelp, false);
        toggleHelp(phoneGlobalHelp, false);
      }

      if (!taxIdInvalid) {
        setFieldInvalid(taxIdInput, false);

        if (taxIdDynamicHelp) {
          taxIdDynamicHelp.classList.remove('text-danger');
          taxIdDynamicHelp.classList.add('text-muted');
        }
      }

      if (!iossInvalid) {
        setFieldInvalid(iossInput, false);
        toggleHelp(iossRequiredHelp, false);
        toggleHelp(iossDefaultHelp, true);
      }

      return (
        !countryInvalid &&
        !phoneInvalid &&
        !buyerTaxIdInvalid &&
        !iossInvalid
      );
    }

    function bindCjCountrySensitiveGuidance() {
      [
        countrySelect,
        phoneInput,
        taxIdInput
      ].forEach(function(element) {
        element?.addEventListener(
          'input',
          function() {
            validateCjCountrySensitiveFields(false);
          }
        );

        element?.addEventListener(
          'change',
          function() {
            validateCjCountrySensitiveFields(false);
          }
        );
      });

      validateCjCountrySensitiveFields(false);
    }

    function countryFlagUrl(countryCode) {
      const code = String(countryCode || '')
        .trim()
        .toLowerCase();

      return code ?
        'https://flagcdn.com/20x15/' + code + '.png' :
        '';
    }

    function closeCjCountryDropdown() {
      if (!countryDropdownButton) {
        return;
      }

      window.setTimeout(function() {
        try {
          const dropdownInstance =
            bootstrap.Dropdown.getOrCreateInstance(
              countryDropdownButton
            );

          dropdownInstance.hide();
        } catch (error) {
          // Safe fallback below handles the visible state.
        }

        const dropdownWrapper =
          countryDropdownButton.closest('.dropdown');

        const dropdownMenu =
          dropdownWrapper?.querySelector('.dropdown-menu');

        dropdownMenu?.classList.remove('show');

        dropdownWrapper?.classList.remove('show');

        countryDropdownButton.classList.remove('show');

        countryDropdownButton.setAttribute(
          'aria-expanded',
          'false'
        );

        countryDropdownButton.blur();
      }, 0);
    }

    function setCjSelectedCountry(countryCode, countryName) {
      const cleanCode = String(countryCode || '')
        .trim()
        .toUpperCase();

      const cleanName = String(countryName || '')
        .trim();

      if (countrySelect) {
        countrySelect.value = cleanCode;

        countrySelect.dispatchEvent(
          new Event('input', {
            bubbles: true
          })
        );

        countrySelect.dispatchEvent(
          new Event('change', {
            bubbles: true
          })
        );
      }

      if (selectedCountryText) {
        selectedCountryText.textContent =
          cleanName || 'Select country';

        selectedCountryText.classList.toggle(
          'text-muted',
          !cleanName
        );
      }

      if (selectedCountryFlag) {
        if (cleanCode) {
          selectedCountryFlag.src =
            countryFlagUrl(cleanCode);

          selectedCountryFlag.classList.remove(
            'd-none'
          );
        } else {
          selectedCountryFlag.removeAttribute(
            'src'
          );

          selectedCountryFlag.classList.add(
            'd-none'
          );
        }
      }

      document
        .querySelectorAll(
          '.js-cj-country-option'
        )
        .forEach(function(option) {
          option.classList.toggle(
            'active',
            String(option.dataset.code || '')
            .trim()
            .toUpperCase() === cleanCode
          );
        });
    }

    function bindCjCountryDropdown() {
      const countryButtons = Array.from(
        document.querySelectorAll(
          '.js-cj-country-option'
        )
      );

      countryButtons.forEach(function(button) {
        button.addEventListener(
          'click',
          function() {
            const countryCode =
              button.dataset.code || '';

            const countryName =
              button.dataset.name ||
              button.textContent ||
              '';

            setCjSelectedCountry(
              countryCode,
              countryName
            );

            closeCjCountryDropdown();
          }
        );
      });

      if (countrySearchInput) {
        countrySearchInput.addEventListener(
          'click',
          function(event) {
            event.stopPropagation();
          }
        );

        countrySearchInput.addEventListener(
          'keydown',
          function(event) {
            event.stopPropagation();
          }
        );

        countrySearchInput.addEventListener(
          'input',
          function() {
            const term = String(
                countrySearchInput.value || ''
              )
              .trim()
              .toLowerCase();

            countryButtons.forEach(function(button) {
              const countryCode = String(
                button.dataset.code || ''
              ).toLowerCase();

              const countryName = String(
                button.dataset.name ||
                button.textContent ||
                ''
              ).toLowerCase();

              const matches = !term ||
                countryName.includes(term) ||
                countryCode.includes(term);

              button.classList.toggle(
                'd-none',
                !matches
              );
            });
          }
        );
      }

      countryDropdownButton?.addEventListener(
        'shown.bs.dropdown',
        function() {
          if (countrySearchInput) {
            countrySearchInput.value = '';

            countryButtons.forEach(function(button) {
              button.classList.remove('d-none');
            });

            countrySearchInput.focus();
          }
        }
      );

      const savedCode = String(
          countrySelect?.value || ''
        )
        .trim()
        .toUpperCase();

      if (savedCode) {
        const savedButton = countryButtons.find(
          function(button) {
            return String(button.dataset.code || '')
              .trim()
              .toUpperCase() === savedCode;
          }
        );

        setCjSelectedCountry(
          savedCode,
          savedButton?.dataset?.name || ''
        );
      }
    }

    function formPayload() {
      const data = new FormData(addressForm);
      const payload = {};

      data.forEach(function(value, key) {
        payload[key] = String(value || '').trim();
      });

      return payload;
    }

    async function selectShippingOption(input) {
      const optionId = String(
        input.value || ''
      ).trim();

      const shippingAmount = Number(
        input.getAttribute(
          'data-shipping-amount'
        ) || 0
      );

      const payableTotal = Number(
        input.getAttribute(
          'data-payable-total'
        ) || 0
      );

      if (!optionId) {
        showMessage(
          'The selected CJ shipping method could not be identified.',
          'error'
        );

        return;
      }

      document
        .querySelectorAll(
          '.js-cj-shipping-option'
        )
        .forEach(function(radio) {
          radio.disabled = true;
        });

      if (continueButton) {
        continueButton.disabled = true;
      }

      clearMessage();

      try {
        const response = await fetch(
          '/api/cj-checkout/select-shipping', {
            method: 'POST',

            headers: {
              'Content-Type': 'application/json',

              Accept: 'application/json'
            },

            credentials: 'same-origin',

            body: JSON.stringify({
              optionId
            })
          }
        );

        const data = await response
          .json()
          .catch(function() {
            return {};
          });

        if (
          !response.ok ||
          data.success === false
        ) {
          throw new Error(
            data.message ||
            'The selected CJ shipping method could not be saved.'
          );
        }

        const selected =
          data.selectedShipping || {};

        if (shippingAmountElement) {
          shippingAmountElement.textContent =
            formatMoney(
              selected.shippingAmount ??
              shippingAmount
            );
        }

        if (payableTotalElement) {
          payableTotalElement.textContent =
            formatMoney(
              selected.payableTotal ??
              payableTotal
            );
        }

        document
          .querySelectorAll(
            '.cj-shipping-option'
          )
          .forEach(function(label) {
            label.classList.remove(
              'border-primary',
              'bg-light'
            );
          });

        input
          .closest(
            '.cj-shipping-option'
          )
          ?.classList.add(
            'border-primary',
            'bg-light'
          );

        if (continueButton) {
          continueButton.disabled =
            false;
        }

        showMessage(
          data.message ||
          'CJ shipping method selected successfully.',
          'success',
          false
        );

        setCjCheckoutHashAndScroll(
          'cj-continue-to-payment'
        );
      } catch (error) {
        input.checked = false;

        if (shippingAmountElement) {
          shippingAmountElement.textContent =
            formatMoney(0);
        }

        if (payableTotalElement) {
          payableTotalElement.textContent =
            formatMoney(
              currentProductTotalBase
            );
        }

        showMessage(
          error?.message ||
          'The selected CJ shipping method could not be saved.',
          'error'
        );
      } finally {
        document
          .querySelectorAll(
            '.js-cj-shipping-option'
          )
          .forEach(function(radio) {
            radio.disabled = false;
          });
      }
    }

    function bindShippingOptions() {
      document
        .querySelectorAll(
          '.js-cj-shipping-option'
        )
        .forEach(function(input) {
          input.addEventListener(
            'change',
            async function() {
              await selectShippingOption(
                input
              );
            }
          );
        });
    }

    function renderShippingOptions(options) {
      if (!optionsContainer || !optionsCard) {
        return;
      }

      const rows = Array.isArray(options) ?
        options : [];

      optionsContainer.innerHTML =
        rows.map(function(option, index) {
          const id =
            'cjShippingOptionDynamic_' +
            index;

          const estimate =
            option.deliveryEstimate ?
            `
                <div class="small text-muted mt-1">
                  Estimated delivery:
                  ${escapeHtml(option.deliveryEstimate)}
                </div>
              ` :
            '';

          const message =
            option.message ?
            `
                <div class="small text-muted mt-1">
                  ${escapeHtml(option.message)}
                </div>
              ` :
            '';

          return `
            <label
              class="d-block border rounded p-3 mb-3 cj-shipping-option"
              for="${id}"
            >
              <div class="d-flex gap-3">
                <input
                  id="${id}"
                  type="radio"
                  name="cjShippingOption"
                  class="form-check-input mt-1 js-cj-shipping-option"
                  value="${escapeHtml(option.id)}"
                  data-shipping-amount="${Number(option.shippingAmount || 0)}"
                  data-payable-total="${Number(option.payableTotal || 0)}"
                >

                <div class="flex-grow-1">
                  <div class="d-flex justify-content-between gap-3">
                    <strong class="text-primary">
                      ${escapeHtml(option.logisticsName)}
                    </strong>

                    <strong>
                      ${formatMoney(option.shippingAmount)}
                    </strong>
                  </div>

                  ${estimate}
                  ${message}
                </div>
              </div>
            </label>
          `;
        }).join('');

      optionsCard.classList.remove(
        'd-none'
      );

      if (continueButton) {
        continueButton.disabled = true;
      }

      if (shippingAmountElement) {
        shippingAmountElement.textContent =
          formatMoney(0);
      }

      if (payableTotalElement) {
        payableTotalElement.textContent =
          formatMoney(
            currentProductTotalBase
          );
      }

      bindShippingOptions();

      setCjCheckoutHashAndScroll(
        'cj-shipping-methods'
      );
    }

    bindCjCountryDropdown();

    bindCjCountrySensitiveGuidance();

    addressForm?.addEventListener(
      'submit',
      async function(event) {
        event.preventDefault();
        clearMessage();

        const countrySensitiveFieldsAreValid =
          validateCjCountrySensitiveFields(true);

        if (
          !addressForm.checkValidity() ||
          !countrySensitiveFieldsAreValid
        ) {
          addressForm.classList.add(
            'was-validated'
          );

          showMessage(
            'Please correct the highlighted CJ delivery-address fields.',
            'error'
          );

          return;
        }

        const originalHtml =
          calculateButton.innerHTML;

        calculateButton.disabled = true;
        calculateButton.innerHTML =
          '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>' +
          'Calculating CJ Shipping...';

        try {
          const response = await fetch(
            '/api/cj-checkout/quote', {
              method: 'POST',

              headers: {
                'Content-Type': 'application/json',

                Accept: 'application/json'
              },

              credentials: 'same-origin',

              body: JSON.stringify(
                formPayload()
              )
            }
          );

          const data = await response
            .json()
            .catch(function() {
              return {};
            });

          if (
            !response.ok ||
            data.success === false
          ) {
            throw new Error(
              data.message ||
              'CJ shipping methods could not be calculated.'
            );
          }

          const quote = data.quote || {};

          if (itemCountElement) {
            itemCountElement.textContent =
              String(quote.itemCount || 0);
          }

          /*
           * Prefer the new VAT-free quote field.
           *
           * productTotalIncVat remains only as a temporary
           * compatibility fallback until the CJ payment route
           * has also been patched.
           */
          const quotedProductTotalBase =
            Number(
              quote.productTotal ??
              quote.productTotalIncVat ??
              0
            );

          currentProductTotalBase =
            Number.isFinite(
              quotedProductTotalBase
            ) ?
            quotedProductTotalBase :
            0;

          if (productTotalElement) {
            productTotalElement.textContent =
              formatMoney(
                currentProductTotalBase
              );
          }

          if (payableTotalElement) {
            payableTotalElement.textContent =
              formatMoney(
                currentProductTotalBase
              );
          }

          renderShippingOptions(
            quote.options
          );

          showMessage(
            data.message ||
            'CJ shipping methods calculated successfully.',
            'success',
            false
          );

          setCjCheckoutHashAndScroll(
            'cj-shipping-methods'
          );
        } catch (error) {
          optionsCard?.classList.add(
            'd-none'
          );

          showMessage(
            error?.message ||
            'CJ shipping methods could not be calculated.',
            'error'
          );
        } finally {
          calculateButton.disabled = false;
          calculateButton.innerHTML =
            originalHtml;
        }
      }
    );

    continueButton?.addEventListener(
      'click',
      async function() {
        clearMessage();

        const selectedInput =
          document.querySelector(
            '.js-cj-shipping-option:checked'
          );

        if (!selectedInput) {
          showMessage(
            'Please select and save a CJ shipping method first.',
            'error'
          );

          return;
        }

        const originalHtml =
          continueButton.innerHTML;

        continueButton.disabled = true;

        continueButton.innerHTML =
          '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>' +
          'Opening PayPal...';

        try {
          const response = await fetch(
            '/api/cj-payment/create', {
              method: 'POST',

              headers: {
                'Content-Type': 'application/json',

                Accept: 'application/json'
              },

              credentials: 'same-origin',

              body: JSON.stringify({})
            }
          );

          const data = await response
            .json()
            .catch(function() {
              return {};
            });

          if (
            !response.ok ||
            data.success === false
          ) {
            const redirectTo = String(
              data.redirectTo || ''
            ).trim();

            if (
              redirectTo &&
              redirectTo.startsWith('/')
            ) {
              window.location.assign(
                redirectTo
              );

              return;
            }

            throw new Error(
              data.message ||
              'The CJ PayPal payment could not be started.'
            );
          }

          const approvalUrl = String(
            data.approvalUrl || ''
          ).trim();

          if (!approvalUrl) {
            throw new Error(
              'PayPal did not return a payment approval page.'
            );
          }

          window.location.assign(
            approvalUrl
          );
        } catch (error) {
          continueButton.disabled = false;

          continueButton.innerHTML =
            originalHtml;

          showMessage(
            error?.message ||
            'The CJ PayPal payment could not be started.',
            'error'
          );
        }
      }
    );

    bindShippingOptions();
  })();
</script>