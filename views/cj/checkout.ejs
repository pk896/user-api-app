<!-- views/cj/checkout.ejs -->
<%
  /*
   * BASE_CURRENCY remains authoritative for all CJ product,
   * cart, shipping, checkout, PayPal, order and supplier
   * fulfilment amounts.
   *
   * Kasyora adds and collects no VAT in the CJ flow.
   * Destination import VAT, customs duties and carrier charges
   * remain outside Kasyora's product-price calculation.
   *
   * CURRENCY affects visible customer amounts only.
   */
  const BASE_CURRENCY = String(
    typeof baseCurrency !== 'undefined'
      ? baseCurrency
      : 'USD'
  ).trim().toUpperCase() || 'USD';

  const CURRENCY = String(
    typeof displayCurrency !== 'undefined'
      ? displayCurrency
      : BASE_CURRENCY
  ).trim().toUpperCase() || BASE_CURRENCY;

  const CURRENCY_RATE_RAW = Number(
    typeof displayRate !== 'undefined'
      ? displayRate
      : 1
  );

  const CURRENCY_RATE =
    Number.isFinite(CURRENCY_RATE_RAW) &&
    CURRENCY_RATE_RAW > 0
      ? CURRENCY_RATE_RAW
      : 1;

  const ITEMS = Array.isArray(cartItems)
    ? cartItems
    : [];

  const SAVED_ADDRESS =
    savedAddress &&
    typeof savedAddress === 'object'
      ? savedAddress
      : {};

  const SAVED_QUOTE =
    savedQuote &&
    typeof savedQuote === 'object'
      ? savedQuote
      : null;

  const SAVED_OPTIONS =
    Array.isArray(SAVED_QUOTE?.options)
      ? SAVED_QUOTE.options
      : [];

  const SAVED_SELECTED_SHIPPING =
    savedSelectedShipping &&
    typeof savedSelectedShipping === 'object'
      ? savedSelectedShipping
      : null;

  const SAVED_SELECTED_SHIPPING_ID =
    String(
      SAVED_SELECTED_SHIPPING?.id || ''
    ).trim();

  /*
   * This VAT-free product total always remains in
   * BASE_CURRENCY.
   *
   * Client-side code uses it instead of reading formatted
   * display-currency text back from the page.
   */
  const INITIAL_PRODUCT_TOTAL_BASE = Number(
    typeof total !== 'undefined'
      ? total
      : (
          typeof totalIncVat !== 'undefined'
            ? totalIncVat
            : 0
        )
  );

  function convertBaseToDisplay(amount) {
    const baseAmount = Number(amount || 0);

    if (!Number.isFinite(baseAmount)) {
      return 0;
    }

    return Number(
      (
        baseAmount *
        CURRENCY_RATE
      ).toFixed(2)
    );
  }

  function formatMoney(amount) {
    const convertedAmount =
      convertBaseToDisplay(amount);

    try {
      const formatted = new Intl.NumberFormat(
        undefined,
        {
          style: 'currency',
          currency: CURRENCY,
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }
      ).format(convertedAmount);

      if (CURRENCY === 'ZAR') {
        return formatted.replace(/^ZAR\s?/, 'R');
      }

      return formatted;
    } catch (error) {
      return (
        CURRENCY +
        ' ' +
        convertedAmount.toFixed(2)
      );
    }
  }

  const CJ_CHECKOUT_CURRENCY_RETURN_TO =
    '/cj/checkout';

  function countryValue(country) {
    if (typeof country === 'string') {
      return country.trim().toUpperCase();
    }

    return String(
      country?.code ||
      country?.countryCode ||
      country?.iso2 ||
      country?.value ||
      ''
    ).trim().toUpperCase();
  }

  function countryLabel(country) {
    if (typeof country === 'string') {
      return country;
    }

    return String(
      country?.name ||
      country?.countryName ||
      country?.label ||
      country?.code ||
      country?.countryCode ||
      ''
    ).trim();
  }

  function safeJson(value) {
    return JSON.stringify(value || {})
      .replace(/</g, '\\u003c')
      .replace(/>/g, '\\u003e')
      .replace(/&/g, '\\u0026');
  }
%>

<!-- Header Start -->
<div class="container-fluid bg-light py-4 border-bottom">
  <div class="container">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
      <div>
        <span class="badge bg-success mb-2">
          CJ Dropshipping Department
        </span>

        <h1 class="text-primary mb-1">
          CJ Checkout
        </h1>

        <nav aria-label="breadcrumb">
          <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item">
              <a href="/store">Store</a>
            </li>

            <li class="breadcrumb-item">
              <a href="/cj/cart">CJ Cart</a>
            </li>

            <li class="breadcrumb-item active" aria-current="page">
              Checkout
            </li>
          </ol>
        </nav>
      </div>

      <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-2">
        <div class="bg-white border rounded px-2 py-1">
          <div class="small fw-bold text-primary mb-1">
            Display currency
          </div>

          <%- include('../store/partials/currency-selector', {
            currencyReturnTo: CJ_CHECKOUT_CURRENCY_RETURN_TO
          }) %>
        </div>

        <a href="/cj/cart" class="btn btn-outline-primary rounded-pill px-4">
          <i class="fas fa-arrow-left me-2"></i>
          Return To CJ Cart
        </a>
      </div>
    </div>
  </div>
</div>
<!-- Header End -->

<%
  const CJ_CHECKOUT_SHOW_CURRENCY_WARNING =
    typeof currencyConversionAvailable !== 'undefined' &&
    currencyConversionAvailable === false;

  const CJ_CHECKOUT_CURRENCY_WARNING_TEXT =
    typeof currencyConversionMessage !== 'undefined'
      ? String(currencyConversionMessage || '').trim()
      : '';
%>

<% if (
  CJ_CHECKOUT_SHOW_CURRENCY_WARNING &&
  CJ_CHECKOUT_CURRENCY_WARNING_TEXT
) { %>
<div class="container mt-4">
  <div class="alert alert-warning border shadow-sm mb-0" role="alert">
    <div class="d-flex align-items-start gap-2">
      <i class="fas fa-exclamation-triangle text-primary mt-1" aria-hidden="true"></i>

      <div>
        <div class="fw-bold text-primary">
          Currency display notice
        </div>

        <div class="small">
          <%= CJ_CHECKOUT_CURRENCY_WARNING_TEXT %>
        </div>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- CJ Notice Start -->
<div class="container-fluid px-0">
  <div class="alert alert-success rounded-0 border-0 mb-0">
    <div class="container">
      <div class="d-flex align-items-start gap-3">
        <i class="fas fa-globe fa-lg mt-1"></i>

        <div>
          <strong>
            Separate CJ logistics checkout
          </strong>

          <div class="small mt-1">
            Enter the delivery address below to request current CJ shipping
            methods. This checkout does not use Shippo, Courier Guy or the
            internal Kasyora order flow.
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- CJ Notice End -->

<div class="container-fluid py-5">
  <div class="container">
    <% if (typeof paymentNotice !== 'undefined' && paymentNotice) { %>
    <div class="alert alert-<%= paymentNotice.type || 'warning' %> border-0 shadow-sm" role="alert">
      <div class="fw-bold mb-1">
        <%= paymentNotice.title || 'CJ PayPal payment notice' %>
      </div>

      <div>
        <%= paymentNotice.message || 'Please check your payment and try again.' %>
      </div>

      <% if (paymentNotice.paypalReference) { %>
      <div class="small mt-2">
        PayPal checkout reference:
        <strong><%= paymentNotice.paypalReference %></strong>
      </div>
      <% } %>
    </div>
    <% } %>

    <div id="cjCheckoutMessage" class="d-none" role="alert"></div>

    <div class="row g-4">
      <!-- Address Form -->
      <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-primary text-white py-3">
            <h4 class="text-white mb-0">
              Delivery Address
            </h4>
          </div>

          <div class="card-body p-4">
            <form id="cjCheckoutAddressForm" novalidate>
              <div class="row g-3">
                <div class="col-12 col-md-6">
                  <label for="cjFirstName" class="form-label fw-semibold">
                    First name
                  </label>

                  <input id="cjFirstName" name="firstName" type="text" class="form-control" value="<%= SAVED_ADDRESS.firstName || '' %>" required>
                </div>

                <div class="col-12 col-md-6">
                  <label for="cjLastName" class="form-label fw-semibold">
                    Last name
                  </label>

                  <input id="cjLastName" name="lastName" type="text" class="form-control" value="<%= SAVED_ADDRESS.lastName || '' %>" required>
                </div>

                <div class="col-12 col-md-6">
                  <label for="cjEmail" class="form-label fw-semibold">
                    Email address
                  </label>

                  <input id="cjEmail" name="email" type="email" class="form-control" value="<%= SAVED_ADDRESS.email || '' %>" required>
                </div>

                <div class="col-12 col-md-6">
                  <label for="cjPhone" class="form-label fw-semibold">
                    Phone number
                  </label>

                  <input id="cjPhone" name="phone" type="tel" class="form-control" value="<%= SAVED_ADDRESS.phone || '' %>" placeholder="+1 555 123 4567" required>

                  <div id="cjPhoneCountryHelp" class="form-text text-danger d-none">
                    For South Africa CJ delivery, use 0632207320, 632207320, or 27632207320. Kasyora will send CJ the correct digits-only format.
                  </div>

                  <div id="cjPhoneGlobalHelp" class="form-text text-danger d-none">
                    Enter a reachable delivery phone number with 6 to 20 digits.
                  </div>
                </div>

                <div class="col-12 col-md-6">
                  <label for="cjCountrySearch" class="form-label fw-semibold">
                    Destination country
                  </label>

                  <input id="cjCountryCode" name="countryCode" type="hidden" value="<%= String(SAVED_ADDRESS.countryCode || '').toUpperCase() %>" required>

                  <div class="dropdown w-100">
                    <button id="cjCountryDropdownButton" class="btn btn-light border w-100 d-flex align-items-center justify-content-between gap-2 text-start" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                      <span class="d-inline-flex align-items-center gap-2 min-w-0">
                        <img id="cjSelectedCountryFlag" src="" alt="" class="border rounded d-none" width="20" height="15" loading="lazy">

                        <span id="cjSelectedCountryText" class="text-muted">
                          Select country
                        </span>
                      </span>

                      <span aria-hidden="true">
                        ▾
                      </span>
                    </button>

                    <div class="dropdown-menu w-100 p-2 shadow" style="max-height: 320px; overflow-y: auto;">
                      <input id="cjCountrySearch" type="text" class="form-control mb-2" placeholder="Search country..." autocomplete="off">

                      <div id="cjCountryOptions">
                        <% (COUNTRIES || []).forEach(function(country) { %>
                        <%
                            const value = countryValue(country);
                            const label = countryLabel(country);
                            const selected = String(SAVED_ADDRESS.countryCode || '').toUpperCase() === value;
                          %>

                        <% if (value && label) { %>
                        <button type="button" class="dropdown-item d-flex align-items-center gap-2 rounded py-2 js-cj-country-option <%= selected ? 'active' : '' %>" data-code="<%= value %>" data-name="<%= label %>">
                          <img src="https://flagcdn.com/20x15/<%= String(value || '').toLowerCase() %>.png" alt="" class="border rounded" width="20" height="15" loading="lazy">

                          <span>
                            <%= label %>
                          </span>
                        </button>
                        <% } %>
                        <% }) %>
                      </div>
                    </div>
                  </div>

                  <div class="form-text">
                    Start typing to search and select the customer delivery country.
                  </div>
                </div>

                <div class="col-12 col-md-6">
                  <label for="cjProvince" class="form-label fw-semibold">
                    Province or state
                  </label>

                  <input id="cjProvince" name="province" type="text" class="form-control" value="<%= SAVED_ADDRESS.province || '' %>" required>
                </div>

                <div class="col-12 col-md-6">
                  <label for="cjCity" class="form-label fw-semibold">
                    City
                  </label>

                  <input id="cjCity" name="city" type="text" class="form-control" value="<%= SAVED_ADDRESS.city || '' %>" required>
                </div>

                <div class="col-12 col-md-6">
                  <label for="cjSuburb" class="form-label fw-semibold">
                    Suburb
                  </label>

                  <input id="cjSuburb" name="suburb" type="text" class="form-control" value="<%= SAVED_ADDRESS.suburb || '' %>">
                </div>

                <div class="col-12 col-md-8">
                  <label for="cjAddressLine1" class="form-label fw-semibold">
                    Street address
                  </label>

                  <input id="cjAddressLine1" name="addressLine1" type="text" class="form-control" value="<%= SAVED_ADDRESS.addressLine1 || '' %>" required>
                </div>

                <div class="col-12 col-md-4">
                  <label for="cjHouseNumber" class="form-label fw-semibold">
                    House number
                  </label>

                  <input id="cjHouseNumber" name="houseNumber" type="text" class="form-control" value="<%= SAVED_ADDRESS.houseNumber || '' %>">
                </div>

                <div class="col-12">
                  <label for="cjAddressLine2" class="form-label fw-semibold">
                    Apartment, suite or additional address
                  </label>

                  <input id="cjAddressLine2" name="addressLine2" type="text" class="form-control" value="<%= SAVED_ADDRESS.addressLine2 || '' %>">
                </div>

                <div class="col-12 col-md-6">
                  <label for="cjPostalCode" class="form-label fw-semibold">
                    Postal code
                  </label>

                  <input id="cjPostalCode" name="postalCode" type="text" class="form-control" value="<%= SAVED_ADDRESS.postalCode || '' %>" required>
                </div>

                <div class="col-12 col-md-6">
                  <label for="cjCompanyName" class="form-label fw-semibold">
                    Company name
                  </label>

                  <input id="cjCompanyName" name="companyName" type="text" class="form-control" value="<%= SAVED_ADDRESS.companyName || '' %>">
                </div>

                <div class="col-12 col-md-6">
                  <label for="cjTaxId" class="form-label fw-semibold">
                    Tax ID / Consignee ID

                    <span id="cjTaxIdRequiredBadge" class="badge bg-primary ms-2 d-none">
                      Required
                    </span>
                  </label>

                  <input id="cjTaxId" name="taxId" type="text" class="form-control" value="<%= SAVED_ADDRESS.taxId || '' %>" placeholder="Optional for most countries" autocomplete="off">

                  <div id="cjTaxIdDynamicHelp" class="form-text text-muted d-none">
                    Tax ID / Consignee ID is required for this destination.
                  </div>
                </div>

                <div class="col-12 col-md-6">
                  <label for="cjIossNumber" class="form-label fw-semibold">
                    IOSS number
                  </label>

                  <input id="cjIossNumber" name="iossNumber" type="text" class="form-control" value="" placeholder="Handled by Kasyora for EU orders" disabled>

                  <div id="cjIossDefaultHelp" class="form-text">
                    For EU CJ delivery, Kasyora must have its own valid IOSS number configured before payment.
                  </div>

                  <div id="cjIossRequiredHelp" class="form-text text-danger d-none">
                    EU CJ delivery is temporarily unavailable because Kasyora has not configured a valid IOSS number yet.
                  </div>
                </div>

                <div class="col-12">
                  <div class="alert alert-light border mb-0">
                    <div class="small">
                      <strong>Current CJ origin:</strong>
                      <%= defaultOriginCountryCode || 'Not configured' %>
                    </div>

                    <div class="small text-muted mt-1">
                      CJ will calculate shipping from the configured origin
                      country to the destination entered above.
                    </div>
                  </div>
                </div>

                <div class="col-12">
                  <button id="cjCalculateShippingButton" type="submit" class="btn btn-primary btn-lg rounded-pill w-100">
                    <i class="fas fa-truck me-2"></i>
                    Calculate CJ Shipping
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>

      <!-- Order Summary -->
      <div class="col-12 col-lg-5 px-0 px-lg-3">
        <div class="card border-0 shadow-sm rounded-0 mb-4">
          <div class="card-header bg-primary text-white py-3 rounded-0">
            <h4 class="text-white mb-0">
              CJ Cart Summary
            </h4>
          </div>

          <div class="card-body p-4">
            <% ITEMS.forEach(function(item) { %>
            <div class="d-flex gap-3 mb-3 pb-3 border-bottom">
              <a href="/cj/product/<%= encodeURIComponent(item.cjProductId) %>" class="flex-shrink-0">
                <img src="<%= item.imageUrl %>" alt="<%= item.name %>" class="border rounded" style="width: 72px; height: 72px; object-fit: contain;">
              </a>

              <div class="flex-grow-1">
                <a href="/cj/product/<%= encodeURIComponent(item.cjProductId) %>" class="text-decoration-none">
                  <div class="fw-semibold text-primary">
                    <%= item.name %>
                  </div>
                </a>

                <div class="small text-muted">
                  <%= item.variantName %>
                </div>

                <div class="small mt-1">
                  <%= item.quantity %>
                  ×
                  <%= formatMoney(
                    Number(
                      item.priceExVat ??
                      item.price ??
                      0
                    )
                  ) %>
                </div>
              </div>

              <div class="fw-semibold text-primary text-end">
                <%= formatMoney(
                  Number(
                    item.priceExVat ??
                    item.price ??
                    0
                  ) *
                  Number(
                    item.quantity ||
                    0
                  )
                ) %>
              </div>
            </div>
            <% }) %>

            <div class="d-flex justify-content-between mb-2">
              <span class="text-muted">
                Items
              </span>

              <strong id="cjCheckoutItemCount">
                <%= Number(itemCount || 0) %>
              </strong>
            </div>

            <div class="d-flex justify-content-between mb-3">
              <span class="fw-semibold">
                Product total
              </span>

              <strong id="cjCheckoutProductTotal" class="text-primary">
                <%= formatMoney(
                  typeof total !== 'undefined'
                    ? total
                    : (
                        typeof totalIncVat !== 'undefined'
                          ? totalIncVat
                          : 0
                      )
                ) %>
              </strong>
            </div>

            <div class="d-flex justify-content-between mb-3">
              <span class="text-muted">
                Selected CJ shipping
              </span>

              <strong id="cjCheckoutShippingAmount">
                <%= SAVED_SELECTED_SHIPPING
                    ? formatMoney(SAVED_SELECTED_SHIPPING.shippingAmount)
                    : formatMoney(0) %>
              </strong>
            </div>

            <hr>

            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-bold fs-5">
                Estimated payable total
              </span>

              <strong id="cjCheckoutPayableTotal" class="text-primary fs-4">
                <%= SAVED_SELECTED_SHIPPING
                    ? formatMoney(
                        SAVED_SELECTED_SHIPPING.payableTotal
                      )
                    : formatMoney(
                        typeof total !== 'undefined'
                          ? total
                          : (
                              typeof totalIncVat !== 'undefined'
                                ? totalIncVat
                                : 0
                            )
                      ) %>
              </strong>
            </div>

            <div class="alert alert-light border small mt-4 mb-0">
              <div class="mb-2">
                <i class="fas fa-info-circle text-primary me-2"></i>

                Kasyora does not add or collect VAT on CJ Dropshipping
                products. Any destination import VAT, customs duties or
                carrier handling charges remain the customer’s
                responsibility during import and delivery.
              </div>

              <div class="mb-2">
                Visible product, shipping and estimated payable amounts are
                displayed in
                <strong><%= CURRENCY %></strong>.
              </div>

              <div>
                CJ cart, logistics, PayPal, order and supplier-order amounts
                remain securely calculated in
                <strong><%= BASE_CURRENCY %></strong>.
              </div>
            </div>
          </div>
        </div>

        <!-- Shipping Options -->
        <div id="cj-shipping-methods" class="card border-0 shadow-sm <%= SAVED_OPTIONS.length ? '' : 'd-none' %>">
          <div class="card-header bg-primary text-white py-3">
            <h4 class="text-white mb-0">
              CJ Shipping Methods
            </h4>
          </div>

          <div class="card-body p-4">
            <div id="cjShippingOptions">
              <% SAVED_OPTIONS.forEach(function(option, index) { %>
              <label class="d-block border rounded p-3 mb-3 cj-shipping-option <%= SAVED_SELECTED_SHIPPING_ID === String(option.id || '').trim() ? 'border-primary bg-light' : '' %>" for="cjShippingOption_<%= index %>">

                <div class="d-flex gap-3">
                  <input id="cjShippingOption_<%= index %>" type="radio" name="cjShippingOption" class="form-check-input mt-1 js-cj-shipping-option" value="<%= option.id %>" data-shipping-amount="<%= option.shippingAmount %>" data-payable-total="<%= option.payableTotal %>" <%= SAVED_SELECTED_SHIPPING_ID === String(option.id || '').trim()
                            ? 'checked'
                            : '' %>>

                  <div class="flex-grow-1">
                    <div class="d-flex justify-content-between gap-3">
                      <strong class="text-primary">
                        <%= option.logisticsName %>
                      </strong>

                      <strong>
                        <%= formatMoney(option.shippingAmount) %>
                      </strong>
                    </div>

                    <% if (option.deliveryEstimate) { %>
                    <div class="small text-muted mt-1">
                      Estimated delivery:
                      <%= option.deliveryEstimate %>
                    </div>
                    <% } %>

                    <% if (option.message) { %>
                    <div class="small text-muted mt-1">
                      <%= option.message %>
                    </div>
                    <% } %>
                  </div>
                </div>
              </label>
              <% }) %>
            </div>

            <div id="cj-continue-to-payment">
              <button id="cjContinueToPaymentButton" type="button" class="btn btn-success btn-lg rounded-pill w-100" <%= SAVED_SELECTED_SHIPPING ? '' : 'disabled' %>>
                <i class="fas fa-lock me-2"></i>
                Continue To CJ Payment
              </button>
            </div>

            <div class="small text-muted text-center mt-3">
              Your payment will be completed securely through PayPal.
              Kasyora stores the order in the separate CJ order department.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../store/partials/footer') %>

<%- include('../store/partials/currency-client') %>

<script nonce="<%= nonce %>">
  (function() {
    /*
     * Always keep these client-side state values in
     * authoritative BASE_CURRENCY.
     */
    let currentProductTotalBase = Number(
      <%- safeJson(INITIAL_PRODUCT_TOTAL_BASE) %>
    );

    if (!Number.isFinite(currentProductTotalBase)) {
      currentProductTotalBase = 0;
    }

    const cjBuyerTaxIdRules =
      <%- safeJson(cjBuyerTaxIdRules || {}) %>;

    const addressForm = document.getElementById(
      'cjCheckoutAddressForm'
    );

    const calculateButton = document.getElementById(
      'cjCalculateShippingButton'
    );

    const messageElement = document.getElementById(
      'cjCheckoutMessage'
    );

    const optionsCard = document.getElementById(
      'cj-shipping-methods'
    );

    const continuePaymentAnchor = document.getElementById(
      'cj-continue-to-payment'
    );

    const optionsContainer = document.getElementById(
      'cjShippingOptions'
    );

    const shippingAmountElement = document.getElementById(
      'cjCheckoutShippingAmount'
    );

    const payableTotalElement = document.getElementById(
      'cjCheckoutPayableTotal'
    );

    const productTotalElement = document.getElementById(
      'cjCheckoutProductTotal'
    );

    const itemCountElement = document.getElementById(
      'cjCheckoutItemCount'
    );

    const continueButton = document.getElementById(
      'cjContinueToPaymentButton'
    );

    const countrySelect = document.getElementById(
      'cjCountryCode'
    );

    const countryDropdownButton = document.getElementById(
      'cjCountryDropdownButton'
    );

    const selectedCountryFlag = document.getElementById(
      'cjSelectedCountryFlag'
    );

    const selectedCountryText = document.getElementById(
      'cjSelectedCountryText'
    );

    const countrySearchInput = document.getElementById(
      'cjCountrySearch'
    );

    const countryOptionsContainer = document.getElementById(
      'cjCountryOptions'
    );

    const phoneInput = document.getElementById(
      'cjPhone'
    );

    const phoneCountryHelp = document.getElementById(
      'cjPhoneCountryHelp'
    );

    const phoneGlobalHelp = document.getElementById(
      'cjPhoneGlobalHelp'
    );

